@page "/app/spirits"
@attribute [Authorize]
@inherits CatalogueReferencePage

<AppPageTitle Title="Spirits"/>

@* The signed-in view of the same reference page, with the player's own record folded in — so it
   can be sorted by what they play and filtered down to what they haven't. The public route
   (/spirits) passes no records and simply doesn't offer those. *@
<SpiritsView Records="Records" Facts="Facts"/>

@code {
    protected override IReadOnlyDictionary<string, SetupInsights.PlayRecord> Project(
        IReadOnlyList<SetupGameFact> facts) => SetupInsights.SpiritRecords(facts);
}
