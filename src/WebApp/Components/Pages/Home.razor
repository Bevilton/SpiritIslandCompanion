@page "/"
@layout PublicLayout
@inject IMediator Mediator

<PageTitle>@AppPageTitle.SiteName</PageTitle>

@* The landing page runs dark → light → dark: the hero and the community band are the sea, the
   middle is parchment, and the footer closes it back into the water. See the palette note at the
   top of Styles/site.css for why the app is composed that way.

   Both dark sections are one continuous gradient read top to bottom — the hero rises from night
   to lit surface water, and the band below carries on down into the deep. They must therefore
   stay adjacent, and nothing may be inserted between them. *@

@* ============================== HERO ============================== *@
<section class="deep-sea relative overflow-hidden">
    <div class="hero-waves">
        <svg viewBox="0 0 1440 210" preserveAspectRatio="none" aria-hidden="true">
            <path d="M-20 34q44-17 88 0t88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0 88 0"/>
            <path d="M-60 84q48-19 96 0t96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0 96 0"/>
            <path d="M-20 136q52-20 104 0t104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0 104 0"/>
            <path d="M-70 184q56-22 112 0t112 0 112 0 112 0 112 0 112 0 112 0 112 0 112 0 112 0 112 0 112 0 112 0"/>
        </svg>
    </div>

    <div class="page-shell">
        <div class="grid items-center gap-8 py-16 md:grid-cols-[1.02fr_.98fr] md:py-24">
            <div>
                <span class="eyebrow eyebrow-on-deep">
                    <span class="eyebrow-dot"></span>
                    Companion app for Spirit Island
                </span>
                @* Not .page-title, and no h1 focus ring: FocusOnNavigate lands focus here and
                   Chrome's default outline draws a box round the headline. *@
                <h1 class="on-deep-title mt-5 text-4xl leading-[1.03] tracking-[-.03em] md:text-6xl focus:outline-none">
                    Track every match.
                    <span class="block text-accent-300" style="text-shadow: 0 0 44px rgb(from var(--color-accent-300) r g b / .34);">
                        Defend the island.
                    </span>
                </h1>
                <p class="on-deep-body mt-6 max-w-[36ch] text-lg leading-relaxed md:text-xl">
                    Log your games, study your stats, and keep your group's history in one calm,
                    unhurried place — built for the cooperative board game by R. Eric Reuss.
                </p>
                <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a href="@(_signedIn ? AppRoutes.Dashboard : AppRoutes.Login)" class="btn btn-primary btn-lg">
                        @(_signedIn ? "Go to dashboard" : "Get started")
                        <Icon Name="arrow-right" Class="w-4 h-4"/>
                    </a>
                    @* The demo, not the catalog: a visitor deciding whether to sign up wants to
                       see the app full of games, and the reference pages have their own section
                       further down. The demo signs them into a throwaway sandbox — see
                       WebApp.Demo.DemoEndpoints. *@
                    <a href="@(_signedIn ? GamesLink.New : AppRoutes.Demo)" class="btn btn-glass btn-lg">
                        @(_signedIn ? "Record a game" : "Try the live demo")
                    </a>
                </div>
                @if (!_signedIn)
                {
                    <p class="on-deep-muted mt-3 text-xs">
                        No account needed — the demo is a full sandbox with over two years of sample games.
                    </p>
                }
            </div>

            @* The island, painted from the same board geometry the playground arranges — see
               tools/island-geometry/build.mjs. Decorative, hence empty alt.
               It stacks under the copy on one column rather than being dropped: it is the one
               thing on the page that says which game this is. Capped there so it stays an
               illustration under the headline instead of a second screenful. *@
            <div class="relative mx-auto w-full max-w-xs md:max-w-none">
                @* width/height are the art's own viewBox (321.4 × 304.6) at ×5, purely to reserve
                   the right box before it loads. They are NOT square: an img with width and height
                   attributes gets aspect-ratio from them, so a square pair letterboxed the island
                   inside its own column and the fleet's per-cent positions no longer lined up with
                   the coast. Re-derive them if the hero layout changes. *@
                <img src="img/hero-island.svg" alt="" class="hero-isle" width="1607" height="1523"/>

                @* The invaders, standing off the coast. The fleet lives INSIDE the island's own
                   column so the ships ring the island at every breakpoint — spread across the
                   whole hero they drifted under the headline and read as a row of icons in the
                   waves rather than as ships closing on a coast.
                   Positions are per cent of this box and the art carries its own margin, so the
                   coast sits at roughly 10–90% of it and these all fall outside that. Purely
                   decorative: no data, nothing interactive. *@
                <div class="hero-fleet" aria-hidden="true">
                    @* The sails' gradient, once for the whole fleet — see InvaderShip. *@
                    @InvaderShip.SailGradient
                    @Ship(3,  58, 0.72, 0)
                    @Ship(23, 90, 1.00, -5200)
                    @Ship(62, 94, 1.06, -2600)
                    @Ship(93, 62, 0.80, -8100)
                </div>
            </div>
        </div>
    </div>
</section>

@* ============================== COMMUNITY BAND ==============================
   Figures on the water rather than four cards floating on it — see .figure. *@
<section class="deep relative overflow-hidden"
         style="background-image: linear-gradient(180deg, var(--si-sea-crest) 0%, var(--color-deep-800) 62%, var(--color-deep-900) 100%);">
    <div class="page-shell py-12 md:py-16">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
            <div>
                <span class="eyebrow eyebrow-on-deep">Across the community</span>
                <h2 class="on-deep-title band-title">
                    Every island, every defeat, every victory.
                </h2>
            </div>
            <a href="@RecordGameHref" class="inline-flex items-center gap-1.5 text-sm text-accent-300 hover:text-accent-200 transition-colors">
                Add your games <Icon Name="arrow-right" Class="w-3.5 h-3.5"/>
            </a>
        </div>

        @if (_loading)
        {
            <LoadingSpinner OnDeep="true"/>
        }
        else if (_stats is null || _stats.TotalGames == 0)
        {
            <div class="rounded-xl border on-deep-rule px-4 py-12 text-center"
                 style="background-color: rgb(from var(--color-deep-100) r g b / .06);">
                <p class="on-deep-body">No games tracked yet — be the first to log one.</p>
                <a href="@RecordGameHref" class="btn btn-primary mt-5">
                    @(_signedIn ? "Record a game" : "Sign in to record a game")
                </a>
            </div>
        }
        else
        {
            @* Four different dimensions, not two views of one. "Completed" used to sit here beside
               "Games tracked" and was really the same figure minus the drafts — and the win rate
               already implies it, since only completed games have an outcome to average. Hours on
               the island says something none of the others do. *@
            <div class="grid grid-cols-2 gap-y-10 md:grid-cols-4 md:gap-y-0">
                <div class="figure">
                    <span class="figure-value">@_stats.TotalGames</span>
                    <span class="figure-label">Games tracked</span>
                </div>
                @* Whole hours, deliberately not StatsFormat.Hours: that rolls over into "7d 21h"
                   past a day, which is right for one player's total and wrong here — a community
                   figure has to be one big number with a small unit beside it, and days undersell
                   a number that only ever grows. *@
                <div class="figure">
                    <span class="figure-value">
                        @((int)_stats.TotalPlayTime.TotalHours)<span class="figure-unit">h</span>
                    </span>
                    <span class="figure-label">On the island</span>
                </div>
                @* At the two-column breakpoint the third figure starts a new row, so its rule
                   would hang off the left edge with nothing before it. *@
                <div class="figure max-md:border-l-0 max-md:pl-0">
                    <span class="figure-value">@_stats.TotalPlayers</span>
                    <span class="figure-label">Players</span>
                </div>
                <div class="figure">
                    <span class="figure-value">
                        @($"{_stats.WinRate:F0}")<span class="figure-unit">%</span>
                    </span>
                    <span class="figure-label">Community win rate</span>
                </div>
            </div>
        }
    </div>
</section>

@* ============================== FEATURES ============================== *@
<section class="page-shell py-16 md:py-24">
    <div class="max-w-2xl">
        <span class="eyebrow">What's inside</span>
        <h2 class="band-title">Built for groups who play often.</h2>
    </div>
    @* Four across rather than three: the island builder is the thing this app has that a
       spreadsheet doesn't, and leaving it off the landing page meant a visitor had to start a game
       before discovering it. *@
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        @Feature("controller", "Match logging",
                 "Capture spirits, aspects, boards, adversaries, and the result. Save drafts mid-game and finish them later.")
        @Feature("map", "Island layouts",
                 "Drag the boards into the island you actually played, then save the shape and reuse it next time.")
        @Feature("chart", "Deep statistics",
                 "Win rates per spirit, adversary, scenario, and player. See trends month over month.")
        @Feature("users", "Friends & players",
                 "Add friends to track shared games. Add local players for the regulars who don't have an account.")
    </div>
</section>

@* ============================== WHAT THE COMMUNITY PLAYS ============================== *@
@if (_stats is { TotalGames: > 0 } && _stats.TopSpirits.Count > 0)
{
    <section class="page-shell pb-16 md:pb-24">
        @* Headed like its three sibling sections. Without this the page went from "Built for groups
           who play often" straight into a table of community figures, which is the one place a
           visitor reading top to bottom had to work out for themselves whose numbers they were. *@
        <div class="mb-10 max-w-2xl">
            <span class="eyebrow">Community trends</span>
            <h2 class="band-title">What everyone plays.</h2>
        </div>

        @* How the island holds as it gets harder. This is here rather than as a third "top five"
           table because it is the one figure a visitor can locate themselves against: everyone
           who plays this game knows roughly what difficulty they play at, and nobody knows
           whether their win rate at it is normal. Bars are the games, the percentage is the
           outcome — so a band nobody plays reads as thin rather than as a suspicious 0%. *@
        @{
            var bands = _stats.DifficultyBands.Where(b => b.Games > 0).ToList();
        }
        @* One band is not a comparison, so the block only earns its place from two up. *@
        @if (bands.Count > 1)
        {
            // every band here has games in it, so this is at least 1 and safe to divide by
            var busiest = bands.Max(b => b.Games);
            <div class="surface mb-5 overflow-hidden">
                <SectionHead Surface="true" Level="3" Title="How the island holds"
                             Note="@($"{_stats.CompletedGames} completed")">
                    <Sub>Win rate by difficulty, across every recorded game</Sub>
                </SectionHead>
                <div class="grid gap-x-6 gap-y-4 p-5 md:p-6 sm:grid-cols-2 lg:grid-cols-5">
                    @foreach (var b in bands)
                    {
                        <div @key="b.Label">
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="micro-label-strong">
                                    Difficulty @b.Label
                                </span>
                                <WinRateFigure Value="b.WinRate" Completed="b.Completed" Class="text-sm"/>
                            </div>
                            @* Bar length is how much the community plays this band; its colour is
                               how they do in it. Two facts, one mark. *@
                            @* A darker track than .meter's own: this card sits on the landing
                               page's parchment band, where ink-100 is barely a shade off it. *@
                            <Meter Value="@Percent.Of(b.Games, busiest)"
                                   FillColor="@WinTone.FillFor(b.WinRate, b.Completed)"
                                   Class="mt-2 h-2 bg-ink-200"/>
                            <div class="row-sub mt-1.5 tabular-nums">
                                @Copy.Count(b.Games, "game")
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="grid gap-5 md:grid-cols-2">
            <div class="surface overflow-hidden">
                <SectionHead Surface="true" Level="3" Title="Most-played spirits">
                    <Trailing><a href="@AppRoutes.PublicSpirits" class="section-link">See all</a></Trailing>
                </SectionHead>
                <ul class="divide-y divide-ink-100">
                    @foreach (var s in _stats.TopSpirits)
                    {
                        @* The spirit's own colour, the same one its card and its presence markers
                           carry everywhere else in the app. *@
                        @TopRow(s.SpiritId, SpiritDot(s.SpiritId), SpiritName(s.SpiritId),
                                s.GamesPlayed, s.WinRate, s.Completed)
                    }
                </ul>
            </div>

            <div class="surface overflow-hidden">
                <SectionHead Surface="true" Level="3" Title="Most-faced adversaries">
                    <Trailing><a href="@AppRoutes.PublicAdversaries" class="section-link">See all</a></Trailing>
                </SectionHead>
                @* An adversary is optional — difficulty comes from the scenario and the blight card
                   too — so a community that has only played open islands has spirits to show here
                   and no adversaries at all. Without this the card was a header over nothing. *@
                @if (_stats.TopAdversaries.Count == 0)
                {
                    <p class="no-data">No adversaries faced yet.</p>
                }
                else
                {
                    <ul class="divide-y divide-ink-100">
                        @foreach (var a in _stats.TopAdversaries)
                        {
                            @TopRow(a.AdversaryId, AdversaryShield, AdversaryName(a.AdversaryId),
                                    a.GamesPlayed, a.WinRate, a.Completed)
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}

@* ============================== BROWSE ============================== *@
<section class="border-t border-ink-200 bg-ink-100">
    <div class="page-shell py-16 md:py-20">
        <div class="mb-10 max-w-xl">
            <span class="eyebrow">Reference</span>
            <h2 class="band-title">Browse the game.</h2>
            <p class="body-copy mt-2">
                Every spirit, adversary, scenario, and board across the base game and expansions —
                no account required.
            </p>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            @Browse(AppRoutes.PublicSpirits,     "sparkles", "Spirits",     GameData.Spirits.Count)
            @Browse(AppRoutes.PublicAdversaries, "shield",   "Adversaries", GameData.Adversaries.Count)
            @Browse(AppRoutes.PublicScenarios,   "book",     "Scenarios",   GameData.Scenarios.Count)
            @Browse(AppRoutes.PublicBoards,      "map",      "Boards",      GameData.Boards.Count)
        </div>
    </div>
</section>

@code {
    /// <summary>
    /// Read once rather than through four <c>AuthorizeView</c> blocks, because every call to action
    /// on this page asks the same single question and only differs in where it points. /login
    /// unconditionally issues an OIDC challenge (see AuthEndpoints), so aiming a signed-in visitor
    /// at it bounces them out to Auth0 and back to this same page — which is why the CTAs branch at
    /// all. Cascaded by AddCascadingAuthenticationState in Program.cs, as AuthorizeView needs too.
    /// </summary>
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private GlobalStatisticsResponse? _stats;
    private bool _loading = true;
    private bool _signedIn;

    /// <summary>Where "record a game" goes: the form itself, or the door.</summary>
    private string RecordGameHref => _signedIn ? GamesLink.New : AppRoutes.Login;

    protected override async Task OnInitializedAsync()
    {
        _signedIn = (await AuthState).User.Identity?.IsAuthenticated ?? false;

        var result = await Mediator.Send(new GetGlobalStatisticsQuery());
        if (result.IsSuccess) _stats = result.Value;
        _loading = false;
    }

    @* The community lists arrive as bare ids, and GameLookups is where an id becomes a name and a
       colour. This page used to keep three dictionaries of its own to make those lookups cheap;
       GameLookups indexes the catalogue itself now, so a per-row lookup costs nothing and the
       fallbacks — an id the catalogue no longer lists — are stated once here instead. *@
    private static string SpiritName(string id) => GameLookups.SpiritFor(id)?.Name ?? id;
    private static string AdversaryName(string id) => GameLookups.AdversaryFor(id)?.Name ?? id;
    private static string SpiritColor(string id) => GameLookups.SpiritColor(GameLookups.SpiritFor(id));

    /// <summary>
    /// One line of a "most-played" list: what it is, what it is called, how often the community
    /// has played it, and how they do. The two lists differ in nothing but the marker at the
    /// front, so that is all either one supplies — written out twice, the adversary list had
    /// already been left with a hand-rolled marker where the spirit list uses the shared one.
    /// </summary>
    private static RenderFragment TopRow(
        string key, RenderFragment marker, string name, int games, double winRate, int completed) =>
        @<li @key="key" class="flex items-center gap-3 px-5 py-3">
            @marker
            <span class="row-title min-w-0 flex-1 truncate">@name</span>
            <span class="block-note shrink-0 tabular-nums">@Copy.Count(games, "game")</span>
            @* The rate is toned by the rate rather than always green — the difficulty bars above
               turn on the same threshold, and a fixed success pill called a 38% win rate a win.
               A dash while nothing has finished: a spirit played three times with all three still
               drafts has a rate of 0 by arithmetic, not a record of three defeats. *@
            <span class="badge @WinTone.BadgeFor(winRate, completed) shrink-0 tabular-nums">@(completed > 0 ? $"{winRate:F0}%" : "—")</span>
        </li>;

    private static RenderFragment SpiritDot(string spiritId) =>
        @<ColorDot Size="sm" Color="@SpiritColor(spiritId)"/>;

    private static readonly RenderFragment AdversaryShield =
        @<IconChip Name="shield" Size="xs" Tone="bg-ember-100 text-ember-700"/>;

    /// <summary>
    /// One invader ship for the hero's fleet — the drawing is <see cref="InvaderShip"/>'s, shared
    /// with the setup screen. <paramref name="leftPct"/> and <paramref name="topPct"/> place it
    /// around the island — both per cent of the island's own box, and the ship is centred on that
    /// point. <paramref name="scale"/> is how near it is, which drives its size and its haze
    /// together. <paramref name="delayMs"/> is negative so each ship starts part-way through the
    /// swell rather than all four rising as one.
    /// </summary>
    private static RenderFragment Ship(double leftPct, double topPct, double scale, int delayMs) =>
        @<span class="hero-ship" style="left: @(leftPct.ToInvariant())%; top: @(topPct.ToInvariant())%; --ship-scale: @(scale.ToInvariant()); animation-delay: @(delayMs)ms;">
            <InvaderShip/>
        </span>;

    /// <summary>The tile a landing-page card leads with — the jade chip with a hairline round it,
    /// which is what lets it sit on a card without reading as a button. Both card kinds wear it.</summary>
    private const string CardChip = "border border-accent-200/70 bg-accent-50 text-accent-700";

    /// <summary>
    /// One of the four cards under "What's inside". The same card as <see cref="Browse"/> below —
    /// a 2xl glyph, the subject's name, a line under it — and the two were naming that subject two
    /// different ways: this one hand-written a size up and a tracking step tighter (an h3 takes the
    /// base layer's tracking-tight), Browse's on .card-title, with two bands between them to make
    /// the difference hard to catch. .card-title is the register, so both wear it. The lines under
    /// them stay their own: a count is not a sentence.
    /// </summary>
    private RenderFragment Feature(string icon, string title, string body) =>
        @<div class="surface p-6">
            <IconChip Name="@icon" Size="2xl" Tone="@CardChip"/>
            <h3 class="card-title mt-4">@title</h3>
            <p class="body-copy mt-2 text-sm">@body</p>
        </div>;

    private RenderFragment Browse(string href, string icon, string label, int count) =>
        @* .card-lift is how a clickable card answers the pointer everywhere else in the app; this
           was the one that had improvised its own rise and dropped the shadow that comes with it.
           The accent border is this card's own — a utility, so it outranks .card-lift's ink. *@
        @<a href="@href"
            class="surface card-lift group flex flex-col gap-4 p-6 hover:border-accent-300
                   focus-ring">
            <IconChip Name="@icon" Size="2xl" Tone="@CardChip" Class="transition-colors group-hover:bg-accent-100"/>
            @* An <h3> as Feature's is, so the two grids of tiles read the same to a screen
               reader as well as on the page. A div rather than a span around them: a span may
               only hold phrasing content, and a heading is not that. *@
            <div>
                <h3 class="card-title">@label</h3>
                <span class="block-note mt-1 block">@count entries</span>
            </div>
        </a>;
}
