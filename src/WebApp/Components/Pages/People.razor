@page "/app/people"
@page "/app/friends"
@page "/app/players"
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<AppPageTitle Title="People"/>

<PageHeader Eyebrow="Your table" Title="People">
    <Sub>@HeaderSummary</Sub>
    <Actions>
        @if (!_loading && _people is not null)
        {
            <a class="btn btn-primary" href="@PeopleLink.ForTab(PeopleLink.Friends)">
                <Icon Name="plus" Class="w-4 h-4"/> Add a friend
            </a>
        }
    </Actions>
</PageHeader>

<FormMessages Feedback="_form"/>

@if (_loading)
{
    <LoadingSpinner/>
}
else if (_people is null)
{
    <NotFound>Couldn't load your people right now.</NotFound>
}
else
{
    @* Same pill row the games list and statistics slice with — and, like the statistics tabs,
       real links, so which list you were reading survives following somebody out of it. *@
    <TabNav Tabs="PeopleLink.Tabs" Current="@_tab" Label="People lists"
            Href="PeopleLink.ForTab" Count="TabPillCount">
        <Trailing>
            @if (PendingForMe > 0 && _tab != PeopleLink.Requests)
            {
                <a class="badge badge-info focus-ring ml-1" href="@PeopleLink.ForTab(PeopleLink.Requests)">
                    <Icon Name="alert" Class="w-3 h-3"/> @PendingForMe waiting on you
                </a>
            }
        </Trailing>
    </TabNav>

    @switch (_tab)
    {
        case PeopleLink.Friends:
            @FriendsTab();
            break;
        case PeopleLink.Players:
            @PlayersTab();
            break;
        case PeopleLink.Requests:
            @RequestsTab();
            break;
    }
}

@* Message and verb are set per action — every prompt here is about a different person. *@
<ConfirmDialog @ref="_confirmDialog" Title="Are you sure?"/>
<LinkPlayerModal @ref="_linkModal" Friends="_people?.Friends ?? []" OnSent="OnMergeChanged"/>
<MergeRequestModal @ref="_mergeModal" OnResolved="OnMergeChanged"/>

@* ============================== FRIENDS ============================== *@
@code {
    private RenderFragment FriendsTab() =>
        @<div class="space-y-6">
            <section class="surface">
                <SectionHead Surface="true" Title="Invite by email">
                    <Sub>They need an account here. Once you're connected you can seat each other in games.</Sub>
                </SectionHead>
                <div class="surface-body">
                    <SubmitField @bind-Value="_friendEmail" InputType="email" Class="max-w-xl"
                                 Placeholder="friend@@example.com" ErrorFor="AddresseeEmail" Errors="@_form.Errors"
                                 Icon="send" SubmitLabel="Send request" OnSubmit="SendFriendRequest"/>
                </div>
            </section>

            @if (_people!.Friends.Count == 0)
            {
                <EmptyState Icon="users" Title="No friends yet"
                            Body="Invite someone above and their games with you start counting on both sides."/>
            }
            else
            {
                <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var f in _people.Friends)
                    {
                        <PersonCard @key="f.UserId" Kind="AssigneeKind.Friend"
                                    Name="@f.Name" DetailLabel="@f.Email"
                                    Record="f"
                                    FavouriteSpiritId="@f.FavouriteSpiritId"
                                    GamesHref="@(f.GamesTogether > 0 ? GamesLink.ForPlayer(f.UserId, null) : null)"
                                    EmptyNote="No games together yet — seat them in your next one.">
                            <Details>@RecordLines(f)</Details>
                            <Actions>
                                @* Only once there is something to show: the statistics page
                                   silently ignores a scope it has no games for, so a link
                                   offered here would land on the unscoped page instead. *@
                                @if (f.GamesTogether > 0)
                                {
                                    <a class="btn btn-sm btn-soft" href="@StatsHref(f)">
                                        <Icon Name="chart" Class="w-3.5 h-3.5"/> Shared stats
                                    </a>
                                }
                                <button type="button" class="btn btn-sm btn-danger-outline ml-auto" @onclick="() => RemoveFriend(f)"
                                        title="@($"Remove {f.Name}")" aria-label="@($"Remove {f.Name}")">
                                    <Icon Name="unlink" Class="w-3.5 h-3.5"/> Remove
                                </button>
                            </Actions>
                        </PersonCard>
                    }
                </div>
            }
        </div>;
}

@* ============================== LOCAL PLAYERS ============================== *@
@code {
    private RenderFragment PlayersTab() =>
        @<div class="space-y-6">
            <section class="surface">
                <SectionHead Surface="true" Title="Add a local player">
                    <Sub>Someone at your table without an account. If they sign up later, link the two and they keep the games.</Sub>
                </SectionHead>
                <div class="surface-body">
                    <SubmitField @bind-Value="_newPlayerName" Class="max-w-md"
                                 Placeholder="Player name…" ErrorFor="Name" Errors="@_form.Errors"
                                 Icon="plus" SubmitLabel="Add" OnSubmit="AddPlayer"/>
                </div>
            </section>

            @if (_people!.LocalPlayers.Count == 0)
            {
                <EmptyState Icon="user" Title="No local players yet"
                            Body="Add the people you play with in person so their spirits and results are recorded too."/>
            }
            else
            {
                <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var p in _people.LocalPlayers)
                    {
                        <PersonCard @key="p.PlayerId" Kind="AssigneeKind.Player"
                                    Name="@p.Name" DetailLabel="Local player · no account"
                                    Record="p"
                                    FavouriteSpiritId="@p.FavouriteSpiritId"
                                    GamesHref="@(p.GamesTogether > 0 ? GamesLink.ForPlayer(null, p.PlayerId) : null)"
                                    EmptyNote="Not in any game yet.">
                            <Details>@RecordLines(p)</Details>
                            <Actions>
                                @if (_editingId == p.PlayerId)
                                {
                                    <div class="flex w-full items-start gap-2">
                                        <div class="flex-1">
                                            <input type="text" class="input" @bind="_editName" aria-label="Player name"/>
                                            <FieldError For="Name" Errors="@_form.Errors"/>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveRename" aria-label="Save name" title="Save name">
                                            <Icon Name="check" Class="w-3.5 h-3.5"/>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _editingId = null" aria-label="Cancel" title="Cancel">
                                            <Icon Name="x" Class="w-3.5 h-3.5"/>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    @* See the note on the friend card: no scope, no page. *@
                                    @if (p.GamesTogether > 0)
                                    {
                                        <a class="btn btn-sm btn-soft" href="@StatsHref(p)">
                                            <Icon Name="chart" Class="w-3.5 h-3.5"/> Stats
                                        </a>
                                    }

                                    @* A merge in flight speaks for the "is this someone with an
                                       account?" question, so it stands where Link would. A declined
                                       one is only an answer to clear away — it must not go on
                                       holding the card's own actions hostage. *@
                                    @if (p.PendingMergeRequestId is { } requestId && !p.MergeDeclined)
                                    {
                                        <span class="badge badge-info" title="@($"Waiting for {p.PendingMergeTargetName}")">
                                            <Icon Name="hourglass" Class="w-3 h-3"/> Link pending
                                        </span>
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _mergeModal.ShowAsync(requestId)">
                                            Review
                                        </button>
                                    }
                                    else if (p.PendingMergeRequestId is { } declinedId)
                                    {
                                        <span class="badge badge-warn" title="@($"{p.PendingMergeTargetName} said this isn't them")">
                                            <Icon Name="x" Class="w-3 h-3"/> Link declined
                                        </span>
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => DismissDeclinedMerge(declinedId)"
                                                title="Clear this and you can ask someone else">
                                            Dismiss
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _linkModal.Show(p)"
                                                title="This guest now has an account">
                                            <Icon Name="users" Class="w-3.5 h-3.5"/> Link
                                        </button>
                                    }

                                    <div class="ml-auto flex gap-1">
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => StartRename(p)"
                                                aria-label="@($"Rename {p.Name}")" title="Rename">
                                            <Icon Name="edit" Class="w-3.5 h-3.5"/>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger-outline" @onclick="() => DeletePlayer(p)"
                                                aria-label="@($"Delete {p.Name}")" title="Delete">
                                            <Icon Name="trash" Class="w-3.5 h-3.5"/>
                                        </button>
                                    </div>
                                }
                            </Actions>
                        </PersonCard>
                    }
                </div>
            }
        </div>;
}

@* ============================== REQUESTS ============================== *@
@code {
    private RenderFragment RequestsTab() =>
        @<div class="space-y-6">
            @if (PendingForMe == 0 && _people!.OutgoingFriendRequests.Count == 0 && _people.OutgoingMergeRequests.Count == 0)
            {
                <EmptyState Icon="check" Title="Nothing waiting"
                            Body="No friend or merge requests need your attention."/>
            }

            @if (_people!.IncomingMergeRequests.Count > 0)
            {
                <section>
                    <SectionHead Title="Someone says a guest of theirs is you"
                                 Note="Confirming hands you those seats"/>
                    <div class="space-y-2">
                        @foreach (var m in _people.IncomingMergeRequests)
                        {
                            <RequestRow @key="m.Id" Kind="AssigneeKind.Player" Name="@m.PlayerName"
                                        Detail="@($"{m.OtherUserName}'s guest · {Copy.Count(m.GameCount, "game")}")">
                                <button type="button" class="btn btn-sm btn-primary shrink-0" @onclick="() => _mergeModal.ShowAsync(m.Id)">
                                    <Icon Name="arrow-right" Class="w-3.5 h-3.5"/> Review
                                </button>
                            </RequestRow>
                        }
                    </div>
                </section>
            }

            @if (_people.IncomingFriendRequests.Count > 0)
            {
                <section>
                    <SectionHead Title="Friend requests"
                                 Note="@($"{_people.IncomingFriendRequests.Count} waiting")"/>
                    <div class="space-y-2">
                        @foreach (var r in _people.IncomingFriendRequests)
                        {
                            <RequestRow @key="r.FriendshipId" Kind="AssigneeKind.Friend" Name="@r.Name"
                                        Detail="@($"{r.Email} · {GameFormat.DayOnly(r.SentAt.DateTime)}")">
                                <div class="flex shrink-0 gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => AcceptRequest(r.FriendshipId)">
                                        <Icon Name="check" Class="w-3.5 h-3.5"/> Accept
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger-outline" @onclick="() => RejectRequest(r.FriendshipId)">
                                        <Icon Name="x" Class="w-3.5 h-3.5"/> Decline
                                    </button>
                                </div>
                            </RequestRow>
                        }
                    </div>
                </section>
            }

            @if (_people.OutgoingFriendRequests.Count > 0 || _people.OutgoingMergeRequests.Count > 0)
            {
                <section>
                    <SectionHead Title="Sent by you" Note="@SentByYouNote"/>
                    <div class="space-y-2">
                        @foreach (var r in _people.OutgoingFriendRequests)
                        {
                            <RequestRow @key="r.FriendshipId" Kind="AssigneeKind.Friend" Name="@r.Name" Detail="@r.Email">
                                <span class="badge badge-neutral shrink-0">
                                    <Icon Name="hourglass" Class="w-3 h-3"/> Friend request pending
                                </span>
                                @* Taking back an unanswered request is the same command that ends a
                                   friendship — there is nothing shared to unpick until it's accepted. *@
                                <button type="button" class="btn btn-sm btn-secondary shrink-0" @onclick="() => CancelFriendRequest(r)">
                                    Cancel
                                </button>
                            </RequestRow>
                        }
                        @foreach (var m in _people.OutgoingMergeRequests)
                        {
                            var declined = m.Status == PlayerMergeStatus.Rejected;
                            <RequestRow @key="m.Id" Kind="AssigneeKind.Player" Name="@m.PlayerName"
                                        Detail="@($"link to {m.OtherUserName} · {Copy.Count(m.GameCount, "game")}")">
                                <span class="badge @(declined ? "badge-warn" : "badge-neutral") shrink-0">
                                    @if (declined)
                                    {
                                        <Icon Name="x" Class="w-3 h-3"/>
                                        <span>Declined</span>
                                    }
                                    else
                                    {
                                        <Icon Name="hourglass" Class="w-3 h-3"/>
                                        <span>Merge pending</span>
                                    }
                                </span>
                                <button type="button" class="btn btn-sm btn-secondary shrink-0" @onclick="() => _mergeModal.ShowAsync(m.Id)">
                                    Review
                                </button>
                            </RequestRow>
                        }
                    </div>
                </section>
            }
        </div>;

    /// <summary>The two lines every person card carries under their favourite spirit — IconNote,
    /// the register for a quiet line led by a glyph, as the statistics page's card writes its own.</summary>
    private static RenderFragment RecordLines(PersonSummary p) =>
        @<text>
            @if (p.BestScore is { } best)
            {
                <IconNote Icon="star">Best score together <span class="font-medium text-ink-800 tabular-nums">@best</span></IconNote>
            }
            @if (p.LastPlayedAt is { } last)
            {
                <IconNote Icon="calendar">Last played @GameFormat.Date(last.DateTime)</IconNote>
            }
        </text>;

}

@code {
    /// <summary>Which list is open. Written back on every tab click — see PeopleLink.</summary>
    [SupplyParameterFromQuery(Name = PeopleLink.TabKey)]
    public string? TabParam { get; set; }

    private PeopleResponse? _people;
    private bool _loading = true;
    private string _tab = PeopleLink.Friends;

    private string _friendEmail = "";
    private string _newPlayerName = "";
    private Guid? _editingId;
    private string _editName = "";

    private readonly FormFeedback _form = new();
    private ConfirmDialog _confirmDialog = default!;
    private LinkPlayerModal _linkModal = default!;
    private MergeRequestModal _mergeModal = default!;

    /// <summary>How many are in a list, or null for an empty one: a list with nothing in it says
    /// so by being empty, and a "0" beside its name is one more number to read past.</summary>
    private int? TabPillCount(string key)
    {
        var count = key switch
        {
            PeopleLink.Friends  => _people?.Friends.Count ?? 0,
            PeopleLink.Players  => _people?.LocalPlayers.Count ?? 0,
            PeopleLink.Requests => (_people?.IncomingFriendRequests.Count ?? 0) + (_people?.IncomingMergeRequests.Count ?? 0)
                                   + (_people?.OutgoingFriendRequests.Count ?? 0) + (_people?.OutgoingMergeRequests.Count ?? 0),
            _                   => 0,
        };
        return count > 0 ? count : null;
    }

    /// <summary>
    /// What the "Sent by you" list actually holds: everything there is waiting on the other
    /// side until one comes back declined, and then the note would be saying the opposite.
    /// </summary>
    private string SentByYouNote =>
        _people?.OutgoingMergeRequests.Any(m => m.Status == PlayerMergeStatus.Rejected) == true
            ? "Some have been answered"
            : "Waiting on the other side";

    /// <summary>Requests only the user can clear — the ones a badge should nag about.</summary>
    private int PendingForMe =>
        (_people?.IncomingFriendRequests.Count ?? 0) + (_people?.IncomingMergeRequests.Count ?? 0);

    private string HeaderSummary
    {
        get
        {
            if (_people is null) return "Friends, guests, and who owes whom a rematch.";
            var friends = _people.Friends.Count;
            var locals = _people.LocalPlayers.Count;
            if (friends == 0 && locals == 0) return "Nobody here yet — add the people you play with.";
            return $"{Copy.Count(friends, "friend")} · {locals} local {Copy.Noun(locals, "player")}";
        }
    }

    /// <summary>
    /// The URL says which list is open — read straight through on every change, because the tabs
    /// write it back and so a re-read is what the last click asked for. That is also what makes
    /// the browser's Back undo a tab rather than leave the page.
    /// </summary>
    protected override void OnParametersSet()
    {
        // The old Friends and Players routes still resolve here, so a bookmark lands where it
        // used to; an explicit ?tab= wins over both.
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        var fromRoute = path switch
        {
            PeopleLink.LegacyPlayersPath => PeopleLink.Players,
            PeopleLink.LegacyFriendsPath => PeopleLink.Friends,
            _                            => null,
        };

        var wanted = PeopleLink.IsTab(TabParam) ? TabParam! : fromRoute ?? PeopleLink.Friends;
        if (wanted == _tab) return;
        _tab = wanted;

        // Switching lists leaves the last action's feedback and any half-finished rename behind —
        // both belong to the list just navigated away from.
        _editingId = null;
        _form.Clear();
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        if (CurrentUser.UserId is not { } userId)
        {
            _loading = false;
            return;
        }

        var result = await Mediator.Send(new GetPeopleQuery(userId));
        if (result.IsSuccess) _people = result.Value;
        _loading = false;
    }

    /// <summary>The statistics page scoped to this person — the same scope its own picker sets.</summary>
    private static string StatsHref(PersonSummary p) => StatsLink.ForPlayer(p.UserId, p.PlayerId);

    private async Task OnMergeChanged()
    {
        _form.Clear();
        await LoadData();
    }

    /// <summary>
    /// Every act on this page is the same three steps — send the command, report how it went
    /// through the form's voice, reload the lists — and eight handlers had them written out.
    /// Returns whether it worked, for the two acts that only clear their field on success. The
    /// reload happens either way: a failed act may still have changed what the server holds
    /// (a request that was answered from the other side in the meantime, say), and the lists
    /// should say so.
    /// </summary>
    private async Task<bool> Run(ICommand command, string success, FormMessageKind kind = FormMessageKind.Success)
    {
        var result = await Mediator.Send(command);
        var ok = _form.Apply(result, success, kind);
        await LoadData();
        return ok;
    }

    // ---------- friends ----------

    private async Task SendFriendRequest()
    {
        var email = _friendEmail;
        if (await Run(new SendFriendRequestCommand(CurrentUser.RequireUserId(), email),
                $"Friend request sent to {email}."))
        {
            _friendEmail = "";
        }
    }

    private Task AcceptRequest(Guid friendshipId) =>
        Run(new AcceptFriendRequestCommand(friendshipId, CurrentUser.RequireUserId()),
            "Friend request accepted.");

    private Task RejectRequest(Guid friendshipId) =>
        Run(new RejectFriendRequestCommand(friendshipId, CurrentUser.RequireUserId()),
            "Friend request declined.", FormMessageKind.Info);

    /// Taking back an unanswered request is the same command that ends a friendship — there is
    /// nothing shared to unpick until it's accepted.
    private Task CancelFriendRequest(PendingFriendRequest request) =>
        Run(new RemoveFriendCommand(request.FriendshipId, CurrentUser.RequireUserId()),
            $"Request to {request.Name} cancelled.", FormMessageKind.Info);

    private async Task RemoveFriend(PersonSummary friend)
    {
        if (friend.FriendshipId is not { } friendshipId) return;

        var shared = friend.GamesTogether;
        var message = shared == 0
            ? $"Remove {friend.Name}? You can send a new request later."
            : $"Remove {friend.Name}? Your {shared} shared {Copy.Noun(shared, "game")} stay with you, " +
              $"with {friend.Name} kept as a local player — and they get their own copy to do as they like with.";

        if (!await _confirmDialog.ShowAsync(message, "Remove")) return;

        await Run(new RemoveFriendCommand(friendshipId, CurrentUser.RequireUserId()),
            $"{friend.Name} removed.", FormMessageKind.Info);
    }

    // ---------- local players ----------

    private async Task AddPlayer()
    {
        if (await Run(new CreatePlayerCommand(_newPlayerName, CurrentUser.RequireUserId()), "Player added."))
        {
            _newPlayerName = "";
        }
    }

    private void StartRename(PersonSummary p)
    {
        _editingId = p.PlayerId;
        _editName = p.Name;
        _form.Clear();
    }

    private async Task SaveRename()
    {
        if (_editingId is not { } id) return;

        if (await Run(new UpdatePlayerCommand(id, _editName, CurrentUser.RequireUserId()), "Player renamed."))
        {
            _editingId = null;
        }
    }

    private async Task DeletePlayer(PersonSummary p)
    {
        if (p.PlayerId is not { } id) return;

        var message = p.GamesTogether == 0
            ? $"Delete {p.Name}?"
            : $"Delete {p.Name}? They sit in {Copy.Count(p.GamesTogether, "recorded game")}, " +
              "where that seat will no longer name anyone.";

        if (!await _confirmDialog.ShowAsync(message, "Delete")) return;

        await Run(new DeletePlayerCommand(id, CurrentUser.RequireUserId()),
            $"{p.Name} deleted.", FormMessageKind.Info);
    }

    /// <summary>Clears a request that came back declined, freeing the guest to be linked again.</summary>
    private Task DismissDeclinedMerge(Guid requestId) =>
        Run(new WithdrawMergeRequestCommand(requestId, CurrentUser.RequireUserId()),
            "Link request cleared.", FormMessageKind.Info);
}
