@page "/app/games/{Id:guid}"
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<AppPageTitle Title="@(_game is null ? "Game" : GameLookups.MatchTitle(_game.Adversaries, _game.ScenarioId))"/>

@if (_loading)
{
    <LoadingSpinner/>
}
else if (_game is null)
{
    <NotFound>Game not found.</NotFound>
}
else
{
    var title = GameLookups.MatchTitle(_game.Adversaries, _game.ScenarioId);

    @* Back to the list as it was left, filters and all, when the game was opened from a slice of
       it — otherwise to the whole history. Same one link either way.

       TitleClass is italic alone, not the full .MatchTitleTone the lists wear: .page-title
       already carries the heading's size and weight. Same question either way. *@
    <PageHeader Eyebrow="@(_game.IsCompleted ? "Recorded match" : "Draft in progress")"
                Title="@title"
                TitleClass="@(GameLookups.IsStandardGame(title) ? "italic" : null)"
                BackHref="@GamesLink.Back(Back)"
                BackLabel="@(HasSlice ? "Filtered games" : "Games")"
                BackTitle="@(HasSlice ? "Back to the filtered list you came from" : "All your games")">
        <TitleSuffix>
            <GameStatusBadge IsCompleted="_game.IsCompleted" Win="_game.Result?.Win"/>
        </TitleSuffix>
        @* StartedAt is read back as stored, not converted: it carries the wall clock the player
           wrote down at offset zero, and converting it to server-local time would shift a
           late-evening game onto the wrong day. *@
        <Sub>
            @GameFormat.Timestamp(_game.StartedAt.DateTime)
            · @Copy.Count(_game.Players.Count, "player")
            · difficulty @_game.Difficulty
        </Sub>
        <Actions>
            @if (IsOwner && !_game.IsCompleted && !_showCompleteForm)
            {
                <button type="button" class="btn btn-primary" @onclick="StartComplete">
                    <Icon Name="check-circle" Class="w-4 h-4"/> Complete game
                </button>
            }
            @* Deleting is the recorder's call alone — everyone else here is a guest in
               somebody else's record of the evening. *@
            @if (IsOwner)
            {
                <button type="button" class="btn btn-danger-outline" @onclick="DeleteGame">
                    <Icon Name="trash" Class="w-4 h-4"/> Delete
                </button>
            }
            else
            {
                <span class="badge badge-neutral" title="@($"{OwnerName} recorded this game and is the only one who can delete it")">
                    <Icon Name="lock" Class="w-3 h-3"/> Recorded by @OwnerName
                </span>
            }
        </Actions>
    </PageHeader>

    <FormMessages Feedback="_form"/>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-6">
        <div class="space-y-8 lg:min-w-0">
            @* ============================== OUTCOME ============================== *@
            @* First, not last: on a finished game the result is what the page was opened for,
               and on a draft it is the one thing still to do. *@
            <section>
                @if (_showCompleteForm)
                {
                    <div class="panel-invite p-5 md:p-6">
                        <InviteHeader Class="mb-5" Title="Record the result"
                                      Sub="Save the outcome to turn this draft into a completed match."/>
                        @* OnChanged is what pulls the action bar's live score along with the
                           panel — the draft is this page's own object, so an edit inside the
                           editor is not a parameter change the page would otherwise hear about. *@
                        <GameResultEditor Result="_result"
                                          Difficulty="_game.Difficulty"
                                          PlayerCount="_game.Players.Count"
                                          Errors="_form.Errors"
                                          OnChanged="StateHasChanged"/>
                        <NoteField Class="mt-5" @bind-Value="_resultNote" Errors="@_form.Errors"
                                   Placeholder="Optional — anything memorable from the match"/>
                    </div>
                }
                else if (_game.Result is not null)
                {
                    <GameResultSummary Result="_game.Result"/>
                }
                else if (IsOwner)
                {
                    @* The same amber invitation the setup screen's "Did you finish this game?"
                       panel uses, so finishing a draft looks like the step it is. *@
                    <div class="panel-invite flex flex-wrap items-center justify-between gap-3 px-5 py-4 md:px-6">
                        <InviteHeader Title="This match is still a draft"
                                      Sub="Record the outcome and the score is computed for you."/>
                        <button type="button" class="btn btn-primary" @onclick="StartComplete">
                            <Icon Name="check-circle" Class="w-4 h-4"/> Complete game
                        </button>
                    </div>
                }
                else
                {
                    @* Someone else's draft. The outcome is theirs to record — offering it here
                       would be an invitation the server refuses. *@
                    <div class="panel-quiet flex flex-wrap items-center gap-3 px-5 py-4 md:px-6">
                        <InviteHeader Lit="false" Icon="hourglass" Title="No outcome recorded yet"
                                      Sub="@($"{OwnerName} recorded this match and is the only one who can finish it. It'll show up in your statistics once they do.")"/>
                    </div>
                }
            </section>

            @* ============================== SETUP ============================== *@
            <section>
                <SectionHead Size="lg" Title="Setup"/>
                @* A recorded game links sideways: its foe, its scenario, and each seat's spirit,
                   board and player all reach the rest of the history that shares them. *@
                <GameSetupSummary
                    LinkGames="true"
                    IslandSetupId="@_game.IslandSetupId"
                    CustomLayoutName="@_game.CustomLayoutName"
                    IslandLayoutJson="@_game.IslandLayoutJson"
                    ExtraBoard="_game.ExtraBoard"
                    ExtraBoardId="@_game.ExtraBoardId"
                    ThematicMaps="_game.ThematicMaps"
                    Difficulty="_game.Difficulty"
                    DifficultyModifier="_game.DifficultyModifier"
                    ScenarioId="@_game.ScenarioId"
                    Adversaries="_game.Adversaries"/>
            </section>

            @* ============================== PLAYERS ============================== *@
            <section>
                @* The count sits at the right-hand end of the band, where every other counted
                   section in the app puts it. *@
                <SectionHead Size="lg" Title="Players"
                             Note="@Copy.Count(_game.Players.Count, "player")"/>
                <div class="grid gap-3">
                    @for (var i = 0; i < _game.Players.Count; i++)
                    {
                        <GamePlayerCard
                            @key="_game.Players[i]"
                            Player="_game.Players[i]"
                            Index="i"
                            LinkGames="true"
                            CurrentUserId="CurrentUser.UserId"
                            Friends="_friends"
                            LocalPlayers="_localPlayers"/>
                    }
                </div>
            </section>

            @* ============================== NOTE ============================== *@
            @if (!_showCompleteForm && !string.IsNullOrWhiteSpace(_game.Note))
            {
                <section>
                    <SectionHead Size="lg" Title="Notes"/>
                    <div class="surface body-copy whitespace-pre-wrap px-5 py-4 md:px-6">@_game.Note</div>
                </section>
            }

            @* ============================== ACTION BAR (complete flow) ============================== *@
            @if (_showCompleteForm)
            {
                <ActionBar>
                    <Stats>
                        <ActionBarStat Label="Difficulty" Value="_game.Difficulty"/>
                        <ActionBarStat Label="Score" Value="ProvisionalScore" Loss="!_result.Win"/>
                    </Stats>
                    <Hint>
                        Saving will convert this draft into a <strong class="text-ink-800">completed game</strong>.
                    </Hint>
                    <Actions>
                        <button type="button" class="btn btn-primary" @onclick="CompleteGame" disabled="@_saving">
                            <ActionGlyph Icon="check-circle" Busy="_saving"/> Save result
                        </button>
                        <button type="button" class="btn btn-ghost" @onclick="CancelComplete">Cancel</button>
                    </Actions>
                </ActionBar>
            }
        </div>

        @* ============================== STICKY SUMMARY (lg+) ============================== *@
        <aside class="hidden lg:sticky lg:top-6 lg:block lg:self-start">
            <div class="surface overflow-hidden">
                @* Won, lost or not yet decided — WinTone.DeepPanel, the same three-way decision
                   every other outcome tone in the app comes through. *@
                <div class="@WinTone.DeepPanel(_game.Result?.Win) px-5 py-4">
                    <div class="micro-label-strong text-inherit opacity-80">
                        @(_game.Result is null ? "Difficulty" : "Score")
                    </div>
                    <div class="numeral-display mt-1 text-3xl">
                        @(_game.Result?.Score ?? _game.Difficulty)
                    </div>
                    <div class="mt-1.5 text-[11px] opacity-80">
                        @if (_game.Result is null)
                        {
                            <span>Draft · outcome not recorded</span>
                        }
                        else
                        {
                            <span>Difficulty @_game.Difficulty · @(_game.Result.Win ? "Victory" : "Defeat")</span>
                        }
                    </div>
                </div>

                @* Players quick list *@
                <div class="px-5 py-4">
                    <div class="micro-label mb-2">
                        Players · @_game.Players.Count
                    </div>
                    <ul class="space-y-2">
                        @foreach (var p in _game.Players)
                        {
                            var spirit = GameLookups.SpiritFor(p.SpiritId);
                            var color = GameLookups.SpiritColor(spirit);
                            var board = GameLookups.BoardFor(p.BoardId);
                            var boardDetail = GameLookups.DetailFor(board);
                            var aspect = GameLookups.AspectFor(p.AspectId);

                            <li @key="p" class="flex items-start gap-2 text-xs">
                                <ColorBar Size="sm" Color="@color" Class="mt-0.5"/>
                                <div class="min-w-0 flex-1">
                                    @* The seat's spirit over its board is the .row-title / .row-sub pair, at the
                                       sidebar's own smaller size. *@
                                    <div class="row-title truncate text-xs">
                                        @(spirit?.Name ?? "Unknown spirit")
                                        @if (aspect is not null)
                                        {
                                            <span class="font-normal text-ink-500"> · @aspect.Name</span>
                                        }
                                    </div>
                                    <div class="row-sub truncate">
                                        @if (board is not null)
                                        {
                                            <span>Board @GameLookups.BoardLetter(board)</span>
                                            @if (boardDetail is not null)
                                            {
                                                <span> · @boardDetail.ThematicName</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>

                @SidebarFact("Date played", GameFormat.Timestamp(_game.StartedAt.DateTime))
                @if (_game.Result is not null)
                {
                    @SidebarFact("Duration", GameFormat.Duration(_game.Result.Duration))
                }
            </div>
        </aside>
    </div>

    <ConfirmDialog @ref="_confirmDialog" Title="Delete game"/>
}

@code {
    /// <summary>One labelled line in the sticky summary panel — a band with a caption over it.</summary>
    private static RenderFragment SidebarFact(string label, string value) =>
        @<div class="border-t border-ink-100 px-5 py-4">
            <div class="micro-label mb-1">@label</div>
            <div class="text-xs text-ink-700">@value</div>
        </div>;

    [Parameter] public Guid Id { get; set; }

    /// <summary>
    /// Opened from a draft's "Finish" shortcut in the games list — lands straight in the
    /// result form instead of asking for a second click on the same intent.
    /// </summary>
    [SupplyParameterFromQuery(Name = GamesLink.FinishKey)]
    public bool Finish { get; set; }

    /// <summary>
    /// The games-list query this game was opened from, so the back link returns to that slice
    /// rather than to the whole history. Absent when the list wasn't narrowed — see GamesLink.
    /// </summary>
    [SupplyParameterFromQuery(Name = GamesLink.BackKey)]
    public string? Back { get; set; }

    private bool HasSlice => !string.IsNullOrWhiteSpace(Back);

    private GetGameResponse? _game;
    private List<FriendResponse> _friends = [];
    private List<ListPlayersResponse> _localPlayers = [];

    private bool _loading = true;
    private bool _saving;
    private bool _showCompleteForm;
    /// Field errors, the general alert and the failed-attempt count in one place — see FormFeedback.
    private readonly FormFeedback _form = new();

    /// The outcome being entered, while the "complete game" form is open.
    private readonly GameResultDraft _result = new();
    private string? _resultNote;

    private ConfirmDialog _confirmDialog = default!;

    /// <summary>Whether the signed-in user is the one who recorded this game.</summary>
    private bool IsOwner => _game is not null && _game.OwnerId == CurrentUser.UserId;

    /// <summary>Who recorded it, for the badge shown to everyone else at the table.</summary>
    private string OwnerName =>
        _friends.FirstOrDefault(f => f.FriendUserId == _game?.OwnerId)?.Name ?? "another player";

    private int ProvisionalScore =>
        _result.Score(_game?.Difficulty ?? 0, _game?.Players.Count ?? 1);

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is { } uid)
        {
            var gameResult = await Mediator.Send(new GetGameQuery(Id, uid));
            if (gameResult.IsSuccess) _game = gameResult.Value;

            var friendsResult = await Mediator.Send(new ListFriendsQuery(uid));
            if (friendsResult.IsSuccess) _friends = friendsResult.Value;

            var playersResult = await Mediator.Send(new ListPlayersQuery(uid));
            if (playersResult.IsSuccess) _localPlayers = playersResult.Value;
        }

        // The "Finish" shortcut is only offered on your own drafts, but the URL it lands on
        // can be typed — so the form opens on the same terms the button appears.
        if (Finish && _game is { IsCompleted: false } && IsOwner) _showCompleteForm = true;

        _loading = false;
    }

    private void StartComplete()
    {
        if (!IsOwner) return;
        _showCompleteForm = true;
        _form.Clear();
    }

    private void CancelComplete()
    {
        _showCompleteForm = false;
        _form.Clear();
    }

    private async Task CompleteGame()
    {
        _saving = true;
        var result = await Mediator.Send(
            new CompleteGameCommand(Id, CurrentUser.RequireUserId(), _result.ToDto(), _resultNote));
        _saving = false;

        if (!_form.Apply(result, "Game completed successfully!")) return;

        _showCompleteForm = false;
        var reload = await Mediator.Send(new GetGameQuery(Id, CurrentUser.RequireUserId()));
        if (reload.IsSuccess) _game = reload.Value;
    }

    private async Task DeleteGame()
    {
        if (!await _confirmDialog.ShowAsync(
                "Are you sure you want to delete this game? This cannot be undone.")) return;

        var result = await Mediator.Send(new DeleteGameCommand(Id, CurrentUser.RequireUserId()));
        if (_form.Apply(result)) Nav.NavigateTo(GamesLink.Back(Back));
    }
}
