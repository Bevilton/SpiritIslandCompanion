@page "/app/settings"
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject CurrentUserState UserState

<AppPageTitle Title="Settings"/>

<PageHeader Eyebrow="Account" Title="Settings">
    <Sub>Configure your collection and preferences.</Sub>
</PageHeader>

<FormMessages Feedback="_form"/>

@if (_loading)
{
    <LoadingSpinner/>
}
else
{
    <section class="surface max-w-2xl mb-5">
        <SectionHead Surface="true" Title="Your name"/>
        <div class="surface-body">
            <p class="body-note mb-5">
                What friends see on shared games and in their statistics. Until you pick one,
                your email address is used instead.
            </p>
            @* The same field-and-button the People page adds a friend or a guest with. Held closed
               while the name is blank or is the one already saved. *@
            <SubmitField @bind-Value="_nickname" Placeholder="@_email" AriaLabel="Display name"
                         MaxLength="Nickname.MaxLength" ErrorFor="Nickname" Errors="@_form.Errors"
                         Icon="check" SubmitLabel="Save name"
                         CanSubmit="@(_nickname.Trim() != _savedNickname)" OnSubmit="SaveNickname"/>
            <p class="block-note mt-2">
                Signed in as <span class="font-medium text-ink-700">@_email</span>. Friend requests are sent to this address.
            </p>
        </div>
    </section>

    <section class="surface max-w-2xl">
        <SectionHead Surface="true" Title="Owned expansions"/>
        <div class="surface-body">
            <p class="body-note mb-5">
                Pick the expansions you own — content throughout the app filters to match. The base game is always included.
            </p>
            <div class="space-y-2">
                @foreach (var expansion in GameData.Expansions)
                {
                    var isBase = expansion.Id == Expansions.BaseGame;
                    var isOwned = isBase || _ownedExpansions.Contains(expansion.Id.Value);
                    var counts = ExpansionTotals[expansion.Id.Value];
                    @* .option-row, the same on/off row the setup form's fine-tune switches are —
                       with a checkbox where those have a switch. The base game's row cannot be
                       switched, so it answers neither the pointer nor the hover. *@
                    <label for="@($"exp-{expansion.Id.Value}")"
                           class="option-row @(isOwned ? "is-on" : null) @(isBase ? null : "cursor-pointer hover:border-ink-300")">
                        <div class="flex items-center gap-3">
                            <input class="checkbox" type="checkbox"
                                   id="@($"exp-{expansion.Id.Value}")"
                                   checked="@isOwned"
                                   disabled="@isBase"
                                   @onchange="e => ToggleExpansion(expansion.Id.Value, (bool)(e.Value ?? false))"/>
                            @* The same name-over-caption pair every other option row in the app
                               is set in (.row-title / .row-sub) — this one had been written by
                               hand a size larger and a weight lighter than the fine-tune rows it
                               is a sibling of. *@
                            <div>
                                <div class="row-title flex items-center gap-2">
                                    @expansion.Name
                                    @if (isBase)
                                    {
                                        <span class="badge badge-neutral">Required</span>
                                    }
                                </div>
                                <div class="row-sub mt-0.5">
                                    @Copy.Count(counts.Spirits, "spirit") ·
                                    @Copy.Count(counts.Adversaries, "adversary") ·
                                    @Copy.Count(counts.Scenarios, "scenario")
                                </div>
                            </div>
                        </div>
                    </label>
                }
            </div>
        </div>
        <div class="surface-foot">
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_saving">
                <ActionGlyph Icon="check" Busy="_saving"/> Save
            </button>
        </div>
    </section>
}

@code {
    private HashSet<string> _ownedExpansions = [];
    private string _nickname = "";
    private string _savedNickname = "";
    private string _email = "";
    private bool _loading = true;
    private bool _saving;
    /// Field errors, the general alert and the failed-attempt count in one place — see FormFeedback.
    private readonly FormFeedback _form = new();

    private record ExpansionCounts(int Spirits, int Adversaries, int Scenarios);

    private static readonly Dictionary<string, ExpansionCounts> ExpansionTotals =
        GameData.Expansions.ToDictionary(
            e => e.Id.Value,
            e => new ExpansionCounts(
                GameData.Spirits.Count(s => s.ExpansionId == e.Id),
                GameData.Adversaries.Count(a => a.ExpansionId == e.Id),
                GameData.Scenarios.Count(s => s.ExpansionId == e.Id)));

    protected override async Task OnInitializedAsync()
    {
        // Without a user there is nothing to load — drop the spinner rather than spin forever.
        if (CurrentUser.UserId is not { } userId)
        {
            _loading = false;
            return;
        }
        var result = await Mediator.Send(new GetUserQuery(userId));
        if (result.IsSuccess)
        {
            _ownedExpansions = result.Value.OwnedExpansionIds.ToHashSet();
            _savedNickname = result.Value.Nickname ?? "";
            _nickname = _savedNickname;
            _email = result.Value.Email;
        }
        _loading = false;
    }

    /// The in-flight state is SubmitField's — it holds its button while this runs.
    private async Task SaveNickname()
    {
        var result = await Mediator.Send(new SetNicknameCommand(
            CurrentUser.RequireUserId(), _nickname));

        if (!_form.Apply(result, "Name saved.")) return;

        _savedNickname = _nickname.Trim();
        _nickname = _savedNickname;
        await UserState.ReloadAsync();
    }

    private void ToggleExpansion(string id, bool isChecked)
    {
        if (id == Expansions.BaseGame.Value) return;
        if (isChecked) _ownedExpansions.Add(id);
        else _ownedExpansions.Remove(id);
    }

    private async Task Save()
    {
        _saving = true;
        var result = await Mediator.Send(new SetOwnedExpansionsCommand(
            CurrentUser.RequireUserId(), _ownedExpansions.ToList()));
        _saving = false;

        if (_form.Apply(result, "Settings saved."))
            await UserState.ReloadAsync();
    }
}
