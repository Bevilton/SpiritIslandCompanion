@page "/app/statistics"
@attribute [Authorize]
@using Application.Features.IslandLayouts
@using Application.Features.Statistics
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Statistics</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Insights</span>
        <h1 class="page-title mt-2">Statistics</h1>
        <p class="page-sub">@HeaderSummary</p>
    </div>
    @if (_unfilteredPlayers.Count > 1)
    {
        <div class="relative">
            <button type="button" @onclick="ToggleScopePicker"
                    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-ink-200 bg-white hover:bg-ink-50 transition-colors text-left
                           focus:outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30 min-w-[14rem]">
                @if (_scoped is null)
                {
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent-50 text-accent-700 shrink-0">
                        <Icon Name="users" Class="w-4 h-4"/>
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-medium text-ink-900">All players</div>
                        <div class="text-[10px] uppercase tracking-wide text-ink-500">Global stats</div>
                    </div>
                }
                else
                {
                    <PlayerAssigneeBadge Kind="PlayerAssigneeBadge.For(_scoped.Kind)" Name="@_scoped.Name"
                                         DetailLabel="@($"{_scoped.GamesPlayed} games")"/>
                }
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none"
                     class="w-4 h-4 text-ink-400 shrink-0 ml-auto transition-transform @(_scopeOpen ? "rotate-180" : "")">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m6 8 4 4 4-4"/>
                </svg>
            </button>

            @if (_scopeOpen)
            {
                <button type="button" class="fixed inset-0 z-20 cursor-default" aria-hidden="true" tabindex="-1"
                        @onclick="() => _scopeOpen = false"></button>
                <div class="absolute z-30 mt-1 right-0 w-72 surface shadow-lg p-2 max-h-80 overflow-y-auto">
                    <button type="button" @onclick="() => SetScope(null)" class="@ScopeRowClass(_scoped is null)">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent-50 text-accent-700 shrink-0">
                            <Icon Name="users" Class="w-4 h-4"/>
                        </span>
                        <div class="flex-1 text-left min-w-0">
                            <div class="text-sm font-medium text-ink-900 truncate">All players</div>
                            <div class="text-[10px] text-ink-500">Global stats across every recorded game</div>
                        </div>
                        @if (_scoped is null) { <Icon Name="check" Class="w-4 h-4 text-accent-700"/> }
                    </button>
                    <div class="my-1 border-t border-ink-100"></div>
                    @foreach (var p in _unfilteredPlayers)
                    {
                        var isSelected = SameScope(p, _scoped);
                        <button type="button" @onclick="() => SetScope(p)" class="@ScopeRowClass(isSelected)">
                            <PlayerAssigneeBadge Kind="PlayerAssigneeBadge.For(p.Kind)" Name="@p.Name"
                                                 DetailLabel="@($"{p.GamesPlayed} games · {p.WinRate:F0}% win")"/>
                            @if (isSelected) { <Icon Name="check" Class="w-4 h-4 text-accent-700 ml-auto"/> }
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_loading)
{
    <LoadingSpinner/>
}
else if (_stats is null || _stats.TotalGames == 0)
{
    <div class="surface px-6 py-16 text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-accent-700">
            <Icon Name="chart" Class="w-6 h-6"/>
        </div>
        @if (_scoped is null)
        {
            <h2 class="text-lg font-semibold text-ink-900" style="font-family: var(--font-serif);">No statistics yet</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-ink-500">
                Record your first game and the numbers start telling the story — win rates, matchups, coverage.
            </p>
            <a href="/app/games/new" class="btn btn-primary mt-5">
                <Icon Name="plus" Class="w-4 h-4"/> Record a game
            </a>
        }
        else
        {
            <h2 class="text-lg font-semibold text-ink-900" style="font-family: var(--font-serif);">No games with @_scoped.Name yet</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-ink-500">Nothing has been recorded for this player so far.</p>
            <button class="btn btn-secondary mt-5" @onclick="() => SetScope(null)">Clear filter</button>
        }
    </div>
}
else
{
    @* ============================== SCOPED PLAYER HEADER ============================== *@
    @if (_scoped is not null)
    {
        var favSpirit = _scoped.FavouriteSpirit is null ? null : GameLookups.SpiritFor(_scoped.FavouriteSpirit);
        var favDetail = favSpirit is null ? null : SpiritDetails.For(favSpirit.Id);
        var favColor = favDetail?.ColorHex ?? GameLookups.NeutralColor;
        var isMe = _scoped.Kind == PlayerKind.Me;
        <div class="surface mb-6 overflow-hidden">
            <div class="flex flex-wrap items-center gap-5 px-5 py-4">
                <PlayerAssigneeBadge Kind="PlayerAssigneeBadge.For(_scoped.Kind)" Name="@_scoped.Name"
                                     DetailLabel="@($"{_scoped.GamesPlayed} game{(_scoped.GamesPlayed == 1 ? "" : "s")} recorded")"
                                     ContainerClass="inline-flex items-center gap-3 min-w-0 flex-1"/>
                <div class="ml-auto flex items-center gap-4">
                    <WinRateRing Pct="_scoped.WinRate" Size="64" Caption="win"/>
                    @if (favSpirit is not null)
                    {
                        <div class="flex min-w-0 items-center gap-2">
                            <span class="inline-block h-9 w-1.5 shrink-0 rounded-full" style="background-color: @favColor;"></span>
                            <div class="min-w-0">
                                <div class="text-[10px] uppercase tracking-wide text-ink-500">Favourite spirit</div>
                                <button type="button" class="truncate text-sm font-semibold text-ink-900 hover:text-accent-800"
                                        @onclick="() => OpenSpirit(favSpirit.Id.Value)">@favSpirit.Name</button>
                            </div>
                        </div>
                    }
                    @* The one place a person's games are reachable from: the cards below are the
                       page's scope picker, and a link inside a button is not something a browser
                       will render — so it belongs here, once, beside the scope it belongs to. *@
                    <a href="@GamesLink.ForPlayer(_scoped.UserId, _scoped.PlayerId)" class="btn btn-secondary btn-sm"
                       title="@($"Open the games list, filtered to the games {(isMe ? "you" : _scoped.Name)} sat in")">
                        <Icon Name="controller" Class="w-3.5 h-3.5"/> @(isMe ? "Your games" : "Their games")
                    </a>
                    <button class="btn btn-ghost btn-sm" @onclick="() => SetScope(null)">
                        <Icon Name="x" Class="w-3.5 h-3.5"/> Clear filter
                    </button>
                </div>
            </div>

            @* The line that says what this page is now showing — the same sentence in every
               scope, so nobody has to work out whose numbers they are looking at. *@
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 bg-ink-50/50 px-5 py-2.5 text-[11px] text-ink-500">
                <span class="inline-flex items-center gap-1.5">
                    <Icon Name="info" Class="w-3.5 h-3.5 text-ink-400"/>
                    @if (isMe)
                    {
                        <span>Every game you sat in, whoever recorded it.</span>
                    }
                    else
                    {
                        <span>
                            Only the games <span class="font-medium text-ink-700">you and @_scoped.Name</span> played together —
                            @(_scoped.Kind == PlayerKind.Friend
                                ? "their other tables stay theirs."
                                : "a guest at your table.")
                        </span>
                    }
                </span>
                <span class="tabular-nums">
                    <span class="font-medium text-accent-700">@_scoped.Wins W</span> ·
                    <span class="font-medium text-red-600">@_scoped.Losses L</span>
                    @if (_scoped.BestScore is { } best)
                    {
                        <span> · best <span class="font-medium text-ink-700">@best</span></span>
                    }
                </span>
            </div>
        </div>
    }

    @* ============================== HERO STRIP ==============================
       Top row: the three headline stats — large tiles.

       Each tile's leading-edge bar says what family the figure belongs to rather than decorating
       it: jade for the island's side of the ledger (games played, wins), sun for a score or a
       difficulty, ember for what the invaders took (blight, a loss, the worst result), deep for
       time and neutral counts. Read down a row it groups the numbers without needing a legend. *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-3">
        <StatHero Value="@_stats.TotalGames.ToString()"
                  Label="Total games"
                  Caption="@StatsFormat.DraftsCaption(_stats.InProgress)"
                  Icon="controller"/>
        <StatHero Value="@($"{_stats.WinRate:F0}%")"
                  Label="Win rate"
                  Caption="@($"{_stats.Wins} W · {_stats.Losses} L")"
                  Icon="trophy"/>
        <StatHero Value="@(_stats.BestScoreGameId is not null ? _stats.BestScore.ToString() : "—")"
                  Label="Best score"
                  Caption="@(_stats.BestScoreGameId is not null ? "View that match →" : "no completed games")"
                  Icon="star" Class="tile-sun"
                  Href="@(_stats.BestScoreGameId is { } id ? GamesLink.Game(id, null) : null)"/>
    </div>
    @* Second row: secondary stats, denser. *@
    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
        <StatHero Value="@($"{_stats.AverageScore:F0}")"
                  Label="Avg score"
                  Caption="@($"{_stats.AverageDifficulty:F1} avg difficulty")"
                  Icon="chart" Class="tile-sun"/>
        <StatHero Value="@StatsFormat.Hours(_stats.TotalPlayTime)"
                  Label="Time played"
                  Caption="@($"avg {_stats.AverageDuration:h\\:mm} per game")"
                  Icon="clock" Class="tile-deep"/>
        <StatHero Value="@(_stats.LongestStreak > 0 ? _stats.LongestStreak.ToString() : "—")"
                  Label="Best streak"
                  Caption="consecutive wins"
                  Icon="sparkles"/>
        <StatHero Value="@(_stats.MinScore?.ToString() ?? "—")"
                  Label="Lowest score"
                  Caption="@(_stats.MinScoreGameId is not null ? "View that match →" : "no completed games")"
                  Icon="minus" Class="tile-ember"
                  Href="@(_stats.MinScoreGameId is { } minId ? GamesLink.Game(minId, null) : null)"/>
        <StatHero Value="@($"{_stats.AverageDahan:F1}")"
                  Label="Avg dahan"
                  Caption="alive at game end"
                  Icon="users" Class="tile-deep"/>
        <StatHero Value="@($"{_stats.AverageBlight:F1}")"
                  Label="Avg blight"
                  Caption="on island at game end"
                  Icon="shield" Class="tile-ember"/>
    </div>

    @* ============================== TABS ============================== *@
    @* Same pill row the games list slices with — one pill active at a time. Real links, since a
       tab is an address here: it can be opened in a new tab, sent to somebody, and returned to
       after following a game out of the page. The scope rides along, so a friend's numbers stay
       a friend's numbers while you move between the sections. *@
    <nav class="mb-6 flex flex-wrap items-center gap-2" aria-label="Statistics sections">
        @foreach (var (key, label) in StatsLink.Tabs)
        {
            var count = TabCount(key);
            <FilterPill Active="@(_tab == key)" Href="@StatsLink.For(key, _scoped?.UserId, _scoped?.PlayerId)"
                        Title="@(_scoped is null ? label : $"{label} — {_scoped.Name}'s games")">
                @label
                @if (count is { } c)
                {
                    <span class="tabular-nums opacity-60">@c</span>
                }
            </FilterPill>
        }
    </nav>

    @switch (_tab)
    {
        case StatsLink.Overview:
            @OverviewTab();
            break;
        case StatsLink.Players:
            @PlayersTab();
            break;
        case StatsLink.Spirits:
            @SpiritsTab();
            break;
        case StatsLink.Adversaries:
            @AdversariesTab();
            break;
        case StatsLink.Scenarios:
            @ScenariosTab();
            break;
        case StatsLink.Boards:
            @BoardsTab();
            break;
    }
}

@* Record sheets — the same reference modals the catalogue pages and the setup screen open.

   All five follow this page's player selector, because everything else on the page does: a card
   that counts twelve games must not open a sheet counting forty. A seat-bound sheet (spirit,
   board) narrows to that person's seats and a table-level one (adversary / scenario / layout) to
   the games they sat in — the same two rules GetStatistics scopes the server-side numbers by.
   The catalogue pages have no selector and pass none of this, so a sheet there is the whole
   account's history; each sheet says in words which of the two it is.

   LinkGames on all five: from here a sheet is a place to read the record, so every line in it
   may be opened as the game it reports. The setup screen opens the same sheets to choose with
   and leaves it off, since a link out of there would abandon a half-built game. *@
<SpiritDetailModal @ref="_spiritModal" OwnedExpansions="OwnedExpansions" Facts="_facts"
                   SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                   LinkGames="true"/>
<AdversaryDetailModal @ref="_adversaryModal" Facts="_facts"
                      SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                      LinkGames="true"/>
<ScenarioDetailModal @ref="_scenarioModal" Facts="_facts"
                     SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                     LinkGames="true"/>
<BoardDetailModal @ref="_boardModal" Facts="_facts"
                  SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                  LinkGames="true"/>
<IslandLayoutDetailModal @ref="_layoutModal" Facts="_facts"
                         SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                         LinkGames="true"/>

@* ============================== OVERVIEW TAB ============================== *@
@code {
    private RenderFragment OverviewTab() =>
        @<div class="space-y-6">
            @{
                var topSpirit = _stats!.SpiritStatistics.OrderByDescending(s => s.GamesPlayed).FirstOrDefault();
                var bestSpirit = _stats.SpiritStatistics.Where(s => s.GamesPlayed >= 3).OrderByDescending(s => s.WinRate).FirstOrDefault();
                var toughAdv = _stats.AdversaryStatistics.Where(a => a.GamesPlayed >= 3).OrderBy(a => a.WinRate).FirstOrDefault();
                var favAdv = _stats.AdversaryStatistics.OrderByDescending(a => a.GamesPlayed).FirstOrDefault();
            }

            @* ===== Outcome donut + Highlights row ===== *@
            <div class="grid lg:grid-cols-3 gap-6">
                @* Outcome donut card *@
                <div class="surface px-5 py-5">
                    <h2 class="section-title mb-3">Outcome</h2>
                    <div class="flex items-center justify-between gap-4">
                        <WinRateRing Pct="_stats.WinRate" Size="128" Stroke="12" Caption="win rate"/>
                        <div class="space-y-2 text-sm flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-2 text-ink-700"><span class="h-2.5 w-2.5 rounded-full bg-accent-500"></span>Wins</span>
                                <span class="font-semibold tabular-nums text-ink-900">@_stats.Wins</span>
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-2 text-ink-700"><span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>Losses</span>
                                <span class="font-semibold tabular-nums text-ink-900">@_stats.Losses</span>
                            </div>
                            <div class="flex items-center justify-between gap-2 pt-2 border-t border-ink-100">
                                <span class="inline-flex items-center gap-2 text-ink-500 text-xs">In progress</span>
                                <span class="font-medium tabular-nums text-ink-700">@_stats.InProgress</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Highlights stack — two highlights *@
                <div class="space-y-3">
                    @if (topSpirit is not null)
                    {
                        var sp = GameLookups.SpiritFor(topSpirit.SpiritId);
                        var color = (sp is null ? null : SpiritDetails.For(sp.Id))?.ColorHex;
                        <InsightCard Title="Most played spirit"
                                     Subject="@(sp?.Name ?? topSpirit.SpiritId)"
                                     Secondary="@($"{topSpirit.WinRate:F0}% win · {topSpirit.AverageScore:F0} avg score")"
                                     Metric="@topSpirit.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     AccentColor="@color"
                                     OnClick="() => OpenSpirit(topSpirit.SpiritId)"/>
                    }
                    @if (bestSpirit is not null && bestSpirit.SpiritId != topSpirit?.SpiritId)
                    {
                        var sp = GameLookups.SpiritFor(bestSpirit.SpiritId);
                        var color = (sp is null ? null : SpiritDetails.For(sp.Id))?.ColorHex;
                        <InsightCard Title="Highest win rate"
                                     Subject="@(sp?.Name ?? bestSpirit.SpiritId)"
                                     Secondary="@($"{bestSpirit.GamesPlayed} games")"
                                     Metric="@($"{bestSpirit.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(bestSpirit.WinRate)"
                                     AccentColor="@color"
                                     OnClick="() => OpenSpirit(bestSpirit.SpiritId)"/>
                    }
                </div>

                @* Highlights stack — adversary side *@
                <div class="space-y-3">
                    @if (favAdv is not null)
                    {
                        var adv = GameLookups.AdversaryFor(favAdv.AdversaryId);
                        <InsightCard Title="Most played adversary"
                                     Subject="@(adv?.Name ?? favAdv.AdversaryId)"
                                     Secondary="@($"avg L{favAdv.AverageLevel:F1} · {favAdv.WinRate:F0}% win")"
                                     Metric="@favAdv.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     OnClick="() => OpenAdversary(favAdv.AdversaryId)"/>
                    }
                    @if (toughAdv is not null && toughAdv.AdversaryId != favAdv?.AdversaryId)
                    {
                        var adv = GameLookups.AdversaryFor(toughAdv.AdversaryId);
                        <InsightCard Title="Toughest matchup"
                                     Subject="@(adv?.Name ?? toughAdv.AdversaryId)"
                                     Secondary="@($"{toughAdv.GamesPlayed} games")"
                                     Metric="@($"{toughAdv.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(toughAdv.WinRate)"
                                     OnClick="() => OpenAdversary(toughAdv.AdversaryId)"/>
                    }
                </div>
            </div>

            @* ===== Recent games ===== *@
            <div>
                <div class="section-head">
                    <h2 class="section-title">Recent games</h2>
                    @* The strip is the newest of whatever this page is counting, so "all" has to
                       mean the same thing — a scoped page sends you to that person's games, not
                       to everybody's. *@
                    <a href="@(_scoped is null ? GamesLink.Path : GamesLink.ForPlayer(_scoped.UserId, _scoped.PlayerId))"
                       class="section-link">View all →</a>
                </div>
                <RecentGamesStrip Games="_stats.RecentGames"/>
            </div>

            @* ===== Activity chart full width ===== *@
            <div class="surface px-5 pt-5 pb-3">
                <div class="section-head">
                    <h2 class="section-title">Activity over time</h2>
                    <span class="section-note">Wins vs losses per month</span>
                </div>
                <MonthlyGamesChart Months="_stats.MonthlyStatistics" Height="280"/>
            </div>

            @* ===== Hardest matchups ===== *@
            @{
                var hardAdversaries = _stats.AdversaryStatistics
                    .Where(a => a.Losses > 0)
                    .OrderByDescending(a => a.Losses)
                    .ThenByDescending(a => a.GamesPlayed)
                    .Take(5)
                    .Select(a =>
                    {
                        var adv = GameLookups.AdversaryFor(a.AdversaryId);
                        return new LossLeaderboard.Row(
                            adv?.Name ?? a.AdversaryId,
                            a.Losses,
                            $"avg L{a.AverageLevel:F1} · {a.WinRate:F0}% win",
                            GamesLink.ForAdversary(a.AdversaryId, status: GameStatusTab.Defeats, who: ScopeWho));
                    })
                    .ToList();
                var hardScenarios = _stats.ScenarioStatistics
                    .Where(s => s.Losses > 0)
                    .OrderByDescending(s => s.Losses)
                    .ThenByDescending(s => s.GamesPlayed)
                    .Take(5)
                    .Select(s =>
                    {
                        var sc = GameLookups.ScenarioFor(s.ScenarioId);
                        return new LossLeaderboard.Row(
                            sc?.Name ?? s.ScenarioId,
                            s.Losses,
                            $"{s.WinRate:F0}% win",
                            GamesLink.ForScenario(s.ScenarioId, GameStatusTab.Defeats, ScopeWho));
                    })
                    .ToList();
                var hardSpirits = _stats.SpiritStatistics
                    .Where(s => s.Losses > 0)
                    .OrderByDescending(s => s.Losses)
                    .ThenByDescending(s => s.GamesPlayed)
                    .Take(5)
                    .Select(s =>
                    {
                        var sp = GameLookups.SpiritFor(s.SpiritId);
                        return new LossLeaderboard.Row(
                            sp?.Name ?? s.SpiritId,
                            s.Losses,
                            $"{s.WinRate:F0}% win",
                            GamesLink.ForSpirit(s.SpiritId, GameStatusTab.Defeats, ScopeWho));
                    })
                    .ToList();
            }
            <div>
                <div class="section-head">
                    <h2 class="section-title">Hardest matchups</h2>
                    <span class="section-note">Sorted by total losses · tap a row for those defeats</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <LossLeaderboard Title="Adversaries" Subtitle="Most defeats by" Rows="hardAdversaries"/>
                    <LossLeaderboard Title="Scenarios" Subtitle="Most defeats in" Rows="hardScenarios"/>
                    <LossLeaderboard Title="Spirits" Subtitle="Most defeats with" Rows="hardSpirits"/>
                </div>
            </div>

            @* ===== Distributions ===== *@
            <div class="grid lg:grid-cols-2 gap-6">
                <div class="surface px-5 pt-5 pb-3">
                    <div class="section-head">
                        <h2 class="section-title">Score distribution</h2>
                        <span class="section-note">@_stats.CompletedScores.Count completed games</span>
                    </div>
                    <ScoreDistributionChart Scores="_stats.CompletedScores"/>
                </div>
                <div class="surface px-5 pt-5 pb-3">
                    <div class="section-head">
                        <h2 class="section-title">Difficulty distribution</h2>
                        <span class="section-note">avg @($"{_stats.AverageDifficulty:F1}")</span>
                    </div>
                    <DifficultyDistributionChart Difficulties="_stats.CompletedDifficulties"/>
                </div>
            </div>

            @* ===== Terror distribution ===== *@
            @{
                var terrorTotal = _stats.TerrorDistribution.Sum(t => t.GamesPlayed);
                var topTerror = _stats.TerrorDistribution.OrderByDescending(t => t.GamesPlayed).FirstOrDefault();
            }
            @if (terrorTotal > 0)
            {
                <div class="surface px-5 py-5">
                    <div class="section-head mb-4">
                        <div>
                            <h2 class="section-title">Terror level at game end</h2>
                            @if (topTerror is not null)
                            {
                                <p class="section-note mt-0.5">
                                    Most games end at <span class="text-ink-800 font-medium">Terror @TerrorBar.TerrorLabel(topTerror.TerrorLevel)</span>
                                    (@($"{(double)topTerror.GamesPlayed / terrorTotal * 100:F0}%"))
                                </p>
                            }
                        </div>
                        <span class="section-note">@terrorTotal completed games</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        @foreach (var t in _stats.TerrorDistribution)
                        {
                            var pct = terrorTotal > 0 ? (double)t.GamesPlayed / terrorTotal * 100 : 0;
                            var losses = t.GamesPlayed - t.Wins;
                            var winPct = t.GamesPlayed > 0 ? (double)t.Wins / t.GamesPlayed * 100 : 0;
                            <div class="rounded-xl border border-ink-200 px-4 py-3">
                                <div class="flex items-baseline justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-block h-3 w-3 rounded-sm" style="background-color: @TerrorBar.TerrorColor(t.TerrorLevel);"></span>
                                        <span class="text-xs uppercase tracking-wide text-ink-500 font-medium">Terror @TerrorBar.TerrorLabel(t.TerrorLevel)</span>
                                    </div>
                                    <span class="text-base font-bold tabular-nums text-ink-900" style="font-family: var(--font-serif);">@t.GamesPlayed</span>
                                </div>
                                <div class="mt-2 h-1.5 bg-ink-100 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full" style="width:@($"{pct:F0}")%; background-color: @TerrorBar.TerrorColor(t.TerrorLevel);"></div>
                                </div>
                                @if (t.GamesPlayed > 0)
                                {
                                    <div class="mt-2 flex items-center justify-between text-[11px] text-ink-500 tabular-nums">
                                        <span><span class="text-accent-700 font-medium">@t.Wins W</span> · <span class="text-red-600 font-medium">@losses L</span></span>
                                        <span class="font-medium @WinTone.ForRate(winPct)">@($"{winPct:F0}% win")</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-2 text-[11px] text-ink-400">no game ended here</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>;
}

@* ============================== PLAYERS TAB ==============================
   Who has been at the table and how each of you did. Every row is over the games the
   signed-in user is part of — a friend's card is your shared record with them, never the
   history they built elsewhere. Picking one scopes the whole page to them. *@
@code {
    private RenderFragment PlayersTab() =>
        @<div class="space-y-6">
            @{
                var ranked = _unfilteredPlayers.OrderByDescending(p => p.GamesPlayed).ToList();
                var mostPlayed = ranked.FirstOrDefault(p => p.Kind != PlayerKind.Me);
                var bestPartner = ranked
                    .Where(p => p.Kind != PlayerKind.Me && p.Wins + p.Losses >= 3)
                    .OrderByDescending(p => p.WinRate)
                    .FirstOrDefault();
            }

            @if (mostPlayed is not null || bestPartner is not null)
            {
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    @if (mostPlayed is not null)
                    {
                        <InsightCard Title="Most games with"
                                     Subject="@mostPlayed.Name"
                                     Secondary="@($"{mostPlayed.WinRate:F0}% win together")"
                                     Metric="@mostPlayed.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     OnClick="() => SetScope(mostPlayed)"/>
                    }
                    @if (bestPartner is not null && !SameScope(bestPartner, mostPlayed))
                    {
                        <InsightCard Title="Best record together"
                                     Subject="@bestPartner.Name"
                                     Secondary="@($"{bestPartner.GamesPlayed} games")"
                                     Metric="@($"{bestPartner.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(bestPartner.WinRate)"
                                     OnClick="() => SetScope(bestPartner)"/>
                    }
                </div>
            }

            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @* The same card the People page shows, so a person looks like themselves
                   wherever they turn up — here it doubles as the page's scope picker. *@
                @foreach (var p in ranked)
                {
                    var active = SameScope(p, _scoped);
                    <PersonCard @key="@($"{p.UserId}-{p.PlayerId}")"
                                Kind="PlayerAssigneeBadge.For(p.Kind)" Name="@p.Name"
                                DetailLabel="@KindCaption(p.Kind)"
                                Games="p.GamesPlayed" Wins="p.Wins" Losses="p.Losses" WinRate="p.WinRate"
                                FavouriteSpiritId="@p.FavouriteSpirit"
                                EmptyNote="No completed games yet."
                                Selected="active"
                                Title="@(active ? "Showing this player — click to clear" : $"Show only games with {p.Name}")"
                                OnClick="() => SetScope(active ? null : p)">
                        <Details>
                            @if (p.BestScore is { } best)
                            {
                                <div class="flex items-center gap-2">
                                    <Icon Name="star" Class="w-3.5 h-3.5 text-ink-400"/>
                                    <span>Best <span class="font-medium text-ink-800 tabular-nums">@best</span> · avg <span class="tabular-nums">@($"{p.AverageScore:F0}")</span></span>
                                </div>
                            }
                        </Details>
                    </PersonCard>
                }
            </div>

            <p class="text-[11px] text-ink-500">
                Counted over your own games only. A friend's own history at other tables is theirs to show.
            </p>
        </div>;

    private static string KindCaption(PlayerKind kind) => kind switch
    {
        PlayerKind.Me     => "You",
        PlayerKind.Friend => "Friend · has an account",
        _                 => "Local player",
    };
}

@* ============================== SPIRITS TAB ============================== *@
@code {
    private RenderFragment SpiritsTab() =>
        @<div class="space-y-6">
            @{
                var topSpirit = _stats!.SpiritStatistics.OrderByDescending(s => s.GamesPlayed).FirstOrDefault();
                var bestScoreSpirit = _stats.SpiritStatistics.Where(s => s.BestScore.HasValue).OrderByDescending(s => s.BestScore!.Value).FirstOrDefault();
                var bestRateSpirit = _stats.SpiritStatistics.Where(s => s.GamesPlayed >= 3).OrderByDescending(s => s.WinRate).FirstOrDefault();
                var playedSpiritIds = _stats.SpiritStatistics.Select(s => s.SpiritId).ToHashSet();
                var ownedSpirits = OwnedSpiritsList();
                var missingSpirits = ownedSpirits.Where(s => !playedSpiritIds.Contains(s.Id.Value)).Cast<object>().ToList();
                var missingAspects = MissingAspects(ownedSpirits);
                var missingAspectGroups = missingAspects
                    .GroupBy(m => (m.SpiritId, m.SpiritName))
                    .OrderBy(g => g.Key.SpiritName)
                    .Select(g => new MissingAspectGroup(g.Key.SpiritId, g.Key.SpiritName, g.Select(m => m.AspectName).ToList()))
                    .Cast<object>().ToList();
                var totalAspects = ownedSpirits.Sum(s => OwnedAspectsFor(s).Count);
            }

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                @if (topSpirit is not null) { @SpiritInsight("Most played", topSpirit, $"{topSpirit.GamesPlayed} games") }
                @if (bestRateSpirit is not null) { @SpiritInsight("Highest win rate", bestRateSpirit, $"{bestRateSpirit.WinRate:F0}%", WinTone.ForRate(bestRateSpirit.WinRate)) }
                @if (bestScoreSpirit is not null) { @SpiritInsight("Highest score", bestScoreSpirit, $"{bestScoreSpirit.BestScore} pts") }
            </div>

            <div class="surface px-5 pt-5 pb-3">
                <div class="section-head">
                    <h2 class="section-title">Games played by spirit</h2>
                </div>
                <SpiritGamesChart Spirits="_stats.SpiritStatistics"/>
            </div>

            <div class="surface">
                <div class="surface-head">
                    <h2 class="text-base font-semibold">All spirits</h2>
                    <span class="text-[11px] text-ink-500">Tap a row for the record sheet, a count for those games</span>
                </div>
                <div class="table-wrap">
                    <table class="table table-hover">
                        <thead><tr>
                            <th>Spirit</th>
                            <th class="text-right">Games</th>
                            <th class="text-right">W</th>
                            <th class="text-right">L</th>
                            <th>Win rate</th>
                            <th class="text-right">Avg score</th>
                            <th class="text-right">Best</th>
                            <th>Terror reached</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var s in _stats.SpiritStatistics)
                        {
                            var spirit = GameLookups.SpiritFor(s.SpiritId);
                            var detail = spirit is null ? null : SpiritDetails.For(spirit.Id);
                            var color = detail?.ColorHex ?? GameLookups.NeutralColor;
                            <tr @onclick="() => OpenSpirit(s.SpiritId)">
                                <td>
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="inline-block h-8 w-1.5 rounded-full shrink-0" style="background-color: @color;"></span>
                                        <div class="min-w-0">
                                            @* A real button inside the clickable row, so the sheet is reachable by keyboard too. *@
                                            <button type="button" @onclick="() => OpenSpirit(s.SpiritId)" @onclick:stopPropagation
                                                    class="block max-w-full truncate rounded text-left text-sm font-semibold text-ink-900
                                                           focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                                @(spirit?.Name ?? s.SpiritId)
                                            </button>
                                            @if (detail is not null) { <div class="text-[11px] text-ink-500 truncate">@detail.PlayStyle</div> }
                                            @* Which variants the plays were: the row's own numbers pool
                                               them, and an aspect is a different spirit to play. *@
                                            @if (PlayedAspects(s) is { Count: > 0 } playedAspects)
                                            {
                                                <div class="mt-1">
                                                    <AspectChips Aspects="playedAspects" Records="AspectRecordsOf(s)"/>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                @GamesCountCell(s.GamesPlayed, GamesLink.ForSpirit(s.SpiritId, who: ScopeWho),
                                                ScopedTitle($"Every game played as {spirit?.Name ?? s.SpiritId}"))
                                <td class="text-right text-accent-700 tabular-nums">@s.Wins</td>
                                <td class="text-right text-red-600 tabular-nums">@s.Losses</td>
                                <td>
                                    @if (s.Wins + s.Losses > 0) { <WinRateBar Pct="s.WinRate"/> }
                                    else { <span class="text-xs text-ink-400">—</span> }
                                </td>
                                <td class="text-right tabular-nums">@(s.Wins + s.Losses > 0 ? $"{s.AverageScore:F0}" : "—")</td>
                                <td class="text-right tabular-nums">@(s.BestScore?.ToString() ?? "—")</td>
                                <td><TerrorBar Counts="s.TerrorCounts" WidthClass="w-28"/></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <CoveragePanel Title="Spirits" Total="ownedSpirits.Count" Missing="missingSpirits" ItemTemplate="SpiritPill"
                           Note="@OutsideCollectionNote(playedSpiritIds, ownedSpirits.Select(s => s.Id.Value), "spirit")"/>

            @* Aspects are counted the way adversary levels are: one entry per variant, grouped
               under the spirit it varies, because an aspect is a different spirit to play. *@
            @if (totalAspects > 0)
            {
                <CoveragePanel Title="Aspects"
                               Total="totalAspects"
                               Missing="missingAspectGroups"
                               MissingCount="missingAspects.Count"
                               ItemTemplate="AspectGroupPill"/>
            }
        </div>;

    private RenderFragment<object> AspectGroupPill => o =>
        @<text>
            @{
                var entry = (MissingAspectGroup)o;
                var spirit = GameLookups.SpiritFor(entry.SpiritId);
                var color = spirit is null ? null : SpiritDetails.For(spirit.Id)?.ColorHex;
            }
            <button type="button" @onclick="() => OpenSpirit(entry.SpiritId)" title="@($"{entry.SpiritName} — details and full record")"
                    class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2.5 py-1 text-xs transition-colors
                           hover:border-amber-400 hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                <span class="inline-block h-2 w-2 rounded-full" style="background-color: @(color ?? GameLookups.NeutralColor);"></span>
                <span class="font-medium text-amber-800">@entry.SpiritName</span>
                <span class="text-amber-700">@string.Join(", ", entry.AspectNames)</span>
            </button>
        </text>;

    private RenderFragment<object> SpiritPill => o =>
        @<text>
            @{
                var spirit = (Spirit)o;
                var detail = SpiritDetails.For(spirit.Id);
                var color = detail?.ColorHex ?? GameLookups.NeutralColor;
            }
            <button type="button" @onclick="() => _spiritModal.Show(spirit)" title="@($"{spirit.Name} — details and full record")"
                    class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2.5 py-1 text-xs transition-colors
                           hover:border-amber-400 hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                <span class="inline-block h-2 w-2 rounded-full" style="background-color: @color;"></span>
                <span class="text-amber-800">@spirit.Name</span>
            </button>
        </text>;

    private RenderFragment SpiritInsight(string title, SpiritStats s, string metric, string? metricColor = null) =>
        @<text>
            @{
                var sp = GameLookups.SpiritFor(s.SpiritId);
                var detail = sp is null ? null : SpiritDetails.For(sp.Id);
                var color = detail?.ColorHex;
            }
            <InsightCard Title="@title"
                         Subject="@(sp?.Name ?? s.SpiritId)"
                         Secondary="@($"{s.GamesPlayed} games · {s.AverageScore:F0} avg")"
                         Metric="@metric"
                         MetricColorClass="@(metricColor ?? "text-ink-900")"
                         AccentColor="@color"
                         OnClick="() => OpenSpirit(s.SpiritId)"/>
        </text>;
}

@* ============================== ADVERSARIES TAB ============================== *@
@code {
    private RenderFragment AdversariesTab() =>
        @<div class="space-y-6">
            @{
                var topAdv = _stats!.AdversaryStatistics.OrderByDescending(a => a.GamesPlayed).FirstOrDefault();
                var bestAdv = _stats.AdversaryStatistics.Where(a => a.GamesPlayed >= 3).OrderByDescending(a => a.WinRate).FirstOrDefault();
                var worstAdv = _stats.AdversaryStatistics.Where(a => a.GamesPlayed >= 3).OrderBy(a => a.WinRate).FirstOrDefault();
                var ownedAdversaries = OwnedAdversariesList();
                var missingLevels = MissingAdversaryLevels(_stats.AdversaryStatistics, ownedAdversaries);
                var missingGroups = missingLevels
                    .GroupBy(m => (m.AdversaryId, m.AdversaryName))
                    .OrderBy(g => g.Key.AdversaryName)
                    .Select(g => new MissingAdversaryGroup(g.Key.AdversaryId, g.Key.AdversaryName, g.Select(m => m.Level).OrderBy(l => l).ToList()))
                    .Cast<object>().ToList();
                var totalLevels = ownedAdversaries.Sum(a => a.Modes.Count());
            }

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                @if (topAdv is not null) { @AdversaryInsight("Most played", topAdv, $"{topAdv.GamesPlayed} games", null) }
                @if (bestAdv is not null) { @AdversaryInsight("Highest win rate", bestAdv, $"{bestAdv.WinRate:F0}%", WinTone.ForRate(bestAdv.WinRate)) }
                @if (worstAdv is not null && worstAdv.AdversaryId != bestAdv?.AdversaryId) { @AdversaryInsight("Toughest", worstAdv, $"{worstAdv.WinRate:F0}%", WinTone.ForRate(worstAdv.WinRate)) }
            </div>

            <div>
                <div class="section-head">
                    <h2 class="section-title">Every foe faced</h2>
                    <span class="section-note">Tap a card for its sheet, a level for those games</span>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    @foreach (var a in _stats.AdversaryStatistics)
                    {
                        var adv = GameLookups.AdversaryFor(a.AdversaryId);
                        var name = adv?.Name ?? a.AdversaryId;
                        @* The card opens the foe's record sheet, as the catalogue cards do — but
                           the counts on it are their own links into the games list, which is where
                           "a lot of England games" turns into the games themselves. A button cannot
                           contain a link, so the disclosure is a full-card overlay and the links
                           are raised above it: the same arrangement FilterBar's header uses. *@
                        <div class="surface relative px-5 py-4 transition-all hover:-translate-y-px hover:shadow-sm">
                            <button type="button" @onclick="() => OpenAdversary(a.AdversaryId)"
                                    title="@($"{name} — details and full record")"
                                    class="absolute inset-0 w-full rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                <span class="sr-only">@name — details and full record</span>
                            </button>
                            <div class="pointer-events-none relative">
                                <div class="flex items-start justify-between gap-3 mb-3">
                                    <div class="min-w-0">
                                        <div class="text-base font-semibold text-ink-900 truncate" style="font-family: var(--font-serif);">@name</div>
                                        <div class="text-[11px] text-ink-500 mt-0.5 tabular-nums">
                                            @* The count is the way into those games, in the same
                                               dotted-rule idiom the tables use — see LinkedCount,
                                               which this cannot share because the tone differs on
                                               the card's smaller, greyer line. *@
                                            <a href="@GamesLink.ForAdversary(a.AdversaryId, who: ScopeWho)"
                                               title="@ScopedTitle($"Every game against {name}")"
                                               class="pointer-events-auto rounded font-medium text-ink-600 underline decoration-dotted
                                                      decoration-ink-300 underline-offset-4 transition-colors
                                                      hover:text-accent-800 hover:decoration-accent-500
                                                      focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                                @a.GamesPlayed game@(a.GamesPlayed == 1 ? "" : "s")
                                            </a> ·
                                            <span class="text-accent-700 font-medium">@a.Wins W</span> ·
                                            <span class="text-red-600 font-medium">@a.Losses L</span> ·
                                            avg L@(a.AverageLevel.ToString("F1"))
                                        </div>
                                    </div>
                                    <WinRateRing Pct="a.WinRate" Size="56"/>
                                </div>
                                @* The same strip the reference card and the record sheet draw
                                   (AdversaryLevelGrid): the level, what it adds to the difficulty,
                                   and the record at it — with a link to those games where there are
                                   any. Only for a foe still in the catalogue; one played from a box
                                   since removed has levels but nothing to say about them. *@
                                @if (adv is not null)
                                {
                                    <AdversaryLevelGrid Adversary="adv" Records="LevelRecords(a)"
                                                        LinkGames="true" RaiseAboveOverlay="true"
                                                        ScopeWho="@ScopeWho"/>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <CoveragePanel Title="Adversary levels"
                           Total="totalLevels"
                           Missing="missingGroups"
                           MissingCount="missingLevels.Count"
                           ItemTemplate="AdversaryLevelGroupPill"
                           Note="@OutsideCollectionNote(
                                     _stats.AdversaryStatistics.Select(a => a.AdversaryId),
                                     ownedAdversaries.Select(a => a.Id.Value),
                                     "adversary")"/>
        </div>;

    /// <summary>
    /// The server's per-level tally in the shape the shared level strip reads — the same
    /// projection AspectRecordsOf does for the aspect chips.
    /// </summary>
    private static IReadOnlyDictionary<int, SetupInsights.PlayRecord> LevelRecords(AdversaryStats a) =>
        a.Levels.ToDictionary(
            l => l.Level,
            l => new SetupInsights.PlayRecord(l.GamesPlayed, l.Wins, l.Losses));

    private RenderFragment<object> AdversaryLevelGroupPill => o =>
        @<text>
            @{
                var entry = (MissingAdversaryGroup)o;
            }
            <button type="button" @onclick="() => OpenAdversary(entry.AdversaryId)" title="@($"{entry.AdversaryName} — details and full record")"
                    class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2.5 py-1 text-xs transition-colors
                           hover:border-amber-400 hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                <Icon Name="shield" Class="w-3 h-3 text-amber-600"/>
                <span class="text-amber-800 font-medium">@entry.AdversaryName</span>
                <span class="text-amber-700">@string.Join(", ", entry.Levels.Select(l => $"L{l}"))</span>
            </button>
        </text>;

    private RenderFragment AdversaryInsight(string title, AdversaryStats a, string metric, string? metricColor) =>
        @<text>
            @{
                var adv = GameLookups.AdversaryFor(a.AdversaryId);
            }
            <InsightCard Title="@title"
                         Subject="@(adv?.Name ?? a.AdversaryId)"
                         Secondary="@($"avg L{a.AverageLevel:F1}")"
                         Metric="@metric"
                         MetricColorClass="@(metricColor ?? "text-ink-900")"
                         OnClick="() => OpenAdversary(a.AdversaryId)"/>
        </text>;
}

@* ============================== SCENARIOS TAB ============================== *@
@code {
