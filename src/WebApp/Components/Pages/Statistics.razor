@page "/app/statistics"
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<AppPageTitle Title="Statistics"/>

<PageHeader Eyebrow="Insights" Title="Statistics">
    <Sub>@HeaderSummary</Sub>
    <Actions>
    @if (_unfilteredPlayers.Count > 1)
    {
        <div class="relative">
            @* The same trigger and menu the seat picker on the setup screen wears — see
               .field-button / .field-menu. *@
            <button type="button" @onclick="ToggleScopePicker" class="field-button min-w-[14rem]"
                    aria-expanded="@Aria.Flag(_scopeOpen)">
                @if (_scoped is null)
                {
                    @EveryoneBadge("Global stats")
                }
                else
                {
                    <PlayerAssigneeBadge Kind="_scoped.Kind.ToAssigneeKind()" Name="@_scoped.Name"
                                         DetailLabel="@Copy.Count(_scoped.GamesPlayed, "game")"
                                         ContainerClass="@PlayerAssigneeBadge.RowLayout"/>
                }
                <Chevron Open="_scopeOpen"/>
            </button>

            @if (_scopeOpen)
            {
                <ClickAway OnDismiss="() => _scopeOpen = false"/>
                <div class="field-menu right-0 w-72 max-h-80">
                    <PickRow Active="_scoped is null" OnClick="() => SetScope(null)">
                        @EveryoneBadge("Every recorded game")
                    </PickRow>
                    <div class="my-1 border-t border-ink-100"></div>
                    @foreach (var p in _unfilteredPlayers)
                    {
                        <PickRow @key="@($"{p.UserId}-{p.PlayerId}")" Active="SameScope(p, _scoped)" OnClick="() => SetScope(p)">
                            <PlayerAssigneeBadge Kind="p.Kind.ToAssigneeKind()" Name="@p.Name"
                                                 DetailLabel="@($"{Copy.Count(p.GamesPlayed, "game")} · {p.WinRate:F0}% win")"/>
                        </PickRow>
                    }
                </div>
            }
        </div>
    }
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingSpinner/>
}
else if (_stats is null || _stats.TotalGames == 0)
{
    @if (_scoped is null)
    {
        <EmptyState Icon="chart" Title="No statistics yet"
                    Body="Record your first game and the numbers start telling the story — win rates, matchups, coverage.">
            <Action>
                <a href="@GamesLink.New" class="btn btn-primary">
                    <Icon Name="plus" Class="w-4 h-4"/> Record a game
                </a>
            </Action>
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="chart" Title="@($"No games with {_scoped.Name} yet")"
                    Body="Nothing has been recorded for this player so far.">
            <Action>
                <button type="button" class="btn btn-secondary" @onclick="() => SetScope(null)">Clear filter</button>
            </Action>
        </EmptyState>
    }
}
else
{
    @* ============================== SCOPED PLAYER HEADER ============================== *@
    @if (_scoped is not null)
    {
        var favSpirit = GameLookups.SpiritFor(_scoped.FavouriteSpirit);
        var favColor = GameLookups.SpiritColor(favSpirit);
        var isMe = _scoped.Kind == PlayerKind.Me;
        <div class="surface mb-6 overflow-hidden">
            <div class="flex flex-wrap items-center gap-5 px-5 py-4">
                <PlayerAssigneeBadge Kind="_scoped.Kind.ToAssigneeKind()" Name="@_scoped.Name"
                                     DetailLabel="@($"{Copy.Count(_scoped.GamesPlayed, "game")} recorded")"
                                     ContainerClass="@PlayerAssigneeBadge.RowLayout"/>
                <div class="ml-auto flex items-center gap-4">
                    <WinRateRing Pct="_scoped.WinRate" Size="64" Caption="win"/>
                    @if (favSpirit is not null)
                    {
                        <div class="flex min-w-0 items-center gap-2">
                            <ColorBar Color="@favColor"/>
                            <div class="min-w-0">
                                <div class="micro-label">Favourite spirit</div>
                                @* .row-title, which is what the three utilities here spelled out —
                                   and the keyboard's way into the spirit's sheet, so it carries
                                   the focus ring every other clickable name does. *@
                                <button type="button" class="row-title block max-w-full truncate rounded hover:text-accent-800 focus-ring"
                                        title="@Copy.SheetTooltip(favSpirit.Name)"
                                        @onclick="() => OpenSpirit(favSpirit.Id.Value)">@favSpirit.Name</button>
                            </div>
                        </div>
                    }
                    @* The one place a person's games are reachable from: the cards below are the
                       page's scope picker, and a link inside a button is not something a browser
                       will render — so it belongs here, once, beside the scope it belongs to. *@
                    <a href="@GamesLink.ForPlayer(_scoped.UserId, _scoped.PlayerId)" class="btn btn-secondary btn-sm"
                       title="@($"Open the games list, filtered to the games {(isMe ? "you" : _scoped.Name)} sat in")">
                        <Icon Name="controller" Class="w-3.5 h-3.5"/> @(isMe ? "Your games" : "Their games")
                    </a>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SetScope(null)">
                        <Icon Name="x" Class="w-3.5 h-3.5"/> Clear filter
                    </button>
                </div>
            </div>

            @* The line that says what this page is now showing — the same sentence in every
               scope, so nobody has to work out whose numbers they are looking at. *@
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 bg-ink-50/50 px-5 py-2.5 section-note">
                <IconNote Icon="info">
                    @if (isMe)
                    {
                        <text>Every game you sat in, whoever recorded it.</text>
                    }
                    else
                    {
                        <text>
                            Only the games <span class="font-medium text-ink-700">you and @_scoped.Name</span> played together —
                            @(_scoped.Kind == PlayerKind.Friend
                                ? "their other tables stay theirs."
                                : "a guest at your table.")
                        </text>
                    }
                </IconNote>
                <span class="tabular-nums">
                    <WinLossTally Wins="_scoped.Wins" Losses="_scoped.Losses"/>
                    @if (_scoped.BestScore is { } best)
                    {
                        <span> · best <span class="font-medium text-ink-700">@best</span></span>
                    }
                </span>
            </div>
        </div>
    }

    @* ============================== HERO STRIP ==============================
       Top row: the three headline stats — large tiles.

       Each tile's leading-edge bar says what family the figure belongs to rather than decorating
       it: jade for the island's side of the ledger (games played, wins), sun for a score or a
       difficulty, ember for what the invaders took (blight, a loss, the worst result), deep for
       time and neutral counts. Read down a row it groups the numbers without needing a legend. *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-3">
        <StatHero Value="@_stats.TotalGames.ToString()"
                  Label="Total games"
                  Caption="@StatsFormat.DraftsCaption(_stats.InProgress)"
                  Icon="controller"/>
        <StatHero Value="@($"{_stats.WinRate:F0}%")"
                  Label="Win rate"
                  Caption="@WinLossTally.Text(_stats.Wins, _stats.Losses)"
                  Icon="trophy"/>
        <StatHero Value="@(_stats.BestScoreGameId is not null ? _stats.BestScore.ToString() : "—")"
                  Label="Best score"
                  Caption="@(_stats.BestScoreGameId is not null ? "View that match →" : "no completed games")"
                  Icon="star" Class="tile-sun"
                  Href="@(_stats.BestScoreGameId is { } id ? GamesLink.Game(id) : null)"/>
    </div>
    @* Second row: secondary stats, denser. *@
    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
        <StatHero Value="@($"{_stats.AverageScore:F0}")"
                  Label="Avg score"
                  Caption="@($"{_stats.AverageDifficulty:F1} avg difficulty")"
                  Icon="chart" Class="tile-sun"/>
        <StatHero Value="@StatsFormat.Hours(_stats.TotalPlayTime)"
                  Label="Time played"
                  Caption="@StatsFormat.AverageDurationCaption(_stats.AverageDuration)"
                  Icon="clock" Class="tile-deep"/>
        <StatHero Value="@(_stats.LongestStreak > 0 ? _stats.LongestStreak.ToString() : "—")"
                  Label="Best streak"
                  Caption="consecutive wins"
                  Icon="sparkles"/>
        <StatHero Value="@(_stats.MinScore?.ToString() ?? "—")"
                  Label="Lowest score"
                  Caption="@(_stats.MinScoreGameId is not null ? "View that match →" : "no completed games")"
                  Icon="minus" Class="tile-ember"
                  Href="@(_stats.MinScoreGameId is { } minId ? GamesLink.Game(minId) : null)"/>
        <StatHero Value="@($"{_stats.AverageDahan:F1}")"
                  Label="Avg dahan"
                  Caption="alive at game end"
                  Icon="users" Class="tile-deep"/>
        <StatHero Value="@($"{_stats.AverageBlight:F1}")"
                  Label="Avg blight"
                  Caption="on island at game end"
                  Icon="shield" Class="tile-ember"/>
    </div>

    @* ============================== TABS ============================== *@
    @* Same pill row the games list slices with — one pill active at a time. Real links, since a
       tab is an address here: it can be opened in a new tab, sent to somebody, and returned to
       after following a game out of the page. The scope rides along, so a friend's numbers stay
       a friend's numbers while you move between the sections. *@
    <TabNav Tabs="StatsLink.Tabs" Current="@_tab" Label="Statistics sections"
            Href="TabHref" Title="TabTitle" Count="TabCount"/>

    @switch (_tab)
    {
        case StatsLink.Overview:
            @OverviewTab();
            break;
        case StatsLink.Players:
            @PlayersTab();
            break;
        case StatsLink.Spirits:
            @SpiritsTab();
            break;
        case StatsLink.Adversaries:
            @AdversariesTab();
            break;
        case StatsLink.Scenarios:
            @ScenariosTab();
            break;
        case StatsLink.Boards:
            @BoardsTab();
            break;
    }
}

@* Record sheets — the same reference modals the catalogue pages and the setup screen open.

   All five follow this page's player selector, because everything else on the page does: a card
   that counts twelve games must not open a sheet counting forty. A seat-bound sheet (spirit,
   board) narrows to that person's seats and a table-level one (adversary / scenario / layout) to
   the games they sat in — the same two rules GetStatistics scopes the server-side numbers by.
   The catalogue pages have no selector and pass none of this, so a sheet there is the whole
   account's history; each sheet says in words which of the two it is.

   LinkGames on all five: from here a sheet is a place to read the record, so every line in it
   may be opened as the game it reports. The setup screen opens the same sheets to choose with
   and leaves it off, since a link out of there would abandon a half-built game. *@
<SpiritDetailModal @ref="_spiritModal" Facts="_facts"
                   SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                   LinkGames="true"/>
<AdversaryDetailModal @ref="_adversaryModal" Facts="_facts"
                      SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                      LinkGames="true"/>
<ScenarioDetailModal @ref="_scenarioModal" Facts="_facts"
                     SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                     LinkGames="true"/>
<BoardDetailModal @ref="_boardModal" Facts="_facts"
                  SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                  LinkGames="true"/>
<IslandLayoutDetailModal @ref="_layoutModal" Facts="_facts"
                         SeatFilter="ScopeSeatFilter" SubjectName="@ScopeSubjectName" ScopeWho="@ScopeWho"
                         LinkGames="true"/>

@code {
    /// <summary>
    /// "Everybody", as one of the people the scope picker offers — the same badge as the players
    /// below it, so the unscoped choice reads as one of the list rather than as a heading over it.
    /// The trigger and the menu row differ only in the line under the name.
    /// </summary>
    private static RenderFragment EveryoneBadge(string detail) =>
        @<PlayerAssigneeBadge Kind="AssigneeKind.Everyone" Name="All players"
                              DetailLabel="@detail"
                              ContainerClass="@PlayerAssigneeBadge.RowLayout"/>;
}

@* ============================== OVERVIEW TAB ============================== *@
@code {
    private RenderFragment OverviewTab() =>
        @<div class="space-y-6">
            @{
                var topSpirit = _stats!.SpiritStatistics.OrderByDescending(s => s.GamesPlayed).FirstOrDefault();
                var bestSpirit = BestRated(_stats.SpiritStatistics);
                var toughAdv = BestRated(_stats.AdversaryStatistics, worst: true);
                var favAdv = _stats.AdversaryStatistics.OrderByDescending(a => a.GamesPlayed).FirstOrDefault();
            }

            @* ===== Outcome donut + Highlights row ===== *@
            <div class="grid lg:grid-cols-3 gap-6">
                @* Outcome donut card *@
                <div class="panel">
                    <SectionHead Title="Outcome"/>
                    <div class="flex items-center justify-between gap-4">
                        <WinRateRing Pct="_stats.WinRate" Size="128" Stroke="12" Caption="win rate"/>
                        <div class="space-y-2 text-sm flex-1 min-w-0">
                            @OutcomeTally("bg-accent-500", "Wins", _stats.Wins)
                            @OutcomeTally("bg-red-400", "Losses", _stats.Losses)
                            @* The third line is not one of the two the ring is drawn from — a
                               draft has no outcome yet — so it wears no swatch and sits below a
                               rule, quieter than the pair above it. *@
                            <div class="flex items-center justify-between gap-2 border-t border-ink-100 pt-2">
                                <span class="block-note">In progress</span>
                                <span class="font-medium tabular-nums text-ink-700">@_stats.InProgress</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Highlights stack — two highlights *@
                <div class="space-y-3">
                    @if (topSpirit is not null)
                    {
                        var sp = GameLookups.SpiritFor(topSpirit.SpiritId);
                        var color = GameLookups.SpiritAccent(sp);
                        <InsightCard Title="Most played spirit"
                                     Subject="@(sp?.Name ?? topSpirit.SpiritId)"
                                     Secondary="@($"{topSpirit.WinRate:F0}% win · {topSpirit.AverageScore:F0} avg score")"
                                     Metric="@topSpirit.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     AccentColor="@color"
                                     OnClick="() => OpenSpirit(topSpirit.SpiritId)"/>
                    }
                    @if (bestSpirit is not null && bestSpirit.SpiritId != topSpirit?.SpiritId)
                    {
                        var sp = GameLookups.SpiritFor(bestSpirit.SpiritId);
                        var color = GameLookups.SpiritAccent(sp);
                        <InsightCard Title="Highest win rate"
                                     Subject="@(sp?.Name ?? bestSpirit.SpiritId)"
                                     Secondary="@Copy.Count(bestSpirit.GamesPlayed, "game")"
                                     Metric="@($"{bestSpirit.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(bestSpirit.WinRate)"
                                     AccentColor="@color"
                                     OnClick="() => OpenSpirit(bestSpirit.SpiritId)"/>
                    }
                </div>

                @* Highlights stack — adversary side *@
                <div class="space-y-3">
                    @if (favAdv is not null)
                    {
                        var adv = GameLookups.AdversaryFor(favAdv.AdversaryId);
                        <InsightCard Title="Most played adversary"
                                     Subject="@(adv?.Name ?? favAdv.AdversaryId)"
                                     Secondary="@($"avg L{favAdv.AverageLevel:F1} · {favAdv.WinRate:F0}% win")"
                                     Metric="@favAdv.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     OnClick="() => OpenAdversary(favAdv.AdversaryId)"/>
                    }
                    @if (toughAdv is not null && toughAdv.AdversaryId != favAdv?.AdversaryId)
                    {
                        var adv = GameLookups.AdversaryFor(toughAdv.AdversaryId);
                        <InsightCard Title="Toughest matchup"
                                     Subject="@(adv?.Name ?? toughAdv.AdversaryId)"
                                     Secondary="@Copy.Count(toughAdv.GamesPlayed, "game")"
                                     Metric="@($"{toughAdv.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(toughAdv.WinRate)"
                                     OnClick="() => OpenAdversary(toughAdv.AdversaryId)"/>
                    }
                </div>
            </div>

            @* ===== Recent games ===== *@
            <div>
                @* The strip is the newest of whatever this page is counting, so "all" has to mean
                   the same thing — a scoped page sends you to that person's games, not to
                   everybody's. *@
                <SectionHead Title="Recent games">
                    <Trailing>
                        <a href="@(_scoped is null ? GamesLink.Path : GamesLink.ForPlayer(_scoped.UserId, _scoped.PlayerId))"
                           class="section-link">View all →</a>
                    </Trailing>
                </SectionHead>
                <RecentGamesStrip Games="_stats.RecentGames"/>
            </div>

            @* ===== Activity chart full width ===== *@
            <div class="panel panel-chart">
                <SectionHead Title="Activity over time" Note="Wins vs losses per month"/>
                <MonthlyGamesChart Months="_stats.MonthlyStatistics"/>
            </div>

            @* ===== Hardest matchups ===== *@
            @{
                var hardAdversaries = HardestBy(
                    _stats.AdversaryStatistics, a => a.Losses, a => a.GamesPlayed,
                    a => GameLookups.AdversaryFor(a.AdversaryId)?.Name ?? a.AdversaryId,
                    a => $"avg L{a.AverageLevel:F1} · {a.WinRate:F0}% win",
                    a => GamesLink.ForAdversary(a.AdversaryId, status: GameStatusTab.Defeats, who: ScopeWho));
                var hardScenarios = HardestBy(
                    _stats.ScenarioStatistics, s => s.Losses, s => s.GamesPlayed,
                    s => GameLookups.ScenarioFor(s.ScenarioId)?.Name ?? s.ScenarioId,
                    s => $"{s.WinRate:F0}% win",
                    s => GamesLink.ForScenario(s.ScenarioId, GameStatusTab.Defeats, ScopeWho));
                var hardSpirits = HardestBy(
                    _stats.SpiritStatistics, s => s.Losses, s => s.GamesPlayed,
                    s => GameLookups.SpiritFor(s.SpiritId)?.Name ?? s.SpiritId,
                    s => $"{s.WinRate:F0}% win",
                    s => GamesLink.ForSpirit(s.SpiritId, GameStatusTab.Defeats, ScopeWho));
            }
            <div>
                <SectionHead Title="Hardest matchups"
                             Note="Sorted by total losses · tap a row for those defeats"/>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <LossLeaderboard Title="Adversaries" Subtitle="Most defeats by" Rows="hardAdversaries"/>
                    <LossLeaderboard Title="Scenarios" Subtitle="Most defeats in" Rows="hardScenarios"/>
                    <LossLeaderboard Title="Spirits" Subtitle="Most defeats with" Rows="hardSpirits"/>
                </div>
            </div>

            @* ===== Distributions ===== *@
            <div class="grid lg:grid-cols-2 gap-6">
                <div class="panel panel-chart">
                    <SectionHead Title="Score distribution"
                                 Note="@($"{_stats.CompletedScores.Count} completed games")"/>
                    <ScoreDistributionChart Scores="_stats.CompletedScores"/>
                </div>
                <div class="panel panel-chart">
                    <SectionHead Title="Difficulty distribution"
                                 Note="@($"avg {_stats.AverageDifficulty:F1}")"/>
                    <DifficultyDistributionChart Difficulties="_stats.CompletedDifficulties"/>
                </div>
            </div>

            @* ===== Terror distribution ===== *@
            <TerrorDistributionPanel Levels="_stats.TerrorDistribution"/>
        </div>;

    /// <summary>
    /// The five entries a "hardest" leaderboard lists: the ones that have actually cost games,
    /// worst first, with the play count breaking a tie so a foe met twice does not outrank one
    /// met twenty times on the same two defeats.
    /// <para>
    /// Three of these were spelled out — adversaries, scenarios, spirits — and differed only in
    /// what each row is called and where its defeats can be read. The ordering, the cutoff and
    /// the "only what has lost" rule are the leaderboard's, not each subject's, so they are
    /// written once.
    /// </para>
    /// </summary>
    private static List<LossLeaderboard.Row> HardestBy<T>(
        IEnumerable<T> rows,
        Func<T, int> losses,
        Func<T, int> played,
        Func<T, string> name,
        Func<T, string> detail,
        Func<T, string> href) =>
        rows.Where(r => losses(r) > 0)
            .OrderByDescending(losses)
            .ThenByDescending(played)
            .Take(LeaderboardRows)
            .Select(r => new LossLeaderboard.Row(name(r), losses(r), detail(r), href(r)))
            .ToList();

    /// <summary>How many rows a "hardest" leaderboard lists — it is the shape of the problem,
    /// not the whole table, which is what the tabs below are for.</summary>
    private const int LeaderboardRows = 5;

    /// <summary>
    /// The best row by win rate, or with <paramref name="worst"/> the poorest — over the rows
    /// with enough finished games to be rated at all. Two drafts and a win is not an 88%, and
    /// that cutoff was written out at seven call sites across five stat types. One spelling now,
    /// so raising the bar is one edit; "finished" is wins plus losses, never seats taken.
    /// </summary>
    private static T? BestRated<T>(IEnumerable<T> rows, bool worst = false)
        where T : class, IWinRateTally
    {
        var rated = rows.Where(r => r.Wins + r.Losses >= StatsFormat.MinRatedGames);
        return worst ? rated.MinBy(r => r.WinRate) : rated.MaxBy(r => r.WinRate);
    }

    /// <summary>One side of the outcome ring's legend: the swatch that names a slice of the ring,
    /// the word for it, and the count. The pair must read as one legend, so it is written once.</summary>
    private static RenderFragment OutcomeTally(string dotClass, string label, int count) =>
        @<div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-2 text-ink-700"><ColorDot Size="sm" Class="@dotClass"/>@label</span>
            <span class="font-semibold tabular-nums text-ink-900">@count</span>
        </div>;
}

@* ============================== PLAYERS TAB ==============================
   Who has been at the table and how each of you did. Every row is over the games the
   signed-in user is part of — a friend's card is your shared record with them, never the
   history they built elsewhere. Picking one scopes the whole page to them. *@
@code {
    private RenderFragment PlayersTab() =>
        @<div class="space-y-6">
            @{
                var ranked = _unfilteredPlayers.OrderByDescending(p => p.GamesPlayed).ToList();
                var mostPlayed = ranked.FirstOrDefault(p => p.Kind != PlayerKind.Me);
                var bestPartner = BestRated(ranked.Where(p => p.Kind != PlayerKind.Me));
            }

            @if (mostPlayed is not null || bestPartner is not null)
            {
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    @if (mostPlayed is not null)
                    {
                        <InsightCard Title="Most games with"
                                     Subject="@mostPlayed.Name"
                                     Secondary="@($"{mostPlayed.WinRate:F0}% win together")"
                                     Metric="@mostPlayed.GamesPlayed.ToString()"
                                     MetricLabel="games"
                                     OnClick="() => SetScope(mostPlayed)"/>
                    }
                    @if (bestPartner is not null && !SameScope(bestPartner, mostPlayed))
                    {
                        <InsightCard Title="Best record together"
                                     Subject="@bestPartner.Name"
                                     Secondary="@Copy.Count(bestPartner.GamesPlayed, "game")"
                                     Metric="@($"{bestPartner.WinRate:F0}%")"
                                     MetricLabel="wins"
                                     MetricColorClass="@WinTone.ForRate(bestPartner.WinRate)"
                                     OnClick="() => SetScope(bestPartner)"/>
                    }
                </div>
            }

            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @* The same card the People page shows, so a person looks like themselves
                   wherever they turn up — here it doubles as the page's scope picker. *@
                @foreach (var p in ranked)
                {
                    var active = SameScope(p, _scoped);
                    @* No DetailLabel: the line under the name is the badge's own word for the kind
                       of person this is, the same word every other surface uses — this tab had
                       kept a second spelling of the three. *@
                    <PersonCard @key="@($"{p.UserId}-{p.PlayerId}")"
                                Kind="p.Kind.ToAssigneeKind()" Name="@p.Name"
                                Record="p"
                                FavouriteSpiritId="@p.FavouriteSpirit"
                                EmptyNote="No completed games yet."
                                Selected="active"
                                Title="@(active ? "Showing this player — click to clear" : $"Show only games with {p.Name}")"
                                OnClick="() => SetScope(active ? null : p)">
                        <Details>
                            @if (p.BestScore is { } best)
                            {
                                <IconNote Icon="star">Best <span class="font-medium text-ink-800 tabular-nums">@best</span> · avg <span class="tabular-nums">@($"{p.AverageScore:F0}")</span></IconNote>
                            }
                        </Details>
                    </PersonCard>
                }
            </div>

            <p class="section-note">
                Counted over your own games only. A friend's own history at other tables is theirs to show.
            </p>
        </div>;
}

@* ============================== SPIRITS TAB ============================== *@
@code {
    private RenderFragment SpiritsTab() =>
        @<div class="space-y-6">
            @{
                var spiritRows = FilteredSpiritStats();
                var tableRows = SortedSpiritRows(spiritRows);
                var byPlayed = spiritRows.OrderByDescending(s => s.GamesPlayed).ToList();
                var heatmapIds = byPlayed.Select(s => s.SpiritId).ToList();
                var topSpirit = byPlayed.FirstOrDefault();
                var bestScoreSpirit = spiritRows.Where(s => s.BestScore.HasValue).OrderByDescending(s => s.BestScore!.Value).FirstOrDefault();
                // Rated over finished games, not seats taken: two drafts and a win is not an 88%.
                var bestRateSpirit = BestRated(spiritRows);
                var playedSpiritIds = _stats!.SpiritStatistics.Select(s => s.SpiritId).ToHashSet();
                var playedSpirits = _stats.SpiritStatistics
                    .Select(s => GameLookups.SpiritFor(s.SpiritId)).OfType<Spirit>().ToList();
                var ownedSpirits = OwnedCatalogue.Spirits(OwnedExpansions);
                var missingSpirits = ownedSpirits.Where(s => !playedSpiritIds.Contains(s.Id.Value)).ToList();
                var ownedAspects = ownedSpirits.Select(s => (Spirit: s, Aspects: OwnedCatalogue.AspectsFor(s.Id, OwnedExpansions))).ToList();
                var missingAspects = StatsCoverage.MissingAspects(ownedAspects, _stats.SpiritStatistics);
                var missingAspectGroups = StatsCoverage.GroupAspects(missingAspects);
                var totalAspects = ownedAspects.Sum(x => x.Aspects.Count);
            }

            @* The same filter stack every catalogue page carries — search, expansion, complexity,
               elements, tokens, ordering — put in charge of the whole tab: the cards, the
               landscape, the table and the matchup grid below all recompute from what it keeps. *@
            <div class="space-y-3">
                <SearchBox @bind-Value="_spiritFilter.Query" Placeholder="Find a spirit…" Class="sm:w-72"/>
                <FilterBar Filter="_spiritFilter" OwnedExpansions="OwnedExpansions"
                           PresentExpansions="_spiritFilter.ExpansionsIn(playedSpirits)"
                           ShowingCount="spiritRows.Count" TotalCount="_stats.SpiritStatistics.Count"
                           UntestedHint="@Copy.UntriedOnStatsTab("spirits", "taken")"
                           Changed="OnSpiritFilterChanged">
                    <Facets Context="bar">
                        <SpiritFacets Filter="_spiritFilter" Bar="bar"/>
                    </Facets>
                </FilterBar>
            </div>

            @if (spiritRows.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    @if (topSpirit is not null) { @SpiritInsight("Most played", topSpirit, Copy.Count(topSpirit.GamesPlayed, "game")) }
                    @if (bestRateSpirit is not null) { @SpiritInsight("Highest win rate", bestRateSpirit, $"{bestRateSpirit.WinRate:F0}%", WinTone.ForRate(bestRateSpirit.WinRate)) }
                    @if (bestScoreSpirit is not null) { @SpiritInsight("Highest score", bestScoreSpirit, $"{bestScoreSpirit.BestScore} pts") }
                </div>
            }

            <div class="panel panel-chart">
                <SectionHead Title="The spirit landscape"
                             Note="played (→) × win rate (↑) · initials on every dot, full name on hover · hollow = fewer than 3 finished games · tap a dot for its sheet"/>
                <SpiritLandscapeChart Spirits="spiritRows" OnPick="OpenSpirit"/>
            </div>

            <div class="surface">
                <SectionHead Surface="true" Title="All spirits"
                             Note="Click a column to sort · tap a row for the record sheet, a count for those games"/>
                @* The list scrolls inside the card with the headings pinned, so "where am I" always
                   has an answer — thirty-seven spirits used to be twenty-eight hundred pixels of it. *@
                <div class="table-wrap max-h-[560px] overflow-y-auto">
                    <table class="table table-hover">
                        <thead><tr>
                            @SpiritTh("name", "Spirit")
                            @SpiritTh("games", "Games", right: true)
                            @SpiritTh("wins", "W", right: true, sortName: "wins")
                            @SpiritTh("losses", "L", right: true, sortName: "losses")
                            @SpiritTh("winrate", "Win rate")
                            @SpiritTh("avg", "Avg score", right: true)
                            @SpiritTh("best", "Best", right: true)
                            <th scope="col" class="@StickyTh">Aspects</th>
                            <th scope="col" class="@StickyTh">Terror reached</th>
                        </tr></thead>
                        <tbody>
                        @if (tableRows.Count == 0)
                        {
                            <tr><td colspan="9" class="no-matches">@Copy.NoRecordedMatches("spirits")</td></tr>
                        }
                        @foreach (var s in tableRows)
                        {
                            var spirit = GameLookups.SpiritFor(s.SpiritId);
                            var detail = GameLookups.DetailFor(spirit);
                            var color = GameLookups.SpiritColor(detail);
                            var playedAspects = PlayedAspects(s);
                            var aspectsOpen = _openAspectRows.Contains(s.SpiritId);
                            <tr @key="s.SpiritId" @onclick="() => OpenSpirit(s.SpiritId)">
                                <td>
                                    <div class="flex items-center gap-3 min-w-0">
                                        <ColorBar Color="@color"/>
                                        <div class="min-w-0">
                                            <RowNameButton Name="@(spirit?.Name ?? s.SpiritId)" OnClick="() => OpenSpirit(s.SpiritId)"/>
                                            @if (detail is not null) { <div class="row-sub truncate">@detail.PlayStyle</div> }
                                        </div>
                                    </div>
                                </td>
                                @GamesCountCell(s.GamesPlayed, GamesLink.ForSpirit(s.SpiritId, who: ScopeWho),
                                                ScopedTitle($"Every game played as {spirit?.Name ?? s.SpiritId}"))
                                @RecordCells(s.Wins, s.Losses, s.WinRate)
                                @AverageScoreCell(s.AverageScore, s.Wins + s.Losses)
                                @FigureCell(s.BestScore?.ToString())
                                <td>
                                    @* Which variants the plays were, folded behind a count: the chips
                                       were what stretched rows to double height, and an aspect is a
                                       question you ask about one spirit, not all thirty-seven at once. *@
                                    @if (playedAspects.Count > 0)
                                    {
                                        <button type="button" @onclick="() => ToggleAspectRow(s.SpiritId)" @onclick:stopPropagation
                                                aria-expanded="@Aria.Flag(aspectsOpen)"
                                                title="@($"{(aspectsOpen ? "Hide" : "Show")} the record per variant")"
                                                class="chip chip-neutral chip-door whitespace-nowrap">
                                            @Copy.Count(playedAspects.Count, "aspect")
                                            <Chevron Open="aspectsOpen" Class="w-3 h-3"/>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="no-figure text-xs">—</span>
                                    }
                                </td>
                                <td><TerrorBar Counts="s.TerrorCounts"/></td>
                            </tr>
                            @if (aspectsOpen && playedAspects.Count > 0)
                            {
                                <tr @key="@($"{s.SpiritId}:aspects")" class="cursor-default!">
                                    <td colspan="9" class="bg-accent-50/40">
                                        <div class="flex flex-wrap items-center gap-2 pl-7">
                                            <span class="shrink-0 micro-label">Variants played</span>
                                            <AspectChips Aspects="playedAspects" Records="AspectRecordsOf(s)"/>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (ScopedFacts.Count > 0)
            {
                <div class="surface">
                    <SectionHead Surface="true" Title="Matchups"
                                 Note="Win rate against each adversary · follows the filter above"/>
                    <MatchupHeatmap Facts="ScopedFacts" SpiritIds="heatmapIds"
                                    SeatFilter="ScopeSeatFilter" ScopeWho="@ScopeWho"
                                    OnPickSpirit="OpenSpirit"/>
                </div>
            }

            <CoveragePanel Title="Spirits" Total="ownedSpirits.Count" Missing="missingSpirits" ItemTemplate="SpiritPill"
                           Note="@StatsCoverage.OutsideCollectionNote(playedSpiritIds, ownedSpirits.Select(s => s.Id.Value), "spirit")"/>

            @* Aspects are counted the way adversary levels are: one entry per variant, grouped
               under the spirit it varies, because an aspect is a different spirit to play. *@
            @if (totalAspects > 0)
            {
                <CoveragePanel Title="Aspects"
                               Total="totalAspects"
                               Missing="missingAspectGroups"
                               MissingCount="missingAspects.Count"
                               ItemTemplate="AspectGroupPill"/>
            }
        </div>;

    // --- The tab's filter, and the table's own orderings on top of it. ---

    /// Opens ordered by play count, the order the old fixed table had.
    private readonly SpiritFilter _spiritFilter = new(FilterState.ByPlayed.Key);

    /// The stats-only column the table is sorted by, when a header click has taken over
    /// from the filter's ordering; null while the filter's own order stands.
    private string? _spiritSortKey;
    private bool _spiritSortDesc;

    /// The filter order the local sort was layered over — epoch included, so re-picking the
    /// very same order in the panel still reads as a new ask. Null until anything is layered.
    private (string Key, bool Desc, int Epoch)? _lastSpiritSort;

    private (string Key, bool Desc, int Epoch) CurrentFilterSort =>
        (_spiritFilter.SortKey, _spiritFilter.Descending, _spiritFilter.SortEpoch);

    /// Spirits whose per-variant records are unfolded under their row.
    private readonly HashSet<string> _openAspectRows = [];

    private void ToggleAspectRow(string spiritId)
    {
        if (!_openAspectRows.Add(spiritId)) _openAspectRows.Remove(spiritId);
    }

    /// <summary>The played spirits the filter keeps, in the filter's order.</summary>
    private List<SpiritStats> FilteredSpiritStats()
    {
        var stats = _stats?.SpiritStatistics ?? [];
        var known = stats.Select(s => GameLookups.SpiritFor(s.SpiritId)).OfType<Spirit>();
        return NarrowStats(stats, s => s.SpiritId, _spiritFilter.Apply(known), sp => sp.Id.Value,
            narrowed: _spiritFilter.Narrows);
    }

    /// <summary>
    /// The table's own orderings — the columns the shared filter has no word for. Rows with
    /// nothing to compare (no finished game, no score) sit at the end whichever way round the
    /// rest is, the same rule the filter's win-rate ordering follows.
    /// </summary>
    private List<SpiritStats> SortedSpiritRows(List<SpiritStats> rows)
    {
        if (_spiritSortKey is null) return rows;
        Func<SpiritStats, double> key = _spiritSortKey switch
        {
            "wins" => s => s.Wins,
            "losses" => s => s.Losses,
            "avg" => s => s.AverageScore,
            _ => s => s.BestScore ?? 0,
        };
        Func<SpiritStats, bool> blank = _spiritSortKey switch
        {
            "avg" => s => s.Wins + s.Losses == 0,
            "best" => s => s.BestScore is null,
            _ => _ => false,
        };
        var ordered = rows.OrderBy(blank);
        return (_spiritSortDesc ? ordered.ThenByDescending(key) : ordered.ThenBy(key))
            .ThenByDescending(s => s.GamesPlayed)
            .ToList();
    }

    /// <summary>
    /// A header click. Three of the columns are orderings the shared filter already owns —
    /// those clicks move the filter itself, so its "sorted by" badge and the header arrow can
    /// never disagree; the stats-only columns sort locally on top.
    /// </summary>
    private void SortSpiritTable(string key)
    {
        var filterKey = FilterSortKeyFor(key);
        if (filterKey is not null)
        {
            // Toggle only when this column's order is the one actually on show. While a local
            // sort has taken over, the filter's direction is stale — the click is asking for
            // this ordering afresh, from its natural end.
            if (_spiritSortKey is null && _spiritFilter.SortKey == filterKey)
                _spiritFilter.Descending = !_spiritFilter.Descending;
            else
                _spiritFilter.SetSort(filterKey);
            _spiritSortKey = null;
        }
        else if (_spiritSortKey == key)
        {
            _spiritSortDesc = !_spiritSortDesc;
        }
        else
        {
            _spiritSortKey = key;
            _spiritSortDesc = true;
        }
        _lastSpiritSort = CurrentFilterSort;
    }

    /// A sort picked in the filter panel takes back over from any header click — even the
    /// order already on the pills, which the epoch tells apart from a facet or query change.
    private void OnSpiritFilterChanged()
    {
        var now = CurrentFilterSort;
        if (now == _lastSpiritSort) return;
        _spiritSortKey = null;
        _lastSpiritSort = now;
    }

    /// Which header wears the arrow — the local override when set, else the filter's own order.
    private (bool Active, bool Desc) SpiritSortState(string key)
    {
        if (_spiritSortKey is not null) return (key == _spiritSortKey, _spiritSortDesc);
        return (FilterSortKeyFor(key) == _spiritFilter.SortKey, _spiritFilter.Descending);
    }

    /// <summary>
    /// The filter's own ordering behind a table column, or null for a column only the table can
    /// sort by. Spelled with the filter's keys rather than by hand, as the filters' defaults are
    /// — a key that matches nothing silently falls back rather than failing.
    /// </summary>
    private static string? FilterSortKeyFor(string column) => column switch
    {
        "games"   => FilterState.ByPlayed.Key,
        "name"    => FilterState.ByName.Key,
        "winrate" => FilterState.ByWinRate.Key,
        _         => null,
    };

    /// <summary>
    /// A heading of the spirits table. The card scrolls its own body, so every heading — sortable
    /// or not — has to stay pinned to the top of it; the two that carry no sort were spelling the
    /// same three utilities out beside this one.
    /// </summary>
    private const string StickyTh = "sticky top-0 z-10 bg-ink-50";

    /// <summary>A sortable column heading. Sticky like its unsortable neighbours, so the header
    /// row survives the card's own scroll. <paramref name="sortName"/> is what the tooltip calls
    /// the column where its label is an initial — "Sort by wins", not "Sort by w".</summary>
    private RenderFragment SpiritTh(string key, string label, bool right = false, string? sortName = null) =>
        @<text>
            @{ var (active, desc) = SpiritSortState(key); }
            <th scope="col" class="@StickyTh @(right ? "text-right" : null)"
                aria-sort="@(active ? (desc ? "descending" : "ascending") : "none")">
                <button type="button" @onclick="() => SortSpiritTable(key)" title="@($"Sort by {sortName ?? label.ToLowerInvariant()}")"
                        class="inline-flex items-center gap-1 rounded focus-ring
                               @(right ? "w-full justify-end" : null) @(active ? "text-accent-700" : "hover:text-ink-700")">
                    @label
                    @if (active)
                    {
                        <span aria-hidden="true" class="text-[9px]">@(desc ? "▼" : "▲")</span>
                    }
                </button>
            </th>
        </text>;

    private RenderFragment<StatsCoverage.MissingAspectGroup> AspectGroupPill => entry =>
        @<MissingPill Label="@entry.SpiritName" Detail="@string.Join(", ", entry.AspectNames)"
                     OnClick="() => OpenSpirit(entry.SpiritId)">
            <Glyph>@SpiritSwatch(GameLookups.SpiritFor(entry.SpiritId))</Glyph>
        </MissingPill>;

    private RenderFragment<Spirit> SpiritPill => spirit =>
        @<MissingPill Label="@spirit.Name"
                     OnClick="() => _spiritModal.Show(spirit)">
            <Glyph>@SpiritSwatch(spirit)</Glyph>
        </MissingPill>;

    /// <summary>A spirit at pill size: its catalogue colour, or the neutral swatch without one.</summary>
    private static RenderFragment SpiritSwatch(Spirit? spirit) =>
        @<ColorDot Color="@GameLookups.SpiritColor(spirit)"/>;

    private RenderFragment SpiritInsight(string title, SpiritStats s, string metric, string? metricColor = null) =>
        @<text>
            @{
                var sp = GameLookups.SpiritFor(s.SpiritId);
                var color = GameLookups.SpiritAccent(sp);
            }
            <InsightCard Title="@title"
                         Subject="@(sp?.Name ?? s.SpiritId)"
                         Secondary="@($"{Copy.Count(s.GamesPlayed, "game")} · {s.AverageScore:F0} avg")"
                         Metric="@metric"
                         MetricColorClass="@metricColor"
                         AccentColor="@color"
                         OnClick="() => OpenSpirit(s.SpiritId)"/>
        </text>;
}

@* ============================== ADVERSARIES TAB ============================== *@
@code {
    private RenderFragment AdversariesTab() =>
        @<div class="space-y-6">
            @{
                var advRows = FilteredAdversaryStats();
                var playedAdversaries = _stats!.AdversaryStatistics
                    .Select(a => GameLookups.AdversaryFor(a.AdversaryId)).OfType<Adversary>().ToList();
                var topAdv = advRows.OrderByDescending(a => a.GamesPlayed).FirstOrDefault();
                var bestAdv = BestRated(advRows);
                var worstAdv = BestRated(advRows, worst: true);
                var ownedAdversaries = OwnedCatalogue.Adversaries(OwnedExpansions);
                // The same walk the dashboard's coverage bar makes — see LevelCoverage.
                var levelCoverage = LevelCoverage.Of(_stats.AdversaryStatistics, ownedAdversaries);
                var missingLevels = levelCoverage.Missing;
                var missingGroups = StatsCoverage.GroupLevels(missingLevels);
                var totalLevels = levelCoverage.Total;
            }

            @* The same bar the spirits tab carries, asking only what a foe can answer —
               expansion, recorded play, ordering. Everything below follows it. The name search
               above it is the reference page's too: the filter has always narrowed by name, and
               this was the one tab with no way to say so. *@
            <div class="space-y-3">
                <SearchBox @bind-Value="_advFilter.Query" Placeholder="Find an adversary…" Class="sm:w-72"/>
                <FilterBar Filter="_advFilter" OwnedExpansions="OwnedExpansions"
                           PresentExpansions="_advFilter.ExpansionsIn(playedAdversaries)"
                           ShowingCount="advRows.Count" TotalCount="_stats.AdversaryStatistics.Count"
                           UntestedLabel="Never faced"
                           UntestedHint="@Copy.UntriedOnStatsTab("foes", "met", "faced")"
                           Changed="StateHasChanged"/>
            </div>

            @if (advRows.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    @if (topAdv is not null) { @AdversaryInsight("Most played", topAdv, Copy.Count(topAdv.GamesPlayed, "game")) }
                    @if (bestAdv is not null) { @AdversaryInsight("Highest win rate", bestAdv, $"{bestAdv.WinRate:F0}%", WinTone.ForRate(bestAdv.WinRate)) }
                    @if (worstAdv is not null && worstAdv.AdversaryId != bestAdv?.AdversaryId) { @AdversaryInsight("Toughest", worstAdv, $"{worstAdv.WinRate:F0}%", WinTone.ForRate(worstAdv.WinRate)) }
                </div>
            }

            <div>
                <SectionHead Title="Every foe faced"
                             Note="Tap a card for its sheet, a level to open it focused on that level"/>

                @if (advRows.Count == 0)
                {
                    <div class="surface no-matches">@Copy.NoRecordedMatches("adversaries", "faced")</div>
                }
                else
                {
                    <div class="grid sm:grid-cols-2 gap-4">
                        @foreach (var a in advRows)
                        {
                            var adv = GameLookups.AdversaryFor(a.AdversaryId);
                            var name = adv?.Name ?? a.AdversaryId;
                            @* The card opens the foe's record sheet, as the catalogue cards do — but
                               the counts on it are their own links into the games list, which is where
                               "a lot of England games" turns into the games themselves. A button cannot
                               contain a link, so CardOverlay raises the links above the disclosure. *@
                            <div @key="a.AdversaryId" class="surface card-lift relative px-5 py-4">
                                <CardOverlay Label="@Copy.SheetTooltip(name)"
                                             OnOpen="() => OpenAdversary(a.AdversaryId)">
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="min-w-0">
                                            <div class="card-title truncate">@name</div>
                                            <div class="row-sub mt-0.5 tabular-nums">
                                                @* The count is the way into those games, in the same
                                                   dotted-rule idiom the tables use (.linked-count) —
                                                   at the card's own smaller, greyer tone. *@
                                                <a href="@GamesLink.ForAdversary(a.AdversaryId, who: ScopeWho)"
                                                   title="@ScopedTitle($"Every game against {name}")"
                                                   class="linked-count pointer-events-auto font-medium text-ink-600 focus-ring">
                                                    @Copy.Count(a.GamesPlayed, "game")
                                                </a> ·
                                                <WinLossTally Wins="a.Wins" Losses="a.Losses"/> ·
                                                avg L@(a.AverageLevel.ToString("F1"))
                                            </div>
                                        </div>
                                        <WinRateRing Pct="a.WinRate" Size="56"/>
                                    </div>
                                    @* The same strip the reference card and the record sheet draw
                                       (AdversaryLevelGrid): the level, what it adds to the difficulty,
                                       and the record at it — a tap opens the sheet focused on that
                                       level, where the way to those games is the profile's own link.
                                       Only for a foe still in the catalogue; one played from a box
                                       since removed has levels but nothing to say about them. *@
                                    @if (adv is not null)
                                    {
                                        <AdversaryLevelGrid Adversary="adv" Records="LevelRecords(a)"
                                                            OnPick="level => OpenAdversary(a.AdversaryId, level)"
                                                            TapHint="Opens the record sheet focused on this level."
                                                            RaiseAboveOverlay="true"/>
                                    }
                                </CardOverlay>
                            </div>
                        }
                    </div>
                }
            </div>

            <CoveragePanel Title="Adversary levels"
                           Total="totalLevels"
                           Missing="missingGroups"
                           MissingCount="missingLevels.Count"
                           ItemTemplate="AdversaryLevelGroupPill"
                           Note="@StatsCoverage.OutsideCollectionNote(
                                     _stats.AdversaryStatistics.Select(a => a.AdversaryId),
                                     ownedAdversaries.Select(a => a.Id.Value),
                                     "adversary")"/>
        </div>;

    /// Foes have no facets of their own — expansion, recorded play and ordering is the whole ask.
    private readonly CatalogueFilter<Adversary> _advFilter =
        new(a => a.Id.Value, a => a.Name, a => a.ExpansionId, defaultSortKey: FilterState.ByPlayed.Key);

    /// <summary>The faced adversaries the filter keeps, in the filter's order.</summary>
    private List<AdversaryStats> FilteredAdversaryStats()
    {
        var stats = _stats?.AdversaryStatistics ?? [];
        var known = stats.Select(a => GameLookups.AdversaryFor(a.AdversaryId)).OfType<Adversary>();
        return NarrowStats(stats, a => a.AdversaryId, _advFilter.Apply(known), a => a.Id.Value,
            narrowed: _advFilter.Narrows);
    }

    /// <summary>
    /// The server's per-level tally in the shape the shared level strip reads — the same
    /// projection AspectRecordsOf does for the aspect chips.
    /// </summary>
    private static IReadOnlyDictionary<int, SetupInsights.PlayRecord> LevelRecords(AdversaryStats a) =>
        SetupInsights.PlayRecordsBy(a.Levels, l => l.Level);

    private RenderFragment<StatsCoverage.MissingAdversaryGroup> AdversaryLevelGroupPill => entry =>
        @<MissingPill Label="@entry.AdversaryName" Detail="@string.Join(", ", entry.Levels.Select(l => $"L{l}"))"
                     OnClick="() => OpenAdversary(entry.AdversaryId)">
            <Glyph><Icon Name="shield" Class="w-3 h-3 text-amber-600"/></Glyph>
        </MissingPill>;

    private RenderFragment AdversaryInsight(string title, AdversaryStats a, string metric, string? metricColor = null) =>
        @<text>
            @{
                var adv = GameLookups.AdversaryFor(a.AdversaryId);
            }
            <InsightCard Title="@title"
                         Subject="@(adv?.Name ?? a.AdversaryId)"
                         Secondary="@($"avg L{a.AverageLevel:F1}")"
                         Metric="@metric"
                         MetricColorClass="@metricColor"
                         OnClick="() => OpenAdversary(a.AdversaryId)"/>
        </text>;
}

@* ============================== SCENARIOS TAB ============================== *@
@code {
    private RenderFragment ScenariosTab() =>
        @<div class="space-y-6">
            @{
                var scenRows = FilteredScenarioStats();
                var playedScenarios = _stats!.ScenarioStatistics
                    .Select(s => GameLookups.ScenarioFor(s.ScenarioId)).OfType<Scenario>().ToList();
                var topScen = scenRows.OrderByDescending(s => s.GamesPlayed).FirstOrDefault();
                var bestScen = BestRated(scenRows);
                var playedIds = _stats.ScenarioStatistics.Select(s => s.ScenarioId).ToHashSet();
                var ownedScenarios = OwnedCatalogue.Scenarios(OwnedExpansions);
                var missing = ownedScenarios.Where(s => !playedIds.Contains(s.Id.Value)).ToList();
