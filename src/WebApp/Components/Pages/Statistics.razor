@* ============================== TAB FILTERS, SHARED PLUMBING ==============================
   Each catalogue tab runs the same FilterBar the browse pages and pickers use, pointed at the
   played list its stats describe. The filter thinks in catalogue items; the tabs think in stats
   rows — these two are the seam between them. *@
@code {
    /// <summary>
    /// Maps a filtered, ordered catalogue back onto the stats rows it narrows. Rows whose id the
    /// catalogue no longer lists (a spirit played from a box since removed) can't answer the
    /// filter's questions, so they stay visible only while nothing is narrowing — the same rule
    /// <see cref="SpiritFilter"/> applies to a spirit without a catalogue entry.
    /// </summary>
    private static List<TStats> NarrowStats<TStats, TItem>(
        IReadOnlyList<TStats> stats,
        Func<TStats, string> statId,
        IReadOnlyList<TItem> ordered,
        Func<TItem, string> itemId,
        bool narrowed) where TStats : class
    {
        var byId = stats.ToDictionary(statId);
        var rows = ordered
            .Select(item => byId.GetValueOrDefault(itemId(item)))
            .Where(row => row is not null)
            .Select(row => row!)
            .ToList();
        if (!narrowed)
        {
            var seen = rows.Select(statId).ToHashSet();
            rows.AddRange(stats.Where(s => !seen.Contains(statId(s))));
        }
        return rows;
    }

    /// <summary>
    /// Hands each tab's filter the record it orders and sifts by, re-pointed whenever the
    /// numbers change hands — the same reload that moves the page onto another player's games.
    /// </summary>
    private void WireCatalogueFilters()
    {
        if (_stats is null) return;
        _spiritFilter.UseHistory(SetupInsights.PlayRecordsBy(_stats.SpiritStatistics, s => s.SpiritId));
        _advFilter.UseHistory(SetupInsights.PlayRecordsBy(_stats.AdversaryStatistics, a => a.AdversaryId));
        _scenarioFilter.UseHistory(SetupInsights.PlayRecordsBy(_stats.ScenarioStatistics, s => s.ScenarioId));
        _boardFilter.UseHistory(SetupInsights.PlayRecordsBy(_stats.BoardStatistics, b => b.BoardId));
    }
}

@code {
    [CascadingParameter(Name = CurrentUserState.OwnedExpansionsCascade)]
    public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    // The URL holds which tab is open and whose games are counted, and the page writes it back on
    // every change — so a tab can be linked at, shared, and returned to after following a game
    // out of it. Read through StatsLink, the same names everything else links with.

    /// <summary>Opens the page on a named tab. Ignored when it names no tab we have.</summary>
    [SupplyParameterFromQuery(Name = StatsLink.TabKey)]
    public string? TabParam { get; set; }

    /// <summary>Opens the page already scoped to a friend — the People page links this way.
    /// Ignored when that account has never sat in one of your games.</summary>
    [SupplyParameterFromQuery(Name = StatsLink.UserKey)]
    public Guid? ScopeUserParam { get; set; }

    /// <summary>The same, for a local player.</summary>
    [SupplyParameterFromQuery(Name = StatsLink.PlayerKey)]
    public Guid? ScopePlayerParam { get; set; }

    private StatisticsResponse? _stats;
    private List<PlayerStats> _unfilteredPlayers = [];
    private PlayerStats? _scoped;
    private bool _loading = true;
    private bool _scopeOpen;
    private string _tab = StatsLink.Overview;

    // The raw per-game history behind the record sheets and the layout tallies —
    // the same facts the setup screen and the catalogue pages load.
    private IReadOnlyList<SetupGameFact>? _facts;
    private List<IslandLayoutResponse> _savedLayouts = [];
    private Dictionary<string, SetupInsights.PlayRecord> _layoutRecords = [];
    private Dictionary<Guid, SetupInsights.PlayRecord> _savedLayoutRecords = [];

    private SpiritDetailModal _spiritModal = default!;
    private AdversaryDetailModal _adversaryModal = default!;
    private ScenarioDetailModal _scenarioModal = default!;
    private BoardDetailModal _boardModal = default!;
    private IslandLayoutDetailModal _layoutModal = default!;

    private void OpenSpirit(string id) { if (GameLookups.SpiritFor(id) is { } s) _spiritModal.Show(s); }
    private void OpenAdversary(string id, int? level = null) { if (GameLookups.AdversaryFor(id) is { } a) _adversaryModal.Show(a, level); }
    private void OpenScenario(string? id) { if (GameLookups.ScenarioFor(id) is { } s) _scenarioModal.Show(s); }
    private void OpenBoard(string id) { if (GameLookups.BoardFor(id) is { } b) _boardModal.Show(b); }

    /// <summary>Seat predicate for the picked player, so the spirit/board sheets profile their
    /// seats. Rebuilt only when the scope moves (<see cref="ApplyScope"/>), so the components it
    /// is handed can tell "same scope" by reference and keep their own derived work.</summary>
    private Func<SetupFactSeat, bool>? ScopeSeatFilter { get; set; }

    /// <summary>Whose record the sheets are labelled with — null for "you".</summary>
    private string? ScopeSubjectName =>
        _scoped is null || _scoped.Kind == PlayerKind.Me ? null : _scoped.Name;

    /// <summary>
    /// The page scope as a games-list <c>who</c> key, put on every slice this page links at so a
    /// count and the list it opens are the same games. Null while the page is global.
    /// </summary>
    private string? ScopeWho =>
        _scoped is null ? null : GamesFilter.WhoKey(_scoped.UserId, _scoped.PlayerId);

    /// <summary>
    /// A link's tooltip, narrowed the way <see cref="ScopeWho"/> narrows the link itself — while
    /// the page is somebody's, "every game" is not the promise these links keep.
    /// </summary>
    private string ScopedTitle(string title) =>
        _scoped is null ? title : $"{title} — {_scoped.Name}'s games only";

    /// <summary>The history narrowed to the page scope: games the picked player sat in. Held
    /// rather than filtered per access — the tab fragments read it on every render, and its
    /// stable reference is what lets the matchup grid skip re-tallying an unchanged history.</summary>
    private IReadOnlyList<SetupGameFact> ScopedFacts { get; set; } = [];

    /// <summary>
    /// Everything derived from "whose games": the seat predicate, the narrowed history, and the
    /// layout tallies that follow the page scope the way the server-side stats do. Runs when the
    /// scope or the facts move — never per render.
    /// </summary>
    private void ApplyScope()
    {
        ScopeSeatFilter = _scoped switch
        {
            null => null,
            { UserId: { } u } => s => s.UserId == u,
            { PlayerId: { } p } => s => s.PlayerId == p,
            _ => null,
        };
        ScopedFacts = _facts is null ? []
            : ScopeSeatFilter is { } filter ? _facts.Where(g => g.Seats.Any(filter)).ToList()
            : _facts;
        _layoutRecords = SetupInsights.LayoutRecords(ScopedFacts);
        _savedLayoutRecords = SetupInsights.SavedLayoutRecords(ScopedFacts);
    }

    /// <summary>A tab's address — the scope rides along, so a friend's numbers stay a friend's
    /// numbers while the reader moves between sections.</summary>
    private string TabHref(string key) => StatsLink.For(key, _scoped?.UserId, _scoped?.PlayerId);

    /// <summary>A tab's tooltip. Whose games it will count, while the page is somebody's — the
    /// label alone would promise the whole account's.</summary>
    private string TabTitle(string key, string label) =>
        _scoped is null ? label : $"{label} — {_scoped.Name}'s games";

    /// <summary>Played-entity count shown on the tab pill; null for tabs that aren't a list.</summary>
    private int? TabCount(string key) => key switch
    {
        StatsLink.Players     => _unfilteredPlayers.Count > 1 ? _unfilteredPlayers.Count : null,
        StatsLink.Spirits     => _stats?.SpiritStatistics.Count,
        StatsLink.Adversaries => _stats?.AdversaryStatistics.Count,
        StatsLink.Scenarios   => _stats?.ScenarioStatistics.Count,
        StatsLink.Boards      => _stats?.BoardStatistics.Count,
        _                     => null,
    };

    /// <summary>
    /// Moves the page by writing the URL rather than by setting a field — the parameters coming
    /// back are what actually moves it, so there is one path in whether the change came from
    /// this page, a link elsewhere, or the browser's Back button. Replacing rather than pushing:
    /// changing whose numbers these are is reading one page, and Back should leave it rather than
    /// walk back through every pick made on the way. (The tabs are plain links and push, which
    /// is what makes Back undo a tab.)
    /// </summary>
    private void Go(string tab, PlayerStats? scope) =>
        Nav.NavigateTo(StatsLink.For(tab, scope?.UserId, scope?.PlayerId), forceLoad: false, replace: true);

    /// Whether the one-off loads (the player tally, the raw facts) have happened — the scope
    /// below is resolved against that tally, so it cannot be applied before it exists.
    private bool _loaded;

    /// The scope the numbers currently on the page were loaded for.
    private (Guid? User, Guid? Player)? _appliedScope;

    protected override async Task OnParametersSetAsync()
    {
        _tab = StatsLink.IsTab(TabParam) ? TabParam! : StatsLink.Overview;

        if (!_loaded) return;

        var wanted = (ScopeUserParam, ScopePlayerParam);
        if (_appliedScope == wanted) return;
        _appliedScope = wanted;

        // A scope naming somebody who has never sat in one of your games resolves to nobody, and
        // the page stays global rather than showing an empty record for a stranger.
        var scoped = ScopeUserParam is { } user ? _unfilteredPlayers.FirstOrDefault(p => p.UserId == user)
            : ScopePlayerParam is { } local ? _unfilteredPlayers.FirstOrDefault(p => p.PlayerId == local)
            : null;
        if (SameScope(scoped, _scoped)) return;

        _scoped = scoped;
        _loading = true;
        StateHasChanged();
        await LoadStats(scoped?.UserId, scoped?.PlayerId);
        ApplyScope();
        _loading = false;
    }

    /// The shared summary line, prefixed with whose it is when the page is scoped.
    private string HeaderSummary
    {
        get
        {
            if (_stats is null || _stats.TotalGames == 0)
                return "Your game history, distilled.";
            var line = StatsFormat.Summary(_stats);
            return _scoped is null ? line : $"{_scoped.Name} · {line}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Without a user there is nothing to load — drop the spinner rather than spin forever.
        if (CurrentUser.UserId is not { } userId)
        {
            _loading = false;
            return;
        }

        // Sequential sends — the scoped DbContext behind IMediator is not thread-safe.
        await LoadStats(scopeUserId: null, scopePlayerId: null);
        _unfilteredPlayers = _stats?.PlayerStatistics ?? [];

        var facts = await Mediator.Send(new GetSetupFactsQuery(userId));
        if (facts.IsSuccess) _facts = facts.Value;
        var layouts = await Mediator.Send(new ListIslandLayoutsQuery(userId));
        if (layouts.IsSuccess) _savedLayouts = layouts.Value;
        ApplyScope();

        // Arriving scoped at somebody (from a People card, say) is the URL's business, not this
        // method's — OnParametersSetAsync applies it once the tally above exists to resolve it
        // against, by the same path a pick from the dropdown takes.
        _loaded = true;
        _loading = false;
    }

    private async Task LoadStats(Guid? scopeUserId, Guid? scopePlayerId)
    {
        if (CurrentUser.UserId is not { } userId) return;
        var query = new GetStatisticsQuery(userId, scopeUserId, scopePlayerId);
        var result = await Mediator.Send(query);
        if (result.IsSuccess)
        {
            _stats = result.Value;
            WireCatalogueFilters();
        }
    }

    private void ToggleScopePicker() => _scopeOpen = !_scopeOpen;

    /// <summary>
    /// Picks whose games the page counts. Only writes the URL — the reload happens in
    /// OnParametersSetAsync, so a pick here and a link in from the People page take one path.
    /// The tab is carried over: changing whose numbers these are is not a reason to stop
    /// reading about spirits.
    /// </summary>
    private void SetScope(PlayerStats? player)
    {
        _scopeOpen = false;
        if (SameScope(player, _scoped)) return;
        Go(_tab, player);
    }

    /// <summary>Whether two picks name the same person — by identity, not by the tally row.</summary>
    private static bool SameScope(PlayerStats? a, PlayerStats? b) =>
        (a, b) switch
        {
            (null, null) => true,
            (null, _) or (_, null) => false,
            _ => a.UserId == b.UserId && a.PlayerId == b.PlayerId,
        };

    /// <summary>The spirit's per-aspect tally in the shape the shared chips read.</summary>
    private static IReadOnlyDictionary<string, SetupInsights.PlayRecord> AspectRecordsOf(SpiritStats s) =>
        SetupInsights.PlayRecordsBy(s.Aspects, a => a.AspectId ?? SetupInsights.BaseAspectKey);

    /// <summary>
    /// Only the aspects actually played. The table is a record, not a catalogue — listing the
    /// variants never taken would widen every row of a spirit like Shadows to say nothing.
    /// </summary>
    private IReadOnlyList<Aspect> PlayedAspects(SpiritStats s)
    {
        var played = s.Aspects.Where(a => a.AspectId is not null).Select(a => a.AspectId!).ToHashSet();
        if (played.Count == 0) return [];
        return GameData.Aspects.Where(a => played.Contains(a.Id.Value)).ToList();
    }

}
