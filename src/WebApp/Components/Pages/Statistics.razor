                    </div>
                    <div class="table-wrap">
                        <table class="table table-hover">
                            <thead><tr><th>Scenario</th><th class="text-right">Games</th><th class="text-right">W</th><th class="text-right">L</th><th>Win rate</th><th class="text-right">Avg score</th></tr></thead>
                            <tbody>
                            @foreach (var s in _stats.ScenarioStatistics)
                            {
                                var sc = GameLookups.ScenarioFor(s.ScenarioId);
                                <tr @onclick="() => OpenScenario(s.ScenarioId)">
                                    <td>
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-accent-50 text-accent-700 shrink-0"><Icon Name="book" Class="w-3.5 h-3.5"/></span>
                                            <button type="button" @onclick="() => OpenScenario(s.ScenarioId)" @onclick:stopPropagation
                                                    class="truncate rounded text-left text-sm font-semibold text-ink-900
                                                           focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                                @(sc?.Name ?? s.ScenarioId)
                                            </button>
                                        </div>
                                    </td>
                                    @GamesCountCell(s.GamesPlayed, GamesLink.ForScenario(s.ScenarioId, who: ScopeWho),
                                                    ScopedTitle($"Every game in {sc?.Name ?? s.ScenarioId}"))
                                    <td class="text-right text-accent-700 tabular-nums">@s.Wins</td>
                                    <td class="text-right text-red-600 tabular-nums">@s.Losses</td>
                                    <td>
                                        @if (s.Wins + s.Losses > 0) { <WinRateBar Pct="s.WinRate"/> }
                                        else { <span class="text-xs text-ink-400">—</span> }
                                    </td>
                                    <td class="text-right tabular-nums">@(s.Wins + s.Losses > 0 ? $"{s.AverageScore:F0}" : "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
