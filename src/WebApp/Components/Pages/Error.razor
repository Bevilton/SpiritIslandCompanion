@page "/Error"
@* Static on purpose: HttpContext (for the request id) only exists during static rendering,
   and after an unhandled error a working circuit is the last thing to rely on. *@
@attribute [ExcludeFromInteractiveRouting]
@* PublicLayout rather than the router's default. AppShell loads the account's context from the
   database on init, which is precisely what may have just failed — an error page that re-runs the
   failing query answers a 500 with a 500. PublicShell touches nothing but the auth cookie, and it
   is also the chrome that works whether or not anyone is signed in. *@
@layout PublicLayout
@using System.Diagnostics

<AppPageTitle Title="Something went wrong"/>

@* Not EmptyState: that says "nothing here yet" in jade and offers the way to fill it, which is
   the opposite of what has happened. Same shape, so the two still read as one family. *@
<div class="public-page">
    <div class="surface mx-auto max-w-xl px-6 py-16 text-center">
        <IconChip Name="alert" Size="3xl" Tone="bg-red-100 text-red-700" Class="mb-4"/>
        <h1 class="dialog-title-xl">Something went wrong</h1>
        <p class="body-note mx-auto mt-2 max-w-sm">
            The page couldn't be loaded. Nothing you had recorded is lost — try again, and if it
            keeps happening the reference below identifies this particular failure.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <a href="@AppRoutes.Home" class="btn btn-primary">
                <Icon Name="arrow-left" Class="w-4 h-4"/> Back to safety
            </a>
        </div>

        @if (RequestId is { Length: > 0 } id)
        {
            <p class="mt-6 text-xs text-ink-400">
                Reference <code class="rounded bg-ink-100 px-1.5 py-0.5 font-mono text-ink-600">@id</code>
            </p>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// What identifies this failure in the logs. Activity.Current is the distributed trace when
    /// one is running (see ServiceDefaults); TraceIdentifier is the per-request fallback.
    /// </summary>
    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
