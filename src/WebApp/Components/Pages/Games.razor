@page "/app/games"
@attribute [Authorize]
@using Application.Features.Games
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Games</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Match history</span>
        <h1 class="page-title mt-2">Games</h1>
        <p class="page-sub">@HeaderSummary</p>
    </div>
    <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
        <input type="search" class="input w-full sm:w-64" placeholder="Search games…" aria-label="Search games"
               @bind="_filter.Query" @bind:event="oninput"/>
        <a href="/app/games/new" class="btn btn-primary shrink-0">
            <Icon Name="plus" Class="w-4 h-4"/> New game
        </a>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner/>
}
else if (_games.Count == 0)
{
    <div class="surface px-6 py-16 text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-accent-700">
            <Icon Name="trophy" Class="w-6 h-6"/>
        </div>
        <h2 class="text-lg font-semibold text-ink-900" style="font-family: var(--font-serif);">No games yet</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-500">
            Set up your first island and the record starts here — victories, defeats and drafts alike.
        </p>
        <a href="/app/games/new" class="btn btn-primary mt-5">
            <Icon Name="plus" Class="w-4 h-4"/> Record your first game
        </a>
    </div>
}
else
{
    var facets = ActiveFacets;
    var inSlice = FacetFiltered;

    @* What the list is currently narrowed to, spelled out and undoable one pill at a time. It
       leads the page because a slice is often arrived at by link — from an adversary's level
       grid, a spirit's row, a record sheet — and a list that has quietly dropped most of the
       history has to say so, and has to be wideable again without starting over. *@
    @if (facets.Count > 0)
    {
        <div class="mb-3 flex flex-wrap items-center gap-1.5">
            <span class="mr-0.5 text-[11px] uppercase tracking-wide text-ink-500">Showing</span>
            @foreach (var facet in facets)
            {
                <button type="button" @onclick="() => RemoveFacet(facet)"
                        title="@($"{facet.Group}: {facet.Label} — remove this filter")"
                        class="inline-flex items-center gap-1.5 rounded-full border border-accent-300 bg-accent-100 px-2.5 py-1
                               text-xs font-medium text-accent-800 transition-colors hover:bg-accent-200
                               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                    @facet.Label
                    <Icon Name="x" Class="w-3 h-3 opacity-60"/>
                </button>
            }
            @if (facets.Count > 1)
            {
                <button type="button" @onclick="ClearFacets"
                        class="ml-0.5 rounded px-1 text-[11px] text-accent-700 hover:underline
                               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                    Clear all
                </button>
            }
        </div>
    }

    @* The first question of the page — which slice — stays out in the open; everything finer
       lives in the filter bar below, the same shell the catalogue pages use.

       The tallies are over the games the filters above already allow, not the whole history:
       on a list narrowed to one foe, "38 victories" would be counting games the page is
       refusing to show. *@
    <div class="mb-3 flex flex-wrap items-center gap-2">
        <FilterPill Active="@(_filter.Status == GameStatusTab.All)" OnToggle="() => SetStatus(GameStatusTab.All)">
            All <span class="tabular-nums opacity-60">@inSlice.Count</span>
        </FilterPill>
        <FilterPill Active="@(_filter.Status == GameStatusTab.Victories)" OnToggle="() => SetStatus(GameStatusTab.Victories)">
            Victories <span class="tabular-nums opacity-60">@inSlice.Count(g => g.Win == true)</span>
        </FilterPill>
        <FilterPill Active="@(_filter.Status == GameStatusTab.Defeats)" OnToggle="() => SetStatus(GameStatusTab.Defeats)">
            Defeats <span class="tabular-nums opacity-60">@inSlice.Count(g => g.Win == false)</span>
        </FilterPill>
        <FilterPill Active="@(_filter.Status == GameStatusTab.Drafts)" OnToggle="() => SetStatus(GameStatusTab.Drafts)">
            Drafts <span class="tabular-nums opacity-60">@inSlice.Count(g => !g.IsCompleted)</span>
        </FilterPill>
    </div>

    <FilterBar @ref="_bar" Filter="_filter"
               ShowingCount="Visible.Count" TotalCount="_games.Count"
               Changed="FilterChanged">
        <Facets>
            @if (_bar is not null)
            {
                <GameFacets Filter="_filter" Bar="_bar" Games="_games"/>
            }
        </Facets>
    </FilterBar>

    @if (Visible.Count == 0)
    {
        <div class="surface mt-6 py-10 text-center text-ink-500">
            <p class="text-sm">No games match the current filters.</p>
            <button type="button" class="btn btn-secondary btn-sm mt-4" @onclick="ResetFilters">Reset filters</button>
        </div>
    }
    else if (_filter.GroupsByMonth)
    {
        @* Month sections only while the list is in date order — cutting a difficulty ordering
           into months would show neither. *@
        @foreach (var month in Visible.GroupBy(g => new { g.StartedAt.Year, g.StartedAt.Month }))
        {
            var games = month.ToList();
            var wins = games.Count(g => g.Win == true);
            var losses = games.Count(g => g.Win == false);
            <section class="mt-6">
                <div class="mb-2 flex items-baseline justify-between px-1">
                    <h2 class="text-base font-semibold" style="font-family: var(--font-serif);">
                        @games[0].StartedAt.DateTime.ToString("MMMM yyyy")
                    </h2>
                    <span class="text-xs tabular-nums text-ink-500">
                        @games.Count game@(games.Count == 1 ? "" : "s")@if (wins + losses > 0)
                        {
                            <span title="@wins won, @losses lost"> · @wins–@losses</span>
                        }
                    </span>
                </div>
                <div class="surface divide-y divide-ink-100 overflow-hidden">
                    @foreach (var g in games)
                    {
                        @GameRow(g)
                    }
                </div>
            </section>
        }
    }
    else
    {
        <div class="surface mt-6 divide-y divide-ink-100 overflow-hidden">
            @foreach (var g in Visible)
            {
                @GameRow(g)
            }
        </div>
    }
}

@code {
    // Every slice the list can be in, as the router hands it over. The names and the reading of
    // them live in GamesLink, which is also what the statistics page builds its links with — so
    // a link can only ever ask for something the list knows how to be.
    [SupplyParameterFromQuery(Name = GamesLink.AdversaryKey)] public string[]? AdversaryParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.LevelKey)] public int[]? LevelParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.ScenarioKey)] public string[]? ScenarioParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.SpiritKey)] public string[]? SpiritParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.SpiritModeKey)] public string? SpiritModeParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.BoardKey)] public string[]? BoardParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.IslandKey)] public string[]? IslandParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.WhoKey)] public string[]? WhoParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.SizeKey)] public int[]? SizeParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.DifficultyKey)] public string[]? DifficultyParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.StatusKey)] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.SortKey)] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = GamesLink.DirectionKey)] public string? DirectionParam { get; set; }

    private List<ListGamesResponse> _games = [];
    private bool _loading = true;

    private readonly GamesFilter _filter = new();
    private FilterBar? _bar;

    private List<ListGamesResponse> Visible => _filter.Apply(_games);

    /// <summary>Everything the filters allow before the status tab has its say — what the tab
    /// counts are taken over.</summary>
    private List<ListGamesResponse> FacetFiltered => _games.Where(_filter.MatchesFacets).ToList();

    private IReadOnlyList<GamesFilter.ActiveFacet> ActiveFacets => _filter.ActiveFacets(_games);

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is not { } userId) return;
        var result = await Mediator.Send(new ListGamesQuery(userId));
        if (result.IsSuccess) _games = result.Value;
        _loading = false;
    }

    /// <summary>
    /// The URL is the filter. Read straight through on every parameter change — the page writes
    /// itself back out after each edit, so re-reading what it just wrote is a no-op, and the
    /// browser's own Back leaves a slice the way it arrived.
    /// </summary>
    protected override void OnParametersSet() =>
        GamesLink.Read(
            new GamesLink.Params(
                AdversaryParam, LevelParam, ScenarioParam, SpiritParam, SpiritModeParam,
                BoardParam, IslandParam, WhoParam, SizeParam, DifficultyParam,
                StatusParam, SortParam, DirectionParam),
            _filter);

    /// <summary>
    /// Writes the filter into the address bar, replacing rather than pushing: a run of pill
    /// clicks is one act of narrowing, and Back should leave for wherever the slice came from
    /// rather than walk back through every pill on the way in.
    /// </summary>
    private void SyncUrl() => Nav.NavigateTo(GamesLink.For(_filter), forceLoad: false, replace: true);

    private void FilterChanged() => SyncUrl();

    private void SetStatus(GameStatusTab status)
    {
        _filter.Status = status;
        SyncUrl();
    }

    private void RemoveFacet(GamesFilter.ActiveFacet facet)
    {
        facet.Remove();
        SyncUrl();
    }

    private void ClearFacets()
    {
        _filter.Clear();
        SyncUrl();
    }

    private void ResetFilters()
    {
        _filter.Reset();
        SyncUrl();
    }

    /// <summary>
    /// The current slice as a query, carried on every game's link so the game page can offer the
    /// way back to this list rather than to the whole history. Empty on an unnarrowed list, which
    /// keeps a game's URL clean in the ordinary case.
    /// </summary>
    private string BackQuery => GamesLink.Query(_filter);

    private string GameHref(Guid id) => GamesLink.Game(id, BackQuery);

    private string HeaderSummary
    {
        get
        {
            if (_games.Count == 0) return "Every match you've recorded.";
            var completed = _games.Count(g => g.IsCompleted);
            var wins = _games.Count(g => g.Win == true);
            var drafts = _games.Count - completed;
            var parts = new List<string> { $"{_games.Count} match{(_games.Count == 1 ? "" : "es")}" };
            if (completed > 0) parts.Add($"{100.0 * wins / completed:F0}% victories");
            if (drafts > 0) parts.Add($"{drafts} draft{(drafts == 1 ? "" : "s")} waiting");
            return string.Join(" · ", parts);
        }
    }

    private void Open(Guid id) => Nav.NavigateTo(GameHref(id));

    private void Finish(Guid id)
    {
        var href = GameHref(id);
        Nav.NavigateTo(href.Contains('?') ? $"{href}&finish=true" : $"{href}?finish=true");
    }

    private RenderFragment GameRow(ListGamesResponse g) => __builder =>
    {
        var isStandardGame = g.Adversaries.Count == 0 && g.ScenarioId is null;
        var title = GameLookups.MatchTitle(g.Adversaries, g.ScenarioId);
        // The scenario gets its own chip only when the adversaries took the title.
        var scenarioChip = g.Adversaries.Count > 0 ? GameLookups.ScenarioFor(g.ScenarioId) : null;
        // Only a hand-built island is worth a chip — the saved shape's name, or a plain
        // "Custom island" for a one-off arrangement. Published layouts stay unremarkable.
        var islandChip = IslandSetups.IsCustomId(g.IslandSetupId) ? g.CustomLayoutName ?? "Custom island" : null;
        var spiritIds = g.Players.Select(p => p.SpiritId).ToList();

        <div @key="g.Id" @onclick="() => Open(g.Id)"
             class="group flex cursor-pointer items-center gap-3 px-4 py-3.5 transition-colors hover:bg-ink-50/70 md:gap-4 md:px-5">
            @* StartedAt is read back as stored, not converted: it carries the wall clock the
               player wrote down at offset zero (see GameDetail). *@
            @* The title carries the year, which the cell has no room for and month sections
               only show while grouping by date. *@
            <div class="w-11 shrink-0 text-center" title="@g.StartedAt.DateTime.ToString("MMMM d, yyyy")">
                <div class="text-lg font-semibold leading-none tabular-nums text-ink-900" style="font-family: var(--font-serif);">
                    @g.StartedAt.DateTime.ToString("dd")
                </div>
                <div class="mt-0.5 text-[10px] uppercase tracking-wide text-ink-500">@g.StartedAt.DateTime.ToString("MMM")</div>
            </div>

            <div class="min-w-0 flex-1">
                <div class="flex min-w-0 items-center gap-2">
                    @* A real link inside the clickable row, so the game is reachable by keyboard
                       and middle-click too. *@
                    <a href="@GameHref(g.Id)"
                       class="truncate rounded text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40
                              @(isStandardGame ? "font-normal italic text-ink-500" : "font-semibold text-ink-900")">
                        @title
                    </a>
                    @if (scenarioChip is not null)
                    {
                        <span class="hidden shrink-0 items-center gap-1 rounded-full border border-amber-200/70 bg-amber-50 px-2 py-0.5 text-[10px] font-medium text-amber-800 sm:inline-flex">
                            <Icon Name="book" Class="w-3 h-3"/> @scenarioChip.Name
                        </span>
                    }
                    @if (islandChip is not null)
                    {
                        <span class="hidden shrink-0 items-center gap-1 rounded-full border border-sky-200/70 bg-sky-50 px-2 py-0.5 text-[10px] font-medium text-sky-800 sm:inline-flex"
                              title="Played on a hand-built island">
                            <Icon Name="map" Class="w-3 h-3"/> @islandChip
                        </span>
                    }
                </div>
                <div class="mt-1 flex min-w-0 items-center gap-2">
                    <SpiritAvatarStack SpiritIds="spiritIds" Max="4"/>
                    <span class="truncate text-xs text-ink-500">@string.Join(", ", g.Players.Select(p => p.Name))</span>
                </div>
            </div>

            <span class="hidden h-8 min-w-8 shrink-0 items-center justify-center rounded-lg bg-accent-50 px-2 text-sm font-semibold tabular-nums text-accent-800 md:inline-flex"
                  style="font-family: var(--font-serif);" title="Difficulty @g.Difficulty">
                @g.Difficulty
            </span>

            <span class="hidden shrink-0 sm:block"><GameStatusBadge IsCompleted="g.IsCompleted" Win="g.Win"/></span>

            <div class="flex w-20 shrink-0 items-center justify-end">
                @* Only the owner is offered the outcome: on someone else's draft the whole
                   flow would fail at the server, so it must not be held out here. *@
                @if (!g.IsCompleted && g.OwnerId == CurrentUser.UserId)
                {
                    <button type="button" @onclick="() => Finish(g.Id)" @onclick:stopPropagation="true"
                            title="Record the outcome and finish this draft"
                            class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-800 transition-colors hover:bg-amber-100">
                        Finish <Icon Name="arrow-right" Class="w-3 h-3"/>
                    </button>
                }
                else if (!g.IsCompleted)
                {
                    <span class="inline-flex items-center gap-1 text-[11px] text-ink-400"
                          title="Only the player who recorded this game can finish it">
                        <Icon Name="lock" Class="w-3 h-3"/> theirs
                    </span>
                }
                else if (g.Score is { } score)
                {
                    <span class="text-base font-semibold tabular-nums @(g.Win == true ? "text-accent-800" : "text-red-700")"
                          style="font-family: var(--font-serif);" title="Score">@score</span>
                }
                else
                {
                    <span class="text-sm text-ink-400">—</span>
                }
            </div>

            <Icon Name="chevron-right" Class="w-4 h-4 shrink-0 text-ink-300 transition-colors group-hover:text-ink-500"/>
        </div>
    };
}
