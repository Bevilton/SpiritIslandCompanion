@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@* JSInterop stays global: the playground is the one component that scripts the browser, but every
   dialog that moves focus catches its JSDisconnectedException, and a using that three unrelated
   files need is not one file's to carry. *@
@using Microsoft.JSInterop
@using MediatR
@using Application.Abstractions
@* Deliberately NOT here, each imported by its one user instead: ApexCharts (only the two chart
   components draw with it, and its short type names — Mode, Tooltip — are the kind that shadow
   others when global) and the static RenderMode (the render root alone picks one). *@
@* The feature namespaces are imported wholesale rather than per page: their type names are
   unique across the application layer, and spelling them out inline had grown to a hundred
   Application.Features.X.Y references that said nothing a using couldn't. *@
@using Application.Features.Friendships
@using Application.Features.Games
@using Application.Features.Games.Dtos
@using Application.Features.IslandLayouts
@using Application.Features.People
@using Application.Features.PlayerMerges
@using Application.Features.Players
@using Application.Features.Statistics
@using Application.Features.Users
@using Domain.Models.Static
@using Domain.Models.Static.Data
@using Domain.Models.Game
@using Domain.Models.IslandLayout
@* The domain's namespaces are imported as a set for the same reason the feature ones are, and
   the last two were the ones missing from it: Nickname was reached as the whole
   Domain.Models.User.Nickname on both pages that cap a name field, while IslandLayoutName —
   the identical value object one namespace over — was already a bare name, and the merge
   status was a @@using on each of the two files that read it. *@
@using Domain.Models.PlayerMerge
@using Domain.Models.User
@using Domain.Services
@using WebApp
@using WebApp.Auth
@using WebApp.Catalogue
@using WebApp.Components
@using WebApp.Components.Layout
@using WebApp.Components.Shared
@using WebApp.Components.Shared.Games
@using WebApp.Components.Shared.Games.Filtering
@using WebApp.Components.Shared.People
@using WebApp.Components.Shared.Stats
@using WebApp.Components.Shared.Views
@using WebApp.Demo
@using WebApp.State
@using WebApp.Validation
