@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>

    @* The landing page is public and gets shared into Discord and forum threads, where a page with
       no description renders as a bare URL. Set here rather than per page because the app pages
       behind /login are never the thing being linked, and one accurate sentence beats a stale one
       maintained in nineteen places. Deliberately no og:image: crawlers do not render SVG, and the
       island art is the only picture the app has. *@
    <meta name="description" content="Track your Spirit Island games: log matches with spirits, aspects, adversaries and island layouts, then study win rates for your whole group."/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Spirit Island Companion"/>
    <meta property="og:title" content="Spirit Island Companion"/>
    <meta property="og:description" content="Log your games, study your stats, and keep your group's history in one place."/>
    <meta name="twitter:card" content="summary"/>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet"/>

    @* Stamped so a rebuilt stylesheet is never served from a stale browser cache — see
       StaticAssetStamp. *@
    <link rel="stylesheet" href="app.css?v=@StaticAssetStamp.For(Env.WebRootFileProvider, "app.css")"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
@* Interactive, so the router and the layout share the render root with the pages — a cascading
   value from a *statically* rendered ancestor never reaches an interactive child, and AppShell
   cascades OwnedExpansions. With a static root every picker and reference page would read that
   cascade as null and quietly offer content the player doesn't own.
   The one exception is the Error page, which opts out via [ExcludeFromInteractiveRouting]:
   it reads HttpContext for the request id, which only exists during static rendering — and an
   error page is the last place to depend on a working circuit. *@
@* Blazor-ApexCharts ships its JS as an ES module and imports it itself on first chart render.
   Loading it here with a plain <script> only ever produced a 404 and a module syntax error. *@
<Routes @rendermode="PageRenderMode"/>
<script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
