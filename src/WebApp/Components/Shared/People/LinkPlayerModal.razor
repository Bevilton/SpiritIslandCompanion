@* Points a local player at a friend's account and sends the merge request. Only friends are
   offered: the seats carry a place in each other's history, so the other side has to be
   someone you are already connected to — and they still have to agree. *@
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser

@if (_open)
{
    <ModalShell OnClose="Close" MaxWidth="md:max-w-lg">
        <DialogHeader Eyebrow="Link to an account" Title="@($"Who is “{_player?.Name}”?")" OnClose="Close">
            <Subtitle>
                Pick the friend this guest really is. They get a request showing every game the
                seat covers, and nothing moves until they confirm it.
            </Subtitle>
        </DialogHeader>

        <div class="picker-body">
            <Alert Feedback="_form"/>

            @if (Friends.Count == 0)
            {
                <div class="surface no-data px-5">
                    You have no friends to link to yet — send a friend request first.
                </div>
            }
            else
            {
                <ul class="space-y-1">
                    @foreach (var f in Friends)
                    {
                        var selected = _selected == f.UserId;
                        <li>
                            <PickRow Active="selected" OnClick="() => _selected = f.UserId">
                                <PlayerAssigneeBadge Kind="AssigneeKind.Friend"
                                                     Name="@f.Name" DetailLabel="@f.Email"
                                                     ContainerClass="@PlayerAssigneeBadge.RowLayout"/>
                            </PickRow>
                        </li>
                    }
                </ul>
            }
        </div>

        @* Bordered because the body above scrolls — with the rule the foot family draws (.picker-foot,
           .sheet-foot), not a shade darker. *@
        <div class="dialog-foot border-t border-ink-100">
            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="Send"
                    disabled="@(_saving || _selected is null)">
                <ActionGlyph Icon="send" Busy="_saving" BusyLabel="Sending"/> Send request
            </button>
        </div>
    </ModalShell>
}

@code {
    /// <summary>The friends this local player may be — accounts you are already connected to.</summary>
    [Parameter] public IReadOnlyList<PersonSummary> Friends { get; set; } = [];

    /// <summary>Raised once the request is out, so the page can reload.</summary>
    [Parameter] public EventCallback OnSent { get; set; }

    private bool _open;
    private bool _saving;
    private PersonSummary? _player;
    private Guid? _selected;
    private readonly FormFeedback _form = new();

    public void Show(PersonSummary player)
    {
        _player = player;
        _selected = null;
        _form.Clear();
        _open = true;
        StateHasChanged();
    }

    private void Close() => _open = false;

    private async Task Send()
    {
        if (_player?.PlayerId is not { } playerId || _selected is not { } targetId) return;

        _saving = true;
        var result = await Mediator.Send(new SendMergeRequestCommand(
            CurrentUser.RequireUserId(), playerId, targetId));
        _saving = false;

        if (!_form.Apply(result)) return;

        _open = false;
        await OnSent.InvokeAsync();
    }
}
