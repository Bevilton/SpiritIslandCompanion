@* One person you play with — friend, local player, or you — with the record you share.
   Every number on it is over the reader's own games (see GetPeopleQuery / GetStatisticsQuery),
   so a friend's card says what the two of you did together and nothing about their other tables.

   Shared by the People page and the statistics Players tab: the same person should look the
   same wherever they are shown. The pages differ only in what they put in Details and Actions,
   and in whether the whole card is a picker (OnClick). *@

@if (OnClick.HasDelegate)
{
    <button type="button" @onclick="OnClick" title="@Title"
            class="@ShellClass card-lift text-left focus-ring
                   @(Selected ? "border-accent-400 ring-2 ring-accent-500/20" : null)">
        @Body
    </button>
}
else
{
    <div class="@ShellClass hover:border-ink-300">@Body</div>
}

@code {
    private const string ShellClass = "surface flex flex-col overflow-hidden transition-all";

    private RenderFragment Body => __builder =>
    {
        <div class="flex items-start gap-3 px-5 pt-4">
            <PlayerAssigneeBadge Kind="Kind" Name="@Name" DetailLabel="@DetailLabel"
                                 ContainerClass="@PlayerAssigneeBadge.RowLayout"/>
            @if (Record.GamesPlayed > 0)
            {
                <WinRateRing Pct="Record.WinRate" Size="56" Caption="win"/>
            }
        </div>

        @if (Record.GamesPlayed > 0)
        {
            <div class="mt-3 grid grid-cols-3 divide-x divide-ink-100 border-y border-ink-100 bg-ink-50/40">
                @* The count is the way to the games themselves — no extra action on a card that
                   already carries some. Not while the card is a picker, though: a link inside a
                   button is not a thing the browser will render, as with Actions below. *@
                @if (GamesHref is { } href && !OnClick.HasDelegate)
                {
                    @* The tally's colours mean won and lost, so the link keeps the neutral one
                       and says it is a link with a dotted rule instead — .linked-count, the same
                       one the statistics tables' counts wear. *@
                    <a href="@href" title="@($"See the games {Name} sat in")"
                       class="@TallyCell transition-colors hover:bg-white focus-ring">
                        @TallyFace(Record.GamesPlayed, "games", "linked-count text-ink-900")
                    </a>
                }
                else
                {
                    <div class="@TallyCell">@TallyFace(Record.GamesPlayed, "games", "text-ink-900")</div>
                }
                <div class="@TallyCell">@TallyFace(Record.Wins, "won", WinTone.ForOutcome(true))</div>
                <div class="@TallyCell">@TallyFace(Record.Losses, "lost", WinTone.ForOutcome(false))</div>
            </div>

            <div class="row-sub space-y-1.5 px-5 py-3">
                @if (_favourite is not null)
                {
                    <div class="flex min-w-0 items-center gap-2">
                        <ColorBar Size="xs" Color="@_favouriteColor"/>
                        <span class="truncate">Usually plays <span class="font-medium text-ink-800">@_favourite.Name</span></span>
                    </div>
                }
                @Details
            </div>
        }
        else
        {
            <div class="row-sub border-y border-ink-100 bg-ink-50/40 px-5 py-4">
                @EmptyNote
            </div>
        }

        @* Not while the card is a picker: a button inside a button is not a thing the browser
           will render, so the picker wins and the actions are simply not offered. *@
        @if (Actions is not null && !OnClick.HasDelegate)
        {
            <div class="mt-auto flex flex-wrap items-center gap-2 px-5 py-3">
                @Actions
            </div>
        }
    };

    /// One of the three cells of the record strip. Split from its face because the games cell is
    /// an <c>&lt;a&gt;</c> where the host has a list to send the reader to and a <c>&lt;div&gt;</c>
    /// where it hasn't — the figure inside is the same either way, and had been written twice.
    private const string TallyCell = "block px-3 py-2 text-center";

    private static RenderFragment TallyFace(int value, string label, string tone) =>
        @<text>
            <div class="numeral text-base @tone">@value</div>
            <div class="micro-label">@label</div>
        </text>;

    [Parameter, EditorRequired] public AssigneeKind Kind { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Line under the name — an email address, or what kind of person this is.</summary>
    [Parameter] public string? DetailLabel { get; set; }

    /// <summary>
    /// The record the two of you share — games, wins, losses and the rate. One tally rather than
    /// four loose numbers: the People page hands over a <c>PersonSummary</c> and the statistics
    /// tab a <c>PlayerStats</c>, and both already carry the four under the same names.
    /// </summary>
    [Parameter, EditorRequired] public IWinRateTally Record { get; set; } = default!;

    /// <summary>Resolved from the whole catalogue on purpose: a spirit from an expansion you
    /// don't own is still what they played, and the card has to be able to say so.</summary>
    [Parameter] public string? FavouriteSpiritId { get; set; }

    /// <summary>What to say instead of the record when you haven't played together yet.</summary>
    [Parameter] public string EmptyNote { get; set; } = "No games together yet.";

    /// <summary>
    /// The games list narrowed to this person, when the host has one to offer — it turns the
    /// games tally into a link. Ignored while the card is a picker.
    /// </summary>
    [Parameter] public string? GamesHref { get; set; }

    /// <summary>Extra lines under the favourite spirit — best score, last played, whatever the page has.</summary>
    [Parameter] public RenderFragment? Details { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Set to make the whole card a picker. Actions are then not offered, since a
    /// button inside a button is not a thing the browser will render.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Highlights the card as the current pick — only meaningful with <see cref="OnClick"/>.</summary>
    [Parameter] public bool Selected { get; set; }

    [Parameter] public string? Title { get; set; }

    private Spirit? _favourite;
    private string _favouriteColor = GameLookups.NeutralColor;

    protected override void OnParametersSet()
    {
        _favourite = GameLookups.SpiritFor(FavouriteSpiritId);
        _favouriteColor = GameLookups.SpiritColor(_favourite);
    }
}
