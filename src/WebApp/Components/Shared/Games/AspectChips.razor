@* A spirit's aspects as one row of chips, each carrying its own record. An aspect rewrites
   the spirit enough that "played Lightning 11×" says nothing about how Wind went, so wherever
   a spirit's record is shown its variants are shown beside it.

   With OnPick the chips are buttons that choose the spirit as that aspect; without one they
   are passive labels. Records come from SetupInsights.AspectRecords, keyed by aspect id with
   BaseAspectKey standing for the spirit played with no aspect. *@

@if (Aspects.Count > 0)
{
    <div class="flex flex-wrap items-center gap-1">
        @if (ShowBase)
        {
            @Chip(null, "No aspect", Records?.GetValueOrDefault(SetupInsights.BaseAspectKey))
        }
        @foreach (var aspect in Aspects)
        {
            @Chip(aspect, aspect.Name, Records?.GetValueOrDefault(aspect.Id.Value))
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Aspect> Aspects { get; set; } = [];

    /// <summary>Plays per aspect id. Null means there is no history to report at all.</summary>
    [Parameter] public IReadOnlyDictionary<string, SetupInsights.PlayRecord>? Records { get; set; }

    /// <summary>
    /// Marks the aspect currently chosen. <see cref="SetupInsights.BaseAspectKey"/> selects the
    /// "No aspect" chip; null selects nothing.
    /// </summary>
    [Parameter] public string? SelectedAspectId { get; set; }

    /// <summary>Whether "No aspect" leads the row as a chip of its own.</summary>
    [Parameter] public bool ShowBase { get; set; }

    /// <summary>Makes the chips choosable. A null aspect is the spirit with no aspect.</summary>
    [Parameter] public EventCallback<Aspect?> OnPick { get; set; }

    /// <summary>Whose record the counts are, for the tooltip — "Anna" or null for your own.</summary>
    [Parameter] public string? SubjectName { get; set; }

    private RenderFragment Chip(Aspect? aspect, string label, SetupInsights.PlayRecord? record) => __builder =>
    {
        var selected = SelectedAspectId == (aspect?.Id.Value ?? SetupInsights.BaseAspectKey);
        var played = record?.Played ?? 0;
        var never = Records is not null && played == 0;
        var css = ChipClass(selected, never);
        var title = SetupInsights.RecordTooltip(label, record, SubjectName, Records is not null);

        if (OnPick.HasDelegate)
        {
            <button type="button" @key="@(aspect?.Id.Value ?? "base")" class="@css" title="@title"
                    @onclick="() => OnPick.InvokeAsync(aspect)" @onclick:stopPropagation>
                @ChipBody(label, record, never)
            </button>
        }
        else
        {
            <span @key="@(aspect?.Id.Value ?? "base")" class="@css" title="@title">
                @ChipBody(label, record, never)
            </span>
        }
    };

    private RenderFragment ChipBody(string label, SetupInsights.PlayRecord? record, bool never) => __builder =>
    {
        <span class="truncate">@label</span>
        @if (never)
        {
            <span class="untried-mark">new</span>
        }
        else if (record is { Played: > 0 })
        {
            <span class="tabular-nums opacity-70">@(record.Played)×</span>
            @if (record.Completed > 0)
            {
                <WinRateFigure Value="record.WinRate"/>
            }
        }
    };

    /// Same three states the record pills use everywhere else: chosen, never played, played —
    /// and the same .chip shape, a padding step tighter because a spirit's variants are a run of
    /// them on one line. The tones are the chip family's own (.chip.is-selected, .chip-neutral,
    /// .untried), and so is the answer to the pointer: a played chip that picks is a door
    /// (.chip-door), .untried brings its own hover, and the ring comes with being a button.
    private string ChipClass(bool selected, bool never) =>
        "chip chip-sm max-w-full px-1.5 "
        + (selected
            ? "is-selected"
            : never
                ? "untried"
                : "chip-neutral" + (OnPick.HasDelegate ? " chip-door" : ""));
}
