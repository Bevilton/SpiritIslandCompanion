@* The record sheet's record — a SetupProfiles.Profile rendered as headline numbers,
   what the subject was paired with, and the most recent games. Used by the entity
   detail modals (spirit / board / adversary / scenario / island) so a player can
   explore the history before committing to a matchup.

   The section holds no control over whose games it counts — that is the host's
   scope and nothing but the host's: a reference page is always the whole
   account's history, the statistics page follows its player selector, and the
   setup screen follows whoever sits in the seat being filled. Since the same
   sheet appears under all three, it says which one it is in words (see
   ScopeNote) rather than leaving the numbers to be read as anybody's. *@

@using System.Globalization

<div class="space-y-4">
    <div>
        <h3 class="text-sm font-medium uppercase tracking-wide text-ink-500">@Heading</h3>
        <p class="mt-1 flex items-start gap-1.5 text-[11px] leading-relaxed text-ink-400">
            <Icon Name="users" Class="w-3.5 h-3.5 shrink-0 mt-px"/>
            <span>@ScopeNote</span>
        </p>
    </div>

    @if (Profile.Record.Played == 0)
    {
        <div class="flex items-start gap-2.5 rounded-xl border border-dashed border-amber-300 bg-amber-50/60 px-3.5 py-3">
            <Icon Name="sparkles" Class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"/>
            <div class="text-xs leading-relaxed text-amber-800">
                <span class="font-semibold">@EmptyHeadline</span>
                @* The nudge is only the reader's to act on — offered against somebody else's
                   blank record it would promise something the reader cannot do. ml-1 stands in
                   for the sentence space: Razor trims the whitespace either side of an @if, so
                   the two spans would otherwise be flush against each other. *@
                @if (SubjectName is null)
                {
                    <span class="ml-1 text-amber-700">Pick it and this becomes game one — every number here starts filling in.</span>
                }
            </div>
        </div>
    }
    else
    {
        @* --- headline --- *@
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 rounded-xl border border-ink-200 bg-ink-50/40 px-4 py-3.5">
            @if (Profile.Record.Completed > 0)
            {
                <WinRateRing Pct="Profile.Record.WinRate" Size="76" Stroke="7" Caption="wins"/>
            }
            else
            {
                <div class="flex h-[76px] w-[76px] shrink-0 items-center justify-center rounded-full border-2 border-dashed border-ink-200 text-center">
                    <span class="px-2 text-[9px] uppercase leading-tight tracking-wide text-ink-400">no results yet</span>
                </div>
            }
            <dl class="grid min-w-0 flex-1 grid-cols-2 gap-x-6 gap-y-1.5 sm:grid-cols-3">
                @foreach (var stat in HeroStats)
                {
                    <div class="min-w-0">
                        <dt class="text-[11px] uppercase tracking-wide text-ink-500">@stat.Label</dt>
                        <dd class="truncate text-sm font-semibold tabular-nums text-ink-900">@stat.Value</dd>
                    </div>
                }
            </dl>
        </div>

        @if (Timeline is { } timeline)
        {
            <p class="text-xs text-ink-500">@timeline</p>
        }

        @* --- what it was paired with --- *@
        @if (Profile.Breakdowns.Count > 0)
        {
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var breakdown in Profile.Breakdowns)
                {
                    var most = breakdown.Rows.Max(r => r.Record.Played);
                    <div>
                        <div class="mb-1.5 text-[11px] font-medium uppercase tracking-wider text-ink-500">@breakdown.Title</div>
                        <div class="space-y-1">
                            @foreach (var row in breakdown.Rows)
                            {
                                <div class="flex items-center gap-2 rounded-md px-1.5 py-1 text-xs"
                                     style="@ShareStyle(row, most)"
                                     title="@RowTooltip(row)">
                                    @if (row.Badge is { } badge)
                                    {
                                        <span class="inline-flex h-4 min-w-4 shrink-0 items-center justify-center rounded px-1 text-[10px] font-bold text-white"
                                              style="background-color: @(row.ColorHex ?? "var(--color-ink-400)"); font-family: var(--font-serif);">@badge</span>
                                    }
                                    else if (row.ColorHex is { } dot)
                                    {
                                        <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @dot;"></span>
                                    }
                                    <span class="min-w-0 flex-1 truncate text-ink-800">@row.Label</span>
                                    <span class="shrink-0 tabular-nums text-ink-500">@(row.Record.Played)×</span>
                                    @if (row.Record.Completed > 0)
                                    {
                                        <span class="w-9 shrink-0 text-right tabular-nums font-semibold @WinTone.ForRate(row.Record.WinRate)">@($"{row.Record.WinRate:F0}")%</span>
                                    }
                                    else
                                    {
                                        <span class="w-9 shrink-0 text-right text-ink-300">—</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (breakdown.Hidden > 0)
                        {
                            <div class="mt-1 px-1.5 text-[11px] text-ink-400">+@breakdown.Hidden more</div>
                        }
                    </div>
                }
            </div>
        }

        @* --- recent games --- *@
        @* Each line is the game it reports, so a sheet is a way into the record and not just a
           readout of it — and the header carries the whole slice, which is more games than the
           five shown here. Only where the host asked for links: mid-setup these same sheets are
           how a spirit is chosen, and a link out would abandon the game being set up. *@
        @if (Profile.Recent.Count > 0)
        {
            <div>
                <div class="mb-1.5 flex items-baseline justify-between gap-2">
                    <span class="text-[11px] font-medium uppercase tracking-wider text-ink-500">Recent games</span>
                    @* No count on it: the five lines below may be a person's seats or the whole
                       table's, and a number here could only be right for one of them. *@
                    @if (AllGamesHref is { } allHref)
                    {
                        <a href="@allHref" class="text-[11px] font-medium text-accent-700 hover:text-accent-800 hover:underline"
                           title="@AllGamesTitle">
                            See all games →
                        </a>
                    }
                </div>
                <div class="divide-y divide-ink-100 overflow-hidden rounded-lg border border-ink-200">
                    @foreach (var game in Profile.Recent)
                    {
                        @if (LinkGames)
                        {
                            <a href="@GamesLink.Game(game.GameId, null)" title="Open this game"
                               class="flex flex-wrap items-center gap-x-2.5 gap-y-1 px-2.5 py-1.5 text-xs transition-colors
                                      hover:bg-accent-50/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                @GameLine(game)
                            </a>
                        }
                        else
                        {
                            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 px-2.5 py-1.5 text-xs">
                                @GameLine(game)
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    /// One line of the recent-games list, whether or not it is wrapped in a link.
    private RenderFragment GameLine(SetupProfiles.ProfileGame game) =>
        @<text>
            @* As stored, not converted to server-local — see GameDetail. *@
            <span class="w-14 shrink-0 tabular-nums text-ink-500">@game.When.DateTime.ToString("MMM d")</span>
            <span class="shrink-0 scale-90 origin-left">
                <GameStatusBadge IsCompleted="game.IsCompleted" Win="game.Win"/>
            </span>
            <span class="min-w-0 flex-1 truncate text-ink-700">@game.Context</span>
            <span class="shrink-0 tabular-nums text-ink-400">diff @game.Difficulty</span>
            <span class="w-7 shrink-0 text-right font-semibold tabular-nums text-ink-800">
                @(game.Score?.ToString() ?? "—")
            </span>
        </text>;
}

@code {
    [Parameter, EditorRequired] public SetupProfiles.Profile Profile { get; set; } = default!;

    /// <summary>The subject's display name — used in the never-played message.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Whose history this is when the stats are scoped to someone else, e.g. "Anna".</summary>
    [Parameter] public string? SubjectName { get; set; }

    /// <summary>
    /// What the record is of, as a bare noun phrase — "record with this spirit". The section
    /// puts the possessive on it, so one wording serves every scope the sheet can carry.
    /// </summary>
    [Parameter] public string Title { get; set; } = "record";

    /// <summary>
    /// Whether the numbers are one person's rather than the whole account's. Set by hosts that
    /// narrow the history — the statistics page's player selector, the seat being filled on the
    /// setup screen; the reference pages leave it off, where a sheet is always the account's.
    /// <see cref="SubjectName"/> names that person when it isn't the reader.
    /// </summary>
    [Parameter] public bool Scoped { get; set; }

    /// <summary>
    /// Whether a recent-games line opens the game. Off by default: the same sheets are the
    /// picker on the setup screen, where following a link would walk out of a half-built game.
    /// </summary>
    [Parameter] public bool LinkGames { get; set; }

    /// <summary>
    /// The games list narrowed to this subject, when there is a filter that expresses it. Shown
    /// beside the recent-games heading, since those five are rarely all of them. The host builds
    /// it with the same scope it gave the numbers, so following it can't widen the slice.
    /// </summary>
    [Parameter] public string? AllGamesHref { get; set; }

    /// The link carries the sheet's scope, so its tooltip says so rather than promising the
    /// whole history behind a link that won't deliver it.
    private string AllGamesTitle =>
        SubjectName is { } name ? $"Open the games list, filtered to {Name} and {name}'s games"
        : Scoped ? $"Open the games list, filtered to {Name} and your games"
        : $"Open the games list, filtered to {Name}";

    /// Whether the subject sits in a seat, which is what decides how the scope narrowed the
    /// history — by dropping the other seats, or by dropping games the person was not at.
    private bool SeatBound => SetupProfiles.IsSeatBound(Profile.Kind);

    /// The heading belongs to whoever the numbers do. Unscoped they are the account's rather
    /// than any one person's, so it goes without a possessive.
    private string Heading =>
        SubjectName is { } name ? $"{name}'s {Title}"
        : Scoped ? $"Your {Title}"
        : Title;

    /// <summary>
    /// One line saying exactly whose games were counted. The same sheet is opened from the
    /// reference pages, the statistics page and the setup screen, and the scope is the only
    /// thing that differs between them — so it is stated rather than left to be inferred from
    /// a heading (or, worse, from the "Who played it" breakdown further down).
    /// </summary>
    private string ScopeNote =>
        (Scoped || SubjectName is not null, SeatBound) switch
        {
            (true, true) => $"Counting {Whose} seats only.",
            (true, false) => $"Counting the games {WhoPlayed} played in.",
            (false, true) => "Counting every seat you have recorded — your own and your table's.",
            (false, false) => "Counting every game you have recorded, whoever sat at the table."
        };

    /// "Anna's" / "your own" — the possessive for whoever the sheet is scoped to.
    private string Whose => SubjectName is { } name ? $"{name}'s" : "your own";

    /// "Anna" / "you" — the same person as the subject of a verb.
    private string WhoPlayed => SubjectName ?? "you";

    private string EmptyHeadline
    {
        get
        {
            var verb = Profile.Kind switch
            {
                SetupSubjectKind.Board => "used",
                SetupSubjectKind.Adversary => "faced",
                SetupSubjectKind.IslandLayout or SetupSubjectKind.SavedLayout => "played on",
                _ => "played"
            };
            // Whose blank it is follows the scope: an unscoped sheet has counted the whole
            // table, so reporting nothing as the reader's own miss would overstate it.
            return SubjectName is { } name ? $"{name} has never {verb} {Name}."
                : Scoped ? $"You've never {verb} {Name}."
                : $"Nobody at your table has {verb} {Name}.";
        }
    }

    private IEnumerable<(string Label, string Value)> HeroStats
    {
        get
        {
            var record = Profile.Record;
            yield return ("Played", $"{record.Played}×");
            yield return ("Result", record.Completed > 0 ? $"{record.Wins} W · {record.Losses} L" : "drafts only");
            if (Profile.BestScore is { } best) yield return ("Best score", best.ToString());
            if (Profile.AverageScore is { } avg) yield return ("Avg score", avg.ToString("F0"));
            if (Profile.AverageDifficulty is { } diff) yield return ("Avg difficulty", diff.ToString("F1"));
            if (Profile.HardestWon is { } hardest) yield return ("Hardest won", hardest.ToString());
        }
    }

    /// "Last played 3 weeks ago · first played 8 months ago" — omits the first-played
    /// half when there is only one game to talk about.
    private string? Timeline
    {
        get
        {
            if (Profile.LastPlayed is not { } last) return null;
            var line = $"Last played {SetupInsights.Ago(last)}";
            return Profile.Record.Played > 1 && Profile.FirstPlayed is { } first
                ? $"{line} · first played {SetupInsights.Ago(first)}"
                : line;
        }
    }

    /// Tints the row proportionally to its share of the most-played row, so a
    /// breakdown reads as a bar chart without spending horizontal space on bars.
    private static string ShareStyle(SetupProfiles.ProfileRow row, int most)
    {
        if (most <= 0) return "";
        var share = Math.Round(row.Record.Played * 100.0 / most, 1).ToString("0.#", CultureInfo.InvariantCulture);
        var tint = row.ColorHex is { } color ? $"{color}24" : "rgba(120,113,108,.12)";
        return $"background: linear-gradient(to right, {tint} {share}%, transparent {share}%);";
    }

    private static string RowTooltip(SetupProfiles.ProfileRow row) =>
        row.Record.Completed > 0
            ? $"{row.Label} — {row.Record.Played} played, {row.Record.Wins} won / {row.Record.Losses} lost"
            : $"{row.Label} — {row.Record.Played} played, no results yet";
}
