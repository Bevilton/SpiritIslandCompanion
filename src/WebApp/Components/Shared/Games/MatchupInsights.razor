@* "Your matchup" — live personal-history briefing for the game-setup screen.
   Recomputed from the SetupGameFact history in one pass per render: record
   vs the picked adversaries/scenario, per-level history, spirits already
   fielded vs untested fresh picks, and board habits of the chosen spirits.

   Takes the same MatchupContext the pickers do, so the card and the picker a
   player opens next are reading one description of the table, not two. *@

@using Application.Features.Statistics

<section class="surface p-4">
    <div class="mb-2 flex items-baseline justify-between gap-2">
        <span class="text-xs font-medium uppercase tracking-wide text-ink-500">Your matchup</span>
        @if (_record.LastPlayed is { } last)
        {
            <span class="text-[11px] text-ink-400">played @SetupInsights.Ago(last)</span>
        }
    </div>

    @if (!Context.HasHistory)
    {
        <div class="flex items-start gap-2.5 rounded-xl border border-dashed border-accent-300 bg-accent-50/50 px-3 py-2.5">
            <Icon Name="sparkles" Class="w-4 h-4 text-accent-600 shrink-0 mt-0.5"/>
            <div class="text-xs text-ink-700">
                This will be your <strong>first recorded game</strong> — every stat starts here.
            </div>
        </div>
    }
    else
    {
        <div class="text-sm font-semibold text-ink-900 leading-snug" style="font-family: var(--font-serif);">@Title</div>

        @if (_record.Played > 0)
        {
            <div class="mt-3 flex items-center gap-4">
                @if (_record.Completed > 0)
                {
                    <WinRateRing Pct="_record.WinRate" Size="72" Stroke="7" Caption="wins"/>
                }
                else
                {
                    <div class="flex h-[72px] w-[72px] shrink-0 items-center justify-center rounded-full border-2 border-dashed border-ink-200 text-center">
                        <span class="text-[9px] uppercase tracking-wide text-ink-400 leading-tight px-2">no results yet</span>
                    </div>
                }
                <div class="min-w-0 space-y-1 text-xs text-ink-700">
                    <div>Played <strong class="text-ink-900 tabular-nums">@(_record.Played)×</strong></div>
                    @if (_record.Completed > 0)
                    {
                        <div>
                            <strong class="text-accent-700 tabular-nums">@_record.Wins W</strong>
                            <span class="text-ink-300">·</span>
                            <strong class="text-red-600 tabular-nums">@_record.Losses L</strong>
                        </div>
                        <div>Best score <strong class="text-ink-900 tabular-nums">@_record.BestScore</strong></div>
                    }
                    else
                    {
                        <div class="text-ink-500">Only drafts so far.</div>
                    }
                    @if (_record.LastWin is { } lastWin)
                    {
                        <div class="@(lastWin ? "text-accent-700" : "text-red-600")">
                            Last time you @(lastWin ? "won" : "lost").
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mt-3 flex items-start gap-2.5 rounded-xl border border-dashed border-amber-300 bg-amber-50/60 px-3 py-2.5">
                <Icon Name="sparkles" Class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"/>
                <div class="min-w-0">
                    <div class="text-xs font-semibold text-amber-800">First encounter!</div>
                    <div class="mt-0.5 text-[11px] leading-relaxed text-amber-700">@FallbackLine</div>
                </div>
            </div>
        }

        @* per-level history for a single selected adversary *@
        @if (_levels is { } levels)
        {
            <div class="mt-3.5">
                <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">@SingleAdversaryName by level</div>
                <div class="flex flex-wrap gap-1">
                    @foreach (var (level, rec) in levels)
                    {
                        var isPicked = Context.HighlightLevel == level;
                        <span class="inline-flex flex-col items-center rounded-lg border px-1.5 py-1 min-w-[2.35rem]
                                     @(isPicked ? "border-accent-400 bg-accent-50 ring-1 ring-accent-500/30" : "border-ink-200 bg-white")"
                              title="@(rec.Played == 0
                                        ? $"Level {level} — never played"
                                        : $"Level {level} — played {rec.Played}×{(rec.Completed > 0 ? $", {rec.Wins} won / {rec.Losses} lost" : "")}")">
                            <span class="text-[9px] uppercase tracking-wide text-ink-500">L@(level)</span>
                            <span class="text-[11px] font-semibold tabular-nums @WinTone.ForRecord(rec)">@(rec.Played == 0 ? "—" : $"{rec.Played}×")</span>
                        </span>
                    }
                </div>
            </div>
        }

        @* spirits already fielded + fresh picks *@
        <div class="mt-4 border-t border-ink-100 pt-3">
            @* "at your table" rather than "yours": this card is the table's, so its per-spirit
               counts are every seat on the account and not only the reader's own (the seat
               pickers are where a record narrows to one person — see MatchupContext.SeatFilter). *@
            <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">
                @(Context.ExactLabel is { } scope ? $"Fielded {scope}" : "Go-to spirits at your table")
            </div>
            @if (_playedChips.Count > 0)
            {
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var chip in _playedChips)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-2 py-0.5 text-[11px] text-ink-800"
                              title="@chip.Tooltip">
                            <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @chip.Color;"></span>
                            <span class="max-w-40 truncate">@chip.Name</span>
                            <span class="tabular-nums text-ink-500">@(chip.Played)×</span>
                            @if (chip.Completed > 0)
                            {
                                <span class="tabular-nums font-medium @WinTone.ForRate(chip.WinRate)">@($"{chip.WinRate:F0}")%</span>
                            }
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="text-[11px] text-ink-500">None yet — every spirit is a fresh pick.</div>
            }

            @if (_freshChips.Count > 0)
            {
                <div class="mt-2.5 mb-1.5 flex items-center gap-1 text-[10px] font-medium uppercase tracking-wider text-ink-500">
                    <Icon Name="sparkles" Class="w-3 h-3 text-amber-500"/>
                    @FreshPicksLabel
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var chip in _freshChips)
                    {
                        @if (CanAssignSpirit)
                        {
                            <button type="button" @onclick="() => OnSuggestSpirit.InvokeAsync(chip.SpiritId)"
                                    class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2 py-0.5 text-[11px] text-amber-800 transition-colors hover:border-amber-400 hover:bg-amber-100"
                                    title="@chip.Tooltip — tap to assign to an open seat">
                                <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @chip.Color;"></span>
                                <span class="max-w-40 truncate">@chip.Name</span>
                                <Icon Name="plus" Class="w-2.5 h-2.5"/>
                            </button>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2 py-0.5 text-[11px] text-amber-800"
                                  title="@chip.Tooltip">
                                <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @chip.Color;"></span>
                                <span class="max-w-40 truncate">@chip.Name</span>
                            </span>
                        }
                    }
                </div>
            }
        </div>

        @* board habits of the spirits currently on the island *@
        @if (_boardHabits.Count > 0)
        {
            <div class="mt-4 border-t border-ink-100 pt-3">
                <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">Board habits</div>
                <div class="space-y-1.5">
                    @foreach (var habit in _boardHabits)
                    {
                        <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-[11px] text-ink-700">
                            <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @habit.Color;"></span>
                            <span class="max-w-36 truncate font-medium text-ink-900">@habit.SpiritName</span>
                            <span class="whitespace-nowrap text-ink-400">usually takes</span>
                            <span class="inline-flex h-4 w-4 items-center justify-center rounded text-[9px] font-bold text-white"
                                  style="background-color: @habit.BoardColor; font-family: var(--font-serif);">@habit.BoardLetter</span>
                            <span class="whitespace-nowrap tabular-nums text-ink-500">@(habit.Count)× of @habit.Total</span>
                            @if (habit.Completed > 0)
                            {
                                <span class="tabular-nums font-medium @WinTone.ForRate(habit.WinRate)">@($"{habit.WinRate:F0}")%</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    /// <summary>
    /// The table as it stands — the loaded history plus what the record is measured
    /// against. Same value the pickers are opened with.
    /// </summary>
    [Parameter, EditorRequired] public SetupInsights.MatchupContext Context { get; set; } =
        SetupInsights.MatchupContext.Empty;

    /// <summary>Spirits currently placed on the island (used for board habits).</summary>
    [Parameter] public IReadOnlyList<string> SelectedSpiritIds { get; set; } = [];

    /// <summary>Spirit ids in scope (owned expansions) — the pool for fresh picks.</summary>
    [Parameter] public IReadOnlyList<string> CandidateSpiritIds { get; set; } = [];

    /// <summary>Whether an open seat exists that a fresh pick can be assigned to.</summary>
    [Parameter] public bool CanAssignSpirit { get; set; }

    [Parameter] public EventCallback<string> OnSuggestSpirit { get; set; }

    private IReadOnlyList<SetupGameFact> _broadGames = [];
    private SetupInsights.MatchupRecord _record = SetupInsights.Record([]);
    private Dictionary<string, SetupInsights.PlayRecord> _spiritRecords = [];
    private Dictionary<string, SetupInsights.PlayRecord> _overallSpiritRecords = [];
    private IReadOnlyList<(int Level, SetupInsights.PlayRecord Record)>? _levels;
    private List<SpiritChip> _playedChips = [];
    private List<SpiritChip> _freshChips = [];
    private List<BoardHabit> _boardHabits = [];

    /// Everything on this card is derived from the history. Deriving it here keeps it to
    /// one pass per render, instead of once per property read scattered through the markup.
    protected override void OnParametersSet()
    {
        // The chips are the selection exactly — England L5 means England at L5, and in the scenario
        // if one is picked. Anything wider answers a question the player didn't ask: they can see
        // the neighbouring levels in the strip above, and an empty list here is itself the answer
        // ("nobody has faced this yet"), which the fresh picks below then act on.
        // _broadGames feeds the first-encounter fallback, which deliberately widens to say
        // what related history there is.
        _broadGames = Context.BroadGames();
        var exactGames = Context.ExactGames();
        _record = SetupInsights.Record(exactGames);
        _spiritRecords = SetupInsights.SpiritRecords(exactGames, Context.SeatFilter);
        _overallSpiritRecords = Context.SpiritRecords();
        _levels = BuildLevels();
        _playedChips = BuildPlayedChips();
        _freshChips = BuildFreshChips();
        _boardHabits = BuildBoardHabits();
    }

    private string Title
    {
        get
        {
            var parts = new List<string>();
            foreach (var pick in Context.Adversaries)
            {
                var adv = GameLookups.AdversaryFor(pick.AdversaryId);
                if (adv is null) continue;
                parts.Add(pick.Level is { } lvl ? $"{adv.Name} L{lvl}" : adv.Name);
            }
            var vs = parts.Count > 0 ? $"vs {string.Join(" + ", parts)}" : null;
            var scen = GameLookups.ScenarioFor(Context.ScenarioId)?.Name;
            return (vs, scen) switch
            {
                (null, null) => "All your games",
                (null, _)    => $"Scenario: {scen}",
                (_, null)    => vs!,
                _            => $"{vs} · {scen}"
            };
        }
    }

    /// Shown when the exact selection was never played — names the closest history there is.
    private string FallbackLine
    {
        get
        {
            var anyLevel = Context.AnyLevelGames();
            if (anyLevel.Count > 0)
            {
                var r = SetupInsights.Record(anyLevel);
                return $"You've faced this foe at other levels — {r.Played} play{Plural(r.Played)}{WinPart(r)}.";
            }
            // _broadGames drops the scenario too, so it is the "same foe, any scenario" set.
            if (!string.IsNullOrEmpty(Context.ScenarioId) && Context.Adversaries.Count > 0 && _broadGames.Count > 0)
            {
                var r = SetupInsights.Record(_broadGames);
                return $"You've faced this foe, but never with this scenario — {r.Played} play{Plural(r.Played)}{WinPart(r)}.";
            }
            return "You've never played this setup. Uncharted waters!";
        }
    }

    private static string Plural(int n) => n == 1 ? "" : "s";

    private static string WinPart(SetupInsights.MatchupRecord r)
        => r.Completed > 0 ? $", {r.WinRate:F0}% wins" : "";

    private string? SingleAdversaryName =>
        Context.Adversaries is [{ } single] ? GameLookups.AdversaryFor(single.AdversaryId)?.Name : null;

    /// Level rows for the single selected adversary, ordered by level; null when zero or
    /// several adversaries are selected or it was never faced. The level currently picked is
    /// always among them, even at nought plays — it is the one the strip exists to place.
    private IReadOnlyList<(int Level, SetupInsights.PlayRecord Record)>? BuildLevels()
    {
        if (Context.Adversaries is not [{ } single]) return null;
        var facing = Context.AdversaryRecords().GetValueOrDefault(single.AdversaryId);
        if (facing is null || facing.Played == 0) return null;

        var levels = new Dictionary<int, SetupInsights.PlayRecord>(facing.Levels);
        if (single.Level is { } picked)
            levels.TryAdd(picked, new SetupInsights.PlayRecord(0, 0, 0));

        return levels.OrderBy(kv => kv.Key).Select(kv => (kv.Key, kv.Value)).ToList();
    }

    private sealed record SpiritChip(string SpiritId, string Name, string Color, int Played, int Completed, double WinRate, string Tooltip);

    private List<SpiritChip> BuildPlayedChips() =>
        _spiritRecords
            .OrderByDescending(kv => kv.Value.Played)
            .Take(6)
            .Select(kv => ToChip(kv.Key, kv.Value, Context.ExactLabel))
            .OfType<SpiritChip>()
            .ToList();

    /// Whether the fresh chips hold genuinely untested spirits, or the least-played
    /// fallback — set alongside the chips so the label above them can't disagree.
    private bool _freshChipsAreUntested;

    /// Spirits in scope that never appeared in the current matchup, least-played
    /// overall first (never-played anywhere leads the list). When everything has
    /// been tried already, falls back to the least-played spirits instead.
    private List<SpiritChip> BuildFreshChips()
    {
        var available = CandidateSpiritIds.Except(SelectedSpiritIds).ToList();
        var untested = available.Where(id => !_spiritRecords.ContainsKey(id)).ToList();
        _freshChipsAreUntested = untested.Count > 0;
        var pool = _freshChipsAreUntested ? untested : available;
        return pool
            .OrderBy(id => _overallSpiritRecords.GetValueOrDefault(id)?.Played ?? 0)
            .ThenBy(id => GameLookups.SpiritFor(id)?.Name)
            .Take(4)
            .Select(id => ToChip(id, _overallSpiritRecords.GetValueOrDefault(id) ?? new SetupInsights.PlayRecord(0, 0, 0), null))
            .OfType<SpiritChip>()
            .ToList();
    }

    private string FreshPicksLabel =>
        _freshChipsAreUntested
            ? (Context.HasSelection ? "Fresh picks for this matchup" : "Spirits never played at your table")
            : "All tried — least played";

    /// <param name="scope">
    /// What the count is counting — the selection for the fielded chips, null (meaning the whole
    /// history) for the fresh picks. The two lists draw on different sets, so a shared "overall"
    /// was true of one and a lie about the other.
    /// </param>
    private SpiritChip? ToChip(string spiritId, SetupInsights.PlayRecord vs, string? scope)
    {
        var spirit = GameLookups.SpiritFor(spiritId);
        if (spirit is null) return null;
        var color = SpiritDetails.For(spirit.Id)?.ColorHex ?? GameLookups.NeutralColor;
        var tooltip = vs.Played == 0
            ? $"{spirit.Name} — never played yet"
            : $"{spirit.Name} — {vs.Played} play{Plural(vs.Played)} {scope ?? "overall"}" +
              (vs.Completed > 0 ? $", {vs.Wins} won / {vs.Losses} lost" : "");
        return new SpiritChip(spiritId, spirit.Name, color, vs.Played, vs.Completed, vs.WinRate, tooltip);
    }

    private sealed record BoardHabit(
        string SpiritName, string Color, string BoardLetter, string BoardColor,
        int Count, int Total, int Completed, double WinRate);

    private List<BoardHabit> BuildBoardHabits()
    {
        var habits = new List<BoardHabit>();
        foreach (var spiritId in SelectedSpiritIds.Where(id => !string.IsNullOrEmpty(id)).Distinct().Take(3))
        {
            var spirit = GameLookups.SpiritFor(spiritId);
            if (spirit is null) continue;
            var records = Context.BoardRecords(spiritId);
            if (records.Count == 0) continue;
            var top = records.MaxBy(kv => kv.Value.Played);
            var board = GameLookups.BoardFor(top.Key);
            if (board is null) continue;
            var boardDetail = BoardDetails.For(board.Id);
            habits.Add(new BoardHabit(
                spirit.Name,
                SpiritDetails.For(spirit.Id)?.ColorHex ?? GameLookups.NeutralColor,
                GameLookups.BoardLetter(board),
                boardDetail?.ColorHex ?? GameLookups.NeutralColor,
                top.Value.Played,
                records.Values.Sum(r => r.Played),
                top.Value.Completed,
                top.Value.WinRate));
        }
        return habits;
    }
}
