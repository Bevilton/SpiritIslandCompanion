@* Read-only display card for a recorded player: the seat the setup screen's dialog filled,
   shown as it was recorded. What the two share — the seat badge, the spirit line, the top
   accent in the spirit's colour — they share through the same components (SeatBadge,
   SpiritLine, .top-accent-lg) rather than by promise. *@

@{
    var spirit = GameLookups.SpiritFor(Player.SpiritId);
    var spiritDetail = GameLookups.DetailFor(spirit);
    var color = GameLookups.SpiritColor(spiritDetail);

    var board = GameLookups.BoardFor(Player.BoardId);
    var boardDetail = GameLookups.DetailFor(board);
    var boardColor = GameLookups.BoardColor(boardDetail);
    var boardLetter = GameLookups.BoardLetterFor(Player.BoardId) ?? "?";

    var aspect = GameLookups.AspectFor(Player.AspectId);
}

@* The band across the top is .top-accent-lg, the step a surface of its own takes — the same band
   the dialog that fills this seat wears. The wash under it is this card's alone: the 14 suffix is
   8% alpha, enough to tint the header without the card reading as coloured. *@
<article class="top-accent-lg rounded-2xl border border-ink-200"
         style="--top-accent: @color; background: linear-gradient(to bottom, @(color)14 0%, white 96px);">
    <div class="p-4 md:p-5">
        @* Header: P# badge *@
        <div class="flex items-center justify-between mb-3">
            <SeatBadge Number="Index + 1" Color="@color"/>
            @if (aspect is not null)
            {
                <span class="badge badge-sm badge-neutral">@aspect.Name</span>
            }
        </div>

        @* Main row: spirit | board | assignee *@
        <div class="grid md:grid-cols-12 gap-3">
            <div class="md:col-span-6">
                <div class="micro-label mb-1">Spirit</div>
                @if (spirit is not null)
                {
                    <div class="flex items-center gap-3">
                        <SpiritLine Color="@color" Detail="spiritDetail">
                            <Name>
                                @LinkedName(spirit.Name, GamesLink.ForSpirit(Player.SpiritId),
                                    $"See every game played as {spirit.Name}")
                            </Name>
                        </SpiritLine>
                    </div>
                }
                else
                {
                    <div class="no-value text-sm">Unknown spirit</div>
                }
            </div>

            <div class="md:col-span-3">
                <div class="micro-label mb-1">Board</div>
                @if (board is not null)
                {
                    <div class="flex items-center gap-2">
                        <LetterTile Size="xl" Color="@boardColor" Text="@boardLetter"/>
                        <div class="min-w-0 flex-1">
                            <div class="row-title truncate">
                                @LinkedName(board.Name, GamesLink.ForBoard(Player.BoardId),
                                    $"See every game with {board.Name} on the island")
                            </div>
                            @if (boardDetail is not null)
                            {
                                <div class="row-sub truncate">@boardDetail.ThematicName</div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-value text-sm">No board</div>
                }
            </div>

            <div class="md:col-span-3">
                <div class="micro-label mb-1">Played by</div>
                @{
                    var info = ResolveAssignee();
                    // Nobody named means nothing to look up — an "unassigned" slice of the
                    // history is a set of seats, not a person's record.
                    var named = Player.UserId is not null || Player.PlayerId is not null;
                }
                @if (LinkGames && named)
                {
                    <a href="@GamesLink.ForPlayer(Player.UserId, Player.PlayerId)"
                       title="@($"See every game {info.Name} sat in")"
                       class="block rounded transition-colors hover:bg-ink-50 focus-ring">
                        <PlayerAssigneeBadge Kind="@info.Kind" Name="@info.Name" DetailLabel="@info.Detail"/>
                    </a>
                }
                else
                {
                    <PlayerAssigneeBadge Kind="@info.Kind" Name="@info.Name" DetailLabel="@info.Detail"/>
                }
            </div>
        </div>
    </div>
</article>

@code {
    /// <summary>
    /// What the seat chose, as the way to every other game with it — the name itself is the
    /// link, since a card already three columns wide has no room for a control per column. The
    /// spirit and the board each wrote out the same link and the same plain fallback.
    /// </summary>
    private RenderFragment LinkedName(string name, string href, string title) => __builder =>
    {
        @if (LinkGames)
        {
            <a href="@href" title="@title" class="rounded hover:underline focus-ring">@name</a>
        }
        else
        {
            @name
        }
    };

    [Parameter, EditorRequired] public GamePlayerResponse Player { get; set; } = default!;
    [Parameter, EditorRequired] public int Index { get; set; }

    /// <summary>
    /// Whether the spirit, board and person on the card link to their own slice of the history.
    /// Off by default — see GameSetupSummary.
    /// </summary>
    [Parameter] public bool LinkGames { get; set; }

    [Parameter] public Guid? CurrentUserId { get; set; }
    [Parameter] public IReadOnlyList<FriendResponse> Friends { get; set; } = [];
    [Parameter] public IReadOnlyList<ListPlayersResponse> LocalPlayers { get; set; } = [];

    /// <param name="Detail">The line under the name where it is more than the kind — a friend's
    /// email. Null lets the badge say what kind of person this is, which is its own word for it.</param>
    private sealed record AssigneeInfo(AssigneeKind Kind, string Name, string? Detail = null);

    /// Who sat here, from the seat's ids. A friend or a guest the lists no longer hold keeps their
    /// kind and takes the badge's word for it as their name — the seat names somebody the table
    /// can no longer place, which is different from a seat nobody was named for.
    private AssigneeInfo ResolveAssignee()
    {
        if (Player.UserId is { } uid)
        {
            if (CurrentUserId == uid) return new(AssigneeKind.Me, "Me");
            var friend = Friends.FirstOrDefault(f => f.FriendUserId == uid);
            return new(AssigneeKind.Friend, friend?.Name ?? "Friend", friend?.Email);
        }

        if (Player.PlayerId is { } pid)
        {
            var player = LocalPlayers.FirstOrDefault(p => p.Id == pid);
            return new(AssigneeKind.Player, player?.Name ?? "Local player");
        }

        return new(AssigneeKind.Unknown, "Unassigned");
    }
}
