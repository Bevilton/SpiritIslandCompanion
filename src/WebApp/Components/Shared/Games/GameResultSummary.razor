@* Read-only summary of a completed game's result. Uses the same visual treatment
   as GameResultEditor's score preview so the page reads consistently before and
   after the user records the outcome. Always given a result: the page shows it only once
   there is one, so a nullable here was a guard for a state the host had already ruled out. *@

@{
    var win = Result.Win;
    @* The outcome's two tones are WinTone's, shared with the score preview this panel becomes
       once the result is saved — the two are one panel on two screens, and each had the ternary
       spelled out at four points of its own band. *@
    var caption = WinTone.OutcomeCaption(win);
    var figure = WinTone.OutcomeFigure(win);
}

<section class="panel-result @(win ? "is-win" : "is-loss") rounded-2xl overflow-hidden">
    <div class="px-5 md:px-6 py-5 flex flex-wrap items-center justify-between gap-4 border-b @(win ? "border-accent-200/60" : "border-red-200/60")">
        <div class="flex items-center gap-3">
            @* IconChip at its largest card rung — this was a hand-rolled tile a size off the
               ladder, the only glyph box in the app not drawn by the component. *@
            <IconChip Name="@(win ? "trophy" : "x")" Size="2xl" Tone="@(win ? "bg-accent-600 text-white" : "bg-red-500 text-white")"/>
            <div>
                <div class="micro-label-strong @caption">Outcome</div>
                <div class="numeral-display mt-1 text-2xl @figure">@(win ? "Victory" : "Defeat")</div>
            </div>
        </div>
        <div class="text-right">
            <div class="micro-label-strong @caption">Score</div>
            <div class="numeral-display mt-1 text-4xl @figure">@Result.Score</div>
        </div>
    </div>

    @* Every cell is the same label-over-figure pair — StatCell, shared with the record
       sheet's headline, so the two readouts of one record cannot drift apart. The band is the
       card's .surface-body, as every other card's body gutter is. *@
    <dl class="surface-body grid grid-cols-2 md:grid-cols-3 gap-x-5 gap-y-3">
        <StatCell Label="Terror level" Value="@Result.TerrorLevel.ToString()"/>
        <StatCell Label="Duration" Value="@GameFormat.Duration(Result.Duration)"/>
        <StatCell Label="@(win ? "Cards remaining" : "Cards used")" Value="@Result.Cards.ToString()"/>
        <StatCell Label="Dahan remaining" Value="@Result.Dahan.ToString()"/>
        <StatCell Label="Blight on island" Value="@Result.Blight.ToString()"/>
        @if (Result.ScoreModifier != 0)
        {
            <StatCell Label="Score modifier" Value="@GameFormat.Signed(Result.ScoreModifier)"/>
        }
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public GameResultResponse Result { get; set; } = default!;
}
