@* The island: a zoomable sea that boards are dragged around on.

   The board geometry, the interlock that makes seams flush, and the predefined
   arrangements all live in wwwroot/js/island-geometry.js (generated). Dragging,
   snapping and grouping are handled in wwwroot/js/island-playground.js — pointer
   moves must not round-trip to the server, so all interaction is client-side and
   only the resulting arrangement comes back here.                                *@

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<div class="island-pg-wrap @(_fullscreen ? "island-pg-wrap--full" : "")">
    <div @ref="_canvas" class="island-pg-host"></div>

    @* --- top-left: which arrangement is on the table --- *@
    <div class="island-pg-badge">
        <Icon Name="map" Class="w-3.5 h-3.5"/>
        <span>@LayoutLabel</span>
        @if (BoardCount > 0)
        {
            <span class="island-pg-badge__count">@BoardCount board@(BoardCount == 1 ? "" : "s")</span>
        }
    </div>

    @* --- top-right: view controls --- *@
    <div class="island-pg-tools island-pg-tools--view">
        <button type="button" @onclick="() => Zoom(1.25)" title="Zoom in" aria-label="Zoom in">
            <Icon Name="plus" Class="w-4 h-4"/>
        </button>
        <button type="button" @onclick="() => Zoom(0.8)" title="Zoom out" aria-label="Zoom out">
            <Icon Name="minus" Class="w-4 h-4"/>
        </button>
        <button type="button" @onclick="Fit" title="Fit the island in view" aria-label="Fit to view">
            <Icon Name="maximize" Class="w-4 h-4"/>
        </button>
        <button type="button" @onclick="() => SetFullscreen(!_fullscreen)"
                title="@(_fullscreen ? "Exit full screen" : "Edit full screen")"
                aria-label="@(_fullscreen ? "Exit full screen" : "Edit full screen")">
            <Icon Name="@(_fullscreen ? "minimize" : "expand")" Class="w-4 h-4"/>
        </button>
    </div>

    @* --- bottom: what you can do to the selection --- *@
    @* A locked island offers nothing to rearrange, so the whole bar collapses to the one
       thing still worth doing — setting up whoever sits on the tapped board. *@
    <div class="island-pg-tools island-pg-tools--piece">
        @if (Locked)
        {
            @if (_selected >= 0 && _selected < Boards.Count)
            {
                <button type="button" @onclick="() => ActivateBoard(_selected)" title="Set up this board">
                    <Icon Name="settings" Class="w-4 h-4"/>
                    <span class="island-pg-tools__text">Set up</span>
                </button>
            }
            else
            {
                <span class="island-pg-tools__hint">@LockedHint</span>
            }
        }
        else if (_selected >= 0)
        {
            <button type="button" @onclick="() => Rotate(-1)" title="Rotate 60° counter-clockwise">
                <Icon Name="rotate-ccw" Class="w-4 h-4"/>
            </button>
            <button type="button" @onclick="() => Rotate(1)" title="Rotate 60° clockwise">
                <Icon Name="rotate-cw" Class="w-4 h-4"/>
            </button>
            <button type="button" @onclick="Detach" disabled="@(_islandSize <= 1)"
                    title="@(_islandSize <= 1 ? "This board isn't joined to anything" : "Unstick this board from its island")">
                <Icon Name="unlink" Class="w-4 h-4"/>
                <span class="island-pg-tools__text">Unstick</span>
            </button>
            <span class="island-pg-tools__sep"></span>
            <button type="button" @onclick="() => ActivateBoard(_selected)" title="Set up this board">
                <Icon Name="settings" Class="w-4 h-4"/>
                <span class="island-pg-tools__text">Set up</span>
            </button>
        }
        else
        {
            @* Short by necessity: the toolbar is one row, and the full explanation already
               sits in the tip under the scene. With a single board there is nothing to drag
               together, so the hint points at the one thing left to do. *@
            <span class="island-pg-tools__hint">
                @(BoardCount > 1 ? "Drag boards together to click them into place" : "Tap the board to set it up")
            </span>
        }
        @if (!Locked && BoardCount > 1)
        {
            <span class="island-pg-tools__sep"></span>
            <button type="button" @onclick="Scatter" title="Pull every board apart and start over">
                <Icon Name="shuffle" Class="w-4 h-4"/>
                <span class="island-pg-tools__text">Scatter</span>
            </button>
        }
    </div>
</div>

@code {
    /// One board's presentation. Positions are owned by the playground, not by this list.
    /// <paramref name="Key"/> must be stable for the lifetime of a board: it is how the
    /// playground keeps a board where it is (and its bonds intact) when the list around it
    /// changes — removing the second of four players must not shuffle the other three.
    /// <paramref name="Seated"/> is false for a board nobody plays (the extra board), which
    /// only changes how it is labelled — it still moves, rotates and opens like any other,
    /// because which board it is still has to be chosen.
    public sealed record BoardVisual(
        string Key, string? Letter, string Color, string? SpiritColor, string? Initials, bool Error, bool Seated = true);

    [Parameter, EditorRequired] public IReadOnlyList<BoardVisual> Boards { get; set; } = [];

    /// The predefined arrangement to seed, or a custom id when the player has rearranged.
    [Parameter] public string? LayoutId { get; set; }

    /// <summary>
    /// An exact arrangement to put on the table — a saved layout out of the player's library,
    /// or one being replayed. Takes precedence over <see cref="LayoutId"/>, which can only
    /// name a published shape. The playground echoes its own geometry back through
    /// <see cref="OnLayoutChanged"/>, and ignores it coming back in, so a parent can hold the
    /// current arrangement in this parameter without the two fighting each other.
    /// </summary>
    [Parameter] public string? LayoutGeometry { get; set; }

    /// What the badge calls the arrangement on the table — a published layout's name, the name
    /// of a saved shape, or whatever the host wants to say about a one-off.
    [Parameter] public string LayoutLabel { get; set; } = "Custom";

    /// <summary>
    /// Fixes the arrangement: boards can still be selected, tapped and looked at, but not
    /// moved, rotated, unstuck or scattered. Used for thematic maps, which are one published
    /// island rather than a set of pieces to arrange.
    /// </summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>Why the island can't be rearranged — shown in place of the tools.</summary>
    [Parameter] public string LockedHint { get; set; } = "This island is fixed";

    /// <summary>
    /// Draws the island reflected left-to-right, for a layout played on the boards' reverse
    /// side. The pieces are printed on both sides and the geometry here is traced from one of
    /// them, so turning them over means seeing the same island mirrored.
    /// </summary>
    [Parameter] public bool Mirrored { get; set; }

    /// <summary>
    /// The arrangement after a change, and what it turned out to be.
    /// <para>
    /// <paramref name="MatchedLayoutId"/> is one of <see cref="CandidateLayoutIds"/> when the
    /// island is that layout, however it got there — taking a board out of Standard and
    /// clicking it back, or building Coastline by hand from scattered boards. It lets the host
    /// go back as well as forward. <paramref name="MatchesSeed"/> covers the arrangements that
    /// have no layout id, i.e. the player's own saved shapes.
    /// </para>
    /// </summary>
    public sealed record LayoutChange(string Json, string? MatchedLayoutId, bool MatchesSeed);

    /// Raised whenever the arrangement changes — including when it changes back.
    [Parameter] public EventCallback<LayoutChange> OnLayoutChanged { get; set; }

    /// <summary>
    /// Layouts a hand-built island may be recognised as. Which ones are allowed is a game rule
    /// (board count, thematic maps), so the host decides and the playground only measures.
    /// </summary>
    [Parameter] public IReadOnlyList<string> CandidateLayoutIds { get; set; } = [];

    /// A board was tapped (without dragging) or "Set up" was pressed. Raised for every board,
    /// the extra one included — what a board opens is the host's business, not this file's.
    [Parameter] public EventCallback<int> OnBoardActivated { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<IslandPlayground>? _self;

    /// <summary>
    /// Cache-buster covering the playground module and the geometry it imports, so re-running
    /// the geometry generator is picked up on the next load instead of coming back out of the
    /// browser's module cache. See <see cref="StaticAssetStamp"/>.
    /// </summary>
    private string ScriptStamp => StaticAssetStamp.For(
        Env.WebRootFileProvider, "js/island-playground.js", "js/island-geometry.js");

    private int _selected = -1;
    private int _islandSize;
    private bool _fullscreen;

    /// Set when the sea has changed size and the island has to be re-framed. The fit has to
    /// wait for the browser to lay the new size out, so it happens in OnAfterRenderAsync
    /// rather than in the handler that caused it.
    private bool _refitPending;

    private int BoardCount => Boards.Count;

    private void SetFullscreen(bool on)
    {
        if (_fullscreen == on) return;
        _fullscreen = on;
        _refitPending = true;
    }

    /// Tracks what we last pushed so we only re-seed when something actually changed.
    private int _pushedCount = -1;
    private string? _pushedLayoutId;
    private string? _pushedSignature;
    private bool? _pushedLocked;
    private bool? _pushedMirrored;
    private string? _pushedCandidates;

    /// The geometry the playground and the host already agree on — set both when we push an
    /// arrangement in and when one comes back out, so an echo is never re-applied.
    private string? _pushedGeometry;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", $"./js/island-playground.js?v={ScriptStamp}");
            _self = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<IJSObjectReference>("createForBlazor", _canvas, _self);

            // The component can be disposed while those awaits are in flight (the user
            // navigated away); DisposeAsync saw null handles then, so clean up here.
            if (_disposed)
            {
                await CleanupJsAsync();
                return;
            }
        }
        if (_disposed || _handle is not { } handle) return;

        // DisposeAsync can run between any two of the pushes' awaits (the user navigated
        // away); the local keeps the calls off a nulled field, and the catches keep a handle
        // or circuit that died mid-render from taking the whole circuit down with it.
        try
        {
            await PushStateAsync(handle);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task PushStateAsync(IJSObjectReference handle)
    {
        if (_pushedLocked != Locked)
        {
            _pushedLocked = Locked;
            await handle.InvokeVoidAsync("setLocked", Locked);
        }

        if (_pushedMirrored != Mirrored)
        {
            _pushedMirrored = Mirrored;
            await handle.InvokeVoidAsync("setMirrored", Mirrored);
        }

        var candidates = string.Join(',', CandidateLayoutIds);
        if (_pushedCandidates != candidates)
        {
            _pushedCandidates = candidates;
            await handle.InvokeVoidAsync("setCandidates", CandidateLayoutIds);
        }

        // This page re-renders on every unrelated interaction (typing a note, opening a
        // picker); only cross the interop boundary when a board actually looks different.
        var signature = string.Join('|', Boards.Select(b =>
            $"{b.Key}{b.Letter}{b.Color}{b.SpiritColor}{b.Initials}{b.Error}{b.Seated}"));
        if (signature != _pushedSignature)
        {
            _pushedSignature = signature;
            await handle.InvokeVoidAsync("setBoards", Boards.Select(b => new
            {
                key = b.Key, letter = b.Letter, color = b.Color, spiritColor = b.SpiritColor,
                initials = b.Initials, error = b.Error, seated = b.Seated,
            }));
        }

        // Seed the arrangement when the board count changes, a different predefined layout is
        // picked, or an exact arrangement is handed in. A custom id on its own means the player
        // is arranging it themselves — never stomp on their work.
        var countChanged = _pushedCount != Boards.Count;
        var layoutChanged = _pushedLayoutId != LayoutId;
        var geometryChanged = _pushedGeometry != LayoutGeometry;
        _pushedCount = Boards.Count;
        _pushedLayoutId = LayoutId;
        _pushedGeometry = LayoutGeometry;

        // Both of the seeding calls fit the island themselves.
        if (geometryChanged && !string.IsNullOrEmpty(LayoutGeometry))
        {
            _refitPending = false;
            await handle.InvokeVoidAsync("setLayoutJson", LayoutGeometry);
        }
        else if ((countChanged || layoutChanged) && !string.IsNullOrEmpty(LayoutId) && !IslandSetups.IsCustomId(LayoutId))
        {
            // Seeding declines to move an island that already is the layout — the player having
            // just built it is how the id changed in the first place. Nothing is re-placed and
            // nothing re-framed then, so a pending refit still has to run.
            if (await handle.InvokeAsync<bool>("applyLayout", LayoutId)) _refitPending = false;
        }
        else if (countChanged || _refitPending)
        {
            _refitPending = false;
            await handle.InvokeVoidAsync("fit");

            // Boards came or went and no layout re-seeded the island — which only happens
            // while the arrangement is a hand-built one. Whatever geometry the host is
            // holding describes the old set of boards, so hand back the island as it now
            // stands; otherwise a four-board arrangement would be saved for a three-board game.
            if (countChanged) await PushCurrentArrangement(handle);
        }
    }

    private async Task PushCurrentArrangement(IJSObjectReference handle)
    {
        if (!OnLayoutChanged.HasDelegate) return;
        var now = await handle.InvokeAsync<LayoutChange>("arrangement");
        _pushedGeometry = now.Json;
        await OnLayoutChanged.InvokeAsync(now);
    }

    [JSInvokable]
    public Task OnLayoutChangedFromJs(string json, string? matchedLayoutId, bool matchesSeed)
    {
        // Ours now — don't push it straight back in when the host hands it to us as a parameter.
        _pushedGeometry = json;
        return OnLayoutChanged.InvokeAsync(new LayoutChange(json, matchedLayoutId, matchesSeed));
    }

    [JSInvokable]
    public Task OnSelectionChanged(int index, int islandSize)
    {
        _selected = index;
        _islandSize = islandSize;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBoardTapped(int index) => ActivateBoard(index);

    /// Hand the board off to the host. Full screen has to give way first: whatever the host
    /// opens in response (the seat dialog) would otherwise be buried under the sea, which
    /// covers the page while full screen is on.
    private async Task ActivateBoard(int index)
    {
        if (index < 0 || index >= Boards.Count) return;
        if (_fullscreen)
        {
            SetFullscreen(false);
            // Reached from a JS tap, which re-renders nothing by itself — same as OnSelectionChanged.
            StateHasChanged();
        }
        await OnBoardActivated.InvokeAsync(index);
    }

    private async Task Rotate(int dir) { if (_handle is not null) await _handle.InvokeVoidAsync("rotate", dir); }
    private async Task Detach() { if (_handle is not null) await _handle.InvokeVoidAsync("detach"); }
    private async Task Scatter() { if (_handle is not null) await _handle.InvokeVoidAsync("scatter"); }
    private async Task Fit() { if (_handle is not null) await _handle.InvokeVoidAsync("fit"); }
    private async Task Zoom(double mult) { if (_handle is not null) await _handle.InvokeVoidAsync("zoom", mult); }

    private bool _disposed;

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return new ValueTask(CleanupJsAsync());
    }

    private async Task CleanupJsAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* circuit already gone */ }
        _handle = null;
        _module = null;
        _self?.Dispose();
        _self = null;
    }
}
