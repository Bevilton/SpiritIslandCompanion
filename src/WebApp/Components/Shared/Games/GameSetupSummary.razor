@* Read-only visual summary of how a recorded game was set up — island layout,
   scenario, adversaries — plus a difficulty hero. Companion to GamePlayerCard. *@

@{
    var setup = GameLookups.IslandSetupFor(IslandSetupId);
    var scenario = GameLookups.ScenarioFor(ScenarioId);
    var adversaries = Adversaries
        .Select(a => (Item: a, Adversary: GameLookups.AdversaryFor(a.AdversaryId)))
        .Where(x => x.Adversary is not null)
        .ToList();

    @* What made the difficulty, from the same place the setup screen's dial reads it — the two
       are one explanation of one formula, and each used to keep its own copy of which things
       count. Only the foes still in the catalogue, as the adversaries section below lists: one
       played from a box since removed has a name nobody can look up.

       The extra board's letter is left out here: the island line below already names it in a
       chip, and repeating it in the total's breakdown says it twice. *@
    var contributions = DifficultyBreakdown.Of(
        adversaries.Select(x => (x.Item.AdversaryId, x.Item.Level)),
        ScenarioId, ExtraBoard, extraBoardLetter: null, ThematicMaps, DifficultyModifier);
}

<section class="surface overflow-hidden">
    @* Difficulty hero — .panel-result's jade band, the same gradient the result panels are built
       from, worn as the card's top band rather than as a panel of its own. *@
    <div class="panel-result is-win border-x-0 border-t-0 p-5 flex items-center justify-between gap-4">
        <div>
            <div class="micro-label-strong text-accent-700">Total difficulty</div>
            <div class="numeral-display mt-1 text-4xl text-accent-900">@Difficulty</div>
        </div>
        <div class="text-xs text-accent-800/70 text-right space-y-0.5">
            @if (contributions.Count == 0)
            {
                <div>@GameLookups.StandardGameTitle</div>
            }
            else
            {
                @foreach (var line in contributions)
                {
                    <div>@line.Label <span class="text-accent-700/60">@GameFormat.Signed(line.Amount)</span></div>
                }
            }
        </div>
    </div>

    @* Island layout — the card's .surface-body, as the two bands under it are its .surface-foot;
       all three had spelled the gutters out by hand, with the rule a shade off the class's. *@
    <div class="surface-body flex items-center gap-4">
        <div class="h-20 w-20 shrink-0 flex items-center justify-center">
            @* A hand-built island has no published picture, but the game kept its own copy of
               the arrangement — so the record shows the island as it was actually played. The
               label is the saved shape's name when it had one; a published layout passes none
               and keeps its own. *@
            <IslandSetupDiagram Setup="setup" Geometry="@IslandLayoutJson"
                                Label="@CustomLayoutName"/>
        </div>
        <div class="min-w-0 flex-1">
            <div class="micro-label">Island setup</div>
            @* A hand-built island shows the saved shape's name when it came from the layout
               library; the placeholder setup only knows it as "Custom". *@
            <div class="card-title mt-0.5 truncate">
                @(CustomLayoutName ?? setup?.Name ?? "Unknown layout")
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-1.5">
                @if (setup is not null)
                {
                    <span class="row-sub">@Copy.Count(setup.BoardCount, "board")</span>
                }
                @* SetupChip — the same chip the games list puts beside a match's title for the
                   same facts, so a game reads the same way in the list and on its own page. *@
                @if (IsCustom)
                {
                    <SetupChip Icon="map" Label="Custom island"
                               Title="@(CustomLayoutName is null
                                   ? "A one-off island arranged by hand for this game."
                                   : $"Played on \"{CustomLayoutName}\", a hand-built shape from the layout library.")"/>
                }
                @if (ThematicMaps)
                {
                    <SetupChip Label="Thematic"/>
                }
                @if (ExtraBoard)
                {
                    @* Games recorded before the extra board's letter was asked for have none to
                       show, so the chip falls back to just saying there was one. *@
                    <SetupChip Label="@($"Extra board{(ExtraBoardLetter is { } letter ? $" · {letter}" : "")}")"
                               Title="@(ExtraBoardLetter is null
                                   ? "An extra board was played; which one wasn't recorded."
                                   : $"Board {ExtraBoardLetter} was on the island with no spirit on it.")"/>
                }
            </div>
        </div>
    </div>

    @* Adversaries *@
    @if (adversaries.Count > 0)
    {
        <div class="surface-foot">
            <div class="micro-label mb-2">@Copy.Noun(adversaries.Count, "Adversary")</div>
            <div class="grid sm:grid-cols-2 gap-2.5">
                @foreach (var (item, adv) in adversaries)
                {
                    var mode = adv!.Modes.FirstOrDefault(m => m.Level == item.Level);
                    @Face("shield", "bg-accent-50 text-accent-700", adv.Name,
                        $"Level {item.Level} · +{mode?.Difficulty ?? 0} difficulty",
                        GamesLink.ForAdversary(item.AdversaryId, item.Level),
                        $"See every game against {adv.Name} at level {item.Level}")
                }
            </div>
        </div>
    }

    @* Scenario *@
    @if (scenario is not null)
    {
        <div class="surface-foot">
            <div class="micro-label mb-2">Scenario</div>
            @Face("book", "bg-accent-100 text-accent-700", scenario.Name,
                $"+{scenario.Difficulty} difficulty",
                GamesLink.ForScenario(scenario.Id.Value),
                $"See every game in {scenario.Name}")
        </div>
    }
</section>

@code {
    /// <summary>
    /// One thing the game was set up against — a foe at a level, or the scenario. Given
    /// <see cref="LinkGames"/> the same card becomes the way sideways: from this evening to
    /// every other night with the same foe. The linked and unlinked forms were written out
    /// twice each, once per subject, for four copies of one card.
    /// </summary>
    private RenderFragment Face(string icon, string iconTone, string name, string detail,
        string href, string title) => __builder =>
    {
        var body = FaceBody(icon, iconTone, name, detail);
        @if (LinkGames)
        {
            <a href="@href" title="@title"
               class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3 transition-colors
                      hover:border-accent-300 hover:bg-accent-50/40 focus-ring">@body</a>
        }
        else
        {
            <div class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3">@body</div>
        }
    };

    private static RenderFragment FaceBody(string icon, string iconTone, string name, string detail) =>
        @<text>
            <IconChip Name="@icon" Tone="@iconTone"/>
            <div class="min-w-0 flex-1">
                <div class="row-title truncate">@name</div>
                <div class="row-sub">@detail</div>
            </div>
        </text>;

    /// <summary>
    /// Whether the foe and scenario cards link to every other game with them. Off by default:
    /// only a record of a played game has other games to compare itself with.
    /// </summary>
    [Parameter] public bool LinkGames { get; set; }

    [Parameter, EditorRequired] public string IslandSetupId { get; set; } = "";

    /// <summary>The saved layout the island came from, when it was one — see GetGameResponse.</summary>
    [Parameter] public string? CustomLayoutName { get; set; }

    /// <summary>
    /// The arrangement this game was played on, for a hand-built island — the game's own copy,
    /// so it shows the island as played even if the shape it came from has since been reshaped
    /// or deleted. Null on games recorded before the island was kept, which fall back to the
    /// board-count placeholder.
    /// </summary>
    [Parameter] public string? IslandLayoutJson { get; set; }

    private bool IsCustom => IslandSetups.IsCustomId(IslandSetupId);

    [Parameter] public bool ExtraBoard { get; set; }

    /// <summary>Which lettered board was the extra one; null when the game didn't record it.</summary>
    [Parameter] public string? ExtraBoardId { get; set; }

    private string? ExtraBoardLetter =>
        GameLookups.BoardLetterFor(ExtraBoardId);
    [Parameter] public bool ThematicMaps { get; set; }
    [Parameter] public int Difficulty { get; set; }
    [Parameter] public int DifficultyModifier { get; set; }
    [Parameter] public string? ScenarioId { get; set; }
    [Parameter] public IReadOnlyList<GameAdversaryResponse> Adversaries { get; set; } = [];
}
