@* Read-only visual summary of how a recorded game was set up — island layout,
   scenario, adversaries — plus a difficulty hero. Companion to GamePlayerCard. *@

@{
    var setup = GameLookups.IslandSetupFor(IslandSetupId);
    var scenario = GameLookups.ScenarioFor(ScenarioId);
    var adversaries = Adversaries
        .Select(a => (Item: a, Adversary: GameLookups.AdversaryFor(a.AdversaryId)))
        .Where(x => x.Adversary is not null)
        .ToList();

    var isStandardGame = adversaries.Count == 0 && scenario is null && !ExtraBoard && !ThematicMaps && DifficultyModifier == 0;
}

<section class="surface overflow-hidden">
    @* Difficulty hero *@
    <div class="bg-gradient-to-br from-accent-50 to-accent-100/60 border-b border-accent-200 p-5 flex items-center justify-between gap-4">
        <div>
            <div class="text-[11px] uppercase tracking-wider text-accent-700 font-semibold">Total difficulty</div>
            <div class="text-4xl font-bold text-accent-900 mt-1 leading-none" style="font-family: var(--font-serif);">@Difficulty</div>
        </div>
        <div class="text-xs text-accent-800/70 text-right space-y-0.5">
            @if (isStandardGame)
            {
                <div>@GameLookups.StandardGameTitle</div>
            }
            else
            {
                @foreach (var (item, adv) in adversaries)
                {
                    var mode = adv!.Modes.FirstOrDefault(m => m.Level == item.Level);
                    <div>@adv.Name L@(item.Level) <span class="text-accent-700/60">+@(mode?.Difficulty ?? 0)</span></div>
                }
                @if (scenario is not null)
                {
                    <div>@scenario.Name <span class="text-accent-700/60">+@scenario.Difficulty</span></div>
                }
                @if (ExtraBoard)
                {
                    <div>Extra board <span class="text-accent-700/60">+@GameRestrictions.ExtraBoardDifficultyBonus</span></div>
                }
                @if (ThematicMaps)
                {
                    <div>Thematic maps <span class="text-accent-700/60">+@GameRestrictions.ThematicMapsDifficultyBonus</span></div>
                }
                @if (DifficultyModifier != 0)
                {
                    <div>Modifier <span class="text-accent-700/60">@(DifficultyModifier > 0 ? "+" : "")@DifficultyModifier</span></div>
                }
            }
        </div>
    </div>

    @* Island layout *@
    <div class="px-5 md:px-6 py-5 flex items-center gap-4">
        <div class="h-20 w-20 shrink-0 flex items-center justify-center">
            @* A hand-built island has no published picture, but the game kept its own copy of
               the arrangement — so the record shows the island as it was actually played. The
               label is the saved shape's name when it had one; a published layout passes none
               and keeps its own. *@
            <IslandSetupDiagram Setup="setup" Geometry="@IslandLayoutJson"
                                Label="@CustomLayoutName" Class="max-h-full max-w-full"/>
        </div>
        <div class="min-w-0 flex-1">
            <div class="text-[10px] uppercase tracking-wide text-ink-500 font-medium">Island setup</div>
            @* A hand-built island shows the saved shape's name when it came from the layout
               library; the placeholder setup only knows it as "Custom". *@
            <div class="mt-0.5 text-base font-semibold text-ink-900 truncate">
                @(CustomLayoutName ?? setup?.Name ?? "Unknown layout")
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-1.5">
                @if (setup is not null)
                {
                    <span class="text-[11px] text-ink-500">@setup.NumberOfPlayers @(setup.NumberOfPlayers == 1 ? "board" : "boards")</span>
                }
                @if (IsCustom)
                {
                    <span class="inline-flex items-center text-[10px] uppercase tracking-wider text-sky-700 bg-sky-50 px-1.5 py-0.5 rounded"
                          title="@(CustomLayoutName is null ? "A one-off island arranged by hand for this game." : $"Played on \"{CustomLayoutName}\", a hand-built shape from the layout library.")">
                        Custom island
                    </span>
                }
                @if (ThematicMaps)
                {
                    <span class="inline-flex items-center text-[10px] uppercase tracking-wider text-accent-700 bg-accent-50 px-1.5 py-0.5 rounded">Thematic</span>
                }
                @if (ExtraBoard)
                {
                    @* Games recorded before the extra board's letter was asked for have none to
                       show, so the chip falls back to just saying there was one. *@
                    <span class="inline-flex items-center text-[10px] uppercase tracking-wider text-accent-700 bg-accent-50 px-1.5 py-0.5 rounded"
                          title="@(ExtraBoardLetter is null ? "An extra board was played; which one wasn't recorded." : $"Board {ExtraBoardLetter} was on the island with no spirit on it.")">
                        Extra board@(ExtraBoardLetter is { } letter ? $" · {letter}" : "")
                    </span>
                }
            </div>
        </div>
    </div>

    @* Adversaries *@
    @if (adversaries.Count > 0)
    {
        <div class="px-5 md:px-6 py-4 border-t border-ink-100">
            <div class="text-[10px] uppercase tracking-wide text-ink-500 font-medium mb-2">
                @(adversaries.Count > 1 ? "Adversaries" : "Adversary")
            </div>
            @* Given LinkGames the card is the way sideways: from this evening to every other
               night against the same foe at the same level. Nothing new on the page — the card
               that was already there simply becomes a link. *@
            <div class="grid sm:grid-cols-2 gap-2.5">
                @foreach (var (item, adv) in adversaries)
                {
                    var mode = adv!.Modes.FirstOrDefault(m => m.Level == item.Level);
                    var face = ((RenderFragment)(@<text>
                        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent-50 text-accent-700 shrink-0">
                            <Icon Name="shield" Class="w-4 h-4"/>
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-semibold text-ink-900 truncate">@adv.Name</div>
                            <div class="text-[11px] text-ink-500">Level @item.Level · +@(mode?.Difficulty ?? 0) difficulty</div>
                        </div>
                    </text>));
                    @if (LinkGames)
                    {
                        <a href="@GamesLink.ForAdversary(item.AdversaryId, item.Level)"
                           title="@($"See every game against {adv.Name} at level {item.Level}")"
                           class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3 transition-colors
                                  hover:border-accent-300 hover:bg-accent-50/40
                                  focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                            @face
                        </a>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3">@face</div>
                    }
                }
            </div>
        </div>
    }

    @* Scenario *@
    @if (scenario is not null)
    {
        <div class="px-5 md:px-6 py-4 border-t border-ink-100">
            <div class="text-[10px] uppercase tracking-wide text-ink-500 font-medium mb-2">Scenario</div>
            @{
                var scenarioFace = ((RenderFragment)(@<text>
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent-100 text-accent-700 shrink-0">
                        <Icon Name="book" Class="w-4 h-4"/>
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-semibold text-ink-900 truncate">@scenario.Name</div>
                        <div class="text-[11px] text-ink-500">+@scenario.Difficulty difficulty</div>
                    </div>
                </text>));
            }
            @if (LinkGames)
            {
                <a href="@GamesLink.ForScenario(scenario.Id.Value)"
                   title="@($"See every game in {scenario.Name}")"
                   class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3 transition-colors
                          hover:border-accent-300 hover:bg-accent-50/40
                          focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                    @scenarioFace
                </a>
            }
            else
            {
                <div class="flex items-center gap-3 rounded-lg border border-ink-200 bg-white p-3">@scenarioFace</div>
            }
        </div>
    }
</section>

@code {
    /// <summary>
    /// Whether the foe and scenario cards link to every other game with them. Off by default:
    /// only a record of a played game has other games to compare itself with.
    /// </summary>
    [Parameter] public bool LinkGames { get; set; }

    [Parameter, EditorRequired] public string IslandSetupId { get; set; } = "";

    /// <summary>The saved layout the island came from, when it was one — see GetGameResponse.</summary>
    [Parameter] public string? CustomLayoutName { get; set; }

    /// <summary>
    /// The arrangement this game was played on, for a hand-built island — the game's own copy,
    /// so it shows the island as played even if the shape it came from has since been reshaped
    /// or deleted. Null on games recorded before the island was kept, which fall back to the
    /// board-count placeholder.
    /// </summary>
    [Parameter] public string? IslandLayoutJson { get; set; }

    private bool IsCustom => IslandSetups.IsCustomId(IslandSetupId);

    [Parameter] public bool ExtraBoard { get; set; }

    /// <summary>Which lettered board was the extra one; null when the game didn't record it.</summary>
    [Parameter] public string? ExtraBoardId { get; set; }

    private string? ExtraBoardLetter =>
        GameLookups.BoardFor(ExtraBoardId) is { } b ? GameLookups.BoardLetter(b) : null;
    [Parameter] public bool ThematicMaps { get; set; }
    [Parameter] public int Difficulty { get; set; }
    [Parameter] public int DifficultyModifier { get; set; }
    [Parameter] public string? ScenarioId { get; set; }
    [Parameter] public IReadOnlyList<Application.Features.Games.Dtos.GameAdversaryResponse> Adversaries { get; set; } = [];
}
