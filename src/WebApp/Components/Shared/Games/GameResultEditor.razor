@* Editor for the result of a played game — Win/Defeat hero, stats grid, and a live
   score preview. Used by:
   • GameForm  — wrapped in an "include result" toggle, score is provisional.
   • GameDetail — shown when completing a draft, score is provisional too.

   The seven numbers are one object, the page's own GameResultDraft, written straight into by
   the fields below. It was fourteen parameters — a value and a callback per number — and the
   two pages then held seven mirror fields each and computed the provisional score themselves.
   The component is still presentation-only: the calling page owns the draft and sends it to
   the appropriate Create / Complete command. *@

<div class="space-y-5">
    @* Win/Defeat hero choice *@
    <div class="grid grid-cols-2 gap-2">
        <button type="button" @onclick="() => Set(r => r.Win = true)"
                class="@(Result.Win ? "border-accent-500 bg-accent-50 text-accent-800 ring-2 ring-accent-500/30" : "border-ink-200 bg-white text-ink-600 hover:border-ink-300")
                       flex items-center justify-center gap-2 rounded-xl border px-4 py-3 transition-all focus-ring">
            <Icon Name="trophy" Class="w-5 h-5"/>
            <span class="font-semibold">Victory</span>
        </button>
        <button type="button" @onclick="() => Set(r => r.Win = false)"
                class="@(!Result.Win ? "border-red-400 bg-red-50 text-red-800 ring-2 ring-red-300/40" : "border-ink-200 bg-white text-ink-600 hover:border-ink-300")
                       flex items-center justify-center gap-2 rounded-xl border px-4 py-3 transition-all focus-ring">
            <Icon Name="x" Class="w-5 h-5"/>
            <span class="font-semibold">Defeat</span>
        </button>
    </div>

    @* Stats grid *@
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
        <div>
            <label class="label label-hint">
                <span>Terror level</span>
                <InfoHint>
                    <strong class="text-ink-900">Terror level reached</strong> when the game ended. Tracked for reference but does not affect the score.
                </InfoHint>
            </label>
            <select class="select" value="@Result.TerrorLevel" @onchange="OnTerrorChanged">
                @foreach (var t in Enum.GetValues<TerrorLevel>())
                {
                    <option value="@t">@t</option>
                }
            </select>
            <FieldError For="Result.TerrorLevel" Errors="@Errors"/>
        </div>
        <div>
            <label class="label">Duration (min)</label>
            <input type="number" class="input" value="@Result.DurationMinutes"
                   @onchange="e => SetInt(e, (r, v) => r.DurationMinutes = v)" min="0"/>
            <FieldError For="Result.Duration" Errors="@Errors"/>
        </div>
        <div>
            <label class="label label-hint">
                <span>Dahan remaining</span>
                <InfoHint>
                    <strong class="text-ink-900">Dahan tokens left on the island</strong> when the game ends. Every <span class="text-ink-900">@EffectivePlayers</span> Dahan adds <span class="text-ink-900">+1</span> to your score.
                </InfoHint>
            </label>
            <input type="number" class="input" value="@Result.Dahan"
                   @onchange="e => SetInt(e, (r, v) => r.Dahan = v)" min="0"/>
            <FieldError For="Result.Dahan" Errors="@Errors"/>
        </div>
        <div>
            <label class="label label-hint">
                <span>Blight on island</span>
                <InfoHint>
                    <strong class="text-ink-900">Total Blight tokens on the island</strong> when the game ends. Every <span class="text-ink-900">@EffectivePlayers</span> Blight subtracts <span class="text-ink-900">−1</span> from your score.
                </InfoHint>
            </label>
            <input type="number" class="input" value="@Result.Blight"
                   @onchange="e => SetInt(e, (r, v) => r.Blight = v)" min="0"/>
            <FieldError For="Result.Blight" Errors="@Errors"/>
        </div>
        <div>
            <label class="label label-hint">
                @if (Result.Win)
                {
                    <span>Cards remaining in invader deck</span>
                    <InfoHint>
                        Cards <strong class="text-ink-900">left undrawn</strong> in the invader deck at the end. Each remaining card adds <span class="text-ink-900">+2</span> to your score.
                    </InfoHint>
                }
                else
                {
                    <span>Enemy cards used</span>
                    <InfoHint>
                        Invader cards <strong class="text-ink-900">played or discarded</strong> during the game (not left in the deck). Each used card adds <span class="text-ink-900">+1</span> to your score.
                    </InfoHint>
                }
            </label>
            <input type="number" class="input" value="@Result.Cards"
                   @onchange="e => SetInt(e, (r, v) => r.Cards = v)" min="0"/>
            <FieldError For="Result.Cards" Errors="@Errors"/>
        </div>
        <div>
            <label class="label label-hint">
                <span>Score modifier</span>
                <InfoHint>
                    Manual <strong class="text-ink-900">+/− adjustment</strong> for unusual circumstances — homemade variants, scenario-specific bonuses, or anything the standard formula doesn't capture. Leave at 0 for ordinary games.
                </InfoHint>
            </label>
            <input type="number" class="input" value="@Result.ScoreModifier"
                   @onchange="e => SetInt(e, (r, v) => r.ScoreModifier = v)"/>
            <FieldError For="Result.ScoreModifier" Errors="@Errors"/>
        </div>
    </div>

    @* Live score breakdown — the calculator's own terms (ScoreBreakdown), so the lines and the
       figure they add up to cannot drift apart. *@
    @{ var win = Result.Win; }
    @* The panel's tones are WinTone's, shared with the saved result this preview becomes —
       see GameResultSummary, which is the same band on the game's own page. *@
    <div class="panel-result @(win ? "is-win" : "is-loss") rounded-xl p-5 flex items-center justify-between gap-4">
        <div>
            <div class="micro-label-strong @WinTone.OutcomeCaption(win)">Score preview</div>
            <div class="numeral-display mt-1 text-4xl @WinTone.OutcomeFigure(win)">@ComputedScore</div>
            <div class="mt-1 text-[11px] @(win ? "text-accent-800/70" : "text-red-800/70")">@(win ? "Victory formula" : "Defeat formula")</div>
        </div>
        <div class="text-xs @(win ? "text-accent-800/80" : "text-red-800/80") text-right space-y-0.5 tabular-nums">
            @foreach (var line in ScoreBreakdown.Of(Result, Difficulty, PlayerCount))
            {
                <div>@line.Label <span class="opacity-70">@GameFormat.Signed(line.Amount)</span></div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>The outcome being entered. Edited in place — see <see cref="OnChanged"/>.</summary>
    [Parameter, EditorRequired] public GameResultDraft Result { get; set; } = default!;

    [Parameter] public int Difficulty { get; set; }
    [Parameter] public int PlayerCount { get; set; } = 1;
    [Parameter] public FormErrors? Errors { get; set; }

    /// <summary>
    /// Raised after every edit. The draft is the page's own object, so nothing about it is a
    /// parameter change the host would notice — this is what re-renders whatever the page shows
    /// about the outcome, the live score in its action bar above all.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private int EffectivePlayers => Math.Max(1, PlayerCount);

    private int ComputedScore => Result.Score(Difficulty, PlayerCount);

    private Task Set(Action<GameResultDraft> edit)
    {
        edit(Result);
        return OnChanged.InvokeAsync();
    }

    private Task OnTerrorChanged(ChangeEventArgs e) =>
        Enum.TryParse<TerrorLevel>(e.Value?.ToString(), out var t)
            ? Set(r => r.TerrorLevel = t)
            : Task.CompletedTask;

    /// A blank or unparseable number field reads as zero rather than as "leave it alone" — the
    /// input is cleared to type a new figure, and the preview has to follow it down.
    private Task SetInt(ChangeEventArgs e, Action<GameResultDraft, int> edit)
    {
        var value = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 0;
        return Set(r => edit(r, value));
    }
}
