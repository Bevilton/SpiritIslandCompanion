@* The "your record" affordance every catalogue card shares: the record numbers themselves,
   rendered as one labelled pill.

   With OnClick it is a button that opens the entity's record sheet; a trailing chevron says
   so. Without OnClick the same pill renders as a passive span — for the browse cards, whose
   whole card already opens the sheet, where a second control doing the same thing would be
   noise (and a button may not contain a button).

   Three states: a record ("7× · 67%"), never played while a history exists (the host words
   it — played / faced / used, scoped where the host is), and no history at all, where it
   says "Details" — the sheet still holds the reference text, so the door stays visible. *@

@if (OnClick.HasDelegate)
{
    <button type="button" @onclick="OnClick" title="@Tooltip" aria-label="@Tooltip" class="@Classes">
        @Content
    </button>
}
else
{
    <span class="@Classes" title="@Tooltip">@Content</span>
}

@code {
    /// <summary>The record shown. Null or zero plays renders the never-state.</summary>
    [Parameter] public SetupInsights.PlayRecord? Record { get; set; }

    /// <summary>
    /// Whether any history exists at all. Without one there is nothing to be "never played"
    /// against, so the pill offers the reference sheet as plain "Details" instead.
    /// </summary>
    [Parameter] public bool HasHistory { get; set; } = true;

    /// <summary>What the sheet is about — "Lightning's Swift Strike". Used in the tooltip.</summary>
    [Parameter, EditorRequired] public string Subject { get; set; } = "";

    /// <summary>The never-state wording — played, faced, used; scoped when the host is.</summary>
    [Parameter] public string NeverLabel { get; set; } = "Never played";

    /// <summary>Marks the leader — the board picker's favourite star.</summary>
    [Parameter] public bool Starred { get; set; }

    /// <summary>Opens the record sheet. Omit inside a card that opens it itself.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private bool Never => HasHistory && Record is not { Played: > 0 };

    private string Tooltip => Copy.SheetTooltip(Subject, HasHistory);

    /// The ring and the transition come with being drawn as a button (see button.chip in site.css);
    /// .untried carries the never-state's tone and its own hover, so only the played pill needs
    /// naming as a door.
    private string Classes
    {
        get
        {
            var chrome = Never
                ? "untried"
                : Starred
                    ? "border-accent-300 bg-accent-50/70 text-accent-800"
                    : "chip-neutral";
            var door = OnClick.HasDelegate && !Never ? " chip-door" : "";
            return $"chip chip-sm {chrome}{door}";
        }
    }

    private RenderFragment Content => __builder =>
    {
        if (!HasHistory)
        {
            <Icon Name="chart" Class="w-3 h-3"/>
            <span>Details</span>
        }
        else if (Never)
        {
            <Icon Name="sparkles" Class="w-3 h-3"/>
            <span>@NeverLabel</span>
        }
        else
        {
            <Icon Name="@(Starred ? "star" : "chart")" Class="w-3 h-3"/>
            <span class="tabular-nums font-medium">@(Record!.Played)×</span>
            @if (Record.Completed > 0)
            {
                <WinRateFigure Value="Record.WinRate"/>
            }
        }
        @if (OnClick.HasDelegate)
        {
            <Icon Name="chevron-right" Class="w-2.5 h-2.5 opacity-60"/>
        }
    };
}
