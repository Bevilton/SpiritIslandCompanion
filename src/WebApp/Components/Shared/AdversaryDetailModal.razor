@* Adversary reference sheet. Given Facts it also profiles the record against this foe
   — including per level inside the difficulty grid — and given OnSelected a level can
   be picked straight from here.

   The levels double as the record's focus: outside the picker, tapping a level narrows
   the profile below to the games at that level alone, and tapping it again widens back
   to every level — the same switch the spirit sheet gives its aspects, because a level
   is to a foe what an aspect is to a spirit. The way out to those games is the
   profile's own "See all games" link, which follows the focus.

   A foe is the whole table's, so a host that scopes to one person scopes by the games
   they sat in rather than by seats — see DetailSheetBase. SubjectName names them, and
   every heading and link here follows. *@
@inherits DetailSheetBase

@if (_adversary is not null)
{
    var detail = _detail;

    <ModalShell OnClose="Close" ZIndex="@SheetZIndex" MaxWidth="@SheetWidth">
        <DetailModalHeader Title="@_adversary.Name" OnClose="Close">
            <Glyph><Icon Name="shield" Class="w-6 h-6 text-accent-700 shrink-0 mt-1"/></Glyph>
            <Badges>
                <span class="badge badge-neutral">@GameLookups.ExpansionName(_adversary.ExpansionId)</span>
                @if (detail is not null)
                {
                    <span>· @detail.Theme</span>
                }
            </Badges>
        </DetailModalHeader>

        <div class="sheet-body space-y-6">
            <SheetSummary Text="@detail?.Summary"/>

            @* The one grid that carries both the rules and the record — the same strip the
               catalogue card and the statistics card draw (see AdversaryLevelGrid), so a
               level reads the same wherever it is met. In the picker a tap takes the level;
               everywhere else it focuses the profile below on it. *@
            <div>
                <SectionHead Size="label" Level="3" Title="@LevelGridTitle"/>
                <AdversaryLevelGrid Adversary="_adversary"
                                    Records="@AdversaryLevelGrid.RecordsFor(_facing, Profile is not null)"
                                    OnPick="LevelTap" Current="_level"
                                    TapHint="@(OnSelected.HasDelegate ? "Tap to play it." : "Tap to focus the record on this level.")"
                                    CurrentHint="The record below is focused on this level — tap again for every level."/>
                <p class="block-note mt-2">
                    Each level adds escalation rules.
                    @if (OnSelected.HasDelegate)
                    {
                        <text>Tap a level to play it.</text>
                    }
                    else if (Profile is not null)
                    {
                        <text>Tap a level to focus the record on it — tap again for every level.</text>
                    }
                    else
                    {
                        <text>See the wiki for the per-level setup and rules text.</text>
                    }
                </p>
            </div>

            @if (Profile is not null)
            {
                <SetupProfileSection Profile="Profile" Name="@ProfileName"
                                     Scoped="Scoped" SubjectName="@SubjectName"
                                     Title="@ProfileTitle"
                                     LinkGames="LinkGames"
                                     AllGamesHref="@GamesLink.ForAdversary(_adversary.Id.Value, _level, who: ScopeWho)"/>
            }

            <SheetWikiLink Name="@_adversary.Name"/>
        </div>

        @if (OnSelected.HasDelegate)
        {
            <SheetFooter BackLabel="adversaries" OnBack="Close">
                <span class="block-note">Pick a level above to add this foe.</span>
            </SheetFooter>
        }
    </ModalShell>
}

@code {
    /// <summary>When set, tapping a level picks this adversary at that level.</summary>
    [Parameter] public EventCallback<(Adversary Adversary, int Level)> OnSelected { get; set; }

    private Adversary? _adversary;
    private AdversaryDetail? _detail;
    private SetupInsights.AdversaryFacing? _facing;

    /// The history behind the sheet, already narrowed to the person it is about — kept so
    /// focusing a level is a recount rather than a rebuild of the scope.
    private IReadOnlyList<SetupGameFact>? _scopedFacts;

    /// The level the profile is focused on; null profiles every level at once. Never set in
    /// picker mode, where a tap is the pick and the profile stays every level's.
    private int? _level;

    /// The level grid reports the same slice as the profile below it, so its heading names the
    /// same owner rather than calling the whole table's record the reader's — RecordOwner is that
    /// decision, shared with the spirit sheet's variant strip.
    private string LevelGridTitle =>
        Profile is null ? "Difficulty by level"
        : RecordOwner is { } owner ? $"Difficulty and {owner} record by level"
        : "Difficulty and record by level";

    /// What the profile is of follows the focus, so its heading and empty state name the level
    /// they are actually counting — "Your record at level 3", "never faced England at level 3".
    private string ProfileTitle =>
        _level is { } l ? $"record at level {l}" : "record against this foe";

    private string ProfileName =>
        _level is { } l ? $"{_adversary!.Name} at level {l}" : _adversary!.Name;

    /// <param name="level">Opens with the profile already focused on this level — how a level
    /// tile on a catalogue or statistics card lands here. Ignored in picker mode, where a tap
    /// is the pick rather than the focus switch.</param>
    public void Show(Adversary adversary, int? level = null)
    {
        _adversary = adversary;
        _detail = AdversaryDetails.For(adversary.Id);
        // Scoped by dropping the games the person was not at. Built even when that leaves
        // nothing, so the sheet can report an empty record as theirs rather than vanishing.
        _scopedFacts = ScopedFacts();
        // Null once the foe has never been faced — the grid then shows "—" per level.
        _facing = _scopedFacts is not null
            ? SetupInsights.AdversaryRecords(_scopedFacts).GetValueOrDefault(adversary.Id.Value)
            : null;
        _level = OnSelected.HasDelegate || _scopedFacts is null ? null : level;
        RebuildProfile();
        StateHasChanged();
    }

    private void Close()
    {
        _adversary = null;
        _detail = null;
        Profile = null;
        _facing = null;
        _scopedFacts = null;
        _level = null;
    }

    /// <summary>
    /// The level tiles are a pick where somebody is listening for one, and the record's focus
    /// switch where there is a record — never both, so mid-setup a tap can only ever mean the
    /// choice being made. With neither (the public reference sheet) they are inert.
    /// </summary>
    private EventCallback<int> LevelTap =>
        OnSelected.HasDelegate ? EventCallback.Factory.Create<int>(this, Select)
        : Profile is not null ? EventCallback.Factory.Create<int>(this, ToggleLevel)
        : default;

    private void ToggleLevel(int level)
    {
        _level = _level == level ? null : level;
        RebuildProfile();
    }

    /// The profile counts what the focus says: every game against the foe, or only those with
    /// it at the focused level. The grid keeps the full per-level map either way — it is the
    /// switch, so it has to keep showing everything there is to switch to.
    private void RebuildProfile()
    {
        if (_adversary is null || _scopedFacts is null)
        {
            Profile = null;
            return;
        }
        var id = _adversary.Id.Value;
        var facts = _level is { } l
            ? _scopedFacts.Where(g => g.Adversaries.Any(a => a.AdversaryId == id && a.Level == l)).ToList()
            : _scopedFacts;
        Profile = SetupProfiles.Build(SetupSubjectKind.Adversary, id, facts);
    }

    private async Task Select(int level)
    {
        var adversary = _adversary;
        if (!OnSelected.HasDelegate || adversary is null) return;
        Close();
        await OnSelected.InvokeAsync((adversary, level));
    }
}
