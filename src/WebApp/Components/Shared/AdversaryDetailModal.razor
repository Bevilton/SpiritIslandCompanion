@* Adversary reference sheet. Given Facts it also profiles the player's own record
   — including per level inside the difficulty grid — and given OnSelected a level can
   be picked straight from here. z-60 keeps it above the picker modals (z-50). *@

@using Application.Features.Statistics

@if (_adversary is not null)
{
    var detail = _detail;

    <ModalShell OnClose="Close" ZIndex="z-[60]" MaxWidth="md:max-w-4xl">
            <div class="px-6 md:px-8 pt-6 pb-5 relative bg-ink-50/60 border-b border-ink-200">
                <button class="absolute top-4 right-4 inline-flex h-8 w-8 items-center justify-center rounded-lg text-ink-500 hover:bg-white/60 hover:text-ink-900 transition-colors" @onclick="Close" aria-label="Close">
                    <Icon Name="x" Class="w-5 h-5"/>
                </button>

                <div class="flex items-start gap-3 pr-10">
                    <Icon Name="shield" Class="w-6 h-6 text-accent-700 shrink-0 mt-1"/>
                    <div class="min-w-0 flex-1">
                        <h2 class="text-2xl font-semibold text-ink-900 leading-tight" style="font-family: var(--font-serif);">@_adversary.Name</h2>
                        <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
                            <span class="badge badge-neutral">@GameLookups.ExpansionName(_adversary.ExpansionId)</span>
                            @if (detail is not null)
                            {
                                <span class="text-ink-600">· @detail.Theme</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-y-auto px-6 md:px-8 py-5 space-y-6">
                @if (detail is not null)
                {
                    @* Capped at prose width: the panel is wide for the record tables, not the text. *@
                    <p class="max-w-prose text-ink-700 leading-relaxed">@detail.Summary</p>
                }
                else
                {
                    <p class="text-ink-500 italic">No additional information available.</p>
                }

                @* The one grid that carries both the rules and the record — the same strip the
                   catalogue card and the statistics card draw (see AdversaryLevelGrid), so a
                   level reads the same wherever it is met. *@
                <div>
                    <h3 class="text-sm font-medium uppercase tracking-wide text-ink-500 mb-3">
                        @(_profile is null ? "Difficulty by level" : "Difficulty and your record by level")
                    </h3>
                    <AdversaryLevelGrid Adversary="_adversary"
                                        Records="@(_profile is null ? null : _facing?.Levels ?? AdversaryLevelGrid.NoRecords)"
                                        OnPick="PickLevel" LinkGames="LinkGames"/>
                    <p class="mt-2 text-xs text-ink-500">
                        Each level adds escalation rules.
                        @if (OnSelected.HasDelegate)
                        {
                            <text>Tap a level to play it.</text>
                        }
                        else if (LinkGames && _profile is not null)
                        {
                            <text>Tap a level you've played to see those games.</text>
                        }
                        else
                        {
                            <text>See the wiki for the per-level setup and rules text.</text>
                        }
                    </p>
                </div>

                @if (_profile is not null)
                {
                    <SetupProfileSection Profile="_profile" Name="@_adversary.Name"
                                         Title="Your record against this foe"
                                         LinkGames="LinkGames"
                                         AllGamesHref="@(LinkGames ? GamesLink.ForAdversary(_adversary.Id.Value) : null)"/>
                }

                <div class="pt-2">
                    <a href="@GameLookups.WikiLink(_adversary.Name)" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 text-sm text-accent-700 hover:text-accent-800">
                        Read on the Spirit Island wiki
                        <Icon Name="arrow-right" Class="w-3.5 h-3.5"/>
                    </a>
                </div>
            </div>

            @if (OnSelected.HasDelegate)
            {
                <div class="flex items-center gap-3 border-t border-ink-100 bg-ink-50/40 px-6 md:px-8 py-3.5 md:rounded-b-2xl">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="Close">
                        <Icon Name="arrow-left" Class="w-3.5 h-3.5"/> Back to adversaries
                    </button>
                    <span class="ml-auto text-xs text-ink-500">Pick a level above to add this foe.</span>
                </div>
            }
    </ModalShell>
}

@code {
    /// <summary>
    /// Personal game history. When there is any, the modal profiles the player's record
    /// against this adversary; empty or null hides the stats (plain reference sheet).
    /// </summary>
    [Parameter] public IReadOnlyList<SetupGameFact>? Facts { get; set; }

    /// <summary>
    /// Whether the record may link out to the games behind it. Off by default, and never set by
    /// the setup picker: following a link from there would leave a half-built game behind.
    /// </summary>
    [Parameter] public bool LinkGames { get; set; }

    /// <summary>When set, tapping a level picks this adversary at that level.</summary>
    [Parameter] public EventCallback<(Adversary Adversary, int Level)> OnSelected { get; set; }

    private Adversary? _adversary;
    private AdversaryDetail? _detail;
    private SetupProfiles.Profile? _profile;
    private SetupInsights.AdversaryFacing? _facing;

    public void Show(Adversary adversary)
    {
        _adversary = adversary;
        _detail = AdversaryDetails.For(adversary.Id);
        _profile = Facts is { Count: > 0 }
            ? SetupProfiles.Build(SetupSubjectKind.Adversary, adversary.Id.Value, Facts)
            : null;
        // Null once the foe has never been faced — the grid then shows "—" per level.
        _facing = Facts is { Count: > 0 }
            ? SetupInsights.AdversaryRecords(Facts).GetValueOrDefault(adversary.Id.Value)
            : null;
        StateHasChanged();
    }

    private void Close()
    {
        _adversary = null;
        _detail = null;
        _profile = null;
        _facing = null;
    }

    /// <summary>
    /// The level tiles are only a pick where somebody is listening for one. Handed <see cref="Select"/>
    /// unconditionally, the grid took every host for a picker: on the statistics and reference
    /// pages the tiles became buttons that swallowed the click and did nothing, hiding the links
    /// to those levels' games behind them.
    /// </summary>
    private EventCallback<int> PickLevel =>
        OnSelected.HasDelegate ? EventCallback.Factory.Create<int>(this, Select) : default;

    private async Task Select(int level)
    {
        var adversary = _adversary;
        if (!OnSelected.HasDelegate || adversary is null) return;
        Close();
        await OnSelected.InvokeAsync((adversary, level));
    }
}
