@* A picture of an island, from whichever source there is one.

   The published layouts ship as files: /img/layouts/generated is emitted by
   tools/island-geometry/build.mjs from the very placements the island playground uses, so a
   preview always matches what dropping that layout in produces. A hand-built island has no
   such file — it exists only as the geometry the player saved — and is drawn by
   IslandLayoutDiagram from the same traced board, which also owns the placeholder for an
   island with neither.

   The precedence lives here rather than at each call site: a published layout's own picture
   first, then the geometry, then the placeholder. Three callers used to each spell that out,
   and one of them spelled it differently.

   Thematic islands are drawn reflected, for the same reason the playground reflects them:
   they are played on the boards' reverse side. The files are generated from the one traced
   side, so the reflection happens here rather than in them. *@

@if (_hasImage)
{
    <img src="@_src" alt="@_label" class="@FitBox object-contain @(Setup!.IsThematic ? "-scale-x-100" : null)"
         loading="lazy"/>
}
else
{
    <IslandLayoutDiagram Geometry="@Geometry" BoardCount="@(Setup?.BoardCount ?? BoardCount)"
                         Label="@_label"/>
}

@code {
    /// <summary>The published layout, when the island is one. Null for a shape the player built.</summary>
    [Parameter] public IslandSetup? Setup { get; set; }

    /// <summary>
    /// The arrangement to draw when no picture ships for this island — a saved shape, or the
    /// copy a game kept of the island it was played on. Ignored when <see cref="Setup"/> has a
    /// picture of its own.
    /// </summary>
    [Parameter] public string? Geometry { get; set; }

    /// <summary>Board count for the placeholder, where there is neither a picture nor geometry.
    /// Taken from <see cref="Setup"/> when there is one.</summary>
    [Parameter] public int BoardCount { get; set; }

    /// <summary>
    /// Names the picture, for a screen reader and the placeholder's tooltip. Overrides the name
    /// <see cref="Setup"/> carries, which is what a hand-built island needs: every one of those
    /// shares the setup called "Custom", so only the caller knows whether this one is a shape
    /// from the library and what it is called. Null falls back to the setup's own name.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// How the picture is fitted, on both diagrams. Every caller sits it in a box of its own — a
    /// 48px tile, a 56px chip, a half-screen panel — and asks it to fill that box without
    /// overflowing, so that is all it does. It was a <c>Class</c> parameter defaulting to this,
    /// and once the last <c>h-16 w-auto</c> override had gone no caller set it: a parameter with
    /// one value is a decision pretending to be a choice.
    /// </summary>
    internal const string FitBox = "max-h-full max-w-full";

    private string _src = "";
    private bool _hasImage;
    private string _label = "";

    protected override void OnParametersSet()
    {
        // Custom setups name a board count and nothing else — there is no file for one.
        _hasImage = Setup is { IsCustom: false };
        _src = _hasImage ? $"/img/layouts/generated/{Setup!.Id.Value}.svg" : "";

        var boards = Setup?.BoardCount ?? BoardCount;
        var name = Label ?? Setup?.Name;
        _label = name is null
            ? "Island layout"
            : boards > 0 ? $"{name} layout, {Copy.Count(boards, "board")}" : name;
    }
}
