@* A spirit's tokens (Dahan, Beasts, Wilds, …) as a row of chips. The row itself is
   GlyphBadges; this supplies only the six glyphs and the six tints.
   Pass Size="sm" for compact card display, Size="md" for the modal header. *@

<GlyphBadges TValue="Token" Values="Tokens" Size="@Size" Colour="ColorFor" Glyph="Glyph"/>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Token>? Tokens { get; set; }
    [Parameter] public string Size { get; set; } = "sm";

    private static MarkupString Glyph(Token t, string iconClass) => new(t switch
    {
        Token.Dahan => $@"<svg viewBox=""0 0 24 24"" fill=""currentColor"" class=""{iconClass}"" aria-hidden=""true""><circle cx=""12"" cy=""6"" r=""3""/><path d=""M5 21a7 7 0 1 1 14 0Z""/></svg>",
        Token.Beasts => $@"<svg viewBox=""0 0 24 24"" fill=""currentColor"" class=""{iconClass}"" aria-hidden=""true""><path d=""M7 4 L9 19 L11 5 Z M13 5 L15 19 L17 4 Z""/></svg>",
        Token.Wilds => $@"<svg viewBox=""0 0 24 24"" fill=""currentColor"" class=""{iconClass}"" aria-hidden=""true""><path d=""M12 2 L6 10 L9 10 L4 17 L10 17 L10 22 L14 22 L14 17 L20 17 L15 10 L18 10 Z""/></svg>",
        Token.Disease => $@"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.4"" stroke-linecap=""round"" stroke-linejoin=""round"" class=""{iconClass}"" aria-hidden=""true""><path d=""M6 6 c-3.5 4 -2 11 4.5 12.5 c5.5 1.2 10.5-3 10.5-9 c0-4-3.5-6.5-7.5-5.5 c-3 .8-5 4-3 7 c1 1.8 4 1.8 5 0""/><circle cx=""6"" cy=""6"" r=""1.4"" fill=""currentColor"" stroke=""none""/></svg>",
        Token.Strife => $@"<svg viewBox=""0 0 24 24"" fill=""currentColor"" class=""{iconClass}"" aria-hidden=""true""><path d=""M6 11 a1.5 1.5 0 0 1 3 0 a1.5 1.5 0 0 1 3 0 a1.5 1.5 0 0 1 3 0 a1.5 1.5 0 0 1 3 0 v5 a3 3 0 0 1-3 3 h-6 a3 3 0 0 1-3-3 z""/></svg>",
        Token.Badlands => $@"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"" class=""{iconClass}"" aria-hidden=""true""><path d=""M3 19h18""/><path d=""M4 19 L8 8 L12 14 L16 6 L20 19""/><path d=""M9 19v3M14 19v2.5""/></svg>",
        _ => "",
    });

    private static (string Bg, string Fg) ColorFor(Token t) => t switch
    {
        Token.Dahan    => ("#FEF3C7", "#92400E"), // tan / brown — islanders
        Token.Beasts   => ("#FEE2E2", "#B91C1C"), // red — predators
        Token.Wilds    => ("#DCFCE7", "#166534"), // green — overgrowth
        Token.Disease  => ("#FEF3C7", "#A16207"), // yellow — sickness (matches game token)
        Token.Strife   => ("#DBEAFE", "#1D4ED8"), // blue — discord (matches game token)
        Token.Badlands => ("#FED7AA", "#7C2D12"), // burnt orange — scorched earth
        _              => ("#F0EADC", "#4A4031"), // ink-100 on ink-700 — unreachable, but not a stock grey
    };
}
