@* Scenario picker modal. Filters by expansion + free-text. Selecting closes.
   OwnedExpansions is read from the AppShell cascade — the modal is auth-agnostic. *@

@if (_open)
{
    <ModalShell OnClose="Close">
            <div class="px-6 pt-5 pb-4 border-b border-ink-200 flex items-start gap-4">
                <div class="min-w-0 flex-1">
                    <h2 class="text-xl font-semibold text-ink-900 leading-tight" style="font-family: var(--font-serif);">
                        Choose a scenario
                    </h2>
                    <p class="text-xs text-ink-500 mt-1">
                        Optional rules twist that adds difficulty@(_context.HasHistory ? " · a scenario's record opens its full history" : "").
                    </p>
                </div>
                <input type="search" class="input md:w-56" placeholder="Search by name…" aria-label="Search by name"
                       @bind="_filter.Query" @bind:event="oninput"/>
                <button class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink-500 hover:bg-ink-100 hover:text-ink-900 transition-colors shrink-0" @onclick="Close" aria-label="Close">
                    <Icon Name="x" Class="w-5 h-5"/>
                </button>
            </div>

            @* The same filter every catalogue and picker uses. *@
            <div class="border-b border-ink-200 bg-ink-50/50 px-6 py-3">
                <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
                           PresentExpansions="_filter.ExpansionsIn(_inScope)"
                           ShowingCount="_visible.Count" TotalCount="_inScope.Count"
                           UntestedLabel="Never played" UntestedHint="Scenarios nobody at your table has played"
                           Changed="StateHasChanged"/>
            </div>

            <div class="overflow-y-auto px-6 py-5 flex-1 space-y-2">
                <button type="button"
                        @onclick="() => Pick(null)"
                        class="@(_currentScenarioId is null ? "ring-2 ring-accent-500 border-accent-300" : "border-ink-200 hover:border-ink-300")
                               w-full flex items-center justify-between gap-3 bg-white border rounded-xl p-3 transition-all hover:shadow-sm text-left">
                    <div>
                        <div class="text-sm font-semibold text-ink-900">No scenario</div>
                        @if (_records.GetValueOrDefault("") is { Played: > 0 } noScen)
                        {
                            <div class="flex flex-wrap items-center gap-1 text-[11px] text-ink-500">
                                <span>Standard game — you played</span>
                                <span class="tabular-nums font-medium text-ink-700">@(noScen.Played)×</span>
                                @if (noScen.Completed > 0)
                                {
                                    <span class="tabular-nums font-semibold @WinTone.ForRate(noScen.WinRate)">@($"{noScen.WinRate:F0}")% wins</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-[11px] text-ink-500">Standard game</div>
                        }
                    </div>
                    <span class="text-[10px] uppercase tracking-wider text-ink-400">Default</span>
                </button>

                @foreach (var s in _visible)
                {
                    var detail = ScenarioDetails.For(s.Id);
                    var isSelected = _currentScenarioId == s.Id.Value;

                    @* The record pill is a sibling of the pick button (a button may not contain
                       a button) and doubles as the door to the scenario's full sheet. *@
                    <div @key="s.Id.Value"
                         class="@(isSelected ? "ring-2 ring-accent-500 border-accent-300" : "border-ink-200 hover:border-ink-300")
                                flex flex-col bg-white border rounded-xl transition-all hover:shadow-sm">
                        <button type="button"
                                @onclick="() => Pick(s)"
                                class="w-full flex flex-1 items-start justify-between gap-3 rounded-t-xl p-3 pb-2 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <Icon Name="book" Class="w-4 h-4 text-accent-700 shrink-0"/>
                                    <div class="text-sm font-semibold text-ink-900">@s.Name</div>
                                </div>
                                <div class="text-[11px] text-ink-500 mt-0.5">@GameLookups.ExpansionName(s.ExpansionId)</div>
                                @if (detail is not null)
                                {
                                    <p class="mt-1.5 text-xs text-ink-600 leading-snug line-clamp-2">@detail.Summary</p>
                                }
                            </div>
                            <span class="badge shrink-0 @(s.Difficulty >= 3 ? "badge-warn" : s.Difficulty >= 1 ? "badge-info" : "badge-neutral")">
                                +@s.Difficulty
                            </span>
                        </button>
                        <div class="px-3 pb-2.5">
                            <RecordChip Record="_records.GetValueOrDefault(s.Id.Value)" HasHistory="_context.HasHistory"
                                        Subject="@s.Name" OnClick="() => ShowDetails(s)"/>
                        </div>
                    </div>
                }

                @if (_visible.Count == 0)
                {
                    <div class="text-center py-10 text-ink-500 text-sm">No scenarios match the current filters.</div>
                }
            </div>
    </ModalShell>
}

<ScenarioDetailModal @ref="_detailModal"
                     Facts="_context.Facts"
                     OnSelected="Pick"/>

@code {
    [Parameter] public EventCallback<Scenario?> OnSelected { get; set; }

    private bool _open;
    private string? _currentScenarioId;
    private ScenarioDetailModal _detailModal = default!;

    /// The setup this picker was opened for — supplies the history behind each
    /// card's record and the detail profile.
    private SetupInsights.MatchupContext _context = SetupInsights.MatchupContext.Empty;

    // Snapshotted on open — the form behind the modal can't change while it is up.
    // The empty-string key holds games played without a scenario.
    private Dictionary<string, SetupInsights.PlayRecord> _records = [];

    [CascadingParameter(Name = "OwnedExpansions")]
    public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    public void Show(string? currentScenarioId = null, SetupInsights.MatchupContext? context = null)
    {
        _context = context ?? SetupInsights.MatchupContext.Empty;
        _currentScenarioId = currentScenarioId;
        _records = _context.HasHistory ? _context.ScenarioRecords() : [];

        _filter.Reset();
        _filter.UseHistory(_context.HasHistory ? _records : null);

        _open = true;
        StateHasChanged();
    }

    private void Close() => _open = false;

    private void ShowDetails(Scenario s) => _detailModal.Show(s);

    private async Task Pick(Scenario? s)
    {
        _open = false;
        await OnSelected.InvokeAsync(s);
    }

    /// Ordered by difficulty to start with: a scenario is chosen for how much it adds, and the
    /// picker is a list to scan rather than a catalogue to browse.
    private readonly CatalogueFilter<Scenario> _filter = new(
        s => s.Id.Value, s => s.Name, s => s.ExpansionId,
        numeric: (FilterState.ByDifficulty, s => s.Difficulty),
        defaultSortKey: "difficulty");

    /// Only what the player owns is on their table, so only that is offered.
    private IReadOnlyList<Scenario> _inScope =>
        GameData.Scenarios.Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId)).ToList();

    private IReadOnlyList<Scenario> _visible => _filter.Apply(_inScope);
}
