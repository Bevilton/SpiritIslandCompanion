@* Scenario picker: a list to scan, ordered by what each scenario adds, with "no scenario" leading
   it as a choice of its own. Opened imperatively, like every picker — see PickerModalBase, which
   also owns the lifecycle and the owned-expansions cascade. *@
@inherits PickerModalBase

@* The catalogue this picker offers and the part of it the filter keeps, derived once per
   render rather than from properties read all the way down it — see the note in SpiritsView. *@
@if (IsOpen)
{
    var inScope = OwnedCatalogue.Scenarios(OwnedExpansions);
    var visible = _filter.Apply(inScope);

    <ModalShell OnClose="Close">
        <PickerModalHeader Title="Choose a scenario" OnClose="Close" @bind-Query="_filter.Query">
            <Subtitle>Optional rules twist that adds difficulty@(Context.HasHistory ? " · a scenario's record opens its full history" : "").</Subtitle>
        </PickerModalHeader>

        @* The same filter every catalogue and picker uses. *@
        <div class="picker-filters">
            <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
                       PresentExpansions="_filter.ExpansionsIn(inScope)"
                       ShowingCount="visible.Count" TotalCount="inScope.Count"
                       UntestedLabel="Never played" UntestedHint="@Copy.Untried("Scenarios")"
                       Changed="StateHasChanged"/>
        </div>

        <div class="picker-body space-y-2">
            <button type="button"
                    @onclick="() => Pick(null)"
                    class="pick-card @(_currentScenarioId is null ? "is-selected" : null)
                           flex w-full items-center justify-between gap-3 p-3 text-left focus-ring">
                <div>
                    <div class="row-title">No scenario</div>
                    @if (_records.GetValueOrDefault(SetupInsights.NoScenarioKey) is { Played: > 0 } noScen)
                    {
                        <div class="row-sub flex flex-wrap items-center gap-1">
                            <span>Standard game — you played</span>
                            <span class="tabular-nums font-medium text-ink-700">@(noScen.Played)×</span>
                            @if (noScen.Completed > 0)
                            {
                                <WinRateFigure Value="noScen.WinRate" Suffix=" wins"/>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row-sub">Standard game</div>
                    }
                </div>
                <span class="micro-label text-ink-400">Default</span>
            </button>

            @foreach (var s in visible)
            {
                var detail = ScenarioDetails.For(s.Id);
                var isSelected = _currentScenarioId == s.Id.Value;

                @* The record pill is a sibling of the pick button (a button may not contain
                   a button) and doubles as the door to the scenario's full sheet. *@
                <div @key="s.Id.Value"
                     class="pick-card @(isSelected ? "is-selected" : null) flex flex-col">
                    <button type="button"
                            @onclick="() => Pick(s)"
                            class="w-full flex flex-1 items-start justify-between gap-3 rounded-t-xl p-3 pb-2 text-left focus-ring">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <Icon Name="book" Class="w-4 h-4 text-accent-700 shrink-0"/>
                                @* h3 with the picker's other cards — see BoardPickerModal. *@
                                <h3 class="row-title">@s.Name</h3>
                            </div>
                            <div class="row-sub mt-0.5">@GameLookups.ExpansionName(s.ExpansionId)</div>
                            @if (detail is not null)
                            {
                                <p class="mt-1.5 text-xs text-ink-600 leading-snug line-clamp-2">@detail.Summary</p>
                            }
                        </div>
                        <ScenarioDifficultyBadge Difficulty="s.Difficulty" Class="shrink-0"/>
                    </button>
                    <div class="px-3 pb-2.5">
                        <RecordChip Record="_records.GetValueOrDefault(s.Id.Value)" HasHistory="Context.HasHistory"
                                    Subject="@s.Name" OnClick="() => ShowDetails(s)"/>
                    </div>
                </div>
            }

            @if (visible.Count == 0)
            {
                <div class="no-matches">@Copy.NoMatches("scenarios")</div>
            }
        </div>
    </ModalShell>
}

@* The whole scope, as the other three pickers pass it — see AdversaryPickerModal. *@
<ScenarioDetailModal @ref="_detailModal"
                     Facts="Context.Facts"
                     SeatFilter="Context.SeatFilter"
                     SubjectName="@Context.SubjectName"
                     OnSelected="Pick"/>

@code {
    [Parameter] public EventCallback<Scenario?> OnSelected { get; set; }

    private string? _currentScenarioId;
    private ScenarioDetailModal _detailModal = default!;

    // Snapshotted on open — the form behind the modal can't change while it is up. Games played
    // without a scenario sit under SetupInsights.NoScenarioKey.
    private Dictionary<string, SetupInsights.PlayRecord> _records = [];

    public void Show(string? currentScenarioId = null, SetupInsights.MatchupContext? context = null)
    {
        BeginShow(context);
        _currentScenarioId = currentScenarioId;
        _records = Context.HasHistory ? Context.ScenarioRecords() : [];

        _filter.Reset();
        _filter.UseHistory(Context.HasHistory ? _records : null);

        Open();
    }

    private void ShowDetails(Scenario s) => _detailModal.Show(s);

    private async Task Pick(Scenario? s)
    {
        Close();
        await OnSelected.InvokeAsync(s);
    }

    /// Ordered by difficulty to start with: a scenario is chosen for how much it adds, and the
    /// picker is a list to scan rather than a catalogue to browse.
    private readonly CatalogueFilter<Scenario> _filter = new(
        s => s.Id.Value, s => s.Name, s => s.ExpansionId,
        numeric: (FilterState.ByDifficulty, s => s.Difficulty),
        defaultSortKey: FilterState.ByDifficulty.Key);
}
