@* Board picker: boards as coloured letter tiles grouped by expansion, with the player's record on
   each — narrowed to the spirit being placed when Show is given one. Opened imperatively, like
   every picker — see PickerModalBase, which also owns the lifecycle and the owned-expansions
   cascade. *@
@inherits PickerModalBase

@* The catalogue this picker offers and the part of it the filter keeps, derived once per
   render rather than from properties read all the way down it — see the note in SpiritsView. *@
@if (IsOpen)
{
    var inScope = OwnedCatalogue.Boards(OwnedExpansions);
    var visible = _filter.Apply(inScope);

    <ModalShell OnClose="Close">
        <PickerModalHeader Title="Choose a board" OnClose="Close">
            <Subtitle>
                Pick the board this player will use.@(_recordsLabel is null ? "" : $" Records show {WhoseGames} {_recordsLabel}.")
                @if (BoardsTaken.Count > 0)
                {
                    <text> Boards picked by other players are marked.</text>
                }
            </Subtitle>
        </PickerModalHeader>

        @* The same filter every catalogue and picker uses. *@
        <div class="picker-filters">
            <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
                       PresentExpansions="_filter.ExpansionsIn(inScope)"
                       ShowingCount="visible.Count" TotalCount="inScope.Count"
                       UntestedLabel="@UntestedLabel" UntestedHint="@UntestedHint"
                       Changed="StateHasChanged"/>
        </div>

        <div class="picker-body space-y-6">
            @* Grouped into expansions only while that is the order — see SpiritsView. *@
            @foreach (var grp in _filter.GroupsByExpansion
                ? visible.GroupBy(b => b.ExpansionId).Select(g => (Label: (string?)GameLookups.ExpansionName(g.Key), Boards: g.ToList()))
                : [(Label: (string?)null, Boards: visible.ToList())])
            {
                <div>
                    @if (grp.Label is { } label)
                    {
                        <div class="micro-label mb-2">@label</div>
                    }
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                        @foreach (var b in grp.Boards)
                        {
                            var detail = BoardDetails.For(b.Id);
                            var color = GameLookups.BoardColor(detail);
                            var letter = GameLookups.BoardLetter(b);
                            var isSelected = _currentBoardId == b.Id.Value;
                            var isTaken = BoardsTaken.Contains(b.Id.Value) && !isSelected;
                            var rec = _records.GetValueOrDefault(b.Id.Value);
                            var isFavourite = SetupInsights.IsFavourite(rec, MostPlayed);

                            @* The record pill is a sibling of the pick button, so it stays live
                               even for a taken board — its record is still worth a look. *@
                            <div @key="b.Id.Value"
                                 class="pick-card @(isSelected ? "is-selected" : null) @(isTaken ? "is-taken" : null)
                                        flex flex-col">
                                <button type="button"
                                        @onclick="() => Pick(b)"
                                        disabled="@isTaken"
                                        class="@(isTaken ? "cursor-not-allowed" : null)
                                               flex w-full flex-1 items-center gap-3 rounded-t-xl p-3 pb-2 text-left focus-ring">
                                    <LetterTile Size="2xl" Color="@color" Text="@letter"/>
                                    <div class="min-w-0 flex-1">
                                        @* h3 with the picker's other cards, so the four grids of
                                           choices name what is in them the same way. *@
                                        <h3 class="row-title truncate">@b.Name</h3>
                                        @if (detail is not null)
                                        {
                                            <div class="row-sub truncate">@detail.ThematicName</div>
                                        }
                                        @if (isTaken)
                                        {
                                            <div class="fine-note mt-0.5">In use</div>
                                        }
                                    </div>
                                </button>
                                <div class="px-3 pb-2.5">
                                    <RecordChip Record="rec" HasHistory="Context.HasHistory" Subject="@b.Name"
                                                NeverLabel="@UntestedLabel"
                                                Starred="isFavourite"
                                                OnClick="() => ShowDetails(b)"/>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (visible.Count == 0)
            {
                <div class="no-matches">@Copy.NoMatches("boards")</div>
            }
        </div>
    </ModalShell>
}

<BoardDetailModal @ref="_detailModal"
                  Facts="Context.Facts"
                  SeatFilter="Context.SeatFilter"
                  SubjectName="@Context.SubjectName"
                  OnSelected="Pick"/>

@code {
    [Parameter] public EventCallback<Board> OnSelected { get; set; }

    /// <summary>
    /// Board ids already on the island for another seat — shown dimmed and disabled,
    /// since there is one physical copy of each.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string> BoardsTaken { get; set; } = [];

    private string? _currentBoardId;
    private BoardDetailModal _detailModal = default!;

    // Snapshotted on open — the form behind the modal can't change while it is up.
    private Dictionary<string, SetupInsights.PlayRecord> _records = [];
    private string? _recordsLabel;

    /// The play count of the most-played board, so the leader can be marked as a favourite.
    private int MostPlayed => SetupInsights.Leader(_records);

    /// <param name="forSpiritId">
    /// The spirit being placed, if chosen. Records are then the spirit-on-board
    /// pairing ("2× with Lightning's Swift Strike") instead of the board overall.
    /// </param>
    public void Show(
        string? currentBoardId = null,
        SetupInsights.MatchupContext? context = null,
        string? forSpiritId = null)
    {
        BeginShow(context);
        _currentBoardId = currentBoardId;
        _records = Context.HasHistory ? Context.BoardRecords(forSpiritId) : [];
        _recordsLabel = GameLookups.SpiritFor(forSpiritId) is { } spirit ? $"with {spirit.Name}" : null;

        _filter.Reset();
        _filter.UseHistory(Context.HasHistory ? _records : null);

        Open();
    }

    /// With a spirit already chosen the record is that pairing, not the board overall — so the
    /// filter's pill and each card's never-state have to say so. A board played often but never
    /// under this spirit passes it.
    private string UntestedLabel => _recordsLabel is null ? "Never used" : $"Never {_recordsLabel}";

    /// Whose games the per-board counts are, for the line under the title — the same ownership
    /// decision the record sheets head their strips with (Copy.Owner).
    private string WhoseGames =>
        Copy.Owner(Context.SubjectName, Context.SeatFilter is not null) is { } owner
            ? $"{owner} games"
            : "every game recorded";

    private string UntestedHint => _recordsLabel is null
        ? $"Boards {Context.UntestedIntro("used")}"
        : $"Boards {Context.UntestedIntro("used")} {_recordsLabel} — {Context.UntestedConcession("used")}";

    private void ShowDetails(Board b) => _detailModal.Show(b);

    private async Task Pick(Board b)
    {
        Close();
        await OnSelected.InvokeAsync(b);
    }

    /// No difficulty: one board is not harder than another.
    private readonly CatalogueFilter<Board> _filter = new(
        b => b.Id.Value, b => b.Name, b => b.ExpansionId);
}
