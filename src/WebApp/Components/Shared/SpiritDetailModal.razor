@* Spirit reference sheet. Given Facts it also profiles the history with the spirit,
   and given OnSelected it can be chosen straight from here — that is how the setup
   screen lets you explore before committing to a pick.

   The aspects are one strip of tiles, each carrying the variant's blurb and record —
   the way the adversary sheet's level tiles carry the difficulty and record, because
   an aspect is to a spirit what a level is to a foe. Outside the picker a tap focuses
   the profile below on that variant and a second tap widens back; in the picker a tap
   plays it, "No aspect" tile included, mirroring how a level is picked.

   Whose history that is belongs to the host, not to this sheet — see DetailSheetBase.
   The catalogue pages scope it to nobody, so a sheet there is the whole account's; the
   statistics page passes its selector and the setup screen the seat being filled. The
   sheet only reports which it is. *@
@inherits DetailSheetBase

@if (_spirit is not null)
{
    var detail = _detail;
    var color = GameLookups.SpiritColor(detail);

    <ModalShell OnClose="Close" ZIndex="@SheetZIndex" MaxWidth="@SheetWidth">
        @* Header band coloured by the spirit *@
        <DetailModalHeader Title="@_spirit.Name" OnClose="Close" TintStyle="@GameLookups.TintBandStyle(color)">
            <Glyph>
                <ColorBar Size="full" Color="@color"/>
            </Glyph>
            <Badges>
                <span class="badge badge-neutral">@GameLookups.ExpansionName(_spirit.ExpansionId)</span>
                @if (detail is not null)
                {
                    <span class="badge" style="@GameLookups.TintBadgeStyle(color)">
                        @SpiritFilter.ComplexityLabel(detail.Complexity) complexity
                    </span>
                    <span>· @detail.PlayStyle</span>
                }
            </Badges>
            <Extra>
                @if (detail is not null && (detail.Elements.Count > 0 || detail.Tokens.Count > 0))
                {
                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                        @if (detail.Elements.Count > 0)
                        {
                            <div class="flex items-center gap-2">
                                <span class="micro-label">Elements</span>
                                <ElementBadges Elements="detail.Elements" Size="md"/>
                            </div>
                        }
                        @if (detail.Tokens.Count > 0)
                        {
                            <div class="flex items-center gap-2">
                                <span class="micro-label">Tokens</span>
                                <TokenBadges Tokens="detail.Tokens" Size="md"/>
                            </div>
                        }
                    </div>
                }
            </Extra>
        </DetailModalHeader>

        @* Body *@
        <div class="sheet-body space-y-6">
            <SheetSummary Text="@detail?.Summary"/>

            @* The variant strip: reference and switch in one, the spirit as printed leading
               it. There used to be a chips row up here and a card list at the bottom saying
               the same things twice — one strip in one shape, shared with nothing but styled
               exactly like the adversary sheet's level tiles, replaces both. *@
            @if (_aspects.Count > 0)
            {
                <div>
                    <SectionHead Size="label" Level="3" Title="@AspectGridTitle"/>
                    <div class="grid gap-1.5 sm:grid-cols-2">
                        @AspectTile(null)
                        @foreach (var aspect in _aspects)
                        {
                            @AspectTile(aspect)
                        }
                    </div>
                    <p class="block-note mt-2">
                        An aspect rewrites how the spirit plays.
                        @if (OnSelected.HasDelegate)
                        {
                            <text>Tap a variant to play it.</text>
                        }
                        else if (Profile is not null)
                        {
                            <text>Tap one to focus the record on it — tap again for every variant.</text>
                        }
                    </p>
                </div>
            }

            @if (Profile is not null)
            {
                <SetupProfileSection Profile="Profile" Name="@ProfileName"
                                     Scoped="Scoped" SubjectName="@SubjectName"
                                     Title="@ProfileTitle"
                                     LinkGames="LinkGames"
                                     AllGamesHref="@GamesLink.ForSpirit(_spirit.Id.Value, who: ScopeWho)"
                                     AllGamesLabel="@(_scope is null ? "See all games" : "All games with this spirit")"
                                     AllGamesSubject="@(_scope is null ? null : $"{_spirit.Name} (every variant)")"/>
            }

            <SheetWikiLink Name="@_spirit.Name"/>
        </div>

        @if (OnSelected.HasDelegate)
        {
            @* The variants above are the pick, exactly like the adversary sheet's levels
               — except a spirit without any still needs a way to be taken. *@
            <SheetFooter BackLabel="spirits" OnBack="Close">
                @if (_aspects.Count > 0)
                {
                    <span class="block-note">Pick a variant above to play this spirit.</span>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="() => Select(null)">
                        <Icon Name="check" Class="w-4 h-4"/> Play @_spirit.Name
                    </button>
                }
            </SheetFooter>
        }
    </ModalShell>
}

@code {
    /// One variant tile: the spirit as printed (null), or one of its aspects — the blurb, the
    /// record, and the tap the mode gives it. In the picker an unowned variant is inert: the
    /// collection decides what you can set up, even though it never decides what you can read.
    private RenderFragment AspectTile(Aspect? aspect) => __builder =>
    {
        var key = aspect?.Id.Value ?? SetupInsights.BaseAspectKey;
        var record = _aspectRecords?.GetValueOrDefault(key);
        var owned = aspect is null || Owns(aspect);
        var tappable = OnSelected.HasDelegate ? owned : Profile is not null;
        var ringed = (OnSelected.HasDelegate ? _current : _scope) == key;
        var tile = TileClass(record is { Played: > 0 }, tappable, ringed);
        var tooltip = AspectTooltip(aspect, record, ringed, tappable);

        @if (tappable)
        {
            <button @key="key" type="button" @onclick="() => AspectTap(aspect)" title="@tooltip"
                    class="@tile focus-ring">
                @AspectFace(aspect, record, owned)
            </button>
        }
        else
        {
            <div @key="key" title="@tooltip" class="@tile">
                @AspectFace(aspect, record, owned)
            </div>
        }
    };

    private RenderFragment AspectFace(Aspect? aspect, SetupInsights.PlayRecord? record, bool owned) => __builder =>
    {
        <div class="flex items-baseline gap-2">
            @* .row-title, as the pickers name the same variants — a name is a name. *@
            <span class="row-title">@(aspect?.Name ?? "No aspect")</span>
            @if (!owned)
            {
                <span class="badge badge-neutral shrink-0" title="Played at a table where someone else brought this expansion">
                    not in your collection
                </span>
            }
            @if (aspect is not null)
            {
                <span class="ml-auto shrink-0 micro-label text-ink-400">@GameLookups.ExpansionName(aspect.ExpansionId)</span>
            }
        </div>
        <p class="body-copy mt-1 text-xs">
            @(aspect is null ? "The spirit as printed, without a variant." : AspectDetails.For(aspect.Id)?.Summary)
        </p>
        @* The record line is drawn even when empty, so the tiles keep a common shape — the
           same rule the level tiles follow, worded rather than dashed on this wider face. *@
        @if (_aspectRecords is not null)
        {
            <div class="mt-1.5 text-[10px] tabular-nums @WinTone.ForRecord(record)">
                @(record is { Played: > 0 } ? SetupInsights.RecordLine(record) : "never played")
            </div>
        }
    };
}

@code {
    /// <summary>
    /// The reader's shelf, which decides which aspects are offered: null (an anonymous visitor,
    /// the public routes) shows every aspect. The same cascade every picker reads — it was a
    /// parameter, and the three hosts each forwarded the very value the cascade already carries.
    /// </summary>
    [CascadingParameter(Name = CurrentUserState.OwnedExpansionsCascade)]
    public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>When set, the variant tiles pick this spirit as that variant — used when opened
    /// from the picker. A spirit without variants gets a footer action instead.</summary>
    [Parameter] public EventCallback<SpiritPick> OnSelected { get; set; }

    /// <summary>Whether the aspect is in the reader's collection — see the note in Show.</summary>
    private bool Owns(Aspect aspect) => OwnedExpansions.Owns(aspect.ExpansionId);

    private Spirit? _spirit;
    private SpiritDetail? _detail;
    private IReadOnlyList<Aspect> _aspects = [];

    /// Per-aspect plays for this spirit; null when there is no history to report.
    private Dictionary<string, SetupInsights.PlayRecord>? _aspectRecords;

    /// The variant the profile is focused on: an aspect id, <see cref="SetupInsights.BaseAspectKey"/>
    /// for the spirit as printed, or null for every variant at once. Never set in picker mode,
    /// where a tap is the pick and the profile stays the whole spirit's.
    private string? _scope;

    /// The variant already chosen for the seat being edited — ringed in picker mode, the way
    /// the adversary picker rings its current level.
    private string? _current;

    private Aspect? ScopeAspect => _aspects.FirstOrDefault(a => a.Id.Value == _scope);

    /// The variant strip reports the same slice as the profile below it, so its heading names
    /// the same owner — RecordOwner, the way the adversary sheet's level grid does.
    private string AspectGridTitle =>
        Profile is null ? "Aspects"
        : RecordOwner is { } owner ? $"Aspects and {owner} record"
        : "Aspects and record";

    /// What the profile is of follows the focus, so its heading and empty state name the
    /// variant they are actually counting.
    private string ProfileTitle => _scope switch
    {
        null => "record with this spirit",
        SetupInsights.BaseAspectKey => "record with no aspect",
        _ => $"record as {ScopeAspect?.Name}"
    };

    private string ProfileName => _scope switch
    {
        null => _spirit!.Name,
        SetupInsights.BaseAspectKey => $"{_spirit!.Name} with no aspect",
        _ => $"{_spirit!.Name} · {ScopeAspect?.Name}"
    };

    /// <param name="aspectId">The aspect already chosen for the seat, if any — ringed in the
    /// picker, opened focused everywhere else.</param>
    public void Show(Spirit spirit, string? aspectId = null)
    {
        _spirit = spirit;
        _detail = SpiritDetails.For(spirit.Id);
        _aspectRecords = Facts is { Count: > 0 }
            ? SetupInsights.AspectRecords(Facts, spirit.Id.Value, SeatFilter)
            : null;

        // Owned aspects, plus any that were actually played. A friend can bring an expansion
        // to the table that you don't have a copy of — the game happened, so the record sheet
        // has to be able to show it. What the collection governs is what you can pick, not
        // what you can read back (see AspectTile).
        var played = _aspectRecords?
            .Where(r => r.Value.Played > 0)
            .Select(r => r.Key)
            .ToHashSet() ?? [];

        _aspects = GameData.GetAspectsForSpirit(spirit.Id)
            .Where(a => Owns(a) || played.Contains(a.Id.Value))
            .ToList();
        var known = !string.IsNullOrEmpty(aspectId) && _aspects.Any(a => a.Id.Value == aspectId)
            ? aspectId
            : null;
        _current = OnSelected.HasDelegate ? known : null;
        _scope = OnSelected.HasDelegate || _aspectRecords is null ? null : known;
        RebuildProfile();
        StateHasChanged();
    }

    private void Close()
    {
        _spirit = null;
        _detail = null;
        _aspects = [];
        Profile = null;
        _aspectRecords = null;
        _scope = null;
        _current = null;
    }

    /// A tile is a pick where somebody is listening for one, and the record's focus switch
    /// where there is a record — never both, so mid-setup a tap can only ever mean the choice
    /// being made. The same rule the adversary sheet's level tiles follow.
    private async Task AspectTap(Aspect? aspect)
    {
        if (OnSelected.HasDelegate)
        {
            await Select(aspect);
            return;
        }
        var key = aspect?.Id.Value ?? SetupInsights.BaseAspectKey;
        _scope = _scope == key ? null : key;
        RebuildProfile();
    }

    /// The profile counts what the focus says. An aspect is its own subject kind; the spirit as
    /// printed has none, so "no aspect" is the spirit's own profile over the aspect-less seats —
    /// the seat filter narrowed once more, since an aspect belongs to a seat.
    private void RebuildProfile()
    {
        if (_spirit is null || Facts is not { Count: > 0 })
        {
            Profile = null;
            return;
        }
        Profile = _scope switch
        {
            null => SetupProfiles.Build(SetupSubjectKind.Spirit, _spirit.Id.Value, Facts, SeatFilter),
            SetupInsights.BaseAspectKey => SetupProfiles.Build(
                SetupSubjectKind.Spirit, _spirit.Id.Value, Facts,
                s => s.AspectId is null && (SeatFilter?.Invoke(s) ?? true)),
            _ => SetupProfiles.Build(SetupSubjectKind.Aspect, _scope, Facts, SeatFilter)
        };
    }

    /// <summary>Same chrome the level tiles wear, on a wider face.</summary>
    private static string TileClass(bool played, bool interactive, bool ringed) =>
        $"rounded-lg p-3 text-left {TileChrome.For(played, interactive, ringed)}";

    /// What the tile says on hover: the variant, the record with it, and what a tap will do —
    /// the same sentence shape the level tiles use.
    private string AspectTooltip(Aspect? aspect, SetupInsights.PlayRecord? record, bool ringed, bool tappable)
    {
        var label = aspect is null ? $"{_spirit!.Name} with no aspect" : $"{_spirit!.Name} · {aspect.Name}";
        var line = SetupInsights.RecordTooltip(label, record, SubjectName, _aspectRecords is not null);
        if (ringed)
        {
            return OnSelected.HasDelegate
                ? $"{line}. Already the variant chosen for this seat."
                : $"{line}. The record below is focused on this variant — tap again for every variant.";
        }
        if (!tappable) return line;
        return OnSelected.HasDelegate
            ? $"{line}. Tap to play it."
            : $"{line}. Tap to focus the record on this variant.";
    }

    private async Task Select(Aspect? aspect = null)
    {
        var spirit = _spirit;
        Close();
        if (spirit is not null) await OnSelected.InvokeAsync(new SpiritPick(spirit, aspect));
    }
}
