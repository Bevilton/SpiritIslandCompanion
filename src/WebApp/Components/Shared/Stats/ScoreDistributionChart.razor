@* Completed-game scores as a histogram, bucketed into bands of <c>BucketSize</c>. The picture is
   ColumnChart, shared with the difficulty chart beside it, and the bucketing is Histogram's,
   shared with it too; this decides only the band width and the colour.

   Sun rather than jade: a score is a figure, not an outcome, and the green on this page means
   won. Sun500 rather than 600 so these bars carry the same weight as the jade ones on the
   difficulty chart beside them; 600 goes olive against parchment. *@

<ColumnChart Bars="_bars" Color="@StatsTheme.Sun500"/>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<int> Scores { get; set; } = [];

    /// <summary>The width of a score band. A constant rather than a parameter: one page draws
    /// this chart, and the bucketing is what makes a run of scores read as a distribution.</summary>
    private const int BucketSize = 20;

    private IReadOnlyList<ColumnChart.Bar> _bars = [];

    protected override void OnParametersSet() => _bars = Histogram.Of(Scores, BucketSize);
}
