@* Horizontal strip of the user's 5 most recent finished games — clickable cards that
   navigate to the game detail. Drafts are filtered out upstream (see GetRecentGames), which is
   why a RecentGameSummary carries an outcome and a score rather than the possibility of one:
   the card reports a result, never a status.

   A .surface like every other clickable card, with the outcome's edge as the one utility that
   overrides its border — this was the one card in the app that spelled the surface out by hand
   and so was the only raised card without the shadow. *@

@if (Games.Count == 0)
{
    <div class="surface no-data">No finished games yet.</div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        @foreach (var g in Games)
        {
            var title = GameLookups.MatchTitle(g.AdversaryIds, g.ScenarioId);
            var border = g.Win ? "border-accent-300" : "border-red-200";
            <a @key="g.Id" href="@GamesLink.Game(g.Id)" class="surface card-lift block p-4 @border focus-ring">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="micro-label">@GameFormat.DayOnly(g.StartedAt.DateTime)</div>
                    <GameStatusBadge IsCompleted="true" Win="g.Win"/>
                </div>
                <div class="mb-1 truncate text-sm @GameLookups.MatchTitleTone(title)">@title</div>
                <div class="row-sub mb-2 flex items-center justify-between">
                    <span>@Copy.Count(g.PlayerCount, "player") · diff @g.Difficulty</span>
                    <span class="numeral @WinTone.ForOutcome(g.Win)">@g.Score</span>
                </div>
                <SpiritAvatarStack SpiritIds="g.SpiritIds"/>
            </a>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RecentGameSummary> Games { get; set; } = [];
}
