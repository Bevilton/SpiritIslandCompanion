@* How often the table plays and how it goes, month by month: one column per month, jade won
   stacked on ember lost. The chrome is ChartOptions.Columns, shared with the two distribution
   charts below it on the page. *@

@using ApexCharts

@if (_data.Count == 0)
{
    <div class="no-data">No monthly data yet.</div>
}
else
{
    @* The series colours are the options' — one list, in series order — rather than a Color on
       each series as well, which was the same two hexes spelled a second time. *@
    <ApexChart TItem="MonthlyRow" Options="_options">
        <ApexPointSeries TItem="MonthlyRow"
                         Items="_data"
                         Name="Wins"
                         SeriesType="SeriesType.Bar"
                         XValue="@(d => d.Label)"
                         YValue="@(d => d.Wins)"/>
        <ApexPointSeries TItem="MonthlyRow"
                         Items="_data"
                         Name="Losses"
                         SeriesType="SeriesType.Bar"
                         XValue="@(d => d.Label)"
                         YValue="@(d => d.Losses)"/>
    </ApexChart>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MonthlyStats> Months { get; set; } = [];

    /// <summary>The plot's height. A constant rather than a parameter, as <see cref="ColumnChart"/>'s
    /// is: one page draws this chart, so a height it could pass is a second place to keep the
    /// number — and the default that was here had already stopped being the one in use.</summary>
    private const int PlotHeight = 280;

    /// <summary>One column: the month, and the two outcomes stacked in it. Drafts are in
    /// neither — <see cref="MonthlyStats.Losses"/> is the finished games that were lost, not
    /// everything that wasn't a win.</summary>
    public sealed record MonthlyRow(string Label, int Wins, int Losses);

    private ApexChartOptions<MonthlyRow> _options = new();
    private IReadOnlyList<MonthlyRow> _data = [];

    protected override void OnParametersSet()
    {
        _data = Months
            .OrderBy(m => m.Year).ThenBy(m => m.Month)
            .Select(m => new MonthlyRow(
                Label: GameFormat.MonthShort(new DateTime(m.Year, m.Month, 1)),
                Wins: m.Wins,
                Losses: m.Losses))
            .ToList();

        // The two colours are what the columns mean, so this is the one chart of the three whose
        // legend earns its line.
        _options = ChartOptions.Columns<MonthlyRow>(
            PlotHeight, [StatsTheme.Accent500, StatsTheme.DangerSoft], stacked: true, showLegend: true);
    }
}
