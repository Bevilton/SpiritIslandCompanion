@* Compact "highlight" card — the statistics tabs' answer to "most played", "highest win rate",
   "toughest": a title, a coloured bar for a subject with a colour of its own, the subject's name,
   and the one figure that earns it the card. With OnClick the whole card is a button — it opens
   the subject's record sheet, the same affordance the catalogue cards have. *@

@if (OnClick.HasDelegate)
{
    <button type="button" @onclick="OnClick" title="@Copy.SheetTooltip(Subject)"
            class="surface card-lift px-5 py-4 w-full text-left focus-ring">
        @Body
    </button>
}
else
{
    <div class="surface px-5 py-4">@Body</div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Subject { get; set; } = "";
    [Parameter] public string? Secondary { get; set; }
    [Parameter, EditorRequired] public string Metric { get; set; } = "";
    [Parameter] public string? MetricLabel { get; set; }
    [Parameter] public string? AccentColor { get; set; }
    /// <summary>Tone for the figure — usually WinTone's. Null leaves it in the body ink.</summary>
    [Parameter] public string? MetricColorClass { get; set; }

    /// <summary>Opens the subject's record sheet. Omit for a passive card.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private RenderFragment Body => __builder =>
    {
        <div class="flex items-start gap-3">
            @if (!string.IsNullOrEmpty(AccentColor))
            {
                <ColorBar Size="full" Color="@AccentColor"/>
            }
            <div class="min-w-0 flex-1">
                <div class="micro-label">@Title</div>
                <div class="mt-1 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="card-title truncate">@Subject</div>
                        @if (!string.IsNullOrEmpty(Secondary))
                        {
                            <div class="row-sub mt-0.5 truncate">@Secondary</div>
                        }
                    </div>
                    <div class="text-right shrink-0">
                        <div class="numeral-display text-lg @(MetricColorClass ?? "text-ink-900")">@Metric</div>
                        @if (!string.IsNullOrEmpty(MetricLabel))
                        {
                            <div class="micro-label mt-1">@MetricLabel</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    };
}
