@* The headline stat tile: a label, one big figure, an optional caption, and a whole-tile
   link to whatever the figure is about. The dashboard and the statistics page both open with a
   row of these, which is what keeps a headline number looking the same in both. *@

<div class="@_wrapperClass">
    <div class="flex items-start justify-between gap-3 h-full">
        <div class="min-w-0 flex flex-col gap-1.5">
            <div class="micro-label">@Label</div>
            <div class="stat-tile-value">@Value</div>
            @if (!string.IsNullOrEmpty(Caption))
            {
                <div class="block-note leading-snug">@Caption</div>
            }
        </div>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <IconChip Name="@Icon"/>
        }
    </div>
    @if (Href is not null)
    {
        <a href="@Href" class="absolute inset-0 rounded-xl focus-ring" aria-label="@Label"></a>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }

    /// <summary>Extra classes on the tile — in practice one of tile-sun / tile-ember / tile-deep,
    /// which is how a row of tiles colours the bar down its leading edge to say what kind of
    /// figure each one is. The bar defaults to jade.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>.stat-tile already carries `relative` and a transition, so neither is repeated here.
    /// Built once per parameter change rather than per render — a row of these re-renders with the
    /// page, and the join is the same answer every time.</summary>
    private string _wrapperClass = "stat-tile";

    protected override void OnParametersSet() =>
        _wrapperClass = string.Join(' ', new[]
        {
            "stat-tile",
            Class,
            // The same wash a linked card answers with elsewhere (GameSetupSummary's faces) — the two
            // had settled on /30 and /40, a difference nobody could see and nobody could defend.
            Href is null ? null : "hover:border-accent-300 hover:bg-accent-50/40",
        }.Where(c => !string.IsNullOrEmpty(c)));
}
