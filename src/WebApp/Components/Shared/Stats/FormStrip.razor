@* The last handful of finished games as a row of win/loss pips — the "how has it been
   going lately" line the dashboard leads its numbers with. Each pip links to the game it
   stands for, and the record underneath splits the window into wins and defeats.

   Entries may arrive in any order; the strip always reads oldest → newest, so the pip at
   the right-hand end is the most recent result. The run that record ends on is the streak
   the dashboard's own tile carries — it isn't repeated here. *@

@{
    var ordered = Entries.OrderBy(e => e.PlayedAt).ToList();
    var wins = ordered.Count(e => e.Win);
    var losses = ordered.Count - wins;
}

@if (ordered.Count == 0)
{
    <p class="text-sm text-ink-500">No finished games yet — the run starts with your first recorded result.</p>
}
else
{
    <div class="flex flex-wrap items-center gap-1.5">
        @foreach (var e in ordered)
        {
            @* A shade smaller on a phone, where a ten-game window wraps to a second row. *@
            <a @key="e.Id" href="@GamesLink.Game(e.Id, null)" title="@Tooltip(e)"
               class="inline-flex h-7 w-7 items-center justify-center rounded-lg border text-xs font-bold transition-all sm:h-8 sm:w-8
                      hover:-translate-y-px hover:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40
                      @(e.Win ? "border-accent-200 bg-accent-100 text-accent-800" : "border-red-200 bg-red-50 text-red-700")"
               style="font-family: var(--font-serif);">
                @(e.Win ? "W" : "L")
            </a>
        }
    </div>

    @* Same "N W · N L" shorthand the statistics tables write a record with. *@
    <p class="mt-3 text-xs tabular-nums text-ink-500">
        <span class="font-medium text-accent-700">@wins W</span> ·
        <span class="font-medium text-red-600">@losses L</span>
        over the last @ordered.Count
    </p>
}

@code {
    /// <param name="Title">What the match is called wherever it's listed — see GameLookups.MatchTitle.</param>
    public sealed record Entry(Guid Id, DateTimeOffset PlayedAt, bool Win, string Title, int? Score);

    [Parameter, EditorRequired] public IReadOnlyList<Entry> Entries { get; set; } = [];

    private static string Tooltip(Entry e)
    {
        // StartedAt is read back as stored, not converted — it carries the wall clock the
        // player wrote down (see GameDetail).
        var date = e.PlayedAt.DateTime.ToString("MMM d, yyyy");
        var result = e.Win ? "victory" : "defeat";
        return e.Score is { } score
            ? $"{e.Title} — {result}, {score} points · {date}"
            : $"{e.Title} — {result} · {date}";
    }
}
