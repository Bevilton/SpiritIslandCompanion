@* Games per difficulty: one column per value between the lowest and highest played, so the
   shape says what the table actually reaches for. The picture is ColumnChart and the bucketing
   Histogram's, both shared with the score chart beside it; this decides only that a band is one
   difficulty wide. *@

<ColumnChart Bars="_bars" Color="@StatsTheme.Accent600" XAxisTitle="Difficulty"/>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<int> Difficulties { get; set; } = [];

    private IReadOnlyList<ColumnChart.Bar> _bars = [];

    protected override void OnParametersSet() => _bars = Histogram.Of(Difficulties, bucketSize: 1);
}
