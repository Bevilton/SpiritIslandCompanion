@* Coverage panel — shows how many items from a candidate set haven't been
   played yet, with a horizontal completion bar and a small grid of "missing"
   pills. Generic over the item type so it works for spirits, scenarios,
   boards, adversary levels, etc. *@

@typeparam TItem

@{
    var missingCount = MissingCount ?? Missing.Count;
    // Nothing to cover is fully covered; the clamp is for the printed figure, since Meter clamps
    // its own width.
    var pct = Total > 0 ? Math.Clamp(Percent.Of(Total - missingCount, Total), 0, 100) : 100;
}

<section class="surface px-5 py-4">
    <div class="section-head">
        <div>
            <div class="micro-label">@Title</div>
            <div class="numeral mt-0.5 text-base text-ink-900">
                @(Total - missingCount) <span class="text-ink-500 font-normal">/ @Total played</span>
            </div>
        </div>
        <div class="text-xs tabular-nums @(pct >= 75 ? "text-accent-700" : "text-ink-500")">@($"{pct:F0}%")</div>
    </div>

    @if (!string.IsNullOrEmpty(Note))
    {
        <div class="section-note -mt-1 mb-3">@Note</div>
    }

    <Meter Value="pct" FillClass="bg-accent-500" Class="h-2 mb-4"/>

    @if (Missing.Count == 0)
    {
        <div class="text-xs text-accent-700 flex items-center gap-1.5">
            <Icon Name="check" Class="w-3.5 h-3.5"/>
            All @Title.ToLowerInvariant() covered.
        </div>
    }
    else
    {
        <div class="micro-label mb-2">Not yet played</div>
        <div class="flex flex-wrap gap-1.5">
            @foreach (var item in Missing)
            {
                @ItemTemplate(item)
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public int Total { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Missing { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> ItemTemplate { get; set; } = default!;

    /// <summary>
    /// A line under the tally, for what the tally deliberately leaves out — chiefly the
    /// things played at somebody else's table, from an expansion the reader doesn't own.
    /// Coverage is about your own shelf, so those can't be counted in it, but they did happen.
    /// </summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>Override the number used for the "X / Y played" math when the
    /// items in <see cref="Missing"/> are grouped (e.g. one row per adversary
    /// covering several levels). Defaults to <c>Missing.Count</c>.</summary>
    [Parameter] public int? MissingCount { get; set; }
}
