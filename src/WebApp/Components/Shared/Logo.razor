@* Inline mark + wordmark. Pass Compact="true" for icon-only, OnDeep="true" on deep chrome
   (the sidebar, the public nav, the hero) where the ink-900 wordmark would be invisible. *@
<a href="@Href" class="inline-flex items-center gap-2.5 @(OnDeep ? "text-ink-50 hover:text-ink-50" : "text-ink-900 hover:text-ink-900")">
    <span class="inline-flex h-8 w-8 items-center justify-center rounded-[10px] text-white"
          style="background-image: linear-gradient(150deg, var(--color-accent-500), var(--color-accent-800));
                 box-shadow: inset 0 0 0 1px rgb(from var(--color-accent-300) r g b / .35),
                             0 6px 18px -8px rgb(from var(--color-accent-600) r g b / .70);">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M4 16c1.5-1 3-1.5 4.5-1.5S11.5 15 13 16s3 1.5 4.5 1.5 3-.5 4.5-1.5"/>
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 4c1.8 2.5 3 4.8 3 7.5 0 1.6-1.3 2.5-3 2.5s-3-.9-3-2.5C9 8.8 10.2 6.5 12 4Z"/>
        </svg>
    </span>
    @if (!Compact)
    {
        <span class="font-semibold tracking-tight" style="font-family: var(--font-serif);">Spirit Island</span>
    }
</a>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>Set on deep chrome — flips the wordmark to parchment.</summary>
    [Parameter] public bool OnDeep { get; set; }
}
