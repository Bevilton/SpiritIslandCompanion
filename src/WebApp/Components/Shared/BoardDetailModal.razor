@* Board reference sheet — the board's letter, thematic position and, given Facts, the record on
   it (which spirits get placed there, how those games went). Given OnSelected the board can be
   chosen straight from here. Whose record it is belongs to the host — see DetailSheetBase. *@
@inherits DetailSheetBase

@if (_board is not null)
{
    var detail = _detail;
    var color = GameLookups.BoardColor(detail);
    var letter = GameLookups.BoardLetter(_board);

    <ModalShell OnClose="Close" ZIndex="@SheetZIndex" MaxWidth="@SheetWidth">
        <DetailModalHeader Title="@_board.Name" OnClose="Close" TintStyle="@GameLookups.TintBandStyle(color)">
            <Glyph>
                <LetterTile Size="3xl" Color="@color" Text="@letter"/>
            </Glyph>
            <Badges>
                <span class="badge badge-neutral">@GameLookups.ExpansionName(_board.ExpansionId)</span>
                @if (detail is not null)
                {
                    @* G and H are standard-side stand-ins — saying they sit on the
                       thematic island would contradict the island itself. *@
                    <span>
                        · @detail.ThematicName@(ThematicIslandBoards.Includes(_board.Id) ? " on the thematic island" : " — not part of the thematic island")
                    </span>
                }
            </Badges>
        </DetailModalHeader>

        @* Nothing but the record goes in the body, so a sheet with no record to show has no
           body at all rather than a band of padding. The public pages are a reference anyone
           can read and say nothing about the reader — as the spirit and adversary sheets
           don't either — so only a page that went looking for a record reports finding none. *@
        @if (Profile is not null || !ReferenceOnly)
        {
            <div class="sheet-body">
                @if (Profile is not null)
                {
                    <SetupProfileSection Profile="Profile" Name="@_board.Name"
                                         Scoped="Scoped" SubjectName="@SubjectName"
                                         Title="record on this board"
                                         LinkGames="LinkGames"
                                         AllGamesHref="@GamesLink.ForBoard(_board.Id.Value, who: ScopeWho)"/>
                }
                else
                {
                    <SheetNoRecord Subject="board"/>
                }
            </div>
        }

        @if (OnSelected.HasDelegate)
        {
            <SheetFooter BackLabel="boards" OnBack="Close">
                <button type="button" class="btn btn-primary" @onclick="Select">
                    <Icon Name="check" Class="w-4 h-4"/> Use @_board.Name
                </button>
            </SheetFooter>
        }
    </ModalShell>
}

@code {
    /// <summary>When set, a footer action picks this board — used when opened from the picker.</summary>
    [Parameter] public EventCallback<Board> OnSelected { get; set; }

    private Board? _board;
    private BoardDetail? _detail;

    public void Show(Board board)
    {
        _board = board;
        _detail = BoardDetails.For(board.Id);
        // A board sits in a seat, so the scope narrows the seats rather than dropping games.
        Profile = Facts is { Count: > 0 }
            ? SetupProfiles.Build(SetupSubjectKind.Board, board.Id.Value, Facts, SeatFilter)
            : null;
        StateHasChanged();
    }

    private void Close()
    {
        _board = null;
        _detail = null;
        Profile = null;
    }

    private async Task Select()
    {
        var board = _board;
        Close();
        if (board is not null) await OnSelected.InvokeAsync(board);
    }
}
