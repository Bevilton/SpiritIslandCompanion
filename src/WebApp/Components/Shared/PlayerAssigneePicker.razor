@* Inline picker for who plays a slot in a recorded game: yourself, a friend, or a local player.

   The avatars, the icons and the kind labels are PlayerAssigneeBadge's — this used to carry a
   second copy of all four decisions, plus a private enum shadowing the badge's own and a hand-
   built RenderTreeBuilder where the badge simply renders an <Icon>. The trigger is now literally
   the badge, so what the closed control shows is the same thing every other surface shows for
   that person.

   The rows below are not: a row's second line is the person's email or "Local player" — data
   rather than the kind — so they take the avatar alone and lay the text out themselves.

   The trigger and its menu are .field-button / .field-menu, shared with the statistics page's
   scope picker: the two are the same control, and this one used to spell both out. *@

<div class="relative">
    @{ var current = ResolveCurrent(); }
    <button type="button" @onclick="Toggle" class="field-button w-full justify-between"
            aria-expanded="@Aria.Flag(_open)">
        <PlayerAssigneeBadge Kind="current.Kind" Name="@current.Label"/>
        <Chevron Open="_open"/>
    </button>

    @if (_open)
    {
        <ClickAway OnDismiss="() => _open = false"/>
        <div class="field-menu left-0 right-0 max-h-72">
            <div class="px-2 py-1 micro-label">You</div>
            @Row(SeatAssignee.Me, AssigneeKind.Me, "Me", "Signed-in account", "text-accent-700")

            @if (Friends.Count > 0)
            {
                <div class="mt-2 px-2 py-1 micro-label">
                    Friends · <span class="text-ink-400">accounts</span>
                </div>
                @foreach (var f in Friends)
                {
                    @Row(SeatAssignee.ForFriend(f.FriendUserId), AssigneeKind.Friend, f.Name, f.Email)
                }
            }

            @if (LocalPlayers.Count > 0)
            {
                <div class="mt-2 px-2 py-1 micro-label">
                    Local players · <span class="text-ink-400">no account</span>
                </div>
                @foreach (var p in LocalPlayers)
                {
                    @Row(SeatAssignee.ForPlayer(p.Id), AssigneeKind.Player, p.Name, "Local player")
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>Who is in the seat — see <see cref="SeatAssignee"/> for the shape.</summary>
    [Parameter] public string Value { get; set; } = SeatAssignee.Me;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public IReadOnlyList<FriendResponse> Friends { get; set; } = [];
    [Parameter] public IReadOnlyList<ListPlayersResponse> LocalPlayers { get; set; } = [];

    private bool _open;

    private RenderFragment Row(string key, AssigneeKind kind, string name, string detail,
        string? detailClass = null) =>
        @<PickRow @key="key" Active="Value == key" OnClick="() => Pick(key)">
            @PlayerAssigneeBadge.Avatar(kind)
            <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium text-ink-900">@name</span>
                <span class="block truncate fine-note @detailClass">@detail</span>
            </span>
        </PickRow>;

    private sealed record AssigneeInfo(AssigneeKind Kind, string Label);

    /// What the closed control shows. A friend or a guest the lists no longer hold is drawn as
    /// unknown rather than as their kind — the seat names somebody the table can no longer place.
    private AssigneeInfo ResolveCurrent() => SeatAssignee.Resolve(Value, Friends, LocalPlayers) switch
    {
        (AssigneeKind.Me, _)             => new(AssigneeKind.Me, "Me"),
        (AssigneeKind.Friend, { } name)  => new(AssigneeKind.Friend, name),
        (AssigneeKind.Friend, null)      => new(AssigneeKind.Unknown, "Unknown friend"),
        (AssigneeKind.Player, { } name)  => new(AssigneeKind.Player, name),
        (AssigneeKind.Player, null)      => new(AssigneeKind.Unknown, "Unknown player"),
        _                                => new(AssigneeKind.Unknown, "Select…"),
    };

    private void Toggle() => _open = !_open;

    private async Task Pick(string key)
    {
        _open = false;
        if (Value != key) await ValueChanged.InvokeAsync(key);
    }
}
