@* Toggleable filter pill — clean active/inactive states.
   Usage: <FilterPill Active="@isActive" OnToggle="() => Toggle(value)">Label</FilterPill>

   Given an Href instead it is the same pill as a link, for a row of pills that is really a set
   of addresses rather than a set of switches — the statistics tabs, which live in the URL. Same
   shape either way, so the two kinds of row still look like one control. *@

@if (Href is { } href)
{
    <a href="@href" aria-current="@(Active ? "page" : null)" title="@Title" class="@CssClass">
        @Label
    </a>
}
else
{
    <button type="button"
            @onclick="OnToggle"
            aria-pressed="@Aria.Flag(Active)"
            title="@Title"
            class="@CssClass">
        @Label
    </button>
}

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    /// <summary>Makes the pill a link to this address rather than a switch.</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// How many things this pill would leave showing, set faintly after the label. Eight pills
    /// across four rows were spelling the same tabular, half-lit span out; leave it null where
    /// the pill has nothing to count, which is what the rows that hide a zero already meant.
    /// </summary>
    [Parameter] public int? Count { get; set; }

    private RenderFragment Label => __builder =>
    {
        @ChildContent
        @if (Count is { } count)
        {
            <span class="tabular-nums opacity-60">@count</span>
        }
    };

    /// The tones are the chip family's (.chip.is-selected, .chip-neutral) — which is also what
    /// keeps the link form from coming out jade among the switches, since a link would otherwise
    /// inherit the accent from the base stylesheet. The hovers are a switch's own: it answers the
    /// pointer in ink rather than in the jade a door (.chip-door) does. The ring and the
    /// transition come with being drawn as a button or a link — see button.chip in site.css.
    private string CssClass =>
        "chip chip-lg font-medium "
        + (Active
            // An active pill is still the click that turns it off, so it answers the pointer too.
            ? "is-selected hover:bg-accent-200"
            : "chip-neutral hover:border-ink-300 hover:text-ink-800");
}
