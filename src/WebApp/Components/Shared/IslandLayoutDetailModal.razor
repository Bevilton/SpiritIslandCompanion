@* Island layout record sheet — the layout drawn large, which boards make it when that is
   fixed, and, given Facts, the record on it: how those games went and who was fielded.
   Serves both a published layout, whose picture ships with the app, and a saved shape
   from the player's library, whose picture is drawn from the geometry they saved.

   An island is the whole table's, so a host scopes it to a person by the games they sat
   in rather than by seats — see DetailSheetBase.

   The picture is the point of this sheet — it is the one place the island can be looked at
   properly rather than as a thumbnail in a grid — so it leads the body at full width instead
   of sitting in the header at tile size. *@
@inherits DetailSheetBase

@if (_open)
{
    <ModalShell OnClose="Close" ZIndex="@SheetZIndex" MaxWidth="@SheetWidth">
        <DetailModalHeader Title="@_name" OnClose="Close" TintClass="@HeaderTint">
            <Badges>
                <span class="badge badge-neutral">@Copy.Count(_boardCount, "board")</span>
                @if (_setup?.IsThematic == true)
                {
                    <span class="badge badge-info">Thematic</span>
                }
                @if (_savedAt is { } saved)
                {
                    <span class="badge badge-success">Your shape</span>
                    <span>· kept @SetupInsights.Ago(saved)</span>
                }
            </Badges>
        </DetailModalHeader>

        <div class="sheet-body space-y-6">
            @* The island itself, as big as the sheet allows. *@
            <div class="flex h-44 items-center justify-center rounded-xl border border-ink-200 bg-sky-50/40 p-3 md:h-72">
                <IslandSetupDiagram Setup="_setup" Geometry="@_geometry" BoardCount="_boardCount"
                                    Label="@_name"/>
            </div>

            @* The thematic island is the real island cut up, so which board goes where is
               settled before anyone sits down — worth saying, since every other layout
               leaves it entirely open. Slot order, as the picture is drawn. *@
            @if (_regions is { Count: > 0 })
            {
                <div>
                    <SectionHead Size="label" Level="3" Class="mb-2" Title="Boards on this island"
                                 Note="Fixed — each board is a region"/>
                    <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
                        @foreach (var boardId in _regions)
                        {
                            var detail = BoardDetails.For(boardId);
                            var color = GameLookups.BoardColor(detail);
                            <div @key="boardId" class="flex items-center gap-2.5 rounded-lg border border-ink-200 bg-white px-2.5 py-2">
                                <LetterTile Size="md" Color="@color" Text="@detail?.Letter"/>
                                <span class="tile-title min-w-0 truncate">@detail?.ThematicName</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Profile is not null)
            {
                <SetupProfileSection Profile="Profile" Name="@_name" Title="record on this island"
                                     Scoped="Scoped" SubjectName="@SubjectName"
                                     LinkGames="LinkGames"
                                     AllGamesHref="@_gamesHref"/>
            }
            else if (!ReferenceOnly)
            {
                <SheetNoRecord Subject="layout"/>
            }
        </div>
    </ModalShell>
}

@code {
    private bool _open;
    private string _name = "";
    private int _boardCount;
    private IslandSetup? _setup;
    private string? _geometry;
    private DateTimeOffset? _savedAt;

    /// The games list narrowed to whichever island this sheet was opened for.
    private string? _gamesHref;

    /// <summary>The boards this island is made of, for a thematic layout; null for any other.</summary>
    private IReadOnlyList<BoardId>? _regions;

    /// The header wears the kind's tint — the same two classes the index tiles pick through
    /// IslandTileBase.KindTint, so the sheet and the tile that opened it cannot drift apart. A
    /// standard layout keeps DetailModalHeader's neutral band.
    private string? HeaderTint =>
        _savedAt is not null ? "tint-saved"
        : _setup?.IsThematic == true ? "tint-thematic"
        : null;

    /// <summary>A published layout, matched in the history by its setup id.</summary>
    public void Show(IslandSetup setup)
    {
        _setup = setup;
        _geometry = null;
        _savedAt = null;
        _name = setup.Name;
        _boardCount = setup.BoardCount;
        _regions = ThematicIslandBoards.For(setup.Id);
        Open(SetupSubjectKind.IslandLayout, setup.Id.Value, GamesLink.ForIsland(setup.Id.Value, ScopeWho));
    }

    /// <summary>A shape from the player's library, matched by the games' <c>CustomLayoutId</c>.</summary>
    public void Show(IslandLayoutResponse saved)
    {
        _setup = null;
        _geometry = saved.LayoutJson;
        _savedAt = saved.UpdatedAt;
        _name = saved.Name;
        _boardCount = saved.BoardCount;
        _regions = null;
        Open(SetupSubjectKind.SavedLayout, saved.Id.ToString(), GamesLink.ForSavedLayout(saved.Id, ScopeWho));
    }

    /// The half of opening that is the same for either kind of island: profile it against the
    /// scoped history and raise the sheet.
    private void Open(SetupSubjectKind kind, string id, string gamesHref)
    {
        var facts = ScopedFacts();
        Profile = facts is not null ? SetupProfiles.Build(kind, id, facts) : null;
        _gamesHref = gamesHref;
        _open = true;
        StateHasChanged();
    }

    private void Close()
    {
        _open = false;
        _setup = null;
        _geometry = null;
        _savedAt = null;
        _regions = null;
        Profile = null;
        _gamesHref = null;
    }
}
