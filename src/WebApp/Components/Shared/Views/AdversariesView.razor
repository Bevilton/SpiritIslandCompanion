@* Reference content for adversaries. Used from /adversaries (public) and /app/adversaries.
   Pass OwnedExpansions to filter; null (default) shows every adversary.
   Pass Records for the signed-in view to sort and filter by the account's recorded history — a
   reference page counts every game on the account and never narrows to one player.

   The filter is FilterBar, shared with every other catalogue and picker. Adversaries have no
   facets of their own — expansion, difficulty and the record so far is the whole of what there
   is to ask about eight of them. *@

<div class="page-head">
    <div>
        <span class="eyebrow">Reference</span>
        <h1 class="page-title mt-2">Adversaries</h1>
        <p class="page-sub">@_inScope.Count adversaries with their difficulty progression.</p>
    </div>
    <input type="search" class="input md:w-64" placeholder="Filter by name…" aria-label="Filter by name"
           @bind="_filter.Query" @bind:event="oninput"/>
</div>

<div class="mt-4">
    <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
               PresentExpansions="_filter.ExpansionsIn(_inScope)"
               ShowingCount="_visible.Count" TotalCount="_inScope.Count"
               UntestedLabel="Never faced" UntestedHint="Adversaries nobody at your table has faced"
               Changed="StateHasChanged"/>
</div>

<div class="grid lg:grid-cols-2 gap-4 mt-6">
    @foreach (var a in _visible)
    {
        var detail = AdversaryDetails.For(a.Id);
        var levels = _facing?.GetValueOrDefault(a.Id.Value)?.Levels
                     ?? (Records is null ? null : AdversaryLevelGrid.NoRecords);
        @* A card holding tappable level tiles has to stop being one big button — a button inside
           one is not something the browser will render. The disclosure becomes a full-card
           overlay and the level tiles are raised above it, the same arrangement the statistics
           cards use. *@
        <div @key="a.Id.Value"
             class="surface relative p-5 transition-all hover:shadow-sm hover:-translate-y-px md:p-6">
            <button type="button" @onclick="() => OpenDetail(a)"
                    title="@($"{a.Name} — details{(Records is null ? "" : " and full record")}")"
                    class="absolute inset-0 w-full rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                <span class="sr-only">@a.Name — details@(Records is null ? "" : " and full record")</span>
            </button>
            <div class="pointer-events-none relative">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h3 class="text-lg font-semibold leading-tight">@a.Name</h3>
                        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-500">
                            <span>@GameLookups.ExpansionName(a.ExpansionId)</span>
                            @if (detail is not null)
                            {
                                <span>·</span>
                                <span>@detail.Theme</span>
                            }
                        </div>
                    </div>
                    @* The record over every level, beside the name — the strip below already
                       splits it up, so the total belongs with the foe it is about rather than in
                       a section of its own under it. The shield stays where there is no record
                       to put here, which is the public route. *@
                    @if (Records is not null)
                    {
                        <RecordChip Record="Records.GetValueOrDefault(a.Id.Value)" Subject="@a.Name" NeverLabel="Never faced"/>
                    }
                    else
                    {
                        <Icon Name="shield" Class="w-5 h-5 text-accent-600 shrink-0"/>
                    }
                </div>

                @* The same strip the record sheet and the statistics card draw — which is why a
                   signed-in reader sees their record per level here too, rather than having to
                   open the sheet to find out that this page was showing them half the picture.
                   A tap opens the sheet already focused on that level, the same thing a tap on
                   a level means inside the sheet itself. *@
                <div class="mt-5">
                    <div class="text-xs uppercase tracking-wide text-ink-500 mb-2">
                        @(Records is null ? "Difficulty by level" : "Difficulty and record by level")
                    </div>
                    <AdversaryLevelGrid Adversary="a" Records="levels" Columns="grid-cols-7"
                                        OnPick="LevelTap(a)" TapHint="Opens the record sheet focused on this level."
                                        RaiseAboveOverlay="true"/>
                </div>
            </div>
        </div>
    }
</div>

@if (_visible.Count == 0)
{
    <div class="surface text-center py-10 mt-6 text-ink-500">No adversaries match the current filters.</div>
}

@* LinkGames only where there is a record to link from: the public route has no reader to have
   one, and no games page to send them to. *@
<AdversaryDetailModal @ref="_modal" Facts="Facts" LinkGames="@(Records is not null)"/>

@code {
    /// <summary>Null (default) shows everything; non-null restricts to those expansions.</summary>
    [Parameter] public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>
    /// The account's record per adversary — every game the visitor has recorded, whoever sat at
    /// the table. Unlocks ordering by how often it has been faced and how it went, the never-faced
    /// filter, and the figures on the cards. Null on the public route, which has nobody to have a
    /// record.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, SetupInsights.PlayRecord>? Records { get; set; }

    /// <summary>The history behind <see cref="Records"/>, for the detail modal's profile.</summary>
    [Parameter] public IReadOnlyList<Application.Features.Statistics.SetupGameFact>? Facts { get; set; }

    private AdversaryDetailModal _modal = default!;

    /// Per-level records, derived once per parameter change rather than per card.
    private Dictionary<string, SetupInsights.AdversaryFacing>? _facing;

    /// Difficulty is the top of its range: what the adversary asks of you at its hardest.
    private readonly CatalogueFilter<Adversary> _filter = new(
        a => a.Id.Value, a => a.Name, a => a.ExpansionId,
        numeric: (FilterState.ByDifficulty, a => a.Modes.Any() ? a.Modes.Max(m => m.Difficulty) : 0));

    protected override void OnParametersSet()
    {
        _filter.UseHistory(Records);
        _facing = Facts is { Count: > 0 } ? SetupInsights.AdversaryRecords(Facts) : null;
    }

    private IReadOnlyList<Adversary> _inScope =>
        GameData.Adversaries.Where(a => OwnedExpansions is null || OwnedExpansions.Contains(a.ExpansionId)).ToList();

    private IReadOnlyList<Adversary> _visible => _filter.Apply(_inScope);

    private void OpenDetail(Adversary a) => _modal.Show(a);

    /// <summary>
    /// A level tile opens the sheet focused on that level — but only where there is a record to
    /// focus: on the public route the tiles stay inert and the card's overlay is the one door.
    /// </summary>
    private EventCallback<int> LevelTap(Adversary a) =>
        Records is null ? default : EventCallback.Factory.Create<int>(this, (int level) => _modal.Show(a, level));
}
