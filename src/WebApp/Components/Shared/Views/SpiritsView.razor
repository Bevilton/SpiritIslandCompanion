@* Reference content for spirits browse page. Used from both the public route
   (/spirits) and the authenticated route (/app/spirits).

   OwnedExpansions: pass null (default) to show every spirit; pass a list to filter
   to only those expansions. The view itself is auth-agnostic — the authenticated
   wrapper page is responsible for resolving the user's owned expansions and
   passing them in.

   The filter itself is FilterBar + SpiritFacets, shared with the setup screen's spirit picker. *@

<div class="page-head">
    <div>
        <span class="eyebrow">Reference</span>
        <h1 class="page-title mt-2">Spirits</h1>
        <p class="page-sub">@_inScope.Count spirits across @ExpansionCount expansion@(ExpansionCount == 1 ? "" : "s"). The filter says how many are showing.</p>
    </div>
    <input type="search" class="input md:w-64" placeholder="Filter by name…" aria-label="Filter by name"
           @bind="_filter.Query" @bind:event="oninput"/>
</div>

<div class="mt-4">
    <FilterBar @ref="_bar" Filter="_filter" OwnedExpansions="@OwnedExpansions"
               ShowingCount="_visible.Count" TotalCount="_inScope.Count"
               UntestedLabel="Never played" UntestedHint="Spirits you have never played"
               Changed="StateHasChanged">
        <Facets>
            @if (_bar is not null)
            {
                <SpiritFacets Filter="_filter" Bar="_bar"/>
            }
        </Facets>
    </FilterBar>
</div>

@* Grouped into expansions only while that is the order — sorting by name or complexity across
   the whole catalogue and then cutting it into expansion sections would show neither. *@
@if (_filter.GroupsByExpansion)
{
    @foreach (var grp in _visible.GroupBy(s => s.ExpansionId))
    {
        var expansion = GameData.Expansions.FirstOrDefault(e => e.Id == grp.Key);
        <section class="mt-10">
            <div class="mb-4 flex items-baseline justify-between">
                <h2 class="text-xl font-semibold" style="font-family: var(--font-serif);">@(expansion?.Name ?? grp.Key.Value)</h2>
                <span class="text-xs text-ink-500">@grp.Count() of @_inScope.Count(s => s.ExpansionId == grp.Key)</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var s in grp)
                {
                    @SpiritCard(s)
                }
            </div>
        </section>
    }
}
else
{
    <section class="mt-8">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var s in _visible)
            {
                @SpiritCard(s)
            }
        </div>
    </section>
}

@if (_visible.Count == 0)
{
    <div class="surface mt-6 py-10 text-center text-ink-500">No spirits match the current filters.</div>
}

@* LinkGames only where there is a record to link from — see AdversariesView. *@
<SpiritDetailModal @ref="_modal" OwnedExpansions="@OwnedExpansions" Facts="Facts" LinkGames="@(Records is not null)"/>

@code {
    /// <summary>
    /// Null (default) shows everything; a non-null list restricts the view (and
    /// child detail modal) to those expansions. The authenticated wrapper page
    /// passes in the user's owned expansions; public pages omit this parameter.
    /// </summary>
    [Parameter] public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>
    /// The visitor's own record per spirit, when there is one. Unlocks ordering by play count and
    /// win rate and the never-played filter, and puts the numbers on the cards — sorting by a
    /// figure the cards don't show would leave the order looking arbitrary. Null on the public
    /// route, which has nobody to have a record.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, SetupInsights.PlayRecord>? Records { get; set; }

    /// <summary>The history behind <see cref="Records"/>, for the detail modal's profile.</summary>
    [Parameter] public IReadOnlyList<Application.Features.Statistics.SetupGameFact>? Facts { get; set; }

    private readonly SpiritFilter _filter = new();
    private SpiritDetailModal _modal = default!;
    private FilterBar? _bar;

    /// Every aspect's record in one tally, so a card can look its own up. Computed here rather
    /// than passed in: the page already hands over the history the cards' records come from.
    private IReadOnlyDictionary<string, SetupInsights.PlayRecord>? _aspectRecords;

    protected override void OnParametersSet()
    {
        _filter.UseHistory(Records);
        _aspectRecords = Facts is { Count: > 0 } ? SetupInsights.AspectRecords(Facts) : null;
    }

    /// <summary>
    /// The aspects of a spirit that have actually been played. A browse card reports a record;
    /// listing the variants never taken would only repeat the catalogue count beside it.
    /// </summary>
    private IReadOnlyList<Aspect> PlayedAspects(Spirit s) =>
        _aspectRecords is null
            ? []
            : GameData.GetAspectsForSpirit(s.Id)
                .Where(a => _aspectRecords.GetValueOrDefault(a.Id.Value) is { Played: > 0 })
                .ToList();

    /// Every spirit the visitor could see at all, before the filter narrows it.
    private IReadOnlyList<Spirit> _inScope =>
        GameData.Spirits.Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId)).ToList();

    private IReadOnlyList<Spirit> _visible => _filter.Apply(_inScope);

    private int ExpansionCount => _inScope.Select(s => s.ExpansionId).Distinct().Count();

    private void OpenDetail(Spirit s) => _modal.Show(s);

    private RenderFragment SpiritCard(Spirit s) => __builder =>
    {
        var detail = SpiritDetails.For(s.Id);
        var color = detail?.ColorHex ?? GameLookups.NeutralColor;
        var aspects = GameData.GetAspectsForSpirit(s.Id);
        var visibleAspectCount = OwnedExpansions is null
            ? aspects.Count
            : aspects.Count(a => OwnedExpansions.Contains(a.ExpansionId));

        @* .surface, like the board and scenario cards — spelling the border and fill out by hand
           is what left these as the only reference cards with no shadow. (Comment above the tag,
           never between its attributes: that compiles clean and then kills the circuit.) *@
        <button @key="s.Id.Value" type="button"
                @onclick="() => OpenDetail(s)"
                class="surface p-5 text-left transition-all hover:-translate-y-px hover:border-ink-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
                style="border-top: 3px solid @color;">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="text-base font-semibold leading-snug text-ink-900">@s.Name</h3>
                    @if (detail is not null)
                    {
                        <div class="mt-1 text-xs text-ink-500">@detail.PlayStyle</div>
                    }
                </div>
                @if (detail is not null)
                {
                    <ElementBadges Elements="detail.Elements" Size="sm"/>
                }
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
                @if (detail is not null)
                {
                    <span class="badge" style="background-color: @(color)1f; color: @color;">
                        @SpiritFilter.ComplexityLabel(detail.Complexity)
                    </span>
                }
                @if (detail is { Tokens.Count: > 0 })
                {
                    <TokenBadges Tokens="detail.Tokens" Size="sm"/>
                }
                @* Which expansion it came from is otherwise only visible in the grouped order. *@
                @if (!_filter.GroupsByExpansion && GameData.Expansions.FirstOrDefault(e => e.Id == s.ExpansionId) is { } exp)
                {
                    <span class="text-ink-400">@exp.Name</span>
                }
                @if (visibleAspectCount > 0)
                {
                    <span class="text-ink-500">@visibleAspectCount aspect@(visibleAspectCount == 1 ? "" : "s")</span>
                }
            </div>

            @if (Records is not null)
            {
                @* Passive: the whole card opens the same sheet, so these only show the figures
                   the play-based orderings sort on, in the shape used everywhere else. *@
                <div class="mt-2 space-y-1.5">
                    <RecordChip Record="Records.GetValueOrDefault(s.Id.Value)" Subject="@s.Name"/>
                    @if (PlayedAspects(s) is { Count: > 0 } played)
                    {
                        <AspectChips Aspects="played" Records="_aspectRecords"/>
                    }
                </div>
            }
        </button>
    };
}
