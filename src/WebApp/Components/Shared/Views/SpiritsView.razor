@* Reference content for the spirits browse page. Used from both the public route (/spirits) and
   the authenticated route (/app/spirits); what either one hands over is CatalogueViewBase, and
   the view itself reads no auth state.

   The filter itself is FilterBar + SpiritFacets, shared with the setup screen's spirit picker. *@
@inherits CatalogueViewBase

@* Derived once at the top of the render rather than from properties read all the way down it:
   the filter is mutated in place by the search box and the bar, so there is no parameter change
   to cache against — but every one of those mutations is followed by a render, which makes this
   exactly the moment the lists are stale. As properties they were rebuilt seven times a
   keystroke. *@
@{
    var inScope = OwnedCatalogue.Spirits(OwnedExpansions);
    var visible = _filter.Apply(inScope);
    // How many the shelf holds per expansion — the "12 of 37" each group's heading reports —
    // counted once here rather than once per group per render.
    var perExpansion = inScope.GroupBy(s => s.ExpansionId).ToDictionary(g => g.Key, g => g.Count());
}

<PageHeader Eyebrow="Reference" Title="Spirits">
    <Sub>
        @Copy.Count(inScope.Count, "spirit") across @Copy.Count(perExpansion.Count, "expansion").
        The filter says how many are showing.
    </Sub>
    <Actions>
        <SearchBox @bind-Value="_filter.Query"/>
    </Actions>
</PageHeader>

<div class="mt-4">
    <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
               PresentExpansions="_filter.ExpansionsIn(inScope)"
               ShowingCount="visible.Count" TotalCount="inScope.Count"
               UntestedLabel="Never played" UntestedHint="@Copy.Untried("Spirits")"
               Changed="StateHasChanged">
        <Facets Context="bar">
            <SpiritFacets Filter="_filter" Bar="bar"/>
        </Facets>
    </FilterBar>
</div>

@* Grouped into expansions only while that is the order — sorting by name or complexity across
   the whole catalogue and then cutting it into expansion sections would show neither.

   One loop over labelled groups rather than the grid written out in both branches, as the spirit
   picker and the board picker do it: an unlabelled single group is the flat list. The heading is
   what the two branches genuinely differ by, so it is the part that is conditional. *@
@foreach (var grp in _filter.GroupsByExpansion
    ? visible.GroupBy(s => s.ExpansionId)
        .Select(g => (Heading: (ExpansionId?)g.Key, Spirits: g.ToList()))
    : [(Heading: (ExpansionId?)null, Spirits: visible.ToList())])
{
    <section class="@(grp.Heading is null ? "mt-8" : "mt-10")">
        @if (grp.Heading is { } expansion)
        {
            <SectionHead Size="lg" Title="@GameLookups.ExpansionName(expansion)"
                         Note="@($"{grp.Spirits.Count} of {perExpansion[expansion]}")"/>
        }
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var s in grp.Spirits)
            {
                @SpiritCard(s)
            }
        </div>
    </section>
}

@if (visible.Count == 0)
{
    <div class="surface no-matches mt-6">@Copy.NoMatches("spirits")</div>
}

<SpiritDetailModal @ref="_modal" Facts="Facts" LinkGames="HasRecord"/>

@code {
    private readonly SpiritFilter _filter = new();
    private SpiritDetailModal _modal = default!;

    /// Every aspect's record in one tally, so a card can look its own up. Computed here rather
    /// than passed in: the page already hands over the history the cards' records come from.
    private IReadOnlyDictionary<string, SetupInsights.PlayRecord>? _aspectRecords;

    protected override FilterState Filter => _filter;

    protected override void OnRecordsChanged() =>
        _aspectRecords = Facts is { Count: > 0 } ? SetupInsights.AspectRecords(Facts) : null;

    /// <summary>
    /// The aspects of a spirit that have actually been played. A browse card reports a record;
    /// listing the variants never taken would only repeat the catalogue count beside it.
    /// </summary>
    private IReadOnlyList<Aspect> PlayedAspects(Spirit s) =>
        _aspectRecords is null
            ? []
            : GameData.GetAspectsForSpirit(s.Id)
                .Where(a => _aspectRecords.GetValueOrDefault(a.Id.Value) is { Played: > 0 })
                .ToList();

    private void OpenDetail(Spirit s) => _modal.Show(s);

    private RenderFragment SpiritCard(Spirit s) => __builder =>
    {
        var detail = SpiritDetails.For(s.Id);
        var color = GameLookups.SpiritColor(detail);
        var visibleAspectCount = OwnedCatalogue.AspectsFor(s.Id, OwnedExpansions).Count;

        @* .surface, like the board and scenario cards — spelling the border and fill out by hand
           is what left these as the only reference cards with no shadow. (Comment above the tag,
           never between its attributes: that compiles clean and then kills the circuit.) *@
        <button @key="s.Id.Value" type="button"
                @onclick="() => OpenDetail(s)"
                class="surface card-lift top-accent p-5 text-left focus-ring"
                style="--top-accent: @color;">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="card-title">@s.Name</h3>
                    @if (detail is not null)
                    {
                        <div class="row-sub mt-0.5">@detail.PlayStyle</div>
                    }
                </div>
                @if (detail is not null)
                {
                    <ElementBadges Elements="detail.Elements" Size="sm"/>
                }
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
                @if (detail is not null)
                {
                    <span class="badge" style="@GameLookups.TintBadgeStyle(color)">
                        @SpiritFilter.ComplexityLabel(detail.Complexity)
                    </span>
                }
                @if (detail is { Tokens.Count: > 0 })
                {
                    <TokenBadges Tokens="detail.Tokens" Size="sm"/>
                }
                @* Which expansion it came from is otherwise only visible in the grouped order.
                   GameLookups.ExpansionName, as every other view and picker names one — this was
                   the one place still walking GameData for it. *@
                @if (!_filter.GroupsByExpansion)
                {
                    <span class="text-ink-500">@GameLookups.ExpansionName(s.ExpansionId)</span>
                }
                @if (visibleAspectCount > 0)
                {
                    <span class="text-ink-500">@Copy.Count(visibleAspectCount, "aspect")</span>
                }
            </div>

            @if (HasRecord)
            {
                @* Passive: the whole card opens the same sheet, so these only show the figures
                   the play-based orderings sort on, in the shape used everywhere else. *@
                <div class="mt-2 space-y-1.5">
                    <RecordChip Record="Records.GetValueOrDefault(s.Id.Value)" Subject="@s.Name"/>
                    @if (PlayedAspects(s) is { Count: > 0 } played)
                    {
                        <AspectChips Aspects="played" Records="_aspectRecords"/>
                    }
                </div>
            }
        </button>
    };
}
