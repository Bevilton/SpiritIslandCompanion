@* Reference content for boards. Used from /boards (public) and /app/boards; what either route
   hands over is CatalogueViewBase, plus the two things only this catalogue has — the reader's own
   island shapes, and which route they arrived on — both of which belong to the layouts index
   that follows the boards (IslandLayoutIndex). *@
@inherits CatalogueViewBase

@* Derived once at the top of the render — see SpiritsView. *@
@{
    var inScope = OwnedCatalogue.Boards(OwnedExpansions);
    var visible = _filter.Apply(inScope);
}

<PageHeader Eyebrow="Reference" Title="Island boards">
    <Sub>@HeaderSummary(inScope.Count)</Sub>
</PageHeader>

<section>
    @* Size="lg": the two halves of this page are its own divisions, the register the spirits
       view cuts its expansions in and a recorded game its Setup / Players / Notes. *@
    <SectionHead Size="lg" Title="The boards" Note="Where each one sits on the thematic island"/>

    @* Same filter as every other catalogue. Boards have no facets of their own and no difficulty —
       one board is not harder than another — so it is the shared questions and nothing else.

       And no name search beside the heading, which the other three reference views carry: there
       are eight boards and they are lettered A–H, so the whole catalogue is on screen at once and
       a box to find one in it would be a control that decides nothing. The board picker omits it
       for the same reason and says so; this page and the statistics tab were the two that left it
       to be guessed at. *@
    <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
               PresentExpansions="_filter.ExpansionsIn(inScope)"
               ShowingCount="visible.Count" TotalCount="inScope.Count"
               UntestedLabel="Never used" UntestedHint="@Copy.Untried("Boards", "used")"
               Changed="StateHasChanged"/>

    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var b in visible)
        {
            var detail = BoardDetails.For(b.Id);
            var color = GameLookups.BoardColor(detail);
            var letter = GameLookups.BoardLetter(b);

            @* A button like every other catalogue card — boards have a record sheet too. *@
            <button @key="b.Id.Value" type="button" @onclick="() => OpenDetail(b)"
                    class="surface card-lift top-accent p-4 flex items-start gap-3 text-left focus-ring"
                    style="--top-accent: @color;">
                <LetterTile Size="2xl" Color="@color" Text="@letter"/>
                <div class="min-w-0 flex-1">
                    @* h3, not h4: the page's outline is the heading, "The boards", then the cards. *@
                    <h3 class="card-title">@b.Name</h3>
                    @if (detail is not null)
                    {
                        <p class="row-sub mt-0.5">@detail.ThematicName</p>
                    }
                    <p class="row-sub mt-0.5">@GameLookups.ExpansionName(b.ExpansionId)</p>
                    @* Passive pill — the whole card opens the board's sheet. *@
                    @if (HasRecord)
                    {
                        <div class="mt-1.5">
                            <RecordChip Record="Records.GetValueOrDefault(b.Id.Value)" Subject="@b.Name" NeverLabel="Never used"/>
                        </div>
                    }
                </div>
            </button>
        }
    </div>

    @if (visible.Count == 0)
    {
        <div class="surface no-matches mt-6">@Copy.NoMatches("boards")</div>
    }
</section>

<IslandLayoutIndex SavedLayouts="SavedLayouts" Facts="Facts" SignedIn="SignedIn"/>

@* ReferenceOnly rather than "Facts is null": the public route loads nobody's history, so its
   sheet must not report "no games yet" — a signed-in reader browsing it has a record, this
   page just never went and fetched one. The sheet therefore keys off the route (SignedIn)
   rather than off CatalogueViewBase.HasRecord, which is what the other three catalogues use:
   a signed-in reader with no games yet still has a games page to be sent to. *@
<BoardDetailModal @ref="_modal" Facts="Facts" ReferenceOnly="@(!SignedIn)" LinkGames="SignedIn"/>

@code {
    /// <summary>
    /// The visitor's own layout library, on the signed-in route. Null on the public one — a
    /// shape nobody is signed in to own has nothing to show. Handed on to the layouts index.
    /// </summary>
    [Parameter] public IReadOnlyList<IslandLayoutResponse>? SavedLayouts { get; set; }

    /// <summary>
    /// Whether this is the route that loads the visitor's history. Not the same question as
    /// "is anyone signed in": someone with an account can read the public page, where there is
    /// no history to report because none was fetched. Only the route knows which it is, so it
    /// says so rather than the sheets guessing from an empty <see cref="CatalogueViewBase.Facts"/>.
    /// </summary>
    [Parameter] public bool SignedIn { get; set; }

    /// No numeric axis: one board is not harder or bigger than another, so no such ordering is
    /// offered rather than offered and meaningless.
    private readonly CatalogueFilter<Board> _filter = new(
        b => b.Id.Value, b => b.Name, b => b.ExpansionId);

    protected override FilterState Filter => _filter;

    private BoardDetailModal _modal = default!;

    private void OpenDetail(Board b) => _modal.Show(b);

    /// <summary>The page subtitle. Takes the board count rather than recomputing the owned
    /// catalogue: the render has already worked it out for the list below.</summary>
    private string HeaderSummary(int boards)
    {
        var published = GameData.PublishedIslandSetups.Count;
        var mine = SavedLayouts?.Count ?? 0;
        var summary = $"{Copy.Count(boards, "board")} used to assemble the island, arranged into {Copy.Count(published, "published layout")}";
        return mine > 0
            ? $"{summary} and {Copy.Count(mine, "shape")} of your own."
            : $"{summary}.";
    }
}
