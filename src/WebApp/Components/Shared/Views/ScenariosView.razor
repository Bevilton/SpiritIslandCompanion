@* Reference content for scenarios. Used from /scenarios (public) and /app/scenarios.
   Pass OwnedExpansions to filter; null (default) shows every scenario.
   Pass Records for the signed-in view to sort and filter by the player's own history.

   The filter is FilterBar, shared with every other catalogue and picker. Scenarios have no facets
   of their own — expansion, difficulty and your own record is the whole of what there is to ask. *@

<div class="page-head">
    <div>
        <span class="eyebrow">Reference</span>
        <h1 class="page-title mt-2">Scenarios</h1>
        <p class="page-sub">@_inScope.Count special scenarios that change how the game plays.</p>
    </div>
    <input type="search" class="input md:w-64" placeholder="Filter by name…" aria-label="Filter by name"
           @bind="_filter.Query" @bind:event="oninput"/>
</div>

<div class="mt-4">
    <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
               PresentExpansions="_filter.ExpansionsIn(_inScope)"
               ShowingCount="_visible.Count" TotalCount="_inScope.Count"
               UntestedLabel="Never played" UntestedHint="Scenarios you have never played"
               Changed="StateHasChanged"/>
</div>

<div class="surface mt-6">
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th>Scenario</th>
                <th>Expansion</th>
                @if (Records is not null)
                {
                    <th>Your record</th>
                }
                <th class="text-right">Difficulty</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in _visible)
            {
                <tr @key="s.Id.Value" class="cursor-pointer hover:bg-ink-50/60 transition-colors" @onclick="() => OpenDetail(s)">
                    <td>
                        @* A real button inside the clickable row, so the detail sheet is
                           reachable by keyboard too. *@
                        <button type="button" @onclick="() => OpenDetail(s)" @onclick:stopPropagation="true"
                                class="rounded text-left font-medium text-ink-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                            @s.Name
                        </button>
                    </td>
                    <td class="text-ink-500">@GameLookups.ExpansionName(s.ExpansionId)</td>
                    @if (Records is not null)
                    {
                        @* Passive pill — the row opens the same sheet. Shows the figures the
                           play-based orderings sort on, in the shape used everywhere else. *@
                        <td>
                            <RecordChip Record="Records.GetValueOrDefault(s.Id.Value)" Subject="@s.Name"/>
                        </td>
                    }
                    <td class="text-right">
                        <span class="badge @(s.Difficulty >= 3 ? "badge-warn" : s.Difficulty >= 1 ? "badge-info" : "badge-neutral")">
                            +@s.Difficulty
                        </span>
                    </td>
                </tr>
            }
            @if (_visible.Count == 0)
            {
                <tr><td colspan="@(Records is not null ? 4 : 3)" class="text-center text-ink-500 py-6">No scenarios match.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<ScenarioDetailModal @ref="_modal" Facts="Facts"/>

@code {
    /// <summary>Null (default) shows everything; non-null restricts to those expansions.</summary>
    [Parameter] public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>
    /// The visitor's record per scenario, when there is one. Unlocks ordering by play count and
    /// win rate, the never-played filter, and the column of figures. Null on the public route.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, SetupInsights.PlayRecord>? Records { get; set; }

    /// <summary>The history behind <see cref="Records"/>, for the detail modal's profile.</summary>
    [Parameter] public IReadOnlyList<Application.Features.Statistics.SetupGameFact>? Facts { get; set; }

    private ScenarioDetailModal _modal = default!;

    private readonly CatalogueFilter<Scenario> _filter = new(
        s => s.Id.Value, s => s.Name, s => s.ExpansionId, (FilterState.ByDifficulty, s => s.Difficulty));

    protected override void OnParametersSet()
    {
        _filter.UseHistory(Records);
    }

    private IReadOnlyList<Scenario> _inScope =>
        GameData.Scenarios.Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId)).ToList();

    private IReadOnlyList<Scenario> _visible => _filter.Apply(_inScope);

    private void OpenDetail(Scenario s) => _modal.Show(s);
}
