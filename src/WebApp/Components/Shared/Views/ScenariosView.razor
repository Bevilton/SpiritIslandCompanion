@* Reference content for scenarios. Used from /scenarios (public) and /app/scenarios; what either
   route hands over is CatalogueViewBase.

   The filter is FilterBar, shared with every other catalogue and picker. Scenarios have no facets
   of their own — expansion, difficulty and the record so far is the whole of what there is to ask. *@
@inherits CatalogueViewBase

@* Derived once at the top of the render — see SpiritsView. *@
@{
    var inScope = OwnedCatalogue.Scenarios(OwnedExpansions);
    var visible = _filter.Apply(inScope);
}

<PageHeader Eyebrow="Reference" Title="Scenarios">
    <Sub>@inScope.Count special @Copy.Noun(inScope.Count, "scenario") that change how the game plays.</Sub>
    <Actions>
        <SearchBox @bind-Value="_filter.Query"/>
    </Actions>
</PageHeader>

<div class="mt-4">
    <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
               PresentExpansions="_filter.ExpansionsIn(inScope)"
               ShowingCount="visible.Count" TotalCount="inScope.Count"
               UntestedLabel="Never played" UntestedHint="@Copy.Untried("Scenarios")"
               Changed="StateHasChanged"/>
</div>

<div class="surface mt-6">
    <div class="table-wrap">
        <table class="table table-hover">
            <thead>
            <tr>
                <th scope="col">Scenario</th>
                <th scope="col">Expansion</th>
                @if (HasRecord)
                {
                    <th scope="col">Record</th>
                }
                <th scope="col" class="text-right">Difficulty</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in visible)
            {
                <tr @key="s.Id.Value" @onclick="() => OpenDetail(s)">
                    <td>
                        <RowNameButton Name="@s.Name" OnClick="() => OpenDetail(s)"/>
                    </td>
                    <td class="text-ink-500">@GameLookups.ExpansionName(s.ExpansionId)</td>
                    @if (HasRecord)
                    {
                        @* Passive pill — the row opens the same sheet. Shows the figures the
                           play-based orderings sort on, in the shape used everywhere else. *@
                        <td>
                            <RecordChip Record="Records.GetValueOrDefault(s.Id.Value)" Subject="@s.Name"/>
                        </td>
                    }
                    <td class="text-right">
                        <ScenarioDifficultyBadge Difficulty="s.Difficulty"/>
                    </td>
                </tr>
            }
            @if (visible.Count == 0)
            {
                <tr><td colspan="@(HasRecord ? 4 : 3)" class="no-matches">@Copy.NoMatches("scenarios")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<ScenarioDetailModal @ref="_modal" Facts="Facts" LinkGames="HasRecord"/>

@code {
    private ScenarioDetailModal _modal = default!;

    /// Difficulty is what a scenario adds, so it is the one number this catalogue sorts by.
    private readonly CatalogueFilter<Scenario> _filter = new(
        s => s.Id.Value, s => s.Name, s => s.ExpansionId,
        numeric: (FilterState.ByDifficulty, s => s.Difficulty));

    protected override FilterState Filter => _filter;

    private void OpenDetail(Scenario s) => _modal.Show(s);
}
