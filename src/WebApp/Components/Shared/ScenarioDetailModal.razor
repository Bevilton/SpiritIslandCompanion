@* Scenario reference sheet. Given Facts it also profiles the record with the scenario, and
   given OnSelected it can be chosen straight from here. What the sheet is told about that
   record — the history, whose it is, whether it may link out — is DetailSheetBase's. *@
@inherits DetailSheetBase

@if (_scenario is not null)
{
    var detail = _detail;

    <ModalShell OnClose="Close" ZIndex="@SheetZIndex" MaxWidth="@SheetWidth">
        <DetailModalHeader Title="@_scenario.Name" OnClose="Close">
            <Glyph><Icon Name="book" Class="w-6 h-6 text-accent-700 shrink-0 mt-1"/></Glyph>
            <Badges>
                <span class="badge badge-neutral">@GameLookups.ExpansionName(_scenario.ExpansionId)</span>
                <ScenarioDifficultyBadge Difficulty="_scenario.Difficulty" Prefix="Difficulty "/>
            </Badges>
        </DetailModalHeader>

        <div class="sheet-body space-y-6">
            <SheetSummary Text="@detail?.Summary"/>

            @if (Profile is not null)
            {
                <SetupProfileSection Profile="Profile" Name="@_scenario.Name"
                                     Scoped="Scoped" SubjectName="@SubjectName"
                                     Title="record in this scenario"
                                     LinkGames="LinkGames"
                                     AllGamesHref="@GamesLink.ForScenario(_scenario.Id.Value, who: ScopeWho)"/>
            }

            <SheetWikiLink Name="@_scenario.Name"/>
        </div>

        @if (OnSelected.HasDelegate)
        {
            <SheetFooter BackLabel="scenarios" OnBack="Close">
                <button type="button" class="btn btn-primary" @onclick="Select">
                    <Icon Name="check" Class="w-4 h-4"/> Play this scenario
                </button>
            </SheetFooter>
        }
    </ModalShell>
}

@code {
    /// <summary>When set, a footer action picks this scenario — used when opened from the picker.</summary>
    [Parameter] public EventCallback<Scenario> OnSelected { get; set; }

    private Scenario? _scenario;
    private ScenarioDetail? _detail;

    public void Show(Scenario scenario)
    {
        _scenario = scenario;
        _detail = ScenarioDetails.For(scenario.Id);
        var facts = ScopedFacts();
        Profile = facts is not null
            ? SetupProfiles.Build(SetupSubjectKind.Scenario, scenario.Id.Value, facts)
            : null;
        StateHasChanged();
    }

    private void Close()
    {
        _scenario = null;
        _detail = null;
        Profile = null;
    }

    private async Task Select()
    {
        var scenario = _scenario;
        Close();
        if (scenario is not null) await OnSelected.InvokeAsync(scenario);
    }
}
