@* Scenario reference sheet. Given Facts it also profiles the player's own record
   with the scenario, and given OnSelected it can be chosen straight from here.
   z-60 keeps it above the picker modals (z-50) that open it. *@

@using Application.Features.Statistics

@if (_scenario is not null)
{
    var detail = _detail;

    <ModalShell OnClose="Close" ZIndex="z-[60]" MaxWidth="md:max-w-4xl">
            <div class="px-6 md:px-8 pt-6 pb-5 relative bg-ink-50/60 border-b border-ink-200">
                <button class="absolute top-4 right-4 inline-flex h-8 w-8 items-center justify-center rounded-lg text-ink-500 hover:bg-white/60 hover:text-ink-900 transition-colors" @onclick="Close" aria-label="Close">
                    <Icon Name="x" Class="w-5 h-5"/>
                </button>

                <div class="flex items-start gap-3 pr-10">
                    <Icon Name="book" Class="w-6 h-6 text-accent-700 shrink-0 mt-1"/>
                    <div class="min-w-0 flex-1">
                        <h2 class="text-2xl font-semibold text-ink-900 leading-tight" style="font-family: var(--font-serif);">@_scenario.Name</h2>
                        <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
                            <span class="badge badge-neutral">@GameLookups.ExpansionName(_scenario.ExpansionId)</span>
                            <span class="badge @(_scenario.Difficulty >= 3 ? "badge-warn" : _scenario.Difficulty >= 1 ? "badge-info" : "badge-neutral")">
                                Difficulty +@_scenario.Difficulty
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-y-auto px-6 md:px-8 py-5 space-y-6">
                @if (detail is not null)
                {
                    @* Capped at prose width: the panel is wide for the record tables, not the text. *@
                    <p class="max-w-prose text-ink-700 leading-relaxed">@detail.Summary</p>
                }
                else
                {
                    <p class="text-ink-500 italic">No additional information available.</p>
                }

                @if (_profile is not null)
                {
                    <SetupProfileSection Profile="_profile" Name="@_scenario.Name"
                                         Title="Your record in this scenario"
                                         LinkGames="LinkGames"
                                         AllGamesHref="@(LinkGames ? GamesLink.ForScenario(_scenario.Id.Value) : null)"/>
                }

                <div class="pt-2">
                    <a href="@GameLookups.WikiLink(_scenario.Name)" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 text-sm text-accent-700 hover:text-accent-800">
                        Read on the Spirit Island wiki
                        <Icon Name="arrow-right" Class="w-3.5 h-3.5"/>
                    </a>
                </div>
            </div>

            @if (OnSelected.HasDelegate)
            {
                <div class="flex items-center justify-between gap-3 border-t border-ink-100 bg-ink-50/40 px-6 md:px-8 py-3.5 md:rounded-b-2xl">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="Close">
                        <Icon Name="arrow-left" Class="w-3.5 h-3.5"/> Back to scenarios
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="Select">
                        <Icon Name="check" Class="w-4 h-4"/> Play this scenario
                    </button>
                </div>
            }
    </ModalShell>
}

@code {
    /// <summary>
    /// Personal game history. When there is any, the modal profiles the player's record
    /// with this scenario; empty or null hides the section (plain reference sheet).
    /// </summary>
    [Parameter] public IReadOnlyList<SetupGameFact>? Facts { get; set; }

    /// <summary>Whether the record may link out to the games behind it — see AdversaryDetailModal.</summary>
    [Parameter] public bool LinkGames { get; set; }

    /// <summary>When set, a footer action picks this scenario — used when opened from the picker.</summary>
    [Parameter] public EventCallback<Scenario> OnSelected { get; set; }

    private Scenario? _scenario;
    private ScenarioDetail? _detail;
    private SetupProfiles.Profile? _profile;

    public void Show(Scenario scenario)
    {
        _scenario = scenario;
        _detail = ScenarioDetails.For(scenario.Id);
        _profile = Facts is { Count: > 0 }
            ? SetupProfiles.Build(SetupSubjectKind.Scenario, scenario.Id.Value, Facts)
            : null;
        StateHasChanged();
    }

    private void Close()
    {
        _scenario = null;
        _detail = null;
        _profile = null;
    }

    private async Task Select()
    {
        var scenario = _scenario;
        Close();
        if (scenario is not null) await OnSelected.InvokeAsync(scenario);
    }
}
