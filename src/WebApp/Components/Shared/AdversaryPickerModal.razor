@* Adversary picker: pick a foe together with its level, the level chosen inline on the card's
   own L0..L6 ladder. Opened imperatively, like every picker — see PickerModalBase, which also
   owns the lifecycle and the owned-expansions cascade. *@
@inherits PickerModalBase

@* The catalogue this picker offers and the part of it the filter keeps, derived once per
   render rather than from properties read all the way down it — see the note in SpiritsView. *@
@if (IsOpen)
{
    var inScope = OwnedCatalogue.Adversaries(OwnedExpansions);
    var visible = _filter.Apply(inScope);

    <ModalShell OnClose="Close" MaxWidth="md:max-w-3xl">
        <PickerModalHeader Title="Choose an adversary" OnClose="Close" @bind-Query="_filter.Query">
            <Subtitle>Pick a card to expand level options@(Context.HasHistory ? " · a foe's record opens its full history" : "").</Subtitle>
        </PickerModalHeader>

        @* The same filter every catalogue and picker uses. *@
        <div class="picker-filters">
            <FilterBar Filter="_filter" OwnedExpansions="@OwnedExpansions"
                       PresentExpansions="_filter.ExpansionsIn(inScope)"
                       ShowingCount="visible.Count" TotalCount="inScope.Count"
                       UntestedLabel="Never faced" UntestedHint="@Copy.Untried("Adversaries", "faced")"
                       Changed="StateHasChanged"/>
        </div>

        <div class="picker-body">
            <div class="grid sm:grid-cols-2 gap-3 items-start">
                @foreach (var a in visible)
                {
                    var detail = AdversaryDetails.For(a.Id);
                    var modes = a.Modes.OrderBy(m => m.Level).ToList();
                    var isExpanded = _expandedId == a.Id.Value;
                    var isCurrent = _currentId == a.Id.Value;
                    var isTaken = AdversariesTaken.Contains(a.Id.Value) && !isCurrent;
                    var maxDifficulty = modes.LastOrDefault()?.Difficulty ?? 0;

                    var facing = _facing.GetValueOrDefault(a.Id.Value);

                    <div @key="a.Id.Value"
                         class="pick-card @(isExpanded ? "is-open" : isCurrent ? "is-selected" : null)
                                @(isTaken ? "is-taken" : null)
                                relative overflow-hidden">
                        <button type="button" @onclick="() => Expand(a)" disabled="@isTaken"
                                aria-expanded="@Aria.Flag(isExpanded)"
                                class="@(isTaken ? "cursor-not-allowed" : null)
                                       w-full text-left p-4 pb-2 focus-ring">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="row-title">@a.Name</h3>
                                    <div class="row-sub mt-0.5">
                                        @GameLookups.ExpansionName(a.ExpansionId)@(detail is not null ? $" · {detail.Theme}" : "")
                                    </div>
                                </div>
                                <Icon Name="shield" Class="w-5 h-5 text-accent-600 shrink-0"/>
                            </div>
                            <div class="fine-note mt-3 flex items-center gap-1.5">
                                @* .micro-label — the word captions the range beside it, and it
                                   was the one caption in the app spelling that register out. *@
                                <span class="micro-label">Difficulty</span>
                                <span>L0–L@(modes.Count - 1)</span>
                                <span class="text-ink-300">·</span>
                                <span>up to +@maxDifficulty</span>
                                @if (isTaken)
                                {
                                    <span class="text-ink-300">·</span>
                                    <span>already at the table</span>
                                }
                            </div>
                        </button>

                        @* The record doubles as the door to the foe's full sheet. Sibling of the
                           expand button — a button may not contain a button. *@
                        <div class="flex flex-wrap items-center gap-1.5 px-4 pb-3">
                            <RecordChip Record="facing?.Overall"
                                        HasHistory="Context.HasHistory" Subject="@a.Name" NeverLabel="New foe — never faced"
                                        OnClick="() => ShowDetails(a)"/>
                            @if (facing?.MostPlayedLevel is { } ml)
                            {
                                <span class="fine-note">mostly L@(ml)</span>
                            }
                        </div>

                        @if (isExpanded)
                        {
                            @* The same ladder the reference card, the record sheet and the
                               statistics card draw (AdversaryLevelGrid) — it used to be a
                               fourth hand-rolled strip here, and the odd one out: it counted
                               wins where the others show a win rate. *@
                            <div class="border-t border-ink-200 px-4 py-3 bg-ink-50/50">
                                <div class="micro-label mb-2">Pick a level</div>
                                @* Four to a row rather than seven: two cards sit side by side
                                   in this sheet, so a seven-wide tile is too narrow to hold
                                   "4× · 33%" on one line. *@
                                <AdversaryLevelGrid Adversary="a" Columns="grid-cols-4"
                                                    Records="@AdversaryLevelGrid.RecordsFor(facing, Context.HasHistory)"
                                                    Current="@(isCurrent ? _currentLevel : null)"
                                                    OnPick="level => Pick(a, level)"/>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (visible.Count == 0)
            {
                <div class="no-matches">@Copy.NoMatches("adversaries")</div>
            }
        </div>
    </ModalShell>
}

@* The whole scope, not just the facts: the sheet narrows the record with SeatFilter and names
   whose it is with SubjectName, so a picker that forwards only the facts would show the table's
   record under a heading the sheet believes is one person's. The board and spirit pickers pass
   all three; these two had been left a subset. *@
<AdversaryDetailModal @ref="_detailModal"
                      Facts="Context.Facts"
                      SeatFilter="Context.SeatFilter"
                      SubjectName="@Context.SubjectName"
                      OnSelected="pick => Pick(pick.Adversary, pick.Level)"/>

@code {
    [Parameter] public EventCallback<(Adversary Adversary, int Level)> OnSelected { get; set; }

    /// <summary>
    /// Adversary ids already at the table for another slot — shown dimmed and disabled,
    /// since the same foe can't invade twice (the save rejects the duplicate).
    /// </summary>
    [Parameter] public IReadOnlyCollection<string> AdversariesTaken { get; set; } = [];

    private string? _expandedId;
    private string? _currentId;
    private int? _currentLevel;
    private AdversaryDetailModal _detailModal = default!;

    // Snapshotted on open — the form behind the modal can't change while it is up.
    private Dictionary<string, SetupInsights.AdversaryFacing> _facing = [];

    /// <param name="current">
    /// The slot's pick when one is being changed rather than added — the card is marked and
    /// starts expanded with its level highlighted, like the other pickers mark their current
    /// selection.
    /// </param>
    public void Show(SetupInsights.AdversaryPick? current = null, SetupInsights.MatchupContext? context = null)
    {
        BeginShow(context);
        _currentId = current?.AdversaryId;
        _currentLevel = current?.Level;
        _expandedId = _currentId;
        _facing = Context.HasHistory ? Context.AdversaryRecords() : [];

        _filter.Reset();
        // The per-level breakdown stays in _facing for the cards; the filter only needs the tally.
        _filter.UseHistory(Context.HasHistory ? SetupInsights.AdversaryPlayRecords(_facing) : null);

        Open();
    }

    private void ShowDetails(Adversary a) => _detailModal.Show(a);

    private void Expand(Adversary a)
    {
        _expandedId = _expandedId == a.Id.Value ? null : a.Id.Value;
    }

    private async Task Pick(Adversary a, int level)
    {
        Close();
        await OnSelected.InvokeAsync((a, level));
    }

    /// Difficulty is the top of its range: what the adversary asks of you at its hardest. Ordered
    /// by name to start with — a picker is a list to scan, not a catalogue to browse.
    private readonly CatalogueFilter<Adversary> _filter = new(
        a => a.Id.Value, a => a.Name, a => a.ExpansionId,
        numeric: (FilterState.ByDifficulty, a => a.Modes.Any() ? a.Modes.Max(m => m.Difficulty) : 0),
        defaultSortKey: FilterState.ByName.Key);
}
