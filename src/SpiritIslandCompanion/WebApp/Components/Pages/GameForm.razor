@page "/app/games/new"
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>New Game</PageTitle>

<div class="page-head">
    <div>
        <a href="/app/games" class="text-sm text-ink-500 hover:text-ink-700 flex w-fit items-center gap-1 mb-2">
            <Icon Name="arrow-left" Class="w-3.5 h-3.5"/> Games
        </a>
        <span class="eyebrow">Record a match</span>
        <h1 class="page-title mt-2">New game</h1>
    </div>
</div>

@* The only message this page raises is a save failure the error summary can't place on a field. *@
<Alert Message="@_form.Message" Type="@_form.MessageType"/>
<FormErrorSummary Errors="@_form.Errors" Attempt="_form.Attempt"/>

@if (_loading)
{
    <LoadingSpinner/>
}
else
{
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-6 lg:items-start">

    @* ============================== MAIN COLUMN ============================== *@
    <div class="lg:min-w-0">

    @* ============================== THE SCENE ============================== *@
    @* One body of water, not two. The stops are in pixels, not percentages, so the sky band
       stays put whatever the ship row does, and the sea reaches the playground's own edge
       colour (#2b6fa4) by 238px — where the playground begins. A ship row that wraps only
       pushes the playground further down, into sea that is already that colour, so the two
       still meet seamlessly and the playground reads as open water in the middle of the same
       sea rather than as a framed picture pasted onto the sky. *@
    <section class="relative overflow-hidden rounded-3xl border border-sky-200 shadow-sm"
             style="background: linear-gradient(180deg, #f0f9ff 0px, #e8f6fe 70px, #cdebfb 112px, #a5dcf5 148px, #6fbee2 182px, #4593c6 208px, #2f76b8 226px, #2b6fa4 238px);">

        @* --- decorations (sun, clouds) --- *@
        @* The sun's core sits off-canvas, clear of the difficulty dial in the same corner. *@
        <div class="pointer-events-none absolute -top-20 -right-12 h-44 w-44 rounded-full bg-amber-200/60 blur-3xl"></div>
        <div class="pointer-events-none absolute top-16 left-[26%] blur-[1.5px] si-drift">
            <div class="h-5 w-24 rounded-full bg-white/60"></div>
            <div class="-mt-2.5 ml-6 h-4 w-14 rounded-full bg-white/45"></div>
        </div>
        <div class="pointer-events-none absolute top-7 right-[27%] blur-[1.5px] si-drift" style="animation-delay: -9s;">
            <div class="h-4 w-16 rounded-full bg-white/45"></div>
            <div class="-mt-2 ml-4 h-3 w-10 rounded-full bg-white/35"></div>
        </div>

        @* --- top bar: scenario (left) · difficulty gauge (right) --- *@
        <div class="relative z-20 flex items-start justify-between gap-3 p-4 md:p-5">
            <div class="flex items-center gap-1.5">
                <div class="inline-flex items-center rounded-full bg-white/85 backdrop-blur border border-white/70 shadow-sm">
                    @{ var scen = ScenarioFor(_scenarioId); }
                    <button type="button" @onclick="OpenScenarioPicker"
                            class="flex items-center gap-2 pl-1.5 pr-3 py-1.5 rounded-full hover:bg-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
                            title="@(scen is null ? "Play a scenario (optional)" : $"Scenario: {scen.Name}")">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full @(scen is not null ? "bg-amber-100 text-amber-700" : "bg-ink-100 text-ink-500")">
                            <Icon Name="book" Class="w-3.5 h-3.5"/>
                        </span>
                        @if (scen is not null)
                        {
                            <span class="text-xs font-semibold text-ink-900">@scen.Name</span>
                            @* Several scenarios are worth nothing extra — a "+0" badge is a number that says nothing. *@
                            @if (scen.Difficulty != 0)
                            {
                                <span class="text-[10px] font-medium text-amber-700">+@scen.Difficulty</span>
                            }
                        }
                        else
                        {
                            <span class="text-xs font-medium text-ink-600">Add scenario</span>
                        }
                    </button>
                    @if (scen is not null)
                    {
                        <button type="button" @onclick="ClearScenario" aria-label="Remove scenario"
                                class="mr-1 inline-flex h-5 w-5 items-center justify-center rounded-full text-ink-400 hover:bg-red-50 hover:text-red-600 transition-colors">
                            <Icon Name="x" Class="w-3 h-3"/>
                        </button>
                    }
                </div>
            </div>

            <div class="relative">
                <button type="button" @onclick="() => _difficultyBreakdownOpen = !_difficultyBreakdownOpen"
                        class="relative z-30 flex h-20 w-20 flex-col items-center justify-center rounded-full bg-white border-2 border-amber-300 ring-4 ring-white/60 shadow-lg hover:scale-105 transition-transform focus:outline-none focus-visible:ring-amber-400/60"
                        title="Total difficulty — tap for the breakdown">
                    <span class="text-[9px] uppercase tracking-wider text-ink-500 font-semibold">Difficulty</span>
                    <span class="text-3xl font-bold text-ink-900 leading-none" style="font-family: var(--font-serif);">@ComputedDifficulty</span>
                </button>
                @if (_difficultyBreakdownOpen)
                {
                    @* Full-page catcher so tapping anywhere dismisses the popover. *@
                    <div class="fixed inset-0 z-20" @onclick="() => _difficultyBreakdownOpen = false"></div>
                    <div class="absolute right-0 top-full mt-2 w-64 surface shadow-lg p-4 z-30 text-left">
                        <div class="text-[10px] uppercase tracking-wider text-ink-500 font-semibold mb-2">Difficulty breakdown</div>
                        @if (_adversaries.Count == 0 && string.IsNullOrEmpty(_scenarioId) && !_extraBoard && !_thematicMaps && _difficultyModifier == 0)
                        {
                            <div class="text-xs text-ink-600">Tutorial / freeplay — no adversary, scenario, or modifiers.</div>
                        }
                        else
                        {
                            <ul class="space-y-1 text-xs text-ink-700">
                                @foreach (var a in _adversaries.Where(a => !string.IsNullOrEmpty(a.AdversaryId)))
                                {
                                    var adv = AdversaryFor(a.AdversaryId);
                                    var mode = adv?.Modes.FirstOrDefault(m => m.Level == a.Level);
                                    <li class="flex justify-between gap-2"><span class="truncate">@(adv?.Name ?? "Adversary") L@(a.Level)</span><span class="font-medium tabular-nums">+@(mode?.Difficulty ?? 0)</span></li>
                                }
                                @if (ScenarioFor(_scenarioId) is { } sc)
                                {
                                    <li class="flex justify-between gap-2"><span class="truncate">@sc.Name</span><span class="font-medium tabular-nums">+@sc.Difficulty</span></li>
                                }
                                @if (UsesExtraBoard)
                                {
                                    <li class="flex justify-between gap-2"><span>Extra board@(ExtraBoardLetter is { } el ? $" ({el})" : "")</span><span class="font-medium tabular-nums">+@GameRestrictions.ExtraBoardDifficultyBonus</span></li>
                                }
                                @if (_thematicMaps)
                                {
                                    <li class="flex justify-between gap-2"><span>Thematic maps</span><span class="font-medium tabular-nums">+@GameRestrictions.ThematicMapsDifficultyBonus</span></li>
                                }
                                @if (_difficultyModifier != 0)
                                {
                                    <li class="flex justify-between gap-2"><span>Manual modifier</span><span class="font-medium tabular-nums">@(_difficultyModifier > 0 ? "+" : "")@_difficultyModifier</span></li>
                                }
                                <li class="mt-1 flex justify-between gap-2 border-t border-ink-100 pt-1.5 font-semibold text-ink-900"><span>Total</span><span class="tabular-nums">@ComputedDifficulty</span></li>
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>

        @* --- the sea: adversary ships --- *@
        <div class="relative z-10 mt-1 flex flex-wrap items-end justify-center gap-x-4 gap-y-3 px-4 md:px-8">
            @for (var i = 0; i < _adversaries.Count; i++)
            {
                var idx = i;
                var item = _adversaries[idx];
                var adv = AdversaryFor(item.AdversaryId);
                var mode = adv?.Modes.FirstOrDefault(m => m.Level == item.Level);
                <div @key="item.Key" class="si-bob group relative" style="animation-delay: -@(idx * 1700)ms;">
                    <button type="button" @onclick="() => OpenAdversaryPickerFor(idx)"
                            class="flex flex-col items-center rounded-xl px-1 pb-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
                            title="@(adv?.Name ?? "Adversary") — level @item.Level. Tap to change.">
                        <svg viewBox="0 0 72 62" class="h-14 w-16 drop-shadow-md" aria-hidden="true">
                            <path d="M36 3 L36 11 L47 7 Z" fill="#dc2626"/>
                            <rect x="35" y="5" width="2.5" height="36" rx="1" fill="#44403c"/>
                            <path d="M39.5 9 C53 15 55 29 39.5 37 Z" fill="#fef3c7" stroke="#e7e5e4" stroke-width="1"/>
                            <path d="M34 13 C23.5 18 21.5 30 34 36 Z" fill="#ffffff" stroke="#e7e5e4" stroke-width="1"/>
                            <path d="M13 41 L59 41 L53 54 Q36 58.5 19 54 Z" fill="#7c4a21"/>
                            <path d="M13 41 L59 41 L57.2 45 L14.8 45 Z" fill="#96603a"/>
                            <path d="M6 56 Q12 52.5 18 56 T30 56 T42 56 T54 56 T66 56" fill="none" stroke="#e0f2fe" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
                        </svg>
                        <span class="-mt-1 flex flex-col items-center rounded-xl bg-white/90 backdrop-blur px-2.5 py-1 shadow-sm border border-white/70 leading-tight">
                            <span class="text-[11px] font-semibold text-ink-900 max-w-28 truncate">@(adv?.Name ?? "Adversary…")</span>
                            <span class="text-[10px] text-ink-500">Level @item.Level · +@(mode?.Difficulty ?? 0)</span>
                        </span>
                    </button>
                    <button type="button" @onclick="() => RemoveAdversary(idx)" aria-label="Remove adversary"
                            class="absolute -top-1 -right-1 inline-flex h-6 w-6 items-center justify-center rounded-full bg-white text-ink-400 border border-ink-200 shadow-sm opacity-0 group-hover:opacity-100 focus:opacity-100 hover:bg-red-50 hover:text-red-600 transition-all">
                        <Icon Name="x" Class="w-3 h-3"/>
                    </button>
                </div>
            }

            @* ghost ship — add adversary. Light chip, dark text: this row sits in the pale sky
               band, where the white-on-dark styling of the ship chips below has nothing to
               contrast against. *@
            <button type="button" @onclick="OpenAdversaryPickerForNew"
                    class="group flex flex-col items-center gap-1.5 rounded-xl px-2 py-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/50"
                    title="Add an adversary">
                <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-dashed border-sky-700/40 bg-white/50 text-sky-800 group-hover:border-sky-700/70 group-hover:bg-white/80 group-hover:scale-105 transition-all">
                    <Icon Name="plus" Class="w-5 h-5"/>
                </span>
                <span class="rounded-full border border-white/70 bg-white/85 px-2.5 py-0.5 text-[10px] font-medium text-ink-700 shadow-sm backdrop-blur">
                    @(_adversaries.Count == 0 ? "Calm seas — add adversary" : "Add adversary")
                </span>
            </button>
        </div>

        @* --- the island: a playground of real board pieces the player arranges --- *@
        <div class="relative z-10 mt-4 md:mt-6 px-3 md:px-4">
            <IslandPlayground Boards="BoardVisuals"
                              LayoutId="@EffectiveSetupId"
                              LayoutGeometry="@_customLayoutJson"
                              LayoutLabel="@LayoutLabel"
                              Locked="_thematicMaps"
                              LockedHint="Thematic maps use a fixed island"
                              Mirrored="_thematicMaps"
                              CandidateLayoutIds="CandidateLayoutIds"
                              OnLayoutChanged="OnIslandRearranged"
                              OnBoardActivated="OnIslandBoardActivated"/>
        </div>

        @* --- island legend: who is at the table, once there is anything to tell apart --- *@
        @if (ShowIslandLegend)
        {
        <div class="relative z-10 mt-3 flex flex-wrap justify-center gap-1.5 px-6">
            @for (var i = 0; i < _players.Count; i++)
            {
                var idx = i;
                var p = _players[idx];
                var spirit = SpiritFor(p.SpiritId);
                var spiritDetail = spirit is null ? null : SpiritDetails.For(spirit.Id);
                var color = spiritDetail?.ColorHex ?? GameLookups.NeutralColor;
                var board = BoardFor(p.BoardId);
                var letter = board is null ? null : GameLookups.BoardLetter(board);
                var hasError = HasPlayerError(idx);

                <button @key="p.Key" type="button" @onclick="() => SelectPlayer(idx)"
                        class="flex items-center gap-1.5 rounded-full border border-white/70 bg-white/90 px-2.5 py-1 text-[11px] font-medium text-ink-800 shadow-sm backdrop-blur transition-colors hover:bg-white">
                    @if (spirit is not null)
                    {
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background-color: @color;"></span>
                    }
                    else
                    {
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full border border-dashed border-ink-400"></span>
                    }
                    <span class="max-w-36 truncate">@(spirit?.Name ?? $"Player {idx + 1}")</span>
                    @if (letter is not null)
                    {
                        <span class="rounded bg-ink-100 px-1 text-[9px] font-bold text-ink-600">@letter</span>
                    }
                    @if (hasError)
                    {
                        <span class="h-2 w-2 shrink-0 rounded-full bg-red-500 animate-pulse"></span>
                    }
                </button>
            }
            @if (UsesExtraBoard)
            {
                @* Not a button on the thematic island: the letter comes with the position there,
                   so there is nothing to choose. *@
                <button type="button" @onclick="OpenExtraBoardPicker" disabled="@ThematicBoardsLocked"
                        title="@(ThematicBoardsLocked
                                  ? $"Board {ExtraBoardLetter} is the island position nobody plays — set by the thematic map"
                                  : ExtraBoardChosen
                                      ? $"Board {ExtraBoardLetter} is on the island with no spirit on it — tap to change"
                                      : "Choose which board is the extra one")"
                        class="flex items-center gap-1.5 rounded-full border border-dashed px-2.5 py-1 text-[11px] font-medium backdrop-blur transition-colors
                               @(ExtraBoardHasError
                                   ? "border-red-300 bg-red-50/80 text-red-700 enabled:hover:bg-red-50"
                                   : "border-white/80 bg-white/60 text-ink-600 enabled:hover:bg-white/85")">
                    @if (ExtraBoardChosen)
                    {
                        <span class="rounded bg-ink-100 px-1 text-[9px] font-bold text-ink-600">@ExtraBoardLetter</span>
                        <span>Extra board</span>
                        @if (ThematicBoardsLocked)
                        {
                            <Icon Name="lock" Class="w-3 h-3 text-ink-400"/>
                        }
                    }
                    else
                    {
                        <Icon Name="plus" Class="w-3 h-3"/>
                        <span>Pick the extra board</span>
                    }
                </button>
            }
        </div>
        }

        @* --- player-count stepper --- *@
        <div class="relative z-10 flex justify-center pb-5 pt-4">
            <div class="inline-flex items-center gap-1 rounded-full border border-white/70 bg-white/90 px-1.5 py-1 shadow-md backdrop-blur">
                <button type="button" @onclick="RemoveLastPlayer" disabled="@(_players.Count <= 1)"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-full text-ink-600 transition-colors hover:bg-ink-100 disabled:opacity-30 disabled:hover:bg-transparent"
                        aria-label="Remove last player">
                    <Icon Name="minus" Class="w-4 h-4"/>
                </button>
                <span class="px-2 text-sm font-semibold tabular-nums text-ink-900">
                    @_players.Count <span class="font-normal text-ink-500">@(_players.Count == 1 ? "player" : "players")</span>
                </span>
                <button type="button" @onclick="AddPlayer" disabled="@(!CanAddPlayer)"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-full text-ink-600 transition-colors hover:bg-ink-100 disabled:opacity-30 disabled:hover:bg-transparent"
                        aria-label="Add player" title="@AddPlayerHint">
                    <Icon Name="plus" Class="w-4 h-4"/>
                </button>
            </div>
        </div>
    </section>

    @* Only what is actually on the table: no ship to tap until an adversary is out there, and
       no board to choose on the thematic island, which hands them out itself. *@
    <p class="mt-2 text-xs text-ink-500">
        Tap a board to select it, then <span class="font-medium text-ink-600">Set up</span>
        for its spirit@(ThematicBoardsLocked ? "" : ", board") and player.
        @* On the thematic island the extra board's letter comes with its position, so there is
           nothing left to ask for. *@
        @if (UsesExtraBoard && !ThematicBoardsLocked)
        {
            <text>The <span class="font-medium text-ink-600">extra</span> board needs only its letter.</text>
        }
        @if (_adversaries.Count > 0)
        {
            <text>Tap a ship to change the adversary.</text>
        }
    </p>
    <FieldError For="Players" Errors="@_form.Errors"/>

    @* ============================== OUTCOME (optional) ============================== *@
    <section class="mt-6">
        <div class="rounded-2xl border transition-all
                    @(_includeResult
                        ? "border-amber-300 bg-gradient-to-br from-amber-50 via-white to-amber-50/40 shadow-sm"
                        : "border-ink-200 bg-ink-50/40")">
            <div class="px-5 md:px-6 py-4 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl @(_includeResult ? "bg-amber-100 text-amber-700" : "bg-ink-100 text-ink-500")">
                        <Icon Name="trophy" Class="w-5 h-5"/>
                    </span>
                    <div>
                        <div class="text-sm font-semibold text-ink-900">Did you finish this game?</div>
                        <div class="text-xs text-ink-500">@(_includeResult ? "Recording outcome below." : "Toggle on to record victory/defeat and stats — or skip to save a draft.")</div>
                    </div>
                </div>
                <label class="inline-flex items-center cursor-pointer select-none">
                    <span class="text-xs font-medium text-ink-700 mr-2">@(_includeResult ? "Yes" : "Skip")</span>
                    <span class="relative inline-flex h-6 w-11 items-center">
                        <input type="checkbox" class="sr-only peer" @bind="_includeResult"/>
                        <span class="absolute inset-0 rounded-full bg-ink-200 peer-checked:bg-amber-500 transition-colors"></span>
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
                    </span>
                </label>
            </div>

            @if (_includeResult)
            {
                <div class="border-t border-amber-200/60 bg-white/60 px-5 md:px-6 py-5">
                    <GameResultEditor
                        Difficulty="ComputedDifficulty"
                        PlayerCount="_players.Count"
                        Errors="_form.Errors"
                        Win="_resultWin" WinChanged="v => _resultWin = v"
                        TerrorLevel="_resultTerror" TerrorLevelChanged="v => _resultTerror = v"
                        DurationMinutes="_resultDuration" DurationMinutesChanged="v => _resultDuration = v"
                        Dahan="_resultDahan" DahanChanged="v => _resultDahan = v"
                        Blight="_resultBlight" BlightChanged="v => _resultBlight = v"
                        Cards="_resultCards" CardsChanged="v => _resultCards = v"
                        ScoreModifier="_resultScoreMod" ScoreModifierChanged="v => _resultScoreMod = v"/>
                </div>
            }
        </div>
    </section>

    </div> @* /main column *@

    @* ============================== SIDEBAR ============================== *@
    <aside class="mt-6 lg:mt-0 space-y-4 lg:sticky lg:top-6 lg:self-start lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto lg:pr-1">

        @* --- your matchup: live personal record for the current selection --- *@
        <MatchupInsights Context="TableContext"
                         SelectedSpiritIds="SelectedSpiritIds"
                         CandidateSpiritIds="CandidateSpiritIds"
                         CanAssignSpirit="HasOpenSeat"
                         OnSuggestSpirit="AssignSpiritToOpenSeat"/>

        @* --- island shape: a published layout, one of your saved shapes, or a fresh
               hand-built arrangement. Thematic maps are the exception — see below. --- *@
        <section class="surface p-4">
            <div class="mb-2.5 flex items-baseline justify-between gap-2">
                <span class="text-xs font-medium uppercase tracking-wide text-ink-500">Island shape</span>
                <span class="text-[11px] text-ink-500">@EffectiveBoardCount board@(EffectiveBoardCount == 1 ? "" : "s")@(_thematicMaps ? " · thematic" : "")</span>
            </div>

            @if (_thematicMaps)
            {
                @* One published island per board count, and none at all for five — so there is
                   nothing to choose and nothing to arrange. Show what you get, and say why. *@
                @if (ThematicSetup is { } thematic)
                {
                    <div class="flex items-center gap-3 rounded-xl border border-accent-300 bg-accent-50/60 p-2.5">
                        <div class="flex h-14 w-14 shrink-0 items-center justify-center">
                            <IslandSetupDiagram Setup="thematic" Class="max-h-full max-w-full"/>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 text-[11px] font-semibold text-ink-900">
                                <Icon Name="lock" Class="w-3 h-3 text-accent-700"/> @thematic.Name island
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-ink-600">
                                One fixed arrangement for @EffectiveBoardCount board@(EffectiveBoardCount == 1 ? "" : "s"), and each board is a region of it — both are set for you.
                            </p>
                        </div>
                    </div>

                    @if (ThematicIslandBoards.For(thematic.Id) is { } regions)
                    {
                        <div class="mt-2 flex flex-wrap gap-1">
                            @for (var slot = 0; slot < regions.Count; slot++)
                            {
                                var boardId = regions[slot].Value;
                                var detail = BoardDetails.For(regions[slot]);
                                var unplayed = slot >= _players.Count;
                                <span class="inline-flex items-center gap-1 rounded-full border px-1.5 py-0.5 text-[10px] @(unplayed ? "border-dashed border-ink-300 bg-white text-ink-400" : "border-ink-200 bg-white text-ink-700")"
                                      title="@($"{ThematicPositionOf(boardId)} — board {detail?.Letter}{(unplayed ? " (extra board, nobody plays it)" : $", player {slot + 1}")}")">
                                    <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded text-[8px] font-bold text-white"
                                          style="background-color: @(unplayed ? "var(--color-ink-300)" : detail?.ColorHex ?? GameLookups.NeutralColor); font-family: var(--font-serif);">@detail?.Letter</span>
                                    <span>@detail?.ThematicName</span>
                                </span>
                            }
                        </div>
                    }

                    @if (_facts.Count > 0)
                    {
                        <div class="mt-2">
                            <RecordChip Record="_layoutRecords.GetValueOrDefault(thematic.Id.Value)"
                                        Subject="@($"the {thematic.Name} thematic island")"
                                        OnClick="() => _layoutDetail.Show(thematic)"/>
                        </div>
                    }
                }
                else
                {
                    <div class="flex items-start gap-2 rounded-lg border border-red-300 bg-red-50/70 px-3 py-2.5 text-xs text-red-800">
                        <Icon Name="alert" Class="w-4 h-4 mt-px shrink-0"/>
                        <span>
                            There is no thematic island for @EffectiveBoardCount board@(EffectiveBoardCount == 1 ? "" : "s") — the real
                            island can't be divided that way. Turn <span class="font-medium">Thematic maps</span> off,
                            or change the number of boards.
                        </span>
                    </div>
                }
            }
            else
            {
                @if (SetupOptions.Count == 0 && SavedLayoutOptions.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-amber-300 bg-amber-50/60 px-3 py-2.5 text-xs text-amber-800">
                        No layout is published for @EffectiveBoardCount boards —
                        arrange the boards yourself on the island and it'll be saved as a custom shape.
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var setup in SetupOptions)
                        {
                            var isSelected = !IsCustomLayout && _islandSetupId == setup.Id.Value;
                            @* The record pill is a sibling of the select button (a button may not
                               contain a button) and opens the layout's record sheet. *@
                            <div class="@(isSelected
                                           ? "border-accent-500 bg-accent-50/70 ring-2 ring-accent-500/30"
                                           : "border-ink-200 bg-white hover:border-ink-300 hover:bg-ink-50")
                                        flex flex-col rounded-xl border transition-all">
                                <button type="button" @onclick="() => SelectIslandSetup(setup)"
                                        class="w-full flex-1 rounded-t-xl p-2 pb-1 text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                    <div class="flex h-12 items-center justify-center">
                                        <IslandSetupDiagram Setup="setup" Class="max-h-full max-w-full"/>
                                    </div>
                                    <div class="mt-1 truncate text-[11px] font-medium text-ink-900">@setup.Name</div>
                                </button>
                                @if (_facts.Count > 0)
                                {
                                    <div class="flex justify-center pb-2">
                                        <RecordChip Record="_layoutRecords.GetValueOrDefault(setup.Id.Value)"
                                                    Subject="@setup.Name" OnClick="() => _layoutDetail.Show(setup)"/>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* --- your saved shapes for this board count --- *@
                @if (SavedLayoutOptions.Count > 0)
                {
                    <div class="mt-3 border-t border-ink-100 pt-3">
                        <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">Your saved shapes</div>
                        <div class="space-y-1.5">
                            @foreach (var saved in SavedLayoutOptions)
                            {
                                var isSelected = _savedLayoutId == saved.Id;
                                var savedRecord = _savedLayoutRecords.GetValueOrDefault(saved.Id);
                                var inUse = savedRecord is { Played: > 0 };
                                <div class="flex items-center gap-1">
                                    <button type="button" @onclick="() => SelectSavedLayout(saved)"
                                            title="@($"{saved.Name} — {saved.BoardCount} boards, saved {SetupInsights.Ago(saved.UpdatedAt)}")"
                                            class="@(isSelected
                                                      ? "border-accent-500 bg-accent-50/70 ring-2 ring-accent-500/30"
                                                      : "border-ink-200 bg-white hover:border-ink-300 hover:bg-ink-50")
                                                   flex min-w-0 flex-1 items-center gap-2 rounded-lg border px-2.5 py-1.5 text-left transition-all">
                                        <Icon Name="map" Class="w-3.5 h-3.5 shrink-0 text-ink-400"/>
                                        <span class="min-w-0 flex-1 truncate text-[11px] font-medium text-ink-900">@saved.Name</span>
                                        @if (isSelected)
                                        {
                                            <Icon Name="check" Class="w-3.5 h-3.5 shrink-0 text-accent-600"/>
                                        }
                                    </button>
                                    @if (_facts.Count > 0)
                                    {
                                        <RecordChip Record="savedRecord" Subject="@saved.Name"
                                                    OnClick="() => _layoutDetail.Show(saved)"/>
                                    }
                                    @* A shape with recorded games anchors their per-layout counts,
                                       so the server refuses to delete it — say so up front instead
                                       of letting the click fail. *@
                                    <button type="button" @onclick="() => DeleteSavedLayout(saved)" disabled="@inUse"
                                            title="@(inUse
                                                      ? $"\"{saved.Name}\" has {savedRecord!.Played} recorded game{(savedRecord.Played == 1 ? "" : "s")} — it can't be deleted"
                                                      : $"Delete \"{saved.Name}\"")"
                                            aria-label="@($"Delete {saved.Name}")"
                                            class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-ink-300 transition-colors enabled:hover:bg-red-50 enabled:hover:text-red-600 disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400/40">
                                        <Icon Name="trash" Class="w-3.5 h-3.5"/>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* --- hand-built: name it to keep it --- *@
                @if (IsCustomLayout)
                {
                    <div class="mt-3 rounded-lg border border-accent-300 bg-accent-50/60 px-3 py-2.5">
                        <div class="flex items-start gap-2 text-[11px] text-accent-900">
                            <Icon Name="check-circle" Class="w-3.5 h-3.5 mt-px shrink-0"/>
                            <span>
                                @if (SelectedSavedLayout is { } from)
                                {
                                    <text>Playing your saved <span class="font-semibold">@from.Name</span> — moving a board makes it a one-off again.</text>
                                }
                                else
                                {
                                    <text>Hand-built @EffectiveBoardCount-board island. It's stored with the game either way — name it to reuse it later.</text>
                                }
                            </span>
                        </div>

                        <div class="mt-2 flex items-center gap-1.5">
                            <input type="text" class="input h-8 min-w-0 flex-1 text-xs" maxlength="@IslandLayoutName.MaxLength"
                                   placeholder="@(SelectedSavedLayout is { } s ? s.Name : "Name this shape…")"
                                   @bind="_layoutNameDraft" @bind:event="oninput"
                                   @onkeydown="OnLayoutNameKey"/>
                            <button type="button" class="btn btn-sm btn-primary shrink-0" disabled="@(!CanSaveLayout)"
                                    @onclick="SaveCurrentLayout"
                                    title="@(SelectedSavedLayout is null ? "Save this shape to your layouts" : "Update the saved shape, or type a new name to save a copy")">
                                <Icon Name="save" Class="w-3.5 h-3.5"/> Save shape
                            </button>
                        </div>
                    </div>
                }

                @* Outside the hand-built panel on purpose: deleting a saved shape can take that
                   panel away with it, and the confirmation would have gone with it. *@
                @if (_layoutMessage is not null)
                {
                    <div class="mt-2 text-[11px] @(_layoutSaved ? "text-accent-800" : "text-red-700")">@_layoutMessage</div>
                }
            }
            <FieldError For="IslandSetupId" Errors="@_form.Errors"/>
        </section>

        @* --- fine-tune (collapsed by default) --- *@
        @* No overflow-hidden: it would clip the hint popovers inside. The header rounds itself
           instead, so its hover fill still follows the card's corners. *@
        <section class="surface">
            <button type="button" @onclick="() => _fineTuneOpen = !_fineTuneOpen"
                    class="@(_fineTuneOpen ? "rounded-t-xl" : "rounded-xl") flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition-colors hover:bg-ink-50/60">
                <div class="flex min-w-0 items-center gap-2.5">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-ink-100 text-ink-600">
                        <Icon Name="settings" Class="w-4 h-4"/>
                    </span>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-ink-900">Fine-tune</div>
                        <div class="mt-0.5 flex flex-wrap items-center gap-1">
                            <span class="badge badge-neutral text-[10px]"><Icon Name="calendar" Class="w-3 h-3"/> @_datePlayed.ToString("MMM d, yyyy") · @_timePlayed.ToString("HH:mm")</span>
                            @if (UsesExtraBoard)
                            {
                                <span class="badge @(ExtraBoardHasError ? "badge-warn" : "badge-info") text-[10px]">
                                    Extra board@(ExtraBoardLetter is { } el ? $" {el}" : " — pick one")
                                </span>
                            }
                            @if (_thematicMaps)
                            {
                                <span class="badge badge-info text-[10px]">Thematic</span>
                            }
                            @if (_difficultyModifier != 0)
                            {
                                <span class="badge badge-warn text-[10px]">Mod @(_difficultyModifier > 0 ? "+" : "")@_difficultyModifier</span>
                            }
                        </div>
                    </div>
                </div>
                <Icon Name="chevron-down" Class="@($"w-4 h-4 text-ink-400 shrink-0 transition-transform {(_fineTuneOpen ? "rotate-180" : "")}")"/>
            </button>

            @if (_fineTuneOpen)
            {
                <div class="space-y-4 border-t border-ink-100 px-4 py-4">
                    @* aria-pressed has to be the literal "true"/"false": handed a bool, Blazor
                       drops the attribute for false and renders it empty for true, so the
                       toggle's state never reaches a screen reader. *@
                    <div role="button" tabindex="0" aria-pressed="@(_extraBoard ? "true" : "false")"
                         @onclick="ToggleExtraBoard"
                         @onkeydown="OnExtraBoardKey"
                         class="flex items-center justify-between gap-3 rounded-xl border @(_extraBoard ? "border-accent-300 bg-accent-50/50" : "border-ink-200 bg-white") px-3.5 py-3 select-none @(ExtraBoardAllowed ? "cursor-pointer hover:border-ink-300" : "opacity-50 cursor-not-allowed")">
                        <div class="min-w-0 flex items-start gap-1.5">
                            <div>
                                <div class="text-sm font-semibold text-ink-900">Extra board</div>
                                <div class="text-[11px] text-ink-500">
                                    @(ExtraBoardAllowed
                                        ? $"{_players.Count + 1} boards · +{GameRestrictions.ExtraBoardDifficultyBonus} difficulty"
                                        : _players.Count > GameRestrictions.MaximumPlayersForExtraBoard
                                            ? "Disabled for 6 players"
                                            : $"You own {OwnedBoardCount} boards — all of them are in play")
                                </div>
                            </div>
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="mt-0.5">
                                @* Centred, not anchored to this trigger: the sidebar is barely wider
                                   than the popover, so anchoring runs it off the card. *@
                                @* Where the "which letter?" question gets explained — a hint beside
                                   the field, not the error that fires when it is blank. *@
                                <InfoHint Position="center">
                                    Adds one extra board to the island (so @_players.Count @(_players.Count == 1 ? "player plays" : "players play") on @(_players.Count + 1) boards). Only allowed for 1–5 players. Adds <span class="text-ink-900">+@GameRestrictions.ExtraBoardDifficultyBonus</span> difficulty.
                                    <span class="mt-1.5 block">You still choose <span class="text-ink-900">which</span> board it is: each letter has its own terrain, and there is only one copy of each, so it can't be a board somebody is playing.</span>
                                </InfoHint>
                            </span>
                        </div>
                        <span class="relative inline-flex h-6 w-11 items-center shrink-0 rounded-full transition-colors @(_extraBoard ? "bg-accent-500" : "bg-ink-200")">
                            <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform @(_extraBoard ? "translate-x-5" : "")"></span>
                        </span>
                    </div>

                    <div role="button" tabindex="0" aria-pressed="@(_thematicMaps ? "true" : "false")"
                         @onclick="ToggleThematicMaps"
                         @onkeydown="OnThematicMapsKey"
                         class="flex items-center justify-between gap-3 rounded-xl border @(_thematicMaps ? "border-accent-300 bg-accent-50/50" : "border-ink-200 bg-white") px-3.5 py-3 select-none cursor-pointer hover:border-ink-300">
                        <div class="min-w-0 flex items-start gap-1.5">
                            <div>
                                <div class="text-sm font-semibold text-ink-900">Thematic maps</div>
                                <div class="text-[11px] text-ink-500">+@GameRestrictions.ThematicMapsDifficultyBonus difficulty · fixed island</div>
                            </div>
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="mt-0.5">
                                <InfoHint Position="center">
                                    Plays the real island's own shape instead of an arrangement of your own. There is one thematic island per board count, so the layout is fixed — and none exists for 5 boards. Adds <span class="text-ink-900">+@GameRestrictions.ThematicMapsDifficultyBonus</span> difficulty.
                                </InfoHint>
                            </span>
                        </div>
                        <span class="relative inline-flex h-6 w-11 items-center shrink-0 rounded-full transition-colors @(_thematicMaps ? "bg-accent-500" : "bg-ink-200")">
                            <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform @(_thematicMaps ? "translate-x-5" : "")"></span>
                        </span>
                    </div>

                    <div>
                        <label class="label flex items-center gap-1.5">
                            <span>Difficulty modifier</span>
                            <InfoHint Position="center">
                                Manual <strong class="text-ink-900">+/− adjustment</strong> for homemade variants or anything the standard formula doesn't cover. Leave at 0 for ordinary games. Allowed range: @GameRestrictions.DifficultyModifierMin to +@GameRestrictions.DifficultyModifierMax.
                            </InfoHint>
                        </label>
                        <input type="number" class="input h-10" @bind="_difficultyModifier"
                               min="@GameRestrictions.DifficultyModifierMin" max="@GameRestrictions.DifficultyModifierMax"/>
                        <FieldError For="DifficultyModifier" Errors="@_form.Errors"/>
                    </div>
                    <div class="grid grid-cols-[1fr_auto] gap-2">
                        <div>
                            <label class="label">Date played</label>
                            <input type="date" class="input h-10" @bind="_datePlayed"/>
                        </div>
                        <div>
                            <label class="label">Time</label>
                            <input type="time" class="input h-10" @bind="_timePlayed"/>
                        </div>
                    </div>
                </div>
            }
        </section>

        @* --- note --- *@
        <section class="surface p-4">
            <label class="label">Note</label>
            <textarea class="textarea" rows="3" @bind="_note" placeholder="Optional game notes — anything memorable…"></textarea>
            <FieldError For="Note" Errors="@_form.Errors"/>
        </section>
    </aside>

    </div> @* /lg:grid *@

    @* ============================== ACTIONS ============================== *@
    <div class="sticky bottom-3 z-10 mt-6">
        <div class="surface px-4 md:px-5 py-3 flex flex-wrap items-center gap-3 shadow-lg">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-50 border border-accent-200 px-3 py-1.5 text-sm font-semibold text-accent-900">
                <span class="text-[10px] uppercase tracking-wider text-accent-700 font-semibold">Difficulty</span>
                <span class="tabular-nums" style="font-family: var(--font-serif);">@ComputedDifficulty</span>
            </span>
            @if (_includeResult)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full @(_resultWin ? "bg-accent-50 border-accent-200 text-accent-900" : "bg-red-50 border-red-200 text-red-900") border px-3 py-1.5 text-sm font-semibold">
                    <span class="text-[10px] uppercase tracking-wider font-semibold opacity-70">Score</span>
                    <span class="tabular-nums" style="font-family: var(--font-serif);">@ComputedScore</span>
                </span>
            }
            @* min-w-0 + truncate: the hint gives way on narrow screens rather than pushing
               Cancel onto a second line. *@
            <div class="text-xs mr-auto hidden sm:block min-w-0 flex-1 truncate @(SetupBlockedReason is null ? "text-ink-500" : "text-red-700")">
                @if (SetupBlockedReason is { } blocked) { <span>@blocked</span> }
                else if (_includeResult) { <span>Saving as a <strong class="text-ink-800">finished game</strong>.</span> }
                else { <span>Saving as a <strong class="text-ink-800">draft</strong> — fill in outcome anytime.</span> }
            </div>
            @if (_includeResult)
            {
                <button class="btn btn-primary" @onclick="SaveCompleted" disabled="@(_saving || SetupBlockedReason is not null)">
                    <Icon Name="check-circle" Class="w-4 h-4"/> Save completed game
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="SaveDraft" disabled="@(_saving || SetupBlockedReason is not null)">
                    <Icon Name="save" Class="w-4 h-4"/> Save as draft
                </button>
            }
            <a href="/app/games" class="btn btn-ghost">Cancel</a>
        </div>
    </div>

    @* ============================== PLAYER MODAL ============================== *@
    @* z-40 — deliberately below the spirit/board picker modals (z-50) so those stack on top. *@
    @if (_selectedPlayerIndex >= 0 && _selectedPlayerIndex < _players.Count)
    {
        var idx = _selectedPlayerIndex;
        var p = _players[idx];
        var spirit = SpiritFor(p.SpiritId);
        var spiritDetail = spirit is null ? null : SpiritDetails.For(spirit.Id);
        var color = spiritDetail?.ColorHex ?? GameLookups.NeutralColor;
        var aspects = GetAspectsForSpirit(p.SpiritId);
        var board = BoardFor(p.BoardId);
        var boardDetail = board is null ? null : BoardDetails.For(board.Id);
        var hasSpirit = spirit is not null;

        <ModalShell OnClose="ClosePlayerModal" ZIndex="z-40" Scrollable="false"
                    PanelStyle="@($"border-top: 4px solid {(hasSpirit ? color : "var(--color-ink-300)")};")">
                <div class="flex items-center justify-between gap-3 px-5 pt-4 pb-3 border-b border-ink-100">
                    <span class="inline-flex items-center gap-2 text-xs font-medium text-ink-500">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-[11px] font-semibold"
                              style="@(hasSpirit ? $"background-color: {color}; color: white;" : "background-color: var(--color-ink-100); color: var(--color-ink-600);")">
                            @(idx + 1)
                        </span>
                        <span class="uppercase tracking-wide">Player @(idx + 1) of @_players.Count</span>
                    </span>
                    <button type="button" @onclick="ClosePlayerModal" aria-label="Close"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-ink-500 hover:bg-ink-100 hover:text-ink-900 transition-colors">
                        <Icon Name="x" Class="w-5 h-5"/>
                    </button>
                </div>

                <div class="p-5">
                    <div class="grid gap-3">
                        <div>
                            <label class="label">Spirit</label>
                            <button type="button" @onclick="() => OpenSpiritPicker(idx)"
                                    class="w-full flex items-center gap-3 px-3 py-2 rounded-lg border bg-white hover:bg-ink-50 transition-colors text-left
                                           focus:outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30
                                           @(hasSpirit ? "border-ink-200" : "border-dashed border-ink-300")">
                                @if (spirit is not null)
                                {
                                    <span class="inline-block h-9 w-1.5 rounded-full shrink-0" style="background-color: @color;"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="text-sm font-semibold text-ink-900 truncate">@spirit.Name</div>
                                        @if (spiritDetail is not null)
                                        {
                                            <div class="text-[11px] text-ink-500 truncate">@spiritDetail.PlayStyle</div>
                                        }
                                    </div>
                                    @if (spiritDetail is not null)
                                    {
                                        <ElementBadges Elements="spiritDetail.Elements" Size="sm"/>
                                    }
                                }
                                else
                                {
                                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-ink-100 text-ink-500 shrink-0">
                                        <Icon Name="sparkles" Class="w-4 h-4"/>
                                    </span>
                                    <span class="text-sm text-ink-500 truncate min-w-0 flex-1">Choose a spirit…</span>
                                }
                            </button>
                            <FieldError For="@($"Players[{idx}].SpiritId")" Errors="@_form.Errors"/>
                            @if (_facts.Count > 0 && hasSpirit && SeatInsightLine(p) is { } insight)
                            {
                                <div class="mt-1.5 flex items-start gap-1.5 text-[11px] text-ink-500">
                                    <Icon Name="chart" Class="w-3.5 h-3.5 shrink-0 mt-px text-ink-400"/>
                                    <span>@insight</span>
                                </div>
                            }
                        </div>

                        <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label class="label flex items-center gap-1.5">
                                    <span>Board</span>
                                    @if (ThematicBoardsLocked)
                                    {
                                        <Icon Name="lock" Class="w-3 h-3 text-ink-400"/>
                                    }
                                </label>
                                @* On the thematic island the board comes with the seat's position on
                                   the map, so it is shown rather than chosen. *@
                                @if (ThematicBoardsLocked && board is not null)
                                {
                                    var bColor = boardDetail?.ColorHex ?? GameLookups.NeutralColor;
                                    var letter = GameLookups.BoardLetter(board);
                                    <div class="flex w-full items-center gap-2 rounded-lg border border-ink-200 bg-ink-50/60 px-3 py-2">
                                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-base font-semibold text-white"
                                              style="background-color: @bColor; font-family: var(--font-serif);">
                                            @letter
                                        </span>
                                        <div class="min-w-0 flex-1">
                                            <div class="truncate text-sm font-semibold text-ink-900">@board.Name</div>
                                            <div class="truncate text-[11px] text-ink-500">
                                                @(boardDetail?.ThematicName ?? "thematic position") · set by the island
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => OpenBoardPicker(idx)"
                                            class="w-full flex items-center gap-2 px-3 py-2 rounded-lg border bg-white hover:bg-ink-50 transition-colors text-left
                                                   focus:outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30
                                                   @(board is not null ? "border-ink-200" : "border-dashed border-ink-300")">
                                        @if (board is not null)
                                        {
                                            var bColor = boardDetail?.ColorHex ?? GameLookups.NeutralColor;
                                            var letter = GameLookups.BoardLetter(board);
                                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-white text-base font-semibold shrink-0"
                                                  style="background-color: @bColor; font-family: var(--font-serif);">
                                                @letter
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <div class="text-sm font-semibold text-ink-900 truncate">@board.Name</div>
                                                @if (boardDetail is not null)
                                                {
                                                    <div class="text-[11px] text-ink-500 truncate">@boardDetail.ThematicName</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-ink-100 text-ink-500 shrink-0">
                                                <Icon Name="map" Class="w-4 h-4"/>
                                            </span>
                                            <span class="text-sm text-ink-500 truncate min-w-0 flex-1">Pick…</span>
                                        }
                                    </button>
                                }
                                <FieldError For="@($"Players[{idx}].BoardId")" Errors="@_form.Errors"/>
                                @if (_facts.Count > 0 && board is not null && hasSpirit && SpiritOnBoardLine(p) is { } comboLine)
                                {
                                    <div class="mt-1.5 flex items-start gap-1.5 text-[11px] text-ink-500">
                                        <Icon Name="map" Class="w-3.5 h-3.5 shrink-0 mt-px text-ink-400"/>
                                        <span>@comboLine</span>
                                    </div>
                                }
                            </div>

                            <div>
                                <label class="label">Assigned to</label>
                                <PlayerAssigneePicker
                                    Value="@p.AssignedTo"
                                    ValueChanged="v => OnAssigneeChanged(idx, v)"
                                    Friends="_friends"
                                    LocalPlayers="_localPlayers"/>
                                <FieldError For="@($"Players[{idx}].AssignedTo")" Errors="@_form.Errors"/>
                            </div>
                        </div>
                    </div>

                    @if (hasSpirit && aspects.Count > 0)
                    {
                        <div class="mt-3 pt-3 border-t border-ink-100 flex items-start gap-2 flex-wrap">
                            <span class="text-[10px] uppercase tracking-wide text-ink-500 mt-1.5 mr-1">Aspect</span>
                            <FilterPill Active="@(string.IsNullOrEmpty(p.AspectId))"
                                        OnToggle="() => SelectAspect(idx, null)">
                                None
                            </FilterPill>
                            @foreach (var a in aspects)
                            {
                                var aId = a.Id.Value;
                                <FilterPill Active="@(p.AspectId == aId)"
                                            OnToggle="() => SelectAspect(idx, aId)">
                                    @a.Name
                                </FilterPill>
                            }
                        </div>
                    }
                </div>

                <div class="flex items-center justify-between gap-3 px-5 py-3.5 border-t border-ink-100 bg-ink-50/40 md:rounded-b-2xl">
                    @if (_players.Count > 1)
                    {
                        <button type="button" class="btn btn-sm btn-danger-outline" @onclick="() => RemovePlayer(idx)">
                            <Icon Name="trash" Class="w-3.5 h-3.5"/> Remove player
                        </button>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button type="button" class="btn btn-primary" @onclick="ClosePlayerModal">
                        <Icon Name="check" Class="w-4 h-4"/> Done
                    </button>
                </div>
        </ModalShell>
    }
}

@* ============================== PICKER MODALS ============================== *@
@* Each picker derives its own numbers from the matchup context it is opened with
   (see the Open* handlers) — the seat pickers get the seat being edited so stats
   follow whoever will sit there. *@
<SpiritPickerModal @ref="_spiritPicker" OnSelected="OnSpiritPicked"/>
@* There is one physical copy of each lettered board and the save is rejected for a duplicate —
   so the picker rules taken boards out rather than letting you build a table that can't be
   recorded. *@
<BoardPickerModal @ref="_boardPicker" OnSelected="OnBoardPicked" BoardsTaken="@BoardsTakenForCurrentEdit()"/>
<AdversaryPickerModal @ref="_adversaryPicker" OnSelected="OnAdversaryPicked" AdversariesTaken="@AdversariesTakenForCurrentEdit()"/>
<ScenarioPickerModal @ref="_scenarioPicker" OnSelected="OnScenarioPicked"/>
<IslandLayoutDetailModal @ref="_layoutDetail" Facts="_facts"/>

@code {
    private bool _loading = true;
    private bool _saving;
    /// Field errors are shown against their fields, anything left over becomes the page alert,
    /// and a failed attempt pulls the page back to the summary — see FormFeedback.
    private readonly FormFeedback _form = new();

    private string _islandSetupId = "";
    private string? _scenarioId;
    private DateTime _datePlayed = DateTime.Today;

    /// Defaults to now, so a game recorded as it finishes needs no thought; the field is there
    /// for anything logged after the fact.
    private TimeOnly _timePlayed = new(DateTime.Now.Hour, DateTime.Now.Minute);

    /// The date and time the game started, as stored. The offset is deliberately zero, matching
    /// every row already recorded: what is kept is the wall clock the player wrote down.
    private DateTimeOffset StartedAt => new(
        DateTime.SpecifyKind(_datePlayed.Date + _timePlayed.ToTimeSpan(), DateTimeKind.Unspecified),
        TimeSpan.Zero);

    private SpiritPickerModal _spiritPicker = default!;
    private BoardPickerModal _boardPicker = default!;
    private AdversaryPickerModal _adversaryPicker = default!;
    private ScenarioPickerModal _scenarioPicker = default!;
    private IslandLayoutDetailModal _layoutDetail = default!;

    private int _editingSpiritIndex = -1;
    private int _editingBoardIndex = -1;
    private int _editingAdversaryIndex = -1; // -1 means "add new"

    private int _selectedPlayerIndex = -1; // which island tile has its player modal open; -1 = none
    private bool _fineTuneOpen;
    private bool _difficultyBreakdownOpen;

    [CascadingParameter(Name = "OwnedExpansions")]
    public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    private int ComputedDifficulty =>
        Domain.Services.DifficultyCalculator.Compute(
            scenarioDifficulty: string.IsNullOrEmpty(_scenarioId) ? 0 : ScenarioFor(_scenarioId)?.Difficulty ?? 0,
            adversaryDifficulties: _adversaries
                .Where(a => !string.IsNullOrEmpty(a.AdversaryId))
                .Select(a => AdversaryFor(a.AdversaryId)?.Modes.FirstOrDefault(m => m.Level == a.Level)?.Difficulty ?? 0),
            usesExtraBoard: UsesExtraBoard,
            usesThematicMaps: _thematicMaps,
            modifier: _difficultyModifier);

    private int ComputedScore =>
        Domain.Services.ScoreCalculator.Compute(
            win: _resultWin,
            difficulty: ComputedDifficulty,
            dahan: _resultDahan,
            cards: _resultCards,
            blight: _resultBlight,
            playerCount: _players.Count,
            scoreModifier: _resultScoreMod);

    /// <summary>
    /// How many lettered boards the player actually has, since boards come with expansions: four
    /// in the base game, two more with Jagged Earth, two more with Horizons. The island can't have
    /// more boards than that, however many seats the rules would otherwise allow.
    /// </summary>
    private int OwnedBoardCount =>
        OwnedExpansions is null
            ? GameData.Boards.Count
            : GameData.Boards.Count(b => OwnedExpansions.Contains(b.ExpansionId));

    private bool ExtraBoardAllowed =>
        _players.Count <= GameRestrictions.MaximumPlayersForExtraBoard
        && _players.Count < OwnedBoardCount;
    private bool UsesExtraBoard => _extraBoard && ExtraBoardAllowed;
    private int EffectiveBoardCount => _players.Count + (UsesExtraBoard ? 1 : 0);

    /// <summary>
    /// The extra board is one of the lettered boards off the shelf, not an anonymous "+1": which
    /// letter it is decides that region's terrain, and there is one physical copy of each, so it
    /// has to be chosen and it cannot be a board somebody is already playing.
    /// </summary>
    private string _extraBoardId = "";

    private bool ExtraBoardChosen => !string.IsNullOrEmpty(_extraBoardId);

    /// Whether the form has complained about the extra board — the same "only after a submit"
    /// rule the seats follow, so the island doesn't single this one field out for early scolding.
    private bool ExtraBoardHasError => _form.Errors.HasFor(nameof(Application.Features.Games.DraftGameCommand.ExtraBoardId));

    private string? ExtraBoardLetter =>
        BoardFor(_extraBoardId) is { } b ? GameLookups.BoardLetter(b) : null;

    /// The extra board's letter is only meaningful while an extra board is on the table — sent
    /// as null otherwise, which is what the server insists on.
    private string? ExtraBoardIdForSave => UsesExtraBoard && ExtraBoardChosen ? _extraBoardId : null;

    private void ClearExtraBoard() => _extraBoardId = "";

    /// The published layouts offered for the current board count. Thematic islands are not
    /// among them — with thematic maps on there is exactly one and it isn't a choice — and
    /// nor are custom shapes, which come from rearranging the island rather than picking a tile.
    private IReadOnlyList<IslandSetup> SetupOptions =>
        GameData.PublishedIslandSetups
            .Where(s => s.NumberOfPlayers == EffectiveBoardCount && !s.IsThematic)
            // Standard leads: it is both the common pick and what gets seeded by default.
            .OrderBy(s => s.Name is "Standard" ? 0 : 1)
            .ThenBy(s => s.Name)
            .ToList();

    /// The layouts the playground may recognise a hand-built island as — the same ones offered
    /// as tiles, so building Coastline by hand records Coastline. Empty while thematic maps are
    /// on: that island is fixed, and nothing the player does can make it another layout.
    private IReadOnlyList<string> CandidateLayoutIds =>
        _thematicMaps ? [] : SetupOptions.Select(s => s.Id.Value).ToList();

    private void ToggleExtraBoard()
    {
        if (!ExtraBoardAllowed) return;
        _extraBoard = !_extraBoard;
        if (!_extraBoard) ClearExtraBoard();
        EnsureIslandSetup();
    }

    private void ToggleThematicMaps()
    {
        _thematicMaps = !_thematicMaps;
        EnsureIslandSetup();
    }

    private void OnExtraBoardKey(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter") ToggleExtraBoard();
    }

    private void OnThematicMapsKey(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter") ToggleThematicMaps();
    }

    /// The single thematic island for the current board count, or null where the real
    /// island has no such division (five boards).
    private IslandSetup? ThematicSetup => IslandSetups.ThematicFor(EffectiveBoardCount);

    /// <summary>
    /// On the thematic island a board is a region, not a choice: every seat plays the board
    /// belonging to the island position it sits at. So the boards are assigned from the layout
    /// and the picker is closed — see <see cref="ThematicBoardsLocked"/>.
    /// <para>
    /// Seats take the first positions in slot order. With an extra board the last position is
    /// the one nobody plays — so its letter is dictated by the island too, and asking for it
    /// would be asking a question with one possible answer.
    /// </para>
    /// </summary>
    private void ApplyThematicBoards()
    {
        if (ThematicIslandBoards.For(ThematicSetup?.Id) is not { } boards) return;

        for (var i = 0; i < _players.Count && i < boards.Count; i++)
            _players[i].BoardId = boards[i].Value;

        _extraBoardId = UsesExtraBoard && _players.Count < boards.Count
            ? boards[_players.Count].Value
            : "";
    }

    private bool ThematicBoardsLocked => _thematicMaps && ThematicIslandBoards.For(ThematicSetup?.Id) is not null;

    /// The island region a seat's board stands for — "Northeast", "West".
    private static string? ThematicPositionOf(string boardId) =>
        GameLookups.BoardFor(boardId) is { } board ? BoardDetails.For(board.Id)?.ThematicName : null;

    /// <summary>
    /// Why this setup can't be saved at all, if it can't — only ever a contradiction between
    /// the toggles, never a blank field. No amount of filling things in makes a five-board
    /// thematic island exist, so that is said up front and Save is disabled; blank fields wait
    /// for a submit and come back through <see cref="_form"/> like every other required field.
    /// </summary>
    private string? SetupBlockedReason =>
        _thematicMaps && ThematicSetup is null
            ? $"No thematic island exists for {EffectiveBoardCount} boards — turn Thematic maps off or change the board count."
            : null;

    /// Keeps the selection consistent with the board count and the thematic toggle.
    /// <para>
    /// Thematic maps are one published island per board count, so the choice is made for
    /// you and any hand-built arrangement is dropped. Otherwise a custom shape follows the
    /// board count (the playground re-seeds the arrangement when boards come or go) and a
    /// published layout that no longer fits gives way to the first option.
    /// </para>
    private void EnsureIslandSetup()
    {
        if (_thematicMaps)
        {
            ClearCustomLayout();
            _islandSetupId = ThematicSetup?.Id.Value ?? "";
            ApplyThematicBoards();
            return;
        }

        // A saved shape is built for one board count; once that changes it is a hand-built
        // island of a different size, no longer the saved one.
        if (_savedLayoutId is not null && SelectedSavedLayout is null)
        {
            _savedLayoutId = null;
            _arrangementIsCustom = true;
        }

        // The published selection is kept up to date even while a hand-built island is on the
        // table, so putting the boards back returns to a layout that fits.
        var options = SetupOptions;
        if (!string.IsNullOrEmpty(_islandSetupId) && options.All(s => s.Id.Value != _islandSetupId))
            _islandSetupId = "";
        if (string.IsNullOrEmpty(_islandSetupId) && options.Count > 0)
            _islandSetupId = options[0].Id.Value;
    }

    /// Picking a published layout drops any hand-built arrangement — the playground
    /// re-seeds itself from LayoutId on the next render.
    private void SelectIslandSetup(IslandSetup setup)
    {
        _islandSetupId = setup.Id.Value;
        ClearCustomLayout();
    }

    private List<PlayerFormItem> _players = [new()];
    private List<Application.Features.Friendships.FriendResponse> _friends = [];
    private List<Application.Features.Players.ListPlayersResponse> _localPlayers = [];

    private List<AdversaryFormItem> _adversaries = [];

    private bool _extraBoard;
    private bool _thematicMaps;
    private int _difficultyModifier;

    private bool _includeResult;
    private bool _resultWin = true;
    private TerrorLevel _resultTerror = TerrorLevel.First;
    private int _resultDuration = 60;
    private int _resultDahan;
    private int _resultBlight;
    private int _resultCards;
    private int _resultScoreMod;
    private string? _note;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is not { } userId) return;

        var friendsResult = await Mediator.Send(new Application.Features.Friendships.ListFriendsQuery(userId));
        var playersResult = await Mediator.Send(new Application.Features.Players.ListPlayersQuery(userId));
        var factsResult = await Mediator.Send(new Application.Features.Statistics.GetSetupFactsQuery(userId));
        var layoutsResult = await Mediator.Send(new Application.Features.IslandLayouts.ListIslandLayoutsQuery(userId));

        if (layoutsResult.IsSuccess) _savedLayouts = layoutsResult.Value;
        if (friendsResult.IsSuccess) _friends = friendsResult.Value;
        if (playersResult.IsSuccess) _localPlayers = playersResult.Value;
        if (factsResult.IsSuccess && factsResult.Value.Count > 0)
        {
            _facts = factsResult.Value;
            _layoutRecords = SetupInsights.LayoutRecords(_facts);
            _savedLayoutRecords = SetupInsights.SavedLayoutRecords(_facts);
        }

        EnsureIslandSetup();
        _loading = false;
    }

    @* ============== Matchup insights ============== *@

    /// Personal game history, loaded once; all matchup stats on this page are
    /// computed from it in-memory, so browsing the setup costs no round-trips.
    private List<Application.Features.Statistics.SetupGameFact> _facts = [];
    private Dictionary<string, SetupInsights.PlayRecord> _layoutRecords = new();
    private Dictionary<Guid, SetupInsights.PlayRecord> _savedLayoutRecords = new();

    /// The table as it stands — what every picker measures its stats against.
    private SetupInsights.MatchupContext TableContext => new(_facts, AdversaryPicks, _scenarioId);

    /// The table plus one seat, so that seat's stats follow whoever sits there. The single
    /// place a seat-scoped context is built — the pickers, the seat's history line and the
    /// spirit-on-board line all read the same numbers because they all come through here.
    private SetupInsights.MatchupContext SeatContext(PlayerFormItem seat)
    {
        var filter = SeatFilterFor(seat.AssignedTo);
        // Your own numbers need no attribution; someone else's have to say whose they are.
        var subject = seat.AssignedTo != "me" && filter is not null ? AssigneeLabel(seat.AssignedTo) : null;
        return new SetupInsights.MatchupContext(_facts, AdversaryPicks, _scenarioId, filter, subject);
    }

    private IReadOnlyList<SetupInsights.AdversaryPick> AdversaryPicks =>
        _adversaries
            .Where(a => !string.IsNullOrEmpty(a.AdversaryId))
            .Select(a => new SetupInsights.AdversaryPick(a.AdversaryId, a.Level))
            .ToList();

    private IReadOnlyList<string> SelectedSpiritIds =>
        _players.Select(p => p.SpiritId).Where(id => !string.IsNullOrEmpty(id)).ToList();

    private IReadOnlyList<string> CandidateSpiritIds =>
        GameData.Spirits
            .Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId))
            .Select(s => s.Id.Value)
            .ToList();

    private bool HasOpenSeat => _players.Any(p => string.IsNullOrEmpty(p.SpiritId));

    /// A "fresh pick" chip on the matchup card was tapped — fill the first open seat.
    private void AssignSpiritToOpenSeat(string spiritId)
    {
        var seat = _players.FirstOrDefault(p => string.IsNullOrEmpty(p.SpiritId));
        if (seat is null) return;
        seat.SpiritId = spiritId;
        seat.AspectId = "";
    }

    /// Seat filter for the person assigned to a seat — a friend's or local
    /// player's stats when the seat is theirs, the user's own seats for "me",
    /// null (the own-seats heuristic) for unassigned seats.
    private static Func<Application.Features.Statistics.SetupFactSeat, bool>? SeatFilterFor(string assignedTo)
    {
        if (assignedTo == "me") return s => s.IsMine;
        if (assignedTo.StartsWith("friend:") && Guid.TryParse(assignedTo["friend:".Length..], out var uid))
            return s => s.UserId == uid;
        if (assignedTo.StartsWith("player:") && Guid.TryParse(assignedTo["player:".Length..], out var pid))
            return s => s.PlayerId == pid;
        return null;
    }

    /// One-line history for the seat's assignee and spirit in the player modal,
    /// scoped to the current matchup: "Anna: never vs Russia L3 — vs Russia: 3× ·
    /// 67% · usually board B (4×)". Falls back to the any-level record when the
    /// exact selection was never played.
    private string? SeatInsightLine(PlayerFormItem p)
    {
        var context = SeatContext(p);
        var matchup = context.SpiritMatchups().GetValueOrDefault(p.SpiritId);
        var exact = matchup?.Exact;
        var scope = context.ExactLabel;
        var parts = new List<string>();
        if (exact is { Played: > 0 })
        {
            parts.Add($"{exact.Played}× {scope ?? "overall"}");
            if (exact.Completed > 0) parts.Add($"{exact.WinRate:F0}% wins");
        }
        else if (matchup?.Broad is { Played: > 0 } broad && context.BroadLabel is { } broadLabel)
        {
            parts.Add($"First time {scope} — {broadLabel}: {broad.Played}×{(broad.Completed > 0 ? $" · {broad.WinRate:F0}%" : "")}");
        }
        else
        {
            parts.Add(scope is null ? "First game with this spirit" : $"Never played {scope}");
        }

        // Same seat scope as the record above, so the line can't say "never played"
        // and "usually board B" in the same breath.
        var boards = context.BoardRecords(p.SpiritId);
        if (boards.Count > 0)
        {
            var top = boards.MaxBy(kv => kv.Value.Played);
            if (BoardFor(top.Key) is { } board)
            {
                parts.Add($"usually board {GameLookups.BoardLetter(board)} ({top.Value.Played}×)");
            }
        }
        var line = string.Join(" · ", parts);
        return context.SubjectName is null ? line : $"{context.SubjectName}: {line}";
    }

    /// "Lightning on board B: 3× · 67% wins" — the exact spirit-on-board pairing
    /// shown in the player modal once both are chosen, scoped to whoever sits there.
    private string? SpiritOnBoardLine(PlayerFormItem p)
    {
        if (SpiritFor(p.SpiritId) is not { } spirit || BoardFor(p.BoardId) is not { } board) return null;
        var letter = GameLookups.BoardLetter(board);
        var rec = SeatContext(p).BoardRecords(p.SpiritId).GetValueOrDefault(p.BoardId);
        if (rec is not { Played: > 0 })
            return $"First time playing {spirit.Name} on board {letter}.";
        var wins = rec.Completed > 0 ? $" · {rec.WinRate:F0}% wins" : "";
        return $"{spirit.Name} on board {letter}: {rec.Played}×{wins}";
    }

    @* ============== Island playground ============== *@

    /// The arrangement on the table as the playground's JSON. Saved with the game so the
    /// island can be seen again as it was played, and handed back to the playground so a
    /// saved shape can be put on the table.
    private string? _customLayoutJson;

    /// <summary>
    /// The player has moved the island away from whatever was seeded — a published layout or
    /// a saved shape. Set and cleared by the playground, which is the only thing that can tell
    /// the difference: putting a board back where it was makes the island Standard again, not
    /// a custom shape that happens to look like it.
    /// </summary>
    private bool _arrangementIsCustom;

    private bool IsCustomLayout => _arrangementIsCustom || _savedLayoutId is not null;

    /// The layout recorded against the game: the published selection, or a hand-built shape
    /// of this board count.
    private string EffectiveSetupId =>
        IsCustomLayout ? IslandSetups.CustomIdFor(EffectiveBoardCount) : _islandSetupId;

    private string LayoutLabel =>
        // Nothing to arrange when the island is locked — say what's wrong instead of inviting
        // the player to do something they can't.
        _thematicMaps && ThematicSetup is null ? "No thematic island"
        : string.IsNullOrEmpty(_islandSetupId) ? "Arrange the boards"
        : IsCustomLayout ? SelectedSavedLayout?.Name ?? "Custom shape"
        : GameLookups.IslandSetupFor(_islandSetupId)?.Name ?? "Arrange the boards";

    @* ============== Saved layouts (the player's own library) ============== *@

    private List<Application.Features.IslandLayouts.IslandLayoutResponse> _savedLayouts = [];

    /// The saved layout on the table, if the arrangement still is one. Cleared the moment
    /// the player moves a board — see OnIslandRearranged.
    private Guid? _savedLayoutId;

    private string _layoutNameDraft = "";
    private string? _layoutMessage;
    private bool _layoutSaved;

    /// The player's shapes that fit the current island. A layout is built for a fixed number
    /// of boards, so a four-board shape is simply not on offer at a three-board table.
    private IReadOnlyList<Application.Features.IslandLayouts.IslandLayoutResponse> SavedLayoutOptions =>
        _savedLayouts.Where(l => l.BoardCount == EffectiveBoardCount).ToList();

    private Application.Features.IslandLayouts.IslandLayoutResponse? SelectedSavedLayout =>
        _savedLayoutId is { } id ? SavedLayoutOptions.FirstOrDefault(l => l.Id == id) : null;

    /// Puts a saved shape on the table: the setup becomes a hand-built one of this board
    /// count, and the playground re-seeds from the stored geometry.
    private void SelectSavedLayout(Application.Features.IslandLayouts.IslandLayoutResponse layout)
    {
        _customLayoutJson = layout.LayoutJson;
        _savedLayoutId = layout.Id;
        // It is the saved shape as saved, not a deviation from it — until the player moves something.
        _arrangementIsCustom = false;
        _layoutNameDraft = "";
        _layoutMessage = null;
    }

    /// Save is offered for a fresh name, or to push the current arrangement back onto the
    /// saved shape it came from.
    private bool CanSaveLayout =>
        !string.IsNullOrEmpty(_customLayoutJson)
        && (!string.IsNullOrWhiteSpace(_layoutNameDraft) || SelectedSavedLayout is not null);

    private async Task SaveCurrentLayout()
    {
        if (!CanSaveLayout || CurrentUser.UserId is not { } userId) return;

        var existing = SelectedSavedLayout;
        var renaming = !string.IsNullOrWhiteSpace(_layoutNameDraft);
        // Typing a new name over a saved shape saves a copy; leaving it blank updates the
        // shape you started from.
        var targetId = renaming && existing is not null ? Guid.NewGuid() : existing?.Id ?? Guid.NewGuid();
        var name = renaming ? _layoutNameDraft.Trim() : existing!.Name;

        var result = await Mediator.Send(new Application.Features.IslandLayouts.SaveIslandLayoutCommand(
            targetId, userId, name, _customLayoutJson!, DateTimeOffset.UtcNow));

        if (result.IsFailure)
        {
            _layoutSaved = false;
            _layoutMessage = result.Error.Message;
            return;
        }

        await ReloadSavedLayouts(userId);
        _savedLayoutId = targetId;
        _layoutNameDraft = "";
        _layoutSaved = true;
        _layoutMessage = $"Saved as \"{name}\".";
    }

    private async Task DeleteSavedLayout(Application.Features.IslandLayouts.IslandLayoutResponse layout)
    {
        if (CurrentUser.UserId is not { } userId) return;

        var result = await Mediator.Send(
            new Application.Features.IslandLayouts.DeleteIslandLayoutCommand(layout.Id, userId));
        if (result.IsFailure)
        {
            _layoutSaved = false;
            _layoutMessage = result.Error.Message;
            return;
        }

        await ReloadSavedLayouts(userId);
        // The arrangement stays on the table — it is just no longer one of the saved ones.
        if (_savedLayoutId == layout.Id) _savedLayoutId = null;
        _layoutSaved = true;
        _layoutMessage = $"Deleted \"{layout.Name}\".";
    }

    private async Task ReloadSavedLayouts(Guid userId)
    {
        var reloaded = await Mediator.Send(new Application.Features.IslandLayouts.ListIslandLayoutsQuery(userId));
        if (reloaded.IsSuccess) _savedLayouts = reloaded.Value;
    }

    private async Task OnLayoutNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSaveLayout) await SaveCurrentLayout();
    }

    /// Back to a published layout: forget the arrangement and which saved shape it was.
    private void ClearCustomLayout()
    {
        _customLayoutJson = null;
        _savedLayoutId = null;
        _arrangementIsCustom = false;
        _layoutNameDraft = "";
        _layoutMessage = null;
    }

    /// One entry per board on the island: the seated players first, then the extra board.
    private IReadOnlyList<IslandPlayground.BoardVisual> BoardVisuals
    {
        get
        {
            var visuals = new List<IslandPlayground.BoardVisual>(EffectiveBoardCount);
            for (var i = 0; i < _players.Count; i++)
            {
                var p = _players[i];
                var board = BoardFor(p.BoardId);
                var boardDetail = board is null ? null : BoardDetails.For(board.Id);
                var spirit = SpiritFor(p.SpiritId);
                visuals.Add(new IslandPlayground.BoardVisual(
                    Key: p.Key,
                    Letter: board is null ? null : GameLookups.BoardLetter(board),
                    Color: boardDetail?.ColorHex ?? "#e8dcb8",
                    SpiritColor: spirit is null ? null : SpiritDetails.For(spirit.Id)?.ColorHex ?? GameLookups.NeutralColor,
                    Initials: AssigneeInitials(p.AssignedTo),
                    Error: HasPlayerError(i)));
            }
            // Nobody plays the extra board, so it is marked unseated — the playground labels it
            // "extra" rather than "set up". It still carries a letter and a colour, because it is
            // one of the lettered boards and still has to be chosen.
            if (UsesExtraBoard)
            {
                var extra = BoardFor(_extraBoardId);
                var extraDetail = extra is null ? null : BoardDetails.For(extra.Id);
                visuals.Add(new IslandPlayground.BoardVisual(
                    Key: "extra",
                    Letter: ExtraBoardLetter,
                    Color: extraDetail?.ColorHex ?? "#ded2ae",
                    SpiritColor: null,
                    Initials: null,
                    Error: ExtraBoardHasError,
                    Seated: false));
            }
            return visuals;
        }
    }

    /// The legend earns its space once it can name something — a chosen spirit, a board letter,
    /// or an extra board to account for. Bare "Player 1 · Player 2" chips would only repeat the
    /// stepper below them and the "set up" labels on the boards above.
    private bool ShowIslandLegend =>
        _players.Any(p => !string.IsNullOrEmpty(p.SpiritId) || !string.IsNullOrEmpty(p.BoardId))
        || UsesExtraBoard;

    /// The island changed. It becomes a hand-built shape when it no longer matches what was
    /// seeded — and goes back to being that layout when the player puts it back, which is why
    /// this handles the return trip rather than only the departure.
    private void OnIslandRearranged(IslandPlayground.LayoutChange change)
    {
        // With thematic maps the island isn't the player's to arrange, and nothing in the UI
        // lets them. The playground still reports its geometry when boards come or go, and
        // taking that as a hand-built shape would quietly undo the lock.
        if (_thematicMaps) return;

        _customLayoutJson = change.Json;
        _layoutMessage = null;

        if (change.MatchedLayoutId is { } matched)
        {
            // The island is a published layout, however it got there — dropped in, or built by
            // hand out of scattered boards.
            _islandSetupId = matched;
            _arrangementIsCustom = false;
            _savedLayoutId = null;
        }
        else if (change.MatchesSeed)
        {
            // Not a published shape, but still the one that was put on the table — a saved shape.
            _arrangementIsCustom = false;
        }
        else
        {
            _arrangementIsCustom = true;
            _savedLayoutId = null;
        }
    }


    private bool HasPlayerError(int idx) =>
        _form.Errors.HasFor($"Players[{idx}].SpiritId")
        || _form.Errors.HasFor($"Players[{idx}].BoardId")
        || _form.Errors.HasFor($"Players[{idx}].AssignedTo");

    private string AssigneeLabel(string value) => value switch
    {
        "me" => "You",
        _ when value.StartsWith("friend:") =>
            _friends.FirstOrDefault(f => $"friend:{f.FriendUserId}" == value)?.Nickname ?? "Friend",
        _ when value.StartsWith("player:") =>
            _localPlayers.FirstOrDefault(p => $"player:{p.Id}" == value)?.Name ?? "Player",
        _ => "Unassigned"
    };

    /// Initials for the board chip on the island — null for your own seat, which every seat
    /// starts as: a "Y" for "You" on all four boards labels nothing, and once someone else is
    /// at the table the unlabelled board is the one that is yours.
    private string? AssigneeInitials(string value)
    {
        if (value == "me") return null;
        var parts = AssigneeLabel(value).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1],
            _ => $"{parts[0][..1]}{parts[1][..1]}"
        };
    }

    @* ============== Player editing ============== *@
    /// A board on the island was tapped. The seats come first and open their dialog; the last
    /// board is the extra one, which has no seat and only needs its letter (see BoardVisuals).
    private void OnIslandBoardActivated(int idx)
    {
        // On the thematic island the extra board's letter comes with its position, so there is
        // nothing to open — see ApplyThematicBoards.
        if (idx == _players.Count && UsesExtraBoard)
        {
            if (!ThematicBoardsLocked) OpenExtraBoardPicker();
        }
        else SelectPlayer(idx);
    }

    private void SelectPlayer(int idx)
    {
        if (idx < 0 || idx >= _players.Count) return;
        _selectedPlayerIndex = idx;
    }

    private void ClosePlayerModal() => _selectedPlayerIndex = -1;

    /// Every seat needs a board of its own, so the table is capped by the boards on the shelf as
    /// well as by the rules.
    private bool CanAddPlayer =>
        _players.Count < GameRestrictions.MaximumPlayers && EffectiveBoardCount < OwnedBoardCount;

    private string AddPlayerHint =>
        _players.Count >= GameRestrictions.MaximumPlayers
            ? $"Spirit Island supports up to {GameRestrictions.MaximumPlayers} players"
            : EffectiveBoardCount >= OwnedBoardCount
                ? $"You own {OwnedBoardCount} island board{(OwnedBoardCount == 1 ? "" : "s")} — every board on the island needs to be one of them"
                : "Add player";

    private void AddPlayer()
    {
        if (!CanAddPlayer) return;
        _players.Add(new PlayerFormItem());
        if (!ExtraBoardAllowed) { _extraBoard = false; ClearExtraBoard(); }
        EnsureIslandSetup();
    }

    private void RemovePlayer(int idx)
    {
        _players.RemoveAt(idx);
        _selectedPlayerIndex = -1;
        EnsureIslandSetup();
    }

    private void RemoveLastPlayer()
    {
        if (_players.Count > 1) RemovePlayer(_players.Count - 1);
    }

    private void OnAssigneeChanged(int idx, string value)
    {
        _players[idx].AssignedTo = value;
        _form.Resolve($"Players[{idx}].AssignedTo");
    }

    private void SelectAspect(int idx, string? aspectId)
    {
        _players[idx].AspectId = aspectId ?? "";
    }

    private IReadOnlyList<Aspect> GetAspectsForSpirit(string spiritId)
    {
        if (string.IsNullOrEmpty(spiritId)) { return []; }
        var aspects = GameData.GetAspectsForSpirit(new SpiritId(spiritId));
        if (OwnedExpansions is null) { return aspects; }
        return aspects.Where(a => OwnedExpansions.Contains(a.ExpansionId)).ToList();
    }

    @* ============== Spirit picker ============== *@
    private void OpenSpiritPicker(int idx)
    {
        _editingSpiritIndex = idx;
        _spiritPicker.Show(_players[idx].SpiritId, SeatContext(_players[idx]));
    }

    private void OnSpiritPicked(Spirit spirit)
    {
        if (_editingSpiritIndex < 0 || _editingSpiritIndex >= _players.Count) return;
        var p = _players[_editingSpiritIndex];
        if (p.SpiritId != spirit.Id.Value)
        {
            p.SpiritId = spirit.Id.Value;
            p.AspectId = "";
        }
        _form.Resolve($"Players[{_editingSpiritIndex}].SpiritId");
        _editingSpiritIndex = -1;
    }

    @* ============== Board picker ============== *@
    /// <see cref="_editingBoardIndex"/> when the board being picked is the extra one. It has no
    /// seat, so there is no player index that names it.
    private const int ExtraBoardSlot = -2;

    private void OpenBoardPicker(int idx)
    {
        _editingBoardIndex = idx;
        _boardPicker.Show(_players[idx].BoardId, SeatContext(_players[idx]), _players[idx].SpiritId);
    }

    /// The extra board has no spirit and no player, so it is picked with the table's own context
    /// rather than a seat's — there is nobody whose record could scope it.
    private void OpenExtraBoardPicker()
    {
        _editingBoardIndex = ExtraBoardSlot;
        _boardPicker.Show(_extraBoardId, TableContext);
    }

    /// Boards already on the island, so the picker can rule them out — there is one physical
    /// copy of each. Everything except the board currently being changed.
    private IReadOnlyCollection<string> BoardsTakenForCurrentEdit()
    {
        if (_editingBoardIndex == -1) { return []; }
        var taken = _players
            .Where((_, i) => i != _editingBoardIndex)
            .Select(p => p.BoardId)
            .ToList();
        if (_editingBoardIndex != ExtraBoardSlot && UsesExtraBoard) taken.Add(_extraBoardId);
        return taken.Where(id => !string.IsNullOrEmpty(id)).ToList();
    }

    private void OnBoardPicked(Board board)
    {
        if (_editingBoardIndex == ExtraBoardSlot)
        {
            _extraBoardId = board.Id.Value;
            _form.Resolve(nameof(Application.Features.Games.DraftGameCommand.ExtraBoardId));
        }
        else if (_editingBoardIndex >= 0 && _editingBoardIndex < _players.Count)
        {
            _players[_editingBoardIndex].BoardId = board.Id.Value;
            _form.Resolve($"Players[{_editingBoardIndex}].BoardId");
        }

        _editingBoardIndex = -1;
    }

    @* ============== Adversary picker ============== *@
    private void OpenAdversaryPickerForNew()
    {
        _editingAdversaryIndex = -1;
        _adversaryPicker.Show(context: TableContext);
    }

    private void OpenAdversaryPickerFor(int idx)
    {
        _editingAdversaryIndex = idx;
        var item = _adversaries[idx];
        _adversaryPicker.Show(
            string.IsNullOrEmpty(item.AdversaryId) ? null : new SetupInsights.AdversaryPick(item.AdversaryId, item.Level),
            TableContext);
    }

    /// Adversaries already at the table, so the picker can rule them out — the same foe can't
    /// invade twice. Everything except the slot currently being changed.
    private IReadOnlyCollection<string> AdversariesTakenForCurrentEdit() =>
        _adversaries
            .Where((_, i) => i != _editingAdversaryIndex)
            .Select(a => a.AdversaryId)
            .Where(id => !string.IsNullOrEmpty(id))
            .ToList();

    private void RemoveAdversary(int idx) => _adversaries.RemoveAt(idx);

    private void OnAdversaryPicked((Adversary Adversary, int Level) pick)
    {
        if (_editingAdversaryIndex >= 0 && _editingAdversaryIndex < _adversaries.Count)
        {
            _adversaries[_editingAdversaryIndex] = new AdversaryFormItem
            {
                AdversaryId = pick.Adversary.Id.Value,
                Level = pick.Level
            };
        }
        else
        {
            _adversaries.Add(new AdversaryFormItem
            {
                AdversaryId = pick.Adversary.Id.Value,
                Level = pick.Level
            });
        }
        _editingAdversaryIndex = -1;
    }

    @* ============== Scenario picker ============== *@
    private void OpenScenarioPicker() => _scenarioPicker.Show(_scenarioId, TableContext);

    private void ClearScenario() => _scenarioId = null;

    private void OnScenarioPicked(Scenario? scenario)
    {
        _scenarioId = scenario?.Id.Value;
    }

    @* ============== Lookups ============== *@
    private static Spirit? SpiritFor(string id) => GameLookups.SpiritFor(id);
    private static Board? BoardFor(string id) => GameLookups.BoardFor(id);
    private static Adversary? AdversaryFor(string id) => GameLookups.AdversaryFor(id);
    private static Scenario? ScenarioFor(string? id) => GameLookups.ScenarioFor(id);

    @* ============== Save ============== *@
    private List<Application.Features.Games.Dtos.GamePlayerDto> BuildPlayerDtos()
    {
        return _players.Select(p =>
        {
            Guid? userId = null;
            Guid? playerId = null;

            if (p.AssignedTo == "me")
                userId = CurrentUser.UserId;
            else if (p.AssignedTo.StartsWith("friend:"))
                userId = Guid.Parse(p.AssignedTo["friend:".Length..]);
            else if (p.AssignedTo.StartsWith("player:"))
                playerId = Guid.Parse(p.AssignedTo["player:".Length..]);

            return new Application.Features.Games.Dtos.GamePlayerDto(
                p.SpiritId, string.IsNullOrEmpty(p.AspectId) ? null : p.AspectId,
                p.BoardId, userId, playerId);
        }).ToList();
    }

    private List<Application.Features.Games.Dtos.GameAdversaryDto> BuildAdversaryDtos()
        => _adversaries.Select(a => new Application.Features.Games.Dtos.GameAdversaryDto(a.AdversaryId, a.Level)).ToList();

    private async Task SaveDraft()
    {
        _saving = true;
        var cmd = new Application.Features.Games.DraftGameCommand(
            CurrentUser.UserId!.Value,
            StartedAt,
            EffectiveSetupId,
            UsesExtraBoard,
            ExtraBoardIdForSave,
            _thematicMaps,
            _difficultyModifier,
            BuildPlayerDtos(), BuildAdversaryDtos(),
            string.IsNullOrEmpty(_scenarioId) ? null : _scenarioId,
            string.IsNullOrEmpty(_note) ? null : _note,
            IsCustomLayout ? _customLayoutJson : null,
            IsCustomLayout ? _savedLayoutId : null);

        var result = await Mediator.Send(cmd);
        _saving = false;

        if (_form.Apply(result)) Nav.NavigateTo("/app/games");
    }

    private async Task SaveCompleted()
    {
        _saving = true;
        var resultDto = new Application.Features.Games.Dtos.GameResultDto(
            _resultWin, TimeSpan.FromMinutes(_resultDuration),
            _resultCards, _resultTerror, _resultBlight, _resultDahan, _resultScoreMod);

        var cmd = new Application.Features.Games.CreateGameCommand(
            CurrentUser.UserId!.Value,
            StartedAt,
            EffectiveSetupId,
            UsesExtraBoard,
            ExtraBoardIdForSave,
            _thematicMaps,
            _difficultyModifier,
            BuildPlayerDtos(), BuildAdversaryDtos(),
            string.IsNullOrEmpty(_scenarioId) ? null : _scenarioId,
            resultDto,
            string.IsNullOrEmpty(_note) ? null : _note,
            IsCustomLayout ? _customLayoutJson : null,
            IsCustomLayout ? _savedLayoutId : null);

        var result = await Mediator.Send(cmd);
        _saving = false;

        if (_form.Apply(result)) Nav.NavigateTo("/app/games");
    }

    private class PlayerFormItem
    {
        /// Identity for the island playground, so a board keeps its place and its bonds
        /// when seats around it are added or removed. Never persisted.
        public string Key { get; } = Guid.NewGuid().ToString("N");

        public string SpiritId { get; set; } = "";
        public string AspectId { get; set; } = "";
        public string BoardId { get; set; } = "";
        public string AssignedTo { get; set; } = "me";
    }

    private class AdversaryFormItem
    {
        /// Render identity for the ship row, so removing one ship doesn't re-key the rest.
        public string Key { get; } = Guid.NewGuid().ToString("N");

        public string AdversaryId { get; set; } = "";
        public int Level { get; set; }
    }
}
