@* ============================== BOARDS TAB ============================== *@
@code {
    private RenderFragment BoardsTab() =>
        @<div class="space-y-6">
            @{
                var topBoard = _stats!.BoardStatistics.OrderByDescending(b => b.GamesPlayed).FirstOrDefault();
                var bestBoard = _stats.BoardStatistics.Where(b => b.GamesPlayed >= 3).OrderByDescending(b => b.WinRate).FirstOrDefault();
                var playedIds = _stats.BoardStatistics.Select(b => b.BoardId).ToHashSet();
                var ownedBoards = OwnedBoardsList();
                var missing = ownedBoards.Where(b => !playedIds.Contains(b.Id.Value)).Cast<object>().ToList();

                var playedSetups = GameData.PublishedIslandSetups
                    .Select(s => (Setup: s, Record: _layoutRecords.GetValueOrDefault(s.Id.Value)))
                    .Where(x => x.Record is { Played: > 0 })
                    .OrderByDescending(x => x.Record!.Played)
                    .ToList();
                var savedIds = _savedLayouts.Select(l => l.Id).ToHashSet();
                var playedSaved = _savedLayouts
                    .Select(l => (Layout: l, Record: _savedLayoutRecords.GetValueOrDefault(l.Id)))
                    .Where(x => x.Record is { Played: > 0 })
                    .OrderByDescending(x => x.Record!.Played)
                    .ToList();
                // Hand-built islands that never made it into the library (or whose shape was deleted).
                var oneOffFacts = ScopedFacts
                    .Where(f => IslandSetups.IsCustomId(f.IslandSetupId)
                                && (f.CustomLayoutId is null || !savedIds.Contains(f.CustomLayoutId.Value)))
                    .ToList();
                var oneOffRecord = new SetupInsights.PlayRecord(
                    oneOffFacts.Count,
                    oneOffFacts.Count(g => g.IsCompleted && g.Win == true),
                    oneOffFacts.Count(g => g.IsCompleted && g.Win == false));
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                @if (topBoard is not null) { @BoardInsight("Most played board", topBoard, $"{topBoard.GamesPlayed} games", null) }
                @if (bestBoard is not null && bestBoard.BoardId != topBoard?.BoardId) { @BoardInsight("Highest win rate", bestBoard, $"{bestBoard.WinRate:F0}%", WinTone.ForRate(bestBoard.WinRate)) }
            </div>

            @if (_stats.BoardStatistics.Count > 0)
            {
                <div class="surface">
                    <div class="surface-head">
                        <h2 class="text-base font-semibold">All boards played</h2>
                        <span class="text-[11px] text-ink-500">Tap a row for the record sheet</span>
                    </div>
                    <div class="table-wrap">
                        <table class="table table-hover">
                            <thead><tr><th>Board</th><th class="text-right">Games</th><th class="text-right">W</th><th class="text-right">L</th><th>Win rate</th></tr></thead>
                            <tbody>
                            @foreach (var b in _stats.BoardStatistics)
                            {
                                var board = GameLookups.BoardFor(b.BoardId);
                                var detail = board is null ? null : BoardDetails.For(board.Id);
                                var color = detail?.ColorHex ?? GameLookups.NeutralColor;
                                var letter = detail?.Letter ?? (board is null ? "?" : board.Name[^1..]);
                                <tr @onclick="() => OpenBoard(b.BoardId)">
                                    <td>
                                        <div class="flex items-center gap-3 min-w-0">
                                            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-white text-sm font-semibold shrink-0" style="background-color: @color; font-family: var(--font-serif);">@letter</span>
                                            <div class="min-w-0">
                                                <button type="button" @onclick="() => OpenBoard(b.BoardId)" @onclick:stopPropagation
                                                        class="block max-w-full truncate rounded text-left text-sm font-semibold text-ink-900
                                                               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                                    @(board?.Name ?? b.BoardId)
                                                </button>
                                                @if (detail is not null) { <div class="text-[11px] text-ink-500 truncate">@detail.ThematicName</div> }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-right tabular-nums">@b.GamesPlayed</td>
                                    <td class="text-right text-accent-700 tabular-nums">@b.Wins</td>
                                    <td class="text-right text-red-600 tabular-nums">@b.Losses</td>
                                    <td>
                                        @if (b.Wins + b.Losses > 0) { <WinRateBar Pct="b.WinRate"/> }
                                        else { <span class="text-xs text-ink-400">—</span> }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* ===== Island layouts ===== *@
            @if (playedSetups.Count > 0 || playedSaved.Count > 0 || oneOffRecord.Played > 0)
            {
                <div>
                    <div class="section-head">
                        <h2 class="section-title">Island layouts</h2>
                        <span class="section-note">Standard setups and your saved shapes</span>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                        @foreach (var (setup, rec) in playedSetups)
                        {
                            <button @key="setup.Id.Value" type="button" @onclick="() => _layoutModal.Show(setup)"
                                    title="@($"{setup.Name} — details and full record")"
                                    class="surface p-4 flex flex-col items-center text-center transition-all hover:-translate-y-px hover:shadow-sm
                                           focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                <div class="h-20 w-full flex items-center justify-center">
                                    <IslandSetupDiagram Setup="setup" Class="max-h-full max-w-full"/>
                                </div>
                                <div class="mt-2 max-w-full truncate text-sm font-semibold text-ink-900">@setup.Name</div>
                                <div class="text-[11px] text-ink-500">
                                    @setup.NumberOfPlayers board@(setup.NumberOfPlayers == 1 ? "" : "s")@(setup.IsThematic ? " · thematic" : "")
                                </div>
                                <div class="mt-1.5"><RecordChip Record="rec" Subject="@setup.Name"/></div>
                            </button>
                        }
                        @foreach (var (saved, rec) in playedSaved)
                        {
                            <button @key="saved.Id" type="button" @onclick="() => _layoutModal.Show(saved)"
                                    title="@($"{saved.Name} — details and full record")"
                                    class="surface p-4 flex flex-col items-center text-center transition-all hover:-translate-y-px hover:shadow-sm
                                           focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                                <div class="h-20 w-full flex items-center justify-center">
                                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-dashed border-sky-300 bg-sky-50/60 text-sky-700">
                                        <Icon Name="map" Class="w-5 h-5"/>
                                    </span>
                                </div>
                                <div class="mt-2 max-w-full truncate text-sm font-semibold text-ink-900">@saved.Name</div>
                                <div class="text-[11px] text-ink-500">@saved.BoardCount board@(saved.BoardCount == 1 ? "" : "s") · your saved shape</div>
                                <div class="mt-1.5"><RecordChip Record="rec" Subject="@saved.Name"/></div>
                            </button>
                        }
                        @if (oneOffRecord.Played > 0)
                        {
                            <div class="surface border-dashed p-4 flex flex-col items-center justify-center text-center"
                                 title="Hand-built islands that weren't saved to your library">
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-dashed border-ink-300 bg-white text-ink-500">
                                    <Icon Name="map" Class="w-5 h-5"/>
                                </span>
                                <div class="mt-2 text-sm font-semibold text-ink-900">One-off islands</div>
                                <div class="text-[11px] text-ink-500">hand-built, not saved</div>
                                <div class="mt-1.5"><RecordChip Record="oneOffRecord" Subject="One-off islands"/></div>
                            </div>
                        }
                    </div>
                </div>
            }

            <CoveragePanel Title="Boards" Total="ownedBoards.Count" Missing="missing" ItemTemplate="BoardPill"
                           Note="@OutsideCollectionNote(playedIds, ownedBoards.Select(b => b.Id.Value), "board")"/>
        </div>;

    private RenderFragment<object> BoardPill => o =>
        @<text>
            @{
                var board = (Board)o;
                var detail = BoardDetails.For(board.Id);
                var color = detail?.ColorHex ?? GameLookups.NeutralColor;
                var letter = detail?.Letter ?? board.Name[^1..];
            }
            <button type="button" @onclick="() => _boardModal.Show(board)" title="@($"{board.Name} — details and full record")"
                    class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-amber-300 bg-amber-50/60 px-2.5 py-1 text-xs transition-colors
                           hover:border-amber-400 hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded text-white text-[10px] font-semibold" style="background-color: @color; font-family: var(--font-serif);">@letter</span>
                <span class="text-amber-800">@board.Name</span>
            </button>
        </text>;

    private RenderFragment BoardInsight(string title, BoardStats b, string metric, string? metricColor) =>
        @<text>
            @{
                var board = GameLookups.BoardFor(b.BoardId);
                var detail = board is null ? null : BoardDetails.For(board.Id);
            }
            <InsightCard Title="@title"
                         Subject="@(board?.Name ?? b.BoardId)"
                         Secondary="@(detail?.ThematicName)"
                         Metric="@metric"
                         MetricColorClass="@(metricColor ?? "text-ink-900")"
                         AccentColor="@(detail?.ColorHex)"
                         OnClick="() => OpenBoard(b.BoardId)"/>
        </text>;
}

@code {
    [CascadingParameter(Name = "OwnedExpansions")]
    public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>Opens the page on a named tab, so elsewhere can link straight at a slice
    /// (the dashboard's collection rows do). Ignored when it names no tab we have.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    /// <summary>Opens the page already scoped to a friend — the People page links this way.
    /// Ignored when that account has never sat in one of your games.</summary>
    [SupplyParameterFromQuery(Name = "user")]
    public Guid? ScopeUserParam { get; set; }

    /// <summary>The same, for a local player.</summary>
    [SupplyParameterFromQuery(Name = "player")]
    public Guid? ScopePlayerParam { get; set; }

    private StatisticsResponse? _stats;
    private List<PlayerStats> _unfilteredPlayers = [];
    private PlayerStats? _scoped;
    private bool _loading = true;
    private bool _scopeOpen;
    private string _tab = "overview";

    // The raw per-game history behind the record sheets and the layout tallies —
    // the same facts the setup screen and the catalogue pages load.
    private IReadOnlyList<SetupGameFact>? _facts;
    private List<IslandLayoutResponse> _savedLayouts = [];
    private Dictionary<string, SetupInsights.PlayRecord> _layoutRecords = new();
    private Dictionary<Guid, SetupInsights.PlayRecord> _savedLayoutRecords = new();

    private SpiritDetailModal _spiritModal = default!;
    private AdversaryDetailModal _adversaryModal = default!;
    private ScenarioDetailModal _scenarioModal = default!;
    private BoardDetailModal _boardModal = default!;
    private IslandLayoutDetailModal _layoutModal = default!;

    private void OpenSpirit(string id) { if (GameLookups.SpiritFor(id) is { } s) _spiritModal.Show(s); }
    private void OpenAdversary(string id) { if (GameLookups.AdversaryFor(id) is { } a) _adversaryModal.Show(a); }
    private void OpenScenario(string? id) { if (GameLookups.ScenarioFor(id) is { } s) _scenarioModal.Show(s); }
    private void OpenBoard(string id) { if (GameLookups.BoardFor(id) is { } b) _boardModal.Show(b); }

    /// <summary>Seat predicate for the picked player, so the spirit/board sheets profile their seats.</summary>
    private Func<SetupFactSeat, bool>? ScopeSeatFilter =>
        _scoped switch
        {
            null => null,
            { UserId: { } u } => s => s.UserId == u,
            { PlayerId: { } p } => s => s.PlayerId == p,
            _ => null,
        };

    /// <summary>Whose record the sheets are labelled with — null for "you".</summary>
    private string? ScopeSubjectName =>
        _scoped is null || _scoped.Kind == PlayerKind.Me ? null : _scoped.Name;

    /// <summary>The history narrowed to the page scope: games the picked player sat in.</summary>
    private IReadOnlyList<SetupGameFact> ScopedFacts =>
        _facts is null ? []
        : ScopeSeatFilter is { } filter ? _facts.Where(g => g.Seats.Any(filter)).ToList()
        : _facts;

    /// Layout tallies follow the page scope the way the server-side stats do.
    private void RecomputeLayoutRecords()
    {
        var facts = ScopedFacts;
        _layoutRecords = SetupInsights.LayoutRecords(facts);
        _savedLayoutRecords = SetupInsights.SavedLayoutRecords(facts);
    }

    private record TabDef(string Key, string Label);
    private readonly TabDef[] _tabs =
    [
        new("overview", "Overview"),
        new("players", "Players"),
        new("spirits", "Spirits"),
        new("adversaries", "Adversaries"),
        new("scenarios", "Scenarios"),
        new("boards", "Boards"),
    ];

    /// <summary>Played-entity count shown on the tab pill; null for tabs that aren't a list.</summary>
    private int? TabCount(string key) => key switch
    {
        "players"     => _unfilteredPlayers.Count > 1 ? _unfilteredPlayers.Count : null,
        "spirits"     => _stats?.SpiritStatistics.Count,
        "adversaries" => _stats?.AdversaryStatistics.Count,
        "scenarios"   => _stats?.ScenarioStatistics.Count,
        "boards"      => _stats?.BoardStatistics.Count,
        _             => null,
    };

    private void SetTab(string key) => _tab = key;

    // Only when the query itself changes, so clicking a pill isn't undone by the URL
    // it arrived on still saying something else.
    private string? _appliedTabParam;

    protected override void OnParametersSet()
    {
        if (TabParam == _appliedTabParam) return;
        _appliedTabParam = TabParam;
        if (TabParam is { } key && _tabs.Any(t => t.Key == key)) _tab = key;
    }

    /// The shared summary line, prefixed with whose it is when the page is scoped.
    private string HeaderSummary
    {
        get
        {
            if (_stats is null || _stats.TotalGames == 0)
                return "Your game history, distilled.";
            var line = StatsFormat.Summary(_stats);
            return _scoped is null ? line : $"{_scoped.Name} · {line}";
        }
    }

    public sealed record MissingLevel(string AdversaryId, string AdversaryName, int Level);
    public sealed record MissingAdversaryGroup(string AdversaryId, string AdversaryName, List<int> Levels);

    public sealed record MissingAspect(string SpiritId, string SpiritName, string AspectName);
    public sealed record MissingAspectGroup(string SpiritId, string SpiritName, List<string> AspectNames);

    protected override async Task OnInitializedAsync()
    {
        // Without a user there is nothing to load — drop the spinner rather than spin forever.
        if (CurrentUser.UserId is not { } userId)
        {
            _loading = false;
            return;
        }

        // Sequential sends — the scoped DbContext behind IMediator is not thread-safe.
        await LoadStats(scopeUserId: null, scopePlayerId: null);
        _unfilteredPlayers = _stats?.PlayerStatistics ?? [];

        // Arrived scoped at somebody (from a People card, say) — pick them out of the tally the
        // dropdown reads from, so the whole page behaves as if that pick had been made here.
        if (ScopeUserParam is { } scopeUser)
            _scoped = _unfilteredPlayers.FirstOrDefault(p => p.UserId == scopeUser);
        else if (ScopePlayerParam is { } scopePlayer)
            _scoped = _unfilteredPlayers.FirstOrDefault(p => p.PlayerId == scopePlayer);

        if (_scoped is not null)
            await LoadStats(_scoped.UserId, _scoped.PlayerId);

        var facts = await Mediator.Send(new GetSetupFactsQuery(userId));
        if (facts.IsSuccess) _facts = facts.Value;
        var layouts = await Mediator.Send(new ListIslandLayoutsQuery(userId));
        if (layouts.IsSuccess) _savedLayouts = layouts.Value;
        RecomputeLayoutRecords();

        _loading = false;
    }

    private async Task LoadStats(Guid? scopeUserId, Guid? scopePlayerId)
    {
        if (CurrentUser.UserId is not { } userId) return;
        var query = new GetStatisticsQuery(userId, scopeUserId, scopePlayerId);
        var result = await Mediator.Send(query);
        if (result.IsSuccess) _stats = result.Value;
    }

    private void ToggleScopePicker() => _scopeOpen = !_scopeOpen;

    private async Task SetScope(PlayerStats? player)
    {
        _scopeOpen = false;
        if (SameScope(player, _scoped)) return;

        _scoped = player;
        _loading = true;
        StateHasChanged();
        await LoadStats(player?.UserId, player?.PlayerId);
        RecomputeLayoutRecords();
        _loading = false;
    }

    private static bool SameScope(
        PlayerStats? a,
        PlayerStats? b)
    {
        if (a is null && b is null) return true;
        if (a is null || b is null) return false;
        return a.UserId == b.UserId && a.PlayerId == b.PlayerId;
    }

    private static string ScopeRowClass(bool active) =>
        (active
            ? "bg-accent-50 hover:bg-accent-100 "
            : "hover:bg-ink-50 ")
        + "w-full flex items-center gap-2.5 px-2 py-1.5 rounded-lg transition-colors";

    /// <summary>The spirit's per-aspect tally in the shape the shared chips read.</summary>
    private static IReadOnlyDictionary<string, SetupInsights.PlayRecord> AspectRecordsOf(SpiritStats s) =>
        s.Aspects.ToDictionary(
            a => a.AspectId ?? SetupInsights.BaseAspectKey,
            a => new SetupInsights.PlayRecord(a.GamesPlayed, a.Wins, a.Losses));

    /// <summary>
    /// Only the aspects actually played. The table is a record, not a catalogue — listing the
    /// variants never taken would widen every row of a spirit like Shadows to say nothing.
    /// </summary>
    private IReadOnlyList<Aspect> PlayedAspects(SpiritStats s)
    {
        var played = s.Aspects.Where(a => a.AspectId is not null).Select(a => a.AspectId!).ToHashSet();
        if (played.Count == 0) return [];
        return GameData.Aspects.Where(a => played.Contains(a.Id.Value)).ToList();
    }

    /// <summary>The aspects of one spirit that are on the player's shelf.</summary>
    private IReadOnlyList<Aspect> OwnedAspectsFor(Spirit s) =>
        GameData.GetAspectsForSpirit(s.Id)
            .Where(a => OwnedExpansions is null || OwnedExpansions.Contains(a.ExpansionId))
            .ToList();

    /// <summary>
    /// Every owned aspect never played, flattened. Counted per variant rather than per spirit —
    /// the same way adversary coverage counts levels, and for the same reason.
    /// </summary>
    private List<MissingAspect> MissingAspects(IReadOnlyList<Spirit> ownedSpirits)
    {
        var played = _stats!.SpiritStatistics
            .SelectMany(s => s.Aspects)
            .Select(a => a.AspectId)
            .OfType<string>()
            .ToHashSet();
        return ownedSpirits
            .SelectMany(s => OwnedAspectsFor(s)
                .Where(a => !played.Contains(a.Id.Value))
                .Select(a => new MissingAspect(s.Id.Value, s.Name, a.Name)))
            .ToList();
    }

    /// <summary>
    /// What was played that the coverage bar above it can't count: content from expansions
    /// this account doesn't own, which happens whenever somebody else brings the box. The
    /// record keeps those games; the collection tally is about the shelf, so it can't.
    /// </summary>
    private static string? OutsideCollectionNote(
        IEnumerable<string> playedIds, IEnumerable<string> ownedIds, string noun)
    {
        var owned = ownedIds.ToHashSet();
        var extra = playedIds.Distinct().Count(id => !owned.Contains(id));
        return extra == 0
            ? null
            : $"Plus {extra} {noun}{(extra == 1 ? "" : "s")} played from expansions you don't own.";
    }

    private IReadOnlyList<Spirit> OwnedSpiritsList() =>
        GameData.Spirits.Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId)).ToList();

    private IReadOnlyList<Adversary> OwnedAdversariesList() =>
        GameData.Adversaries.Where(a => OwnedExpansions is null || OwnedExpansions.Contains(a.ExpansionId)).ToList();

    private IReadOnlyList<Scenario> OwnedScenariosList() =>
        GameData.Scenarios.Where(s => OwnedExpansions is null || OwnedExpansions.Contains(s.ExpansionId)).ToList();

    private IReadOnlyList<Board> OwnedBoardsList() =>
        GameData.Boards.Where(b => OwnedExpansions is null || OwnedExpansions.Contains(b.ExpansionId)).ToList();

    private static List<MissingLevel> MissingAdversaryLevels(
        IReadOnlyList<AdversaryStats> stats,
        IReadOnlyList<Adversary> ownedAdversaries)
    {
        var statsByAdv = stats.ToDictionary(a => a.AdversaryId);
        var missing = new List<MissingLevel>();
        foreach (var adv in ownedAdversaries)
        {
            var played = statsByAdv.TryGetValue(adv.Id.Value, out var s)
                ? s.Levels.Select(l => l.Level).ToHashSet()
                : new HashSet<int>();
            foreach (var mode in adv.Modes.OrderBy(m => m.Level))
            {
                if (!played.Contains(mode.Level))
                {
                    missing.Add(new MissingLevel(adv.Id.Value, adv.Name, mode.Level));
                }
            }
        }
        return missing;
    }
}
