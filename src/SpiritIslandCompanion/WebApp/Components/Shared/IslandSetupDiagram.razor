@* Renders a small picture of an island setup.

   The diagrams in /img/layouts/generated are emitted by tools/build-island-geometry.mjs
   from the very placements the island playground uses, so a preview always matches what
   dropping that layout in produces. Custom layouts have no fixed shape — they fall back
   to a board-count placeholder.

   Thematic islands are drawn reflected, for the same reason the playground reflects them:
   they are played on the boards' reverse side. The diagrams are generated from the one
   traced side, so the reflection happens here rather than in the file. *@

@if (Setup is null)
{
    <div class="@PlaceholderClass">—</div>
}
else if (_hasImage)
{
    <img src="@_src"
         alt="@Setup.Name layout, @Setup.NumberOfPlayers @(Setup.NumberOfPlayers == 1 ? "board" : "boards")"
         class="@Class object-contain @(Setup.IsThematic ? "-scale-x-100" : "")"
         loading="lazy"/>
}
else
{
    <div class="@PlaceholderClass" title="@Setup.Name (@Setup.NumberOfPlayers @(Setup.NumberOfPlayers == 1 ? "board" : "boards"))">
        @Setup.NumberOfPlayers<span class="text-[0.65em] align-top">p</span>
    </div>
}

@code {
    [Parameter] public IslandSetup? Setup { get; set; }
    [Parameter] public string Class { get; set; } = "h-16 w-auto";

    private string PlaceholderClass =>
        $"{Class} flex items-center justify-center text-ink-500 font-semibold rounded-lg border border-dashed border-ink-200 bg-ink-50 px-3 aspect-square";

    private string _src = "";
    private bool _hasImage;

    protected override void OnParametersSet()
    {
        _hasImage = Setup is not null && !Setup.IsCustom;
        _src = Setup is null ? "" : $"/img/layouts/generated/{Setup.Id.Value}.svg";
    }
}
