@* Spirit reference sheet. Given Facts it also profiles the player's own history
   with the spirit, and given OnSelected it can be chosen straight from here — that
   is how the setup screen lets you explore before committing to a pick.
   z-60 keeps it above the picker modals (z-50) that open it. *@

@using Application.Features.Statistics

@if (_spirit is not null)
{
    var detail = _detail;
    var color = detail?.ColorHex ?? GameLookups.NeutralColor;

    <ModalShell OnClose="Close" ZIndex="z-[60]">
            @* Header band coloured by the spirit *@
            <div class="px-6 pt-6 pb-5 relative" style="background: linear-gradient(135deg, @(color)18 0%, @(color)08 100%); border-bottom: 1px solid @(color)33;">
                <button class="absolute top-4 right-4 inline-flex h-8 w-8 items-center justify-center rounded-lg text-ink-500 hover:bg-white/60 hover:text-ink-900 transition-colors" @onclick="Close" aria-label="Close">
                    <Icon Name="x" Class="w-5 h-5"/>
                </button>

                <div class="flex items-start gap-4 pr-10">
                    <span class="inline-block w-1.5 self-stretch rounded-full shrink-0" style="background-color: @color;"></span>
                    <div class="min-w-0 flex-1">
                        <h2 class="text-2xl font-semibold text-ink-900 leading-tight" style="font-family: var(--font-serif);">@_spirit.Name</h2>
                        <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
                            <span class="badge badge-neutral">@GameLookups.ExpansionName(_spirit.ExpansionId)</span>
                            @if (detail is not null)
                            {
                                <span class="badge" style="background-color: @(color)20; color: @color;">
                                    @SpiritFilter.ComplexityLabel(detail.Complexity) complexity
                                </span>
                                <span class="text-ink-600">· @detail.PlayStyle</span>
                            }
                        </div>
                        @if (detail is not null && (detail.Elements.Count > 0 || detail.Tokens.Count > 0))
                        {
                            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                                @if (detail.Elements.Count > 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] uppercase tracking-wide text-ink-500">Elements</span>
                                        <ElementBadges Elements="detail.Elements" Size="md"/>
                                    </div>
                                }
                                @if (detail.Tokens.Count > 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] uppercase tracking-wide text-ink-500">Tokens</span>
                                        <TokenBadges Tokens="detail.Tokens" Size="md"/>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Body *@
            <div class="overflow-y-auto px-6 py-5 space-y-6">
                @if (detail is not null)
                {
                    <p class="text-ink-700 leading-relaxed">@detail.Summary</p>
                }
                else
                {
                    <p class="text-ink-500 italic">No additional information available.</p>
                }

                @if (_profile is not null)
                {
                    <SetupProfileSection Profile="_profile" Name="@_spirit.Name" SubjectName="@SubjectName"
                                         Title="Your record with this spirit"/>
                }

                @if (_aspects.Count > 0)
                {
                    <div>
                        <h3 class="text-sm font-medium uppercase tracking-wide text-ink-500 mb-3">Aspects</h3>
                        <ul class="space-y-3">
                            @foreach (var aspect in _aspects)
                            {
                                var aspectDetail = AspectDetails.For(aspect.Id);
                                <li class="rounded-lg border border-ink-200 p-4">
                                    <div class="flex items-center gap-2">
                                        <span class="h-2 w-2 rounded-full shrink-0" style="background-color: @color;"></span>
                                        <span class="font-medium text-ink-900">@aspect.Name</span>
                                        <span class="ml-auto text-[11px] uppercase tracking-wide text-ink-400">@GameLookups.ExpansionName(aspect.ExpansionId)</span>
                                    </div>
                                    @if (aspectDetail is not null)
                                    {
                                        <p class="mt-2 text-sm text-ink-600 leading-relaxed">@aspectDetail.Summary</p>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="pt-2">
                    <a href="@GameLookups.WikiLink(_spirit.Name)" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 text-sm text-accent-700 hover:text-accent-800">
                        Read on the Spirit Island wiki
                        <Icon Name="arrow-right" Class="w-3.5 h-3.5"/>
                    </a>
                </div>
            </div>

            @if (OnSelected.HasDelegate)
            {
                <div class="flex items-center justify-between gap-3 border-t border-ink-100 bg-ink-50/40 px-6 py-3.5 md:rounded-b-2xl">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="Close">
                        <Icon Name="arrow-left" Class="w-3.5 h-3.5"/> Back to spirits
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="Select">
                        <Icon Name="check" Class="w-4 h-4"/> Play @_spirit.Name
                    </button>
                </div>
            }
    </ModalShell>
}

@code {
    /// <summary>
    /// Null (default) shows every aspect; a non-null list restricts to aspects
    /// from the listed expansions. The parent view passes this in; the modal
    /// itself doesn't read auth state.
    /// </summary>
    [Parameter] public IReadOnlyList<ExpansionId>? OwnedExpansions { get; set; }

    /// <summary>
    /// Personal game history. When there is any, the modal profiles the player's record
    /// with this spirit; empty or null hides the section entirely (plain reference sheet).
    /// </summary>
    [Parameter] public IReadOnlyList<SetupGameFact>? Facts { get; set; }

    /// <summary>Scopes the record to one person's seats — a friend sitting in the seat being set up.</summary>
    [Parameter] public Func<SetupFactSeat, bool>? SeatFilter { get; set; }

    /// <summary>Whose record is shown when it isn't the current user's, e.g. "Anna".</summary>
    [Parameter] public string? SubjectName { get; set; }

    /// <summary>When set, a footer action picks this spirit — used when opened from the picker.</summary>
    [Parameter] public EventCallback<Spirit> OnSelected { get; set; }

    private Spirit? _spirit;
    private SpiritDetail? _detail;
    private IReadOnlyList<Aspect> _aspects = [];
    private SetupProfiles.Profile? _profile;

    public void Show(Spirit spirit)
    {
        _spirit = spirit;
        _detail = SpiritDetails.For(spirit.Id);
        _aspects = GameData.GetAspectsForSpirit(spirit.Id)
            .Where(a => OwnedExpansions is null || OwnedExpansions.Contains(a.ExpansionId))
            .ToList();
        _profile = Facts is { Count: > 0 }
            ? SetupProfiles.Build(SetupSubjectKind.Spirit, spirit.Id.Value, Facts, SeatFilter)
            : null;
        StateHasChanged();
    }

    private void Close()
    {
        _spirit = null;
        _detail = null;
        _aspects = [];
        _profile = null;
    }

    private async Task Select()
    {
        var spirit = _spirit;
        Close();
        if (spirit is not null) await OnSelected.InvokeAsync(spirit);
    }
}
