@* "Your record" — renders a SetupProfiles.Profile: headline numbers, what the
   subject was paired with, and the most recent games. Used by the entity detail
   modals (spirit / board / adversary / scenario) so a player can explore their
   own history before committing to a matchup.

   Given Facts and SubjectId (seat-bound subjects only), the section grows an
   owner toggle when more than one person has played the subject — All / You /
   Anna — and rebuilds every number below for the picked person. Hosts that
   already scope the sheet to one person simply don't pass Facts. *@

@using System.Globalization
@using Application.Features.Statistics

<div class="space-y-4">
    <div class="flex items-baseline justify-between gap-2">
        <h3 class="text-sm font-medium uppercase tracking-wide text-ink-500">@Title</h3>
        @if (CornerLabel is { } corner)
        {
            <span class="text-[11px] text-ink-400">@corner</span>
        }
    </div>

    @if (Profile.Record.Played == 0)
    {
        <div class="flex items-start gap-2.5 rounded-xl border border-dashed border-amber-300 bg-amber-50/60 px-3.5 py-3">
            <Icon Name="sparkles" Class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"/>
            <div class="text-xs leading-relaxed text-amber-800">
                <span class="font-semibold">@EmptyHeadline</span>
                <span class="text-amber-700">Pick it and this becomes game one — every number here starts filling in.</span>
            </div>
        </div>
    }
    else
    {
        @* --- owner toggle: whose seats the numbers below count --- *@
        @if (_owners.Count > 1)
        {
            <div class="flex flex-wrap items-center gap-1">
                <button type="button" @onclick="() => SelectOwner(null)" class="@OwnerPillClass(_ownerKey is null)">
                    All players
                </button>
                @foreach (var owner in _owners)
                {
                    <button type="button" @onclick="() => SelectOwner(owner.Key)"
                            class="@OwnerPillClass(_ownerKey == owner.Key)"
                            title="@($"{owner.Label} — played {owner.Played}×")">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background-color: @(owner.ColorHex ?? "#a8a29e");"></span>
                        @owner.Label
                        <span class="tabular-nums opacity-60">@(owner.Played)×</span>
                    </button>
                }
            </div>
        }

        @* --- headline --- *@
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 rounded-xl border border-ink-200 bg-ink-50/40 px-4 py-3.5">
            @if (_shown.Record.Completed > 0)
            {
                <WinRateRing Pct="_shown.Record.WinRate" Size="76" Stroke="7" Caption="wins"/>
            }
            else
            {
                <div class="flex h-[76px] w-[76px] shrink-0 items-center justify-center rounded-full border-2 border-dashed border-ink-200 text-center">
                    <span class="px-2 text-[9px] uppercase leading-tight tracking-wide text-ink-400">no results yet</span>
                </div>
            }
            <dl class="grid min-w-0 flex-1 grid-cols-2 gap-x-6 gap-y-1.5 text-xs sm:grid-cols-3">
                @foreach (var stat in HeroStats)
                {
                    <div class="min-w-0">
                        <dt class="text-[10px] uppercase tracking-wide text-ink-500">@stat.Label</dt>
                        <dd class="truncate font-semibold tabular-nums text-ink-900">@stat.Value</dd>
                    </div>
                }
            </dl>
        </div>

        @if (Timeline is { } timeline)
        {
            <p class="text-[11px] text-ink-500">@timeline</p>
        }

        @* --- what it was paired with --- *@
        @if (_shown.Breakdowns.Count > 0)
        {
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var breakdown in _shown.Breakdowns)
                {
                    var most = breakdown.Rows.Max(r => r.Record.Played);
                    <div>
                        <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">@breakdown.Title</div>
                        <div class="space-y-1">
                            @foreach (var row in breakdown.Rows)
                            {
                                <div class="flex items-center gap-2 rounded-md px-1.5 py-1 text-[11px]"
                                     style="@ShareStyle(row, most)"
                                     title="@RowTooltip(row)">
                                    @if (row.Badge is { } badge)
                                    {
                                        <span class="inline-flex h-4 min-w-4 shrink-0 items-center justify-center rounded px-1 text-[9px] font-bold text-white"
                                              style="background-color: @(row.ColorHex ?? "var(--color-ink-400)"); font-family: var(--font-serif);">@badge</span>
                                    }
                                    else if (row.ColorHex is { } dot)
                                    {
                                        <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @dot;"></span>
                                    }
                                    <span class="min-w-0 flex-1 truncate text-ink-800">@row.Label</span>
                                    <span class="shrink-0 tabular-nums text-ink-500">@(row.Record.Played)×</span>
                                    @if (row.Record.Completed > 0)
                                    {
                                        <span class="w-8 shrink-0 text-right tabular-nums font-semibold @WinTone.ForRate(row.Record.WinRate)">@($"{row.Record.WinRate:F0}")%</span>
                                    }
                                    else
                                    {
                                        <span class="w-8 shrink-0 text-right text-ink-300">—</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (breakdown.Hidden > 0)
                        {
                            <div class="mt-1 px-1.5 text-[10px] text-ink-400">+@breakdown.Hidden more</div>
                        }
                    </div>
                }
            </div>
        }

        @* --- recent games --- *@
        @if (_shown.Recent.Count > 0)
        {
            <div>
                <div class="mb-1.5 text-[10px] font-medium uppercase tracking-wider text-ink-500">Recent games</div>
                <div class="divide-y divide-ink-100 overflow-hidden rounded-lg border border-ink-200">
                    @foreach (var game in _shown.Recent)
                    {
                        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 px-2.5 py-1.5 text-[11px]">
                            @* As stored, not converted to server-local — see GameDetail. *@
                            <span class="w-14 shrink-0 tabular-nums text-ink-500">@game.When.DateTime.ToString("MMM d")</span>
                            <span class="shrink-0 scale-90 origin-left">
                                <GameStatusBadge IsCompleted="game.IsCompleted" Win="game.Win"/>
                            </span>
                            <span class="min-w-0 flex-1 truncate text-ink-700">@game.Context</span>
                            <span class="shrink-0 tabular-nums text-ink-400">diff @game.Difficulty</span>
                            <span class="w-7 shrink-0 text-right font-semibold tabular-nums text-ink-800">
                                @(game.Score?.ToString() ?? "—")
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public SetupProfiles.Profile Profile { get; set; } = default!;

    /// <summary>The subject's display name — used in the never-played message.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Whose history this is when the stats are scoped to someone else, e.g. "Anna".</summary>
    [Parameter] public string? SubjectName { get; set; }

    [Parameter] public string Title { get; set; } = "Your record";

    /// <summary>
    /// The history behind <see cref="Profile"/>. Together with <see cref="SubjectId"/>
    /// this enables the owner toggle; hosts whose sheet is already scoped to one
    /// person leave it null.
    /// </summary>
    [Parameter] public IReadOnlyList<SetupGameFact>? Facts { get; set; }

    /// <summary>The subject's catalogue id — a spirit or board id.</summary>
    [Parameter] public string? SubjectId { get; set; }

    private string? _ownerKey;
    private string? _lastSubject;
    private IReadOnlyList<SetupProfiles.OwnerOption> _owners = [];
    private SetupProfiles.Profile _shown = default!;

    private SetupProfiles.OwnerOption? SelectedOwner =>
        _ownerKey is null ? null : _owners.FirstOrDefault(o => o.Key == _ownerKey);

    protected override void OnParametersSet()
    {
        // A new subject means a new toggle — carrying a selection over would silently
        // show one spirit's sheet filtered by another spirit's player.
        if (_lastSubject != SubjectId)
        {
            _lastSubject = SubjectId;
            _ownerKey = null;
        }
        _owners = Facts is { Count: > 0 } && SubjectId is not null
            ? SetupProfiles.Owners(Profile.Kind, SubjectId, Facts)
            : [];
        if (_ownerKey is not null && _owners.All(o => o.Key != _ownerKey)) _ownerKey = null;
        RecomputeShown();
    }

    private void SelectOwner(string? key)
    {
        _ownerKey = key;
        RecomputeShown();
    }

    private void RecomputeShown() =>
        _shown = SelectedOwner is { } owner && Facts is not null && SubjectId is not null
            ? SetupProfiles.Build(Profile.Kind, SubjectId, Facts, owner.Filter)
            : Profile;

    private static string OwnerPillClass(bool active) =>
        "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-medium transition-colors " +
        (active
            ? "border-accent-300 bg-accent-100 text-accent-800"
            : "border-ink-200 bg-white text-ink-600 hover:border-ink-300 hover:text-ink-800");

    /// The corner names whose games the numbers are: the host's scope wins, then the
    /// toggle's pick; nothing when the sheet is the whole table's.
    private string? CornerLabel =>
        SubjectName is not null ? $"{SubjectName}'s games"
        : SelectedOwner is { } owner ? (owner.Key == "me" ? "your games" : $"{owner.Label}'s games")
        : null;

    private string EmptyHeadline => Profile.Kind switch
    {
        SetupSubjectKind.Spirit => $"You've never played {Name}.",
        SetupSubjectKind.Board => $"You've never used {Name}.",
        SetupSubjectKind.Adversary => $"You've never faced {Name}.",
        SetupSubjectKind.IslandLayout or SetupSubjectKind.SavedLayout => $"You've never played on {Name}.",
        _ => $"You've never played {Name}."
    };

    private IEnumerable<(string Label, string Value)> HeroStats
    {
        get
        {
            var record = _shown.Record;
            yield return ("Played", $"{record.Played}×");
            yield return ("Result", record.Completed > 0 ? $"{record.Wins} W · {record.Losses} L" : "drafts only");
            if (_shown.BestScore is { } best) yield return ("Best score", best.ToString());
            if (_shown.AverageScore is { } avg) yield return ("Avg score", avg.ToString("F0"));
            if (_shown.AverageDifficulty is { } diff) yield return ("Avg difficulty", diff.ToString("F1"));
            if (_shown.HardestWon is { } hardest) yield return ("Hardest won", hardest.ToString());
        }
    }

    /// "Last played 3 weeks ago · first played 8 months ago" — omits the first-played
    /// half when there is only one game to talk about.
    private string? Timeline
    {
        get
        {
            if (_shown.LastPlayed is not { } last) return null;
            var line = $"Last played {SetupInsights.Ago(last)}";
            return _shown.Record.Played > 1 && _shown.FirstPlayed is { } first
                ? $"{line} · first played {SetupInsights.Ago(first)}"
                : line;
        }
    }

    /// Tints the row proportionally to its share of the most-played row, so a
    /// breakdown reads as a bar chart without spending horizontal space on bars.
    private static string ShareStyle(SetupProfiles.ProfileRow row, int most)
    {
        if (most <= 0) return "";
        var share = Math.Round(row.Record.Played * 100.0 / most, 1).ToString("0.#", CultureInfo.InvariantCulture);
        var tint = row.ColorHex is { } color ? $"{color}24" : "rgba(120,113,108,.12)";
        return $"background: linear-gradient(to right, {tint} {share}%, transparent {share}%);";
    }

    private static string RowTooltip(SetupProfiles.ProfileRow row) =>
        row.Record.Completed > 0
            ? $"{row.Label} — {row.Record.Played} played, {row.Record.Wins} won / {row.Record.Losses} lost"
            : $"{row.Label} — {row.Record.Played} played, no results yet";
}
